# Atlas environment variables.
#
# All variables are OPTIONAL. With an empty .env (or no .env at all) you
# get a contributor build: text + figures + search from the committed
# .cache/docs/ snapshot, no PDF, no audio, no Algolia indexing.
#
# Maintainers fill in the secrets below to fetch fresh Google Docs
# content, render PDFs/audio, and index Algolia.

# Maintainer only — base64-encoded Google Cloud service account JSON
# with documents.readonly scope on the textbook docs.
GOOGLE_CREDENTIALS_BASE64=

# Algolia search.
# PUBLIC_ALGOLIA_APP_ID and PUBLIC_ALGOLIA_SEARCH_KEY are committed as
# defaults in astro.config.mjs — leave blank to use them. Override only
# if you're pointing at a different Algolia app.
PUBLIC_ALGOLIA_APP_ID=
PUBLIC_ALGOLIA_SEARCH_KEY=
PUBLIC_ALGOLIA_INDEX_NAME=atlas-foreview
# Maintainer only — needed to push fresh content into the Algolia index.
ALGOLIA_WRITE_KEY=

# Audio rendering (maintainer only).
ELEVENLABS_API_KEY=
GEMINI_API_KEY=

# Cloudflare R2 (maintainer only — hosts generated PDFs and audio).
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Skip flags — set to 1 to bypass expensive stages even when creds are present.
# Useful for local dev when you're iterating on UI and don't need
# fresh PDFs or audio.
SKIP_PDF=
SKIP_AUDIO=
# Local-dev escape hatch: skip the R2 audio download entirely. Saves
# disk space when audio playback isn't needed. CI/production ignore this.
SKIP_AUDIO_DOWNLOAD=
