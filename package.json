{
  "name": "atlas",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "vitest run --dir tests/smoke",
    "test:a11y": "vitest run --dir tests/a11y",
    "typecheck": "astro check",
    "lint": "eslint .",
    "lint:actions": "for f in .github/workflows/*.yml; do action-validator \"$f\" || exit 1; done",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm test",
    "verify": "pnpm lint && pnpm lint:actions && pnpm typecheck && pnpm test && pnpm build && pnpm test:smoke && pnpm test:a11y",
    "prepare": "git config --local core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@aws-sdk/client-s3": "^3.1060.0",
    "@docsearch/css": "^4.6.3",
    "@docsearch/js": "^4.6.3",
    "@elevenlabs/elevenlabs-js": "^2.51.0",
    "@fontsource-variable/jost": "^5.2.8",
    "@fontsource/righteous": "^5.2.7",
    "@foreview/ais-logos-astro": "^0.1.0",
    "@google/genai": "^2.7.0",
    "@iconify-json/cib": "^1.2.3",
    "@iconify-json/tabler": "^1.2.35",
    "@myriaddreamin/typst-ts-node-compiler": "^0.7.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.0",
    "algoliasearch": "^5.53.0",
    "astro": "^6.4.3",
    "astro-icon": "^1.1.5",
    "astro-loading-indicator": "^0.8.0",
    "googleapis": "^173.0.0",
    "p-limit": "^7.3.0",
    "p-throttle": "^8.1.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.0",
    "tippy.js": "^6.3.7",
    "typescript": "^5.9.3",
    "unstorage": "^1.17.5"
  },
  "devDependencies": {
    "@action-validator/cli": "^0.6.0",
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^17.6.0",
    "playwright": "^1.60.0",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "tsx": "^4.22.4",
    "vitest": "^4.1.8"
  }
}
