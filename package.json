{
  "name": "atlas",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "vitest run --dir tests/smoke",
    "test:a11y": "vitest run --dir tests/a11y",
    "typecheck": "NODE_OPTIONS=--max-old-space-size=3584 astro check",
    "lint": "eslint .",
    "lint:actions": "for f in .github/workflows/*.yml; do action-validator \"$f\" || exit 1; done",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm test",
    "verify": "pnpm lint && pnpm lint:actions && pnpm typecheck && pnpm test && pnpm build && pnpm test:smoke && pnpm test:a11y",
    "prepare": "git config --local core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@aws-sdk/client-s3": "^3.1138.0",
    "@docsearch/css": "^5.1.1",
    "@docsearch/js": "^5.1.1",
    "@elevenlabs/elevenlabs-js": "^2.68.0",
    "@fontsource-variable/jost": "^5.3.0",
    "@fontsource/righteous": "^5.3.0",
    "@foreview/ais-logos-astro": "^0.1.0",
    "@google/genai": "^2.24.0",
    "@iconify-json/cib": "^1.2.3",
    "@iconify-json/tabler": "^1.2.39",
    "@myriaddreamin/typst-ts-node-compiler": "^0.7.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "algoliasearch": "^5.59.0",
    "astro": "^7.3.4",
    "astro-icon": "^1.2.0",
    "astro-loading-indicator": "^0.9.0",
    "googleapis": "^181.0.0",
    "p-limit": "^7.3.3",
    "p-throttle": "^8.1.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "tippy.js": "^6.3.7",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "unstorage": "^1.17.5"
  },
  "devDependencies": {
    "@action-validator/cli": "^0.6.0",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "dotenv": "^18.0.3",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.12.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.0.1",
    "tsx": "^4.23.15",
    "vitest": "^5.0.1",
    "@typescript/native": "npm:typescript@^7.0.2"
  },
  "packageManager": "pnpm@12.5.1"
}
