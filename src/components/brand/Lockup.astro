---
import type { HTMLAttributes } from 'astro/types'
import Logomark from './Logomark.astro'

interface Props extends HTMLAttributes<'svg'> {}

const { ...rest } = Astro.props
---
<span class="flex shrink-0 items-center gap-x-2  h-16">
    <Logomark class="h-8 w-auto text-sky-700" />
    <span class="uppercase font-bold font-display">AI Safety Atlas</span>
</span>
