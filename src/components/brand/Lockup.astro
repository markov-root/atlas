---
import type { HTMLAttributes } from 'astro/types'
import Logomark from './Logomark.astro'

interface Props extends HTMLAttributes<'span'> {
  mono?: boolean
  variant?: 'light' | 'dark'
}

const { class: className, mono = false, variant = 'light', ...rest } = Astro.props
const isDark = variant === 'dark'
---
<span class:list={["flex shrink-0 items-center gap-x-2 h-10", className]} {...rest}>
    <Logomark class:list={["h-8 w-auto", mono ? "" : isDark ? "text-white" : "text-brand-600"]} />
    <span class:list={["uppercase font-bold font-display", mono ? "" : isDark ? "text-white" : "text-gray-900"]}>AI Safety Atlas</span>
</span>
