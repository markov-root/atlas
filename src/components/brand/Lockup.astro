---
import type { HTMLAttributes } from 'astro/types'
import Logomark from './Logomark.astro'

interface Props extends HTMLAttributes<'span'> {
  mono?: boolean
}

const { class: className, mono = false, ...rest } = Astro.props
---
<span class:list={["flex shrink-0 items-center gap-x-2 h-16", className]} {...rest}>
    <Logomark class:list={["h-8 w-auto", mono ? "" : "text-brand-600"]} />
    <span class:list={["uppercase font-bold font-display", mono ? "" : "text-gray-900"]}>AI Safety Atlas</span>
</span>
