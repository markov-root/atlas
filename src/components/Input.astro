---
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'input'> {
  label?: string
  variant?: 'light' | 'dark'
}

const { label, id, variant = 'light', class: className, ...rest } = Astro.props

const variantClasses = {
  light: "bg-white border-gray-300 text-gray-900 placeholder:text-gray-500",
  dark: "bg-white/10 border-white/20 text-white placeholder:text-white/50"
}
---

<div>
    {label && <label for={id} class="sr-only">{label}</label>}
    <input
        id={id}
        class:list={[
            "w-full px-4 py-2 rounded-2xl focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500",
            variantClasses[variant],
            className
        ]}
        {...rest}
    />
</div>
