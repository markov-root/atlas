---
import { PUBLIC_ALGOLIA_APP_ID, PUBLIC_ALGOLIA_SEARCH_KEY, PUBLIC_ALGOLIA_INDEX_NAME } from "astro:env/client";

const appId = PUBLIC_ALGOLIA_APP_ID
const apiKey = PUBLIC_ALGOLIA_SEARCH_KEY
const indexName = PUBLIC_ALGOLIA_INDEX_NAME || 'atlas-foreview'
---

<!-- Hidden container for DocSearch -->
<div id="docsearch-container" class="hidden" aria-hidden="true" transition:persist="docsearch"></div>

<script is:inline define:vars={{ appId, apiKey, indexName }}>
(function() {
  // Re-add CSS if removed by ClientRouter head swap
  if (!document.querySelector('link[href*="@docsearch/css"]')) {
    var link = document.createElement('link');
    link.rel = 'stylesheet';
    link.href = 'https://cdn.jsdelivr.net/npm/@docsearch/css@3/dist/style.min.css';
    document.head.appendChild(link);
  }

  if (window.__docsearchInitialized) return;
  window.__docsearchInitialized = true;

  // Load JS and initialize
  var script = document.createElement('script');
  script.src = 'https://cdn.jsdelivr.net/npm/@docsearch/js@3/dist/umd/index.min.js';
  script.onload = function() {
    window.docsearch({
      appId: appId,
      apiKey: apiKey,
      indexName: indexName,
      container: '#docsearch-container',
      searchParameters: {
        hitsPerPage: 10,
      },
    });

    // Expose global open function
    window.openDocSearch = function() {
      var button = document.querySelector('#docsearch-container .DocSearch-Button');
      if (button) button.click();
    };

    // Set up trigger buttons via event delegation (works with DOM swaps from ClientRouter)
    document.addEventListener('click', function(e) {
      if (e.target.closest('[data-docsearch-trigger]')) {
        window.openDocSearch();
      }
    });
  };
  document.head.appendChild(script);
})();
</script>

<style is:global>
  /* Modal styling */
  .DocSearch-Modal {
    --docsearch-primary-color: rgb(37 99 235);
    --docsearch-highlight-color: rgb(37 99 235);
    --docsearch-searchbox-shadow: inset 0 0 0 2px rgb(37 99 235);
  }

  .DocSearch-Hit-source {
    font-weight: 600;
    color: rgb(107 114 128);
  }

  .DocSearch-Hit a {
    border-radius: 8px;
  }

  .DocSearch-Hit[aria-selected="true"] a {
    background: rgb(37 99 235);
  }
</style>
