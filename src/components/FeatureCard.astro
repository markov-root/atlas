---
import { Icon } from 'astro-icon/components'

interface Props {
  icon: string
  title: string
  description: string
  class?: string
}

const { icon, title, description, class: className } = Astro.props
---

<div class:list={["p-6 lg:p-8", className]}>
  <div class="size-10 rounded-full bg-gray-100 flex items-center justify-center mb-4">
    <Icon name={icon} class="size-5 text-gray-600" />
  </div>
  <h3 class="text-base font-semibold text-gray-900">{title}</h3>
  <p class="mt-1 text-sm text-gray-600">{description}</p>
</div>
