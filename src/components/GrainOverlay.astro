---
interface Props {
  opacity?: number
  class?: string
}

const { opacity = 0.5, class: className } = Astro.props
---

<div
  class:list={["absolute inset-0 mix-blend-overlay pointer-events-none", className]}
  style={`opacity: ${opacity}; background-image: url(/noise.webp); background-repeat: repeat;`}
  aria-hidden="true"
></div>
