---
import { getTextbooks } from '@/lib/textbooks'

interface Props {
  currentVersion?: string
  variant?: 'light' | 'dark'
  class?: string
}

const { currentVersion, variant = 'light', class: className } = Astro.props
const isDark = variant === 'dark'

// Get all available textbook versions
const textbooks = await getTextbooks()
const versions = textbooks
  .map(t => t.data.version)
  .sort((a, b) => b.localeCompare(a)) // newest first

// Determine current version from props or URL
const pathname = Astro.url.pathname
const urlVersion = pathname.match(/\/chapters\/([^/]+)\//)?.[1]
  || pathname.match(/\/read\/([^/]+)/)?.[1]
const activeVersion = currentVersion || urlVersion || versions[0]

// Format version for display (e.g., "v1" -> "Version 1")
function formatVersion(v: string) {
  const num = v.replace(/^v/, '')
  return `Version ${num}`
}
---

<select
  class:list={[
    "px-3 py-1.5 text-sm font-medium rounded-lg transition-colors cursor-pointer",
    isDark
      ? "text-white bg-white/10 hover:bg-white/20 border-0"
      : "text-gray-700 bg-gray-100 hover:bg-gray-200 border-0",
    className
  ]}
  data-version-selector
>
  {versions.map((version) => (
    <option value={version} selected={activeVersion === version}>
      {formatVersion(version)}
    </option>
  ))}
</select>

<script>
  document.querySelectorAll<HTMLSelectElement>('[data-version-selector]').forEach((select) => {
    select.addEventListener('change', () => {
      window.location.href = `/read/${select.value}`
    })
  })
</script>
