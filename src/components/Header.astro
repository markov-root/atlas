---
import Lockup from '@/components/brand/Lockup.astro';
import VersionSelector from '@/components/VersionSelector.astro';
import AlgoliaSearch from '@/components/AlgoliaSearch.astro';

interface Props {
  class?: string
  variant?: 'light' | 'dark'
}

const { class: className, variant = 'light' } = Astro.props
const isDark = variant === 'dark'
---

<header class:list={["relative z-10", className]}>
  <nav aria-label="Global" class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 lg:px-8">
    <div class="flex lg:flex-1 items-center gap-4">
      <a href="/" class="-m-1.5 p-1.5">
        <Lockup variant={variant} />
      </a>
      <VersionSelector variant={variant} class="hidden lg:block" />
    </div>
    <div class="flex lg:hidden items-center gap-1">
      <AlgoliaSearch id="mobile-header-search" variant={variant} iconOnly />
      <button type="button" popovertarget="mobile-menu" class:list={["-m-2.5 inline-flex items-center justify-center rounded-md p-2.5", isDark ? "text-white/80" : "text-gray-700"]}>
        <span class="sr-only">Open main menu</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" data-slot="icon" aria-hidden="true" class="size-6">
          <path d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
    </div>
    <div class="hidden lg:flex lg:gap-x-12">
      <a href="/read" class:list={["text-sm/6 px-4 py-1.5 rounded-full", isDark ? "text-white hover:bg-white/10" : "text-gray-900 hover:bg-gray-100"]}>Read</a>
      <a href="/teach" class:list={["text-sm/6 px-4 py-1.5 rounded-full", isDark ? "text-white hover:bg-white/10" : "text-gray-900 hover:bg-gray-100"]}>Teach</a>
      <a href="/get-certified" class:list={["text-sm/6 px-4 py-1.5 rounded-full", isDark ? "text-white hover:bg-white/10" : "text-gray-900 hover:bg-gray-100"]}>Get certified</a>
    </div>
    <div class="hidden lg:flex lg:flex-1 lg:justify-end lg:pr-2">
      <AlgoliaSearch id="header-search" class="w-full max-w-xs" variant={variant} />
    </div>
  </nav>
  <div popover="auto" id="mobile-menu" class="lg:hidden fixed top-14 left-0 m-0 w-full bg-white shadow-lg border-t border-gray-200 p-2">
    <div class="max-w-7xl mx-auto px-4">
      <VersionSelector class="mb-2" />
      <a href="/read" class="block rounded-lg px-3 py-2 text-base/7 text-gray-900 hover:bg-gray-100">Read</a>
      <a href="/teach" class="block rounded-lg px-3 py-2 text-base/7 text-gray-900 hover:bg-gray-100">Teach</a>
      <a href="/get-certified" class="block rounded-lg px-3 py-2 text-base/7 text-gray-900 hover:bg-gray-100">Get certified</a>
    </div>
  </div>
</header>
