---
import Logomark from '@/components/brand/Logomark.astro';
import Lockup from '@/components/brand/Lockup.astro';
import VersionSelector from '@/components/VersionSelector.astro';

interface Props {
  class?: string
  variant?: 'light' | 'dark'
}

const { class: className, variant = 'light' } = Astro.props
const isDark = variant === 'dark'
---

<header class:list={["relative z-10", className]}>
  <nav aria-label="Global" class="mx-auto flex max-w-7xl items-center justify-between px-6 py-3 lg:px-8">
    <div class="flex lg:flex-1 items-center gap-4">
      <a href="/" class="-m-1.5 p-1.5">
        <Lockup variant={variant} />
      </a>
      <VersionSelector variant={variant} class="hidden lg:block" />
    </div>
    <div class="flex lg:hidden">
      <button type="button" command="show-modal" commandfor="mobile-menu" class:list={["-m-2.5 inline-flex items-center justify-center rounded-md p-2.5", isDark ? "text-white/80" : "text-gray-700"]}>
        <span class="sr-only">Open main menu</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" data-slot="icon" aria-hidden="true" class="size-6">
          <path d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
    </div>
    <div class="hidden lg:flex lg:gap-x-12">
      <a href="/read" class:list={["text-sm/6 px-4 py-1.5 rounded-full", isDark ? "text-white hover:bg-white/10" : "text-gray-900 hover:bg-gray-100"]}>Read</a>
      <a href="/teach" class:list={["text-sm/6 px-4 py-1.5 rounded-full", isDark ? "text-white hover:bg-white/10" : "text-gray-900 hover:bg-gray-100"]}>Teach</a>
      <a href="/join-study-group" class:list={["text-sm/6 px-4 py-1.5 rounded-full", isDark ? "text-white hover:bg-white/10" : "text-gray-900 hover:bg-gray-100"]}>Get certified</a>
    </div>
    <div class="hidden lg:flex lg:flex-1 lg:justify-end">
      <div id="search" class="relative w-full max-w-xs">
        <div class="grid w-full grid-cols-1">
          <input
            type="search"
            id="search-input"
            placeholder="Search"
            class:list={[
              "col-start-1 row-start-1 block w-full rounded-full py-1.5 pr-3 pl-10 text-base sm:text-sm/6 focus:outline-2 focus:-outline-offset-2",
              isDark
                ? "bg-white/10 text-white placeholder:text-white/50 outline-white/20 focus:outline-white/40"
                : "bg-white text-gray-900 placeholder:text-gray-500 outline-1 -outline-offset-1 outline-gray-300 focus:outline-brand-600"
            ]}
          />
          <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class:list={["pointer-events-none col-start-1 row-start-1 ml-3 size-5 self-center", isDark ? "text-white/50" : "text-gray-500"]}>
            <path d="M9 3.5a5.5 5.5 0 1 0 0 11 5.5 5.5 0 0 0 0-11ZM2 9a7 7 0 1 1 12.452 4.391l3.328 3.329a.75.75 0 1 1-1.06 1.06l-3.329-3.328A7 7 0 0 1 2 9Z" clip-rule="evenodd" fill-rule="evenodd" />
          </svg>
        </div>
        <div id="search-results" class="hidden absolute top-full left-0 right-0 z-50 mt-1 max-h-96 overflow-y-auto rounded-md bg-white shadow-lg ring-1 ring-gray-200">
        </div>
      </div>
    </div>
  </nav>
  <el-dialog>
    <dialog id="mobile-menu" class="backdrop:bg-transparent lg:hidden">
      <div tabindex="0" class="fixed inset-0 focus:outline-none">
        <el-dialog-panel class="fixed inset-y-0 right-0 z-50 w-full overflow-y-auto bg-white p-6 sm:max-w-sm sm:ring-1 sm:ring-gray-900/10">
          <div class="flex items-center justify-between">
            <a href="/" class="-m-1.5 p-1.5">
              <span class="sr-only">AI Safety Atlas</span>
              <Logomark class="h-8 w-auto text-brand-600" />
            </a>
            <button type="button" command="close" commandfor="mobile-menu" class="-m-2.5 rounded-md p-2.5 text-gray-700">
              <span class="sr-only">Close menu</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" data-slot="icon" aria-hidden="true" class="size-6">
                <path d="M6 18 18 6M6 6l12 12" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>
          </div>
          <div class="mt-6 flow-root">
            <div class="-my-6 divide-y divide-gray-500/10">
              <div class="space-y-2 py-6">
                <VersionSelector class="mb-2" />
                <a href="/read" class="-mx-3 block rounded-full px-3 py-2 text-base/7 text-gray-900 hover:bg-gray-100">Read</a>
                <a href="/teach" class="-mx-3 block rounded-full px-3 py-2 text-base/7 text-gray-900 hover:bg-gray-100">Teach</a>
                <a href="/join-study-group" class="-mx-3 block rounded-full px-3 py-2 text-base/7 text-gray-900 hover:bg-gray-100">Get certified</a>
              </div>
              <div class="py-6">
                <div id="mobile-search-container" class="relative w-full">
                  <div class="grid w-full grid-cols-1">
                    <input
                      type="search"
                      id="mobile-search-input"
                      placeholder="Search..."
                      class="col-start-1 row-start-1 block w-full rounded-full bg-white py-2.5 pr-3 pl-10 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-500 focus:outline-2 focus:-outline-offset-2 focus:outline-brand-600"
                    />
                    <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="pointer-events-none col-start-1 row-start-1 ml-3 size-5 self-center text-gray-500">
                      <path d="M9 3.5a5.5 5.5 0 1 0 0 11 5.5 5.5 0 0 0 0-11ZM2 9a7 7 0 1 1 12.452 4.391l3.328 3.329a.75.75 0 1 1-1.06 1.06l-3.329-3.328A7 7 0 0 1 2 9Z" clip-rule="evenodd" fill-rule="evenodd" />
                    </svg>
                  </div>
                  <div id="mobile-search-results" class="hidden mt-2 max-h-64 overflow-y-auto rounded-md bg-gray-50 ring-1 ring-gray-200">
                  </div>
                </div>
              </div>
            </div>
          </div>
        </el-dialog-panel>
      </div>
    </dialog>
  </el-dialog>
</header>

<script>
  let pagefind: any = null;

  async function initPagefind() {
    if (pagefind) return pagefind;
    const pagefindPath = "/pagefind/pagefind.js";
    pagefind = await import(/* @vite-ignore */ pagefindPath);
    await pagefind.init();
    return pagefind;
  }

  // Desktop search
  const input = document.getElementById("search-input") as HTMLInputElement;
  const resultsContainer = document.getElementById("search-results")!;

  if (input && resultsContainer) {
    let debounceTimer: number;

    input.addEventListener("input", () => {
      clearTimeout(debounceTimer);
      debounceTimer = window.setTimeout(() => performSearch(input.value, resultsContainer), 150);
    });

    input.addEventListener("focus", () => {
      if (resultsContainer.children.length > 0) {
        resultsContainer.classList.remove("hidden");
      }
    });

    document.addEventListener("click", (e) => {
      if (!document.getElementById("search")?.contains(e.target as Node)) {
        resultsContainer.classList.add("hidden");
      }
    });

    document.addEventListener("keydown", (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key === "k") {
        e.preventDefault();
        input.focus();
      }
    });
  }

  // Mobile search
  const mobileInput = document.getElementById("mobile-search-input") as HTMLInputElement;
  const mobileResultsContainer = document.getElementById("mobile-search-results")!;

  if (mobileInput && mobileResultsContainer) {
    let mobileDebounceTimer: number;

    mobileInput.addEventListener("input", () => {
      clearTimeout(mobileDebounceTimer);
      mobileDebounceTimer = window.setTimeout(() => performSearch(mobileInput.value, mobileResultsContainer), 150);
    });
  }

  async function performSearch(query: string, container: HTMLElement) {
    if (!query.trim()) {
      container.classList.add("hidden");
      container.innerHTML = "";
      return;
    }

    const pf = await initPagefind();
    const search = await pf.search(query);
    const results = await Promise.all(
      search.results.slice(0, 8).map((r: any) => r.data())
    );

    if (results.length === 0) {
      container.innerHTML = `
        <div class="px-4 py-3 text-sm text-gray-500">
          No results found for "${query}"
        </div>
      `;
    } else {
      const allResults: { url: string; title: string; excerpt: string }[] = [];

      for (const result of results) {
        if (result.sub_results && result.sub_results.length > 0) {
          for (const sub of result.sub_results) {
            allResults.push({
              url: sub.url,
              title: sub.title || result.meta?.title || "Untitled",
              excerpt: sub.excerpt,
            });
          }
        } else {
          allResults.push({
            url: result.url,
            title: result.meta?.title || "Untitled",
            excerpt: result.excerpt,
          });
        }
      }

      container.innerHTML = allResults
        .slice(0, 10)
        .map(
          (result) => `
          <a href="${result.url}" class="block px-4 py-3 hover:bg-gray-50 border-b border-gray-100 last:border-0">
            <div class="text-sm font-medium text-gray-900">${result.title}</div>
            <div class="mt-1 text-sm text-gray-600 line-clamp-2">${result.excerpt}</div>
          </a>
        `
        )
        .join("");
    }

    container.classList.remove("hidden");
  }
</script>
