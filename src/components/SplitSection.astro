---
import GrainOverlay from './GrainOverlay.astro'

interface Props {
  id?: string
  heading: string
  headingDescription?: string
  leftBg?: 'white' | 'black' | 'blue' | 'gray'
  rightBg?: 'white' | 'black' | 'blue' | 'gray'
  class?: string
}

const {
  id,
  heading,
  headingDescription,
  leftBg = 'white',
  rightBg = 'black',
  class: className
} = Astro.props

const bgClasses = {
  white: 'bg-white',
  black: 'bg-black',
  blue: 'bg-blue-600',
  gray: 'bg-gray-100'
}

const textClasses = {
  white: 'text-gray-900',
  black: 'text-white',
  blue: 'text-white',
  gray: 'text-gray-900'
}

const descriptionClasses = {
  white: 'text-gray-600',
  black: 'text-white/70',
  blue: 'text-white/80',
  gray: 'text-gray-600'
}

const needsGrain = (bg: string) => bg === 'black' || bg === 'blue'
const grainOpacity = (bg: string) => bg === 'gray' ? 0.3 : 0.5
---

<section id={id} class:list={["mx-4 mt-4 rounded-3xl overflow-hidden", className]}>
  <div class="grid lg:grid-cols-2">
    <!-- Left column -->
    <div class:list={[bgClasses[leftBg], textClasses[leftBg], "flex flex-col relative overflow-hidden"]}>
      {needsGrain(leftBg) && <GrainOverlay opacity={grainOpacity(leftBg)} />}

      <!-- Header -->
      <div class="flex justify-end relative z-10">
        <div class="w-full max-w-[40rem] px-6 pt-12 lg:pt-16 lg:px-8">
          <h2 class="text-3xl lg:text-4xl font-semibold font-display leading-tight max-w-md">
            {heading}
          </h2>
          {headingDescription && (
            <p class:list={["mt-4 text-base lg:text-lg leading-relaxed max-w-md", descriptionClasses[leftBg]]}>
              {headingDescription}
            </p>
          )}
        </div>
      </div>

      <!-- Left content -->
      <div class="flex justify-end relative z-10">
        <div class="w-full max-w-[40rem] px-6 pb-12 lg:pb-16 lg:px-8">
          <slot name="left" />
        </div>
      </div>
    </div>

    <!-- Right column -->
    <div class:list={[bgClasses[rightBg], textClasses[rightBg], "flex flex-col relative overflow-hidden"]}>
      {needsGrain(rightBg) && <GrainOverlay opacity={grainOpacity(rightBg)} />}

      <!-- Empty spacer for header alignment -->
      <div class="hidden lg:block relative z-10">
        <div class="w-full max-w-[40rem] px-6 pt-12 lg:pt-16 lg:px-8">
          <!-- Invisible spacer matching header structure -->
          <div class="text-3xl lg:text-4xl font-semibold font-display leading-tight max-w-md invisible" aria-hidden="true">
            {heading}
          </div>
          {headingDescription && (
            <p class="mt-4 text-base lg:text-lg leading-relaxed max-w-md invisible" aria-hidden="true">
              {headingDescription}
            </p>
          )}
        </div>
      </div>

      <!-- Right content -->
      <div class="relative z-10">
        <div class="w-full max-w-[40rem] px-6 py-12 lg:pb-16 lg:pt-0 lg:px-8">
          <slot name="right" />
        </div>
      </div>
    </div>
  </div>
</section>
