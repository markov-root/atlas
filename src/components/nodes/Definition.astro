---
import type { Node } from '@/textbook-loader/transformer';
import type { InstanceCount } from '@/textbook-loader';
import NodeRenderer from '@/components/NodeRenderer.astro';

interface Props {
  term?: string;
  source?: Node;
  chapterNumber: number;
  instanceCount: InstanceCount;
}

const { term, source, chapterNumber, instanceCount } = Astro.props;

const definitionNumber = `Definition ${chapterNumber}.${instanceCount.inChapter}`;
---

<div class="definition-card my-6 rounded-lg border-l-4 border-brand-500 bg-brand-50 px-6 py-4" data-collapsed="true">
  <dt
    class="definition-header flex cursor-pointer items-center justify-between font-semibold text-brand-900 not-prose md:cursor-default"
  >
    <span>{definitionNumber}{term && <> — {term}</>}</span>
    <svg
      class="definition-chevron h-5 w-5 shrink-0 transition-transform md:hidden"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      stroke-width="2"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
    </svg>
  </dt>
  <dd class="definition-content mt-2 hidden md:block">
    <slot />
    {source && <cite class="mt-2 block text-sm text-brand-700 not-prose"><NodeRenderer node={source} /></cite>}
  </dd>
</div>

<script>
  function initDefinitions() {
    const definitions = document.querySelectorAll('.definition-card');

    definitions.forEach((card) => {
      const header = card.querySelector('.definition-header');
      const content = card.querySelector('.definition-content');
      const chevron = card.querySelector('.definition-chevron');

      if (!header || !content) return;

      header.addEventListener('click', (e) => {
        // Only toggle on mobile
        if (window.innerWidth >= 768) return;

        e.stopPropagation();
        const isCollapsed = card.getAttribute('data-collapsed') === 'true';

        if (isCollapsed) {
          // Close other open definitions first
          definitions.forEach((other) => {
            if (other !== card && other.getAttribute('data-collapsed') === 'false') {
              other.setAttribute('data-collapsed', 'true');
              other.querySelector('.definition-content')?.classList.add('hidden');
              other.querySelector('.definition-chevron')?.classList.remove('rotate-180');
            }
          });

          card.setAttribute('data-collapsed', 'false');
          content.classList.remove('hidden');
          chevron?.classList.add('rotate-180');
        } else {
          card.setAttribute('data-collapsed', 'true');
          content.classList.add('hidden');
          chevron?.classList.remove('rotate-180');
        }
      });
    });

    // Click outside to close
    document.addEventListener('click', (e) => {
      if (window.innerWidth >= 768) return;

      const target = e.target as HTMLElement;
      if (!target.closest('.definition-card')) {
        definitions.forEach((card) => {
          if (card.getAttribute('data-collapsed') === 'false') {
            card.setAttribute('data-collapsed', 'true');
            card.querySelector('.definition-content')?.classList.add('hidden');
            card.querySelector('.definition-chevron')?.classList.remove('rotate-180');
          }
        });
      }
    });
  }

  // Run on initial load and after Astro page transitions
  initDefinitions();
  document.addEventListener('astro:after-swap', initDefinitions);
</script>
