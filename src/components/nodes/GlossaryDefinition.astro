---
interface Props {
  term: string;
  definition: string;
  sourceUrl?: string;
  sourceLabel?: string;
  matchedText: string;
}

const { term, definition, sourceUrl, sourceLabel, matchedText } = Astro.props;
---

<span
  class="glossary-term"
  tabindex="0"
  data-glossary-term={term}
  data-glossary-definition={definition}
  data-glossary-source-url={sourceUrl}
  data-glossary-source-label={sourceLabel}
>{matchedText}</span>

<script>
  import tippy from 'tippy.js';
  import 'tippy.js/dist/tippy.css';

  function initGlossary() {
    const terms = document.querySelectorAll('.glossary-term:not([data-tippy-initialized])');

    terms.forEach((el) => {
      const term = el.getAttribute('data-glossary-term');
      const definition = el.getAttribute('data-glossary-definition');
      const sourceUrl = el.getAttribute('data-glossary-source-url');
      const sourceLabel = el.getAttribute('data-glossary-source-label');

      let content = `<strong>${term}</strong><p>${definition}</p>`;
      if (sourceUrl && sourceLabel) {
        content += `<a href="${sourceUrl}" target="_blank" rel="noopener noreferrer">${sourceLabel}</a>`;
      }

      tippy(el as HTMLElement, {
        content,
        allowHTML: true,
        interactive: true,
        appendTo: document.body,
        trigger: 'mouseenter focus click',
        touch: ['hold', 300],
        theme: 'glossary',
      });

      el.setAttribute('data-tippy-initialized', 'true');
    });
  }

  initGlossary();
  document.addEventListener('astro:after-swap', initGlossary);
</script>

<style is:global>
  .glossary-term {
    background-color: var(--color-gray-100);
    padding: 0 4px;
    border-bottom: 2px solid rgba(25, 113, 194, 0.35);
    cursor: help;
  }

  .glossary-term:hover {
    border-bottom-color: rgba(25, 113, 194, 0.6);
  }

  .tippy-box[data-theme~='glossary'] {
    background-color: var(--color-brand-600);
    color: white;
    font-size: 0.875rem;
    line-height: 1.5;
    max-width: 320px;
  }

  .tippy-box[data-theme~='glossary'] .tippy-content {
    padding: 0.75rem 1rem;
  }

  .tippy-box[data-theme~='glossary'] .tippy-arrow {
    color: var(--color-brand-600);
  }

  .tippy-box[data-theme~='glossary'] strong {
    display: block;
    font-weight: 600;
    margin-bottom: 0.25rem;
  }

  .tippy-box[data-theme~='glossary'] p {
    margin: 0;
  }

  .tippy-box[data-theme~='glossary'] a {
    display: block;
    font-size: 0.75rem;
    color: var(--color-brand-100);
    margin-top: 0.5rem;
    text-decoration: underline;
  }

  .tippy-box[data-theme~='glossary'] a:hover {
    color: white;
  }
</style>
