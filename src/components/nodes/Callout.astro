---
interface Props {
  flavor?: string;
}

const { flavor = 'info' } = Astro.props;

const flavorStyles: Record<string, { box: string; icon?: string }> = {
  warning: {
    box: 'bg-amber-50 border border-amber-200 text-amber-800',
  },
};

const defaultStyle = {
  box: 'bg-gray-50',
  icon: 'ℹ️',
};

const style = flavorStyles[flavor] ?? defaultStyle;
---
<div class={`not-prose rounded-2xl  px-6 py-4 ${style.box}`}>
  <div class="flex gap-5">
    {flavor === 'warning' && (
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
    </svg>
    )}
    <div class="prose-p:my-0">
      <slot />
    </div>
  </div>
</div>
