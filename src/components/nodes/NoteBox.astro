---
import { formatReadingTime } from '@/textbook-loader/utils';
import { Icon } from 'astro-icon/components'

interface Props {
  title?: string;
  collapsed?: boolean;
  readingTimeInSeconds: number;
}

const { title, collapsed = false, readingTimeInSeconds } = Astro.props;
---

<details class="group not-prose mb-8"  open={!collapsed}>
  <summary class="bg-gray-50 group group-hover:cursor-pointer border border-gray-200 rounded-2xl group-open:rounded-b-none px-6 py-4 flex justify-between">
      <span class="">
<span class="font-bold block underline group-hover:text-brand-500">{title}</span>
<span class="space-x-1">
    <span class="">Optional</span>
    <span aria-hidden="true">&bull;</span>
    <span class="">{formatReadingTime(readingTimeInSeconds)} read</span>
</span>
      </span>
      <Icon name="tabler:chevron-right" class="w-6" />
  </summary>
  <div class="note-box-content px-6 py-2 border border-t-0 border-gray-200 rounded-b-2xl">
    <slot />
  </div>
</details>
