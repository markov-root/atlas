---
import { formatReadingTime } from '@/textbook-loader/utils';
import { Icon } from 'astro-icon/components'

interface Props {
  title?: string;
  slug: string;
  collapsed?: boolean;
  readingTimeInSeconds: number;
}

const { title, slug, readingTimeInSeconds } = Astro.props;
---

<div class="notebox-wrapper not-prose mb-8" data-notebox-id={slug}>
  <a href={`#${slug}`} class="notebox-trigger bg-gray-50 hover:bg-gray-100 border border-gray-200 rounded-2xl px-6 py-4 flex items-center justify-between transition-colors">
    <span>
      <span class="font-bold block">{title}</span>
      <span class="text-gray-600 text-sm space-x-1">
        <span>Optional</span>
        <span aria-hidden="true">&bull;</span>
        <span>{formatReadingTime(readingTimeInSeconds)} read</span>
      </span>
    </span>
    <Icon name="tabler:chevron-right" class="size-6 text-gray-400" />
  </a>
  <div class="notebox-content hidden" data-notebox-title={title} data-notebox-time={formatReadingTime(readingTimeInSeconds)}>
    <slot />
  </div>
</div>
