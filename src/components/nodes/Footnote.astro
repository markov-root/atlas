---
interface Props {
  number: string;
}

const { number } = Astro.props;
---

<sup class="footnote-ref -ml-1">
  <a href={`#fn-${number}`} id={`fnref-${number}`}>{number}</a>
</sup>

<style>
  .footnote-ref a {
    color: var(--color-brand-600);
    text-decoration: none;
    font-weight: 500;
  }

  .footnote-ref a:hover {
    text-decoration: underline;
  }
</style>
