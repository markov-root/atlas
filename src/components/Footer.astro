---
import Lockup from './brand/Lockup.astro'
import Button from './Button.astro'
import Input from './Input.astro'
import InputLabel from './InputLabel.astro'
import Textarea from './Textarea.astro'
import OrgLogo from './OrgLogo.astro'
import CardLink from './CardLink.astro'
import { Icon } from 'astro-icon/components'
import { siteConfig } from '@/config/site'
---

<footer class="mx-4 mt-4 mb-4 rounded-3xl overflow-hidden bg-black">
    <!-- Main footer content -->
    <div class="grid lg:grid-cols-2">
        <!-- Left: Branding & Social -->
        <div class="flex justify-end">
            <div class="w-full max-w-[40rem] px-6 py-12 lg:px-8 lg:py-16">
                <Lockup variant="dark" class="mb-6" />
                <p class="text-balance text-white/80 text-lg lg:text-xl max-w-md leading-relaxed">
                    Distilling safety research into a complete learning ecosystem.
                </p>
                <div class="flex gap-4 mt-8">
                    <a href="https://github.com/markov-root/atlas" class="text-white/50 hover:text-white transition-colors">
                        <span class="sr-only">GitHub</span>
                        <Icon name="cib:github" class="size-6" />
                    </a>
                    <a href="https://www.youtube.com/@securite-ia" class="text-white/50 hover:text-white transition-colors">
                        <span class="sr-only">YouTube</span>
                        <Icon name="cib:youtube" class="size-6" />
                    </a>
                </div>

                <div class="mt-12">
                    <h3 class="font-semibold text-white mb-4">A project by the French Center for AI Safety</h3>
                    <a href="https://cesia.org" class="inline-flex hover:opacity-80 transition-opacity">
                        <OrgLogo url="https://cesia.org" color="white" class="h-12 w-auto" />
                    </a>
                </div>
            </div>
        </div>

        <!-- Right: Contact Form -->
        <div class="border-t lg:border-t-0 lg:border-l border-white/10">
            <div class="w-full max-w-[40rem] px-6 py-12 lg:px-8 lg:py-16">
                <h3 class="font-semibold text-white mb-6">Get in touch</h3>
                <form action={siteConfig.contactFormspree} method="POST" class="space-y-4">
                    <div class="grid sm:grid-cols-2 gap-4">
                        <div>
                            <InputLabel for="contact-name" variant="dark" required>Name</InputLabel>
                            <Input type="text" name="name" id="contact-name" required placeholder="Name" variant="dark" />
                        </div>
                        <div>
                            <InputLabel for="contact-email" variant="dark" required>Email</InputLabel>
                            <Input type="email" name="email" id="contact-email" required placeholder="Email" variant="dark" />
                        </div>
                    </div>
                    <div>
                        <InputLabel for="contact-message" variant="dark" required>Message</InputLabel>
                        <Textarea name="message" id="contact-message" rows="3" required placeholder="Message" variant="dark" />
                    </div>
                    <Button type="submit" variant="dark">Send message</Button>
                </form>
            </div>
        </div>
    </div>

    <!-- Links section -->
    <div class="border-t border-white/10">
        <div class="grid lg:grid-cols-2">
            <div class="flex justify-end">
                <div class="w-full max-w-[40rem] px-6 py-8 lg:px-8 lg:py-12 grid grid-cols-2 gap-8">
                    <div>
                        <h3 class="font-semibold text-white mb-4">Navigation</h3>
                        <div class="flex flex-col gap-2">
                            <CardLink href="/read" variant="dark">Read</CardLink>
                            <CardLink href="/teach" variant="dark">Teach</CardLink>
                            <CardLink href="/join-study-group" variant="dark">Get certified</CardLink>
                        </div>
                    </div>
                    <div>
                        <h3 class="font-semibold text-white mb-4">Funded by</h3>
                        <div class="flex flex-col gap-2">
                            <CardLink href="https://coefficientgiving.org" variant="dark">Coefficient Giving</CardLink>
                            <CardLink href="https://manifund.org" variant="dark">Manifund</CardLink>
                        </div>
                    </div>
                </div>
            </div>
            <div class="border-t lg:border-t-0 lg:border-l border-white/10">
                <div class="w-full max-w-[40rem] px-6 py-8 lg:px-8 lg:py-12">
                    <h3 class="font-semibold text-white mb-4">Cite this work as</h3>
                    <p class="text-sm text-white/70 leading-relaxed">
                        {siteConfig.citation}
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Bottom bar -->
    <div class="border-t border-white/10">
        <div class="grid lg:grid-cols-2">
            <div class="flex justify-end">
                <div class="w-full max-w-[40rem] px-6 py-6 lg:px-8">
                    <p class="text-sm text-white/50">Content licensed under <a class="underline hover:text-white transition-colors" href="https://creativecommons.org/licenses/by-sa/4.0">CC BY-SA 4.0</a> unless otherwise noted.</p>
                </div>
            </div>
            <div class="border-t lg:border-t-0 lg:border-l border-white/10">
                <div class="w-full max-w-[40rem] px-6 py-6 lg:px-8 flex gap-6">
                    <a href="https://foreview.org" class="text-sm text-white/50 underline hover:text-white transition-colors">Site by Foreview</a>
                    <a href="/privacy-policy" class="text-sm text-white/50 underline hover:text-white transition-colors">Privacy Policy</a>
                </div>
            </div>
        </div>
    </div>
</footer>
