---
import Logomark from './brand/Logomark.astro'
---

<footer class="relative overflow-hidden">
    <div class="bg-gray-100">
        <div class="max-w-7xl mx-auto px-6 lg:px-8 py-8 sm:py-12 lg:py-16 z-10 relative">
        <Logomark class="max-h-12 not-dark:text-brand-600 dark:text-white mb-4" />
        <img src="https://tailwindcss.com/plus-assets/img/logos/mark.svg?color=indigo&shade=500" alt="Company name" class="h-9 not-dark:hidden" />
        <p class="text-balance text-gray-800 dark:text-gray-400 mb-6 text-xl max-w-lg lg:text-2xl lg:max-w-xl leading-10">
            Distilling safety research into a complete learning ecosystem.
        </p>
        <a href="mailto:markov@ai-safety-atlas.com" class="text-gray-800 hover:text-gray-800 dark:text-gray-300 dark:hover:text-gray-200 underline">
            Contact us
        </a>
        </div>
    </div>
    <div class="bg-gray-100 border-t border-gray-300">
    <div class="px-6 lg:px-8 py-8 lg:py-12 md:grid md:grid-cols-3 md:gap-8 max-w-7xl mx-auto z-10 relative space-y-8 md:space-y-0">
        <div>
            <h3 class="font-semibold text-gray-900 dark:text-white">Navigation</h3>
            <ul role="list" class="mt-6 space-y-4">
                <li>
                    <a href="/read" class="text-gray-700 underline hover:text-gray-900 dark:text-gray-300 dark:hover:text-gray-200">Read</a>
                </li>
                <li>
                    <a href="/teach" class="text-gray-700 underline  hover:text-gray-900 dark:text-gray-300 dark:hover:text-gray-200">Teach</a>
                </li>
                <li>
                    <a href="/join-study-group" class="text-gray-700 underline hover:text-gray-900 dark:text-gray-300 dark:hover:text-gray-200">Get certified</a>
                </li>
                <li>
                    <a href="/about" class="text-gray-700 underline hover:text-gray-900 dark:text-gray-300 dark:hover:text-gray-200">About us</a>
                </li>
            </ul>
        </div>
        <div>
            <h3 class="font-semibold text-gray-900 dark:text-white">Funded by</h3>
            <ul role="list" class="mt-6 space-y-4">
                <li>
                    <a href="https://cesia.org" class="text-gray-700 underline hover:text-gray-900 dark:text-gray-300 dark:hover:text-gray-200">French Center for AI Safety</a>
                </li>
                <li>
                    <a href="https://coefficientgiving.org" class="text-gray-700 underline hover:text-gray-900 dark:text-gray-300 dark:hover:text-gray-200">Coefficient Giving</a>
                </li>
                <li>
                    <a href="https://manifund.org" class="text-gray-700 underline hover:text-gray-900 dark:text-gray-300 dark:hover:text-gray-200">Manifund</a>
                </li>
            </ul>
        </div>
        <div>
            <h3 class="font-semibold text-gray-900 dark:text-white">Socials</h3>
            <ul role="list" class="mt-6 space-y-4">
                <li>
                    <a href="https://github.com/markov-root/atlas" class="text-gray-700 underline hover:text-gray-900 dark:text-gray-300 dark:hover:text-gray-200">GitHub</a>
                </li>
                <li>
                    <a href="https://www.youtube.com/@securite-ia" class="text-gray-700 underline hover:text-gray-900 dark:text-gray-300 dark:hover:text-gray-200">YouTube</a>
                </li>

            </ul>
        </div>
    </div>
    </div>
    <div class="border-t border-gray-900/10 py-6 dark:border-white/10 relative z-10 bg-white">
        <div class="max-w-7xl mx-auto w-full  flex justify-between flex-wrap px-6 lg:px-8">
            <p class="text-sm/6 text-gray-700 dark:text-gray-300">Content licensed under <a class="underline" href="https://creativecommons.org/licenses/by-sa/4.0">CC BY-SA 4.0</a> unless otherwise noted.</p>
            <ul class="text-sm/6 flex flex-wrap space-x-6 text-gray-700 dark:text-gray-300 mt-4 sm:mt-0">
                <li>
                    <a href="https://foreview.org" class="underline">Site from Foreview</a>
                </li>
                <li>
                    <a href="/privacy-policy" class="underline">Privacy Policy</a>
                </li>
            </ul>
        </div>
    </div>
    <Logomark class="h-full w-auto hidden md:block -right-8 absolute -top-[1.6175rem] text-gray-50 z-1" />
</footer>
