---
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'textarea'> {
  label?: string
  variant?: 'light' | 'dark'
}

const { label, id, variant = 'light', class: className, ...rest } = Astro.props

const variantClasses = {
  light: "form-control-light",
  dark: "form-control-dark"
}
---

<div>
    {label && <label for={id} class="sr-only">{label}</label>}
    <textarea
        id={id}
        class:list={[
            "form-control resize-none",
            variantClasses[variant],
            className
        ]}
        {...rest}
    ></textarea>
</div>
