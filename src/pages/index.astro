---
import Default from "@/layouts/Default.astro";
import Header from "@/components/Header.astro"
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { siteConfig } from "@/config/site";
import { getLatestTextbook } from "@/lib/textbooks";
import OrgLogo from "@/components/OrgLogo.astro";
import CardLink from "@/components/CardLink.astro";
import GrainOverlay from "@/components/GrainOverlay.astro";

import markovImg from "@/assets/markov-photo.jpg";
import charbelImg from "@/assets/charbel-photo.jpg";
import ensParisSaclayLogo from "@/assets/ens-paris-saclay.png";
import Button from "@/components/Button.astro";

const authorImages: Record<string, ImageMetadata> = {
  "markov-photo.jpg": markovImg,
  "charbel-photo.jpg": charbelImg,
};

const textbook = await getLatestTextbook();

// Build chapter lookup: number -> { title, slug, firstSectionSlug }
const chapterLookup = new Map(
  textbook.chapters.map(ch => [
    ch.number,
    {
      title: ch.title,
      slug: ch.slug,
      firstSectionSlug: ch.sections[0]?.slug,
    }
  ])
);

function getChapterUrl(chapterNum: number) {
  const chapter = chapterLookup.get(chapterNum);
  if (!chapter) return '/read';
  return `/chapters/${textbook.version}/${chapter.slug}/${chapter.firstSectionSlug}`;
}

function getChapterTitle(chapterNum: number) {
  return chapterLookup.get(chapterNum)?.title ?? `Chapter ${chapterNum}`;
}

---
<Default title="Atlas – The Open Textbook for AI Safety" description="A comprehensive, free resource covering AI capabilities, risks, alignment, and governance. Written by researchers from the French Center for AI Safety." noHeader>
    <!-- Navbar -->
    <div class="sm:mx-4 mt-4">
        <Header class="bg-white rounded-3xl" />
    </div>

    <!-- Hero + CTA Section -->
    <section class="sm:mx-4 mt-4 rounded-3xl overflow-hidden">
        <div class="grid lg:grid-cols-2 lg:h-[88vh]">
            <!-- Left: Blue hero -->
            <div class="bg-blue-600 text-white lg:rounded-tl-3xl lg:rounded-bl-3xl flex justify-end relative overflow-hidden">
                <GrainOverlay />
                <div class="w-full max-w-[40rem] px-6 py-12 lg:px-8 lg:py-16 flex flex-col justify-between h-full min-h-[500px] lg:min-h-0 relative z-10">
                    <div class="max-w-md">
                        <h1 class="text-4xl lg:text-5xl 2xl:text-6xl font-semibold text-balance font-display leading-tight text-white">
                            The open textbook for AI Safety
                        </h1>
                        <p class="mt-4 text-sm lg:text-base text-white/80">
                            Written by Markov Grey and Charbel-Raphael Segerie from the <a class="underline" href="https://cesia.org">French Center for AI Safety</a>.
                        </p>
                    </div>
                    <div class="max-w-md">
                        <p class="text-sm font-medium text-white uppercase tracking-wide mb-4">Trusted by</p>
                        <div class="grid grid-cols-2 gap-3">
                            <span class="bg-white/5 rounded-2xl px-3 h-12 flex items-center justify-center">
                                <OrgLogo url="https://ml4good.org" class="h-5 w-auto" color="white" />
                            </span>
                            <span class="bg-white/5 rounded-2xl px-3 h-12 flex items-center justify-center">
                                <OrgLogo url="https://bluedot.org" class="h-5 w-auto" color="white" />
                            </span>
                            <span class="bg-white/5 rounded-2xl px-3 h-12 flex items-center justify-center">
                                <OrgLogo url="https://www.enais.co" class="h-6 w-auto" color="white" />
                            </span>
                            <span class="bg-white/5 rounded-2xl px-3 h-12 flex items-center justify-center">
                                <img src={ensParisSaclayLogo.src} alt="ENS Paris Saclay" class="h-7 w-auto brightness-0 invert" />
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right: CTA cards -->
            <div class="lg:rounded-tr-3xl lg:rounded-br-3xl flex flex-col bg-white overflow-hidden">
                <!-- Learn Card -->
                <a href="/read" class="relative flex-1 flex items-end bg-white hover:bg-gray-50 transition-colors group lg:rounded-tr-3xl">
                    <div class="w-full max-w-[40rem] px-6 py-10 lg:px-8 lg:py-12 relative">
                        <span class="absolute top-10 right-6 lg:hidden inline-flex items-center justify-center size-10 rounded-full bg-gray-300 group-hover:bg-blue-600 transition-colors">
                            <Icon name="tabler:arrow-up-right" class="size-5 text-gray-600 group-hover:text-white" />
                        </span>
                        <p class="text-sm font-medium text-gray-500">I want to learn</p>
                        <div class="mt-2 flex items-center gap-3">
                            <h2 class="text-2xl lg:text-3xl font-semibold text-gray-900 font-display">Read the textbook</h2>
                            <span class="hidden lg:inline-flex items-center justify-center size-10 rounded-full bg-gray-300 group-hover:bg-blue-600 transition-colors">
                                <Icon name="tabler:arrow-up-right" class="size-5 text-gray-600 group-hover:text-white" />
                            </span>
                        </div>
                        <p class="mt-4 text-base lg:text-lg text-gray-600">
                            Self-study or join a cohort. From capabilities to governance, from alignment to oversight.
                        </p>
                    </div>
                </a>

                <!-- Divider -->
                <div class="border-t border-gray-200"></div>

                <!-- Teach Card -->
                <a href="/teach" class="relative flex-1 flex items-start bg-white hover:bg-gray-50 transition-colors group lg:rounded-br-3xl">
                    <div class="w-full max-w-[40rem] px-6 py-10 lg:px-8 lg:py-12 relative">
                        <span class="absolute top-10 right-6 lg:hidden inline-flex items-center justify-center size-10 rounded-full bg-gray-300 group-hover:bg-blue-600 transition-colors">
                            <Icon name="tabler:arrow-up-right" class="size-5 text-gray-600 group-hover:text-white" />
                        </span>
                        <p class="text-sm font-medium text-gray-500">I want to teach</p>
                        <div class="mt-2 flex items-center gap-3">
                            <h2 class="text-2xl lg:text-3xl font-semibold text-gray-900 font-display">Run a course</h2>
                            <span class="hidden lg:inline-flex items-center justify-center size-10 rounded-full bg-gray-300 group-hover:bg-blue-600 transition-colors">
                                <Icon name="tabler:arrow-up-right" class="size-5 text-gray-600 group-hover:text-white" />
                            </span>
                        </div>
                        <p class="mt-4 text-base lg:text-lg text-gray-600">
                            We provide students, materials, and facilitation guides. You focus on building your community.
                        </p>
                    </div>
                </a>
            </div>
        </div>
    </section>

    <!-- What the textbook covers -->
    <section class="sm:mx-4 mt-4">
        <div class="grid lg:grid-cols-2">
            <div class="lg:sticky lg:top-4 lg:self-start lg:mb-4">
                <div class="bg-white lg:h-[calc(100vh-2rem)] rounded-3xl lg:rounded-r-none flex justify-end overflow-hidden">
                    <div class="w-full max-w-[40rem] px-6 py-12 lg:px-8 lg:py-16 flex flex-col justify-between h-full">
                        <div class="max-w-md">
                            <h2 class="font-display text-3xl lg:text-4xl font-normal leading-tight mb-6 text-gray-900">
                                {siteConfig.textbookQuestions.title}
                            </h2>
                            <p class="text-base lg:text-lg 2xl:text-xl text-gray-600 leading-relaxed">
                                {siteConfig.textbookQuestions.description}
                            </p>
                        </div>
                        <div class="text-sm lg:text-base 2xl:text-lg text-gray-600 mt-8 lg:mt-0">
                            {siteConfig.textbookQuestions.meta.map((item, i) => (
                                <span class:list={["block", i < siteConfig.textbookQuestions.meta.length - 1 && "mb-2"]}>{item}</span>
                            ))}
                        </div>
                    </div>
                </div>
            </div>
            <div class="lg:mb-4">
            <div class="bg-black text-white rounded-3xl lg:rounded-l-none divide-y divide-white/10 relative overflow-hidden">
                <GrainOverlay />
                <!-- Invisible spacer to align with left heading -->
                <div class="hidden lg:block relative z-10 px-6 pt-12 lg:pt-16 lg:px-8" aria-hidden="true">
                    <div class="w-full max-w-[40rem]">
                        <h2 class="font-display text-3xl lg:text-4xl font-normal leading-tight mb-6 invisible">
                            {siteConfig.textbookQuestions.title}
                        </h2>
                        <p class="text-base lg:text-lg 2xl:text-xl leading-relaxed invisible">
                            {siteConfig.textbookQuestions.description}
                        </p>
                    </div>
                </div>
                {siteConfig.textbookQuestions.questions.map((q, index) => (
                    <div class="relative z-10">
                        <div class="w-full max-w-[40rem] px-6 py-8 lg:px-8 lg:py-12 grid grid-cols-[32px_1fr] lg:grid-cols-[48px_1fr] gap-4 lg:gap-8">
                            <span class="font-display text-2xl lg:text-4xl text-white/30">{index + 1}</span>
                            <div>
                                <h3 class="font-display text-xl lg:text-2xl font-normal mb-4 leading-snug">
                                    {q.question}
                                </h3>
                                <p class="text-sm text-white/70 leading-relaxed mb-6">
                                    {q.description}
                                </p>
                                <div class="flex flex-col gap-2">
                                    {q.chapters.map(chNum => (
                                        <CardLink href={getChapterUrl(chNum)} variant="dark">
                                            Ch {chNum}: {getChapterTitle(chNum)}
                                        </CardLink>
                                    ))}
                                </div>
                            </div>
                        </div>
                    </div>
                ))}
            </div>
            </div>
        </div>
    </section>

    <!-- Authors Section -->
    <section class="sm:mx-4 mt-4 rounded-3xl overflow-hidden bg-white">
        <!-- Top row -->
        <div class="grid lg:grid-cols-2">
            <!-- Left: Heading -->
            <div class="flex justify-end border-b border-gray-200">
                <div class="w-full max-w-[40rem] px-6 py-16 lg:px-8 lg:py-24">
                    <h2 class="text-4xl lg:text-5xl font-semibold text-gray-900 font-display leading-tight max-w-sm">
                        Written by researchers, for everyone
                    </h2>
                </div>
            </div>

            <!-- Right: Primary authors grid -->
            <div class="lg:border-l border-b border-gray-200 flex flex-col justify-end">
                <div class="border-t border-gray-200">
                    <div class="w-full max-w-[40rem] grid grid-cols-1 sm:grid-cols-2">
                        {siteConfig.authors.primary.map((author, i) => (
                            <div class:list={[
                                "p-6 lg:p-8",
                                i === 0 && "border-b sm:border-b-0 sm:border-r border-gray-200",
                                i === 1 && "sm:border-r border-gray-200"
                            ]}>
                                <Image
                                    src={authorImages[author.image]}
                                    alt={author.name}
                                    class="size-20 rounded-2xl object-cover mb-4"
                                    width={256}
                                    height={256}
                                />
                                <h3 class="text-base font-semibold text-gray-900">{author.name}</h3>
                                <p class="mt-1 text-sm text-gray-600">{author.bio}</p>
                            </div>
                        ))}
                    </div>
                </div>
            </div>
        </div>

        <!-- Bottom row: Contributing & Advisors -->
        <div class="flex justify-center">
            <div class="w-full max-w-[80rem] grid grid-cols-2 lg:grid-cols-4">
                {siteConfig.authors.contributing.map((author, i) => (
                    <div class:list={[
                        "p-6 lg:p-8 flex flex-col border-b border-gray-200",
                        i === 0 && "border-l border-r lg:border-r",
                        i === 1 && "border-r lg:border-r"
                    ]}>
                        <h3 class="text-base font-semibold text-gray-900">{author.name}</h3>
                        <p class="text-sm text-gray-500">Contributing Author</p>
                        <p class="mt-auto pt-4 text-sm text-gray-600">{author.bio}</p>
                    </div>
                ))}
                {siteConfig.authors.advisors.map((advisor, i) => (
                    <div class:list={[
                        "p-6 lg:p-8 flex flex-col border-b border-gray-200",
                        i === 0 && "border-l lg:border-l-0 border-r",
                        i === 1 && "border-r"
                    ]}>
                        <h3 class="text-base font-semibold text-gray-900">{advisor.name}</h3>
                        <p class="text-sm text-gray-500">Advisor</p>
                        <p class="mt-auto pt-4 text-sm text-gray-600">{advisor.bio}</p>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- Bottom CTA Section -->
    <section class="sm:mx-4 mt-4 mb-4 rounded-3xl overflow-hidden">
        <div class="grid lg:grid-cols-2">
            <!-- Learn - Blue background -->
            <a href="/read" class="bg-blue-600 flex justify-end group hover:bg-blue-700 transition-colors relative overflow-hidden">
                <GrainOverlay />
                <div class="w-full max-w-[40rem] px-6 py-16 lg:px-8 lg:py-24 relative z-10">
                    <span class="absolute top-10 right-6 lg:hidden inline-flex items-center justify-center size-10 rounded-full bg-white/20 group-hover:bg-white transition-colors">
                        <Icon name="tabler:arrow-up-right" class="size-5 text-white group-hover:text-blue-600" />
                    </span>
                    <div class="flex items-center gap-3">
                        <h2 class="text-3xl lg:text-4xl font-semibold text-white font-display">Start reading</h2>
                        <span class="hidden lg:inline-flex items-center justify-center size-10 rounded-full bg-white/20 group-hover:bg-white transition-colors">
                            <Icon name="tabler:arrow-up-right" class="size-5 text-white group-hover:text-blue-600" />
                        </span>
                    </div>
                    <p class="mt-6 text-lg text-white/80 max-w-md">
                        Start with Chapter 1 or jump to any topic. Self-paced, always free.
                    </p>
                </div>
            </a>

            <!-- Teach - White background -->
            <a href="/teach" class="bg-white px-6 py-16 lg:px-8 lg:py-24 group hover:bg-gray-50 transition-colors relative">
                <span class="absolute top-10 right-6 lg:hidden inline-flex items-center justify-center size-10 rounded-full bg-gray-300 group-hover:bg-blue-600 transition-colors">
                    <Icon name="tabler:arrow-up-right" class="size-5 text-gray-600 group-hover:text-white" />
                </span>
                <div class="w-full max-w-[40rem]">
                    <div class="flex items-center gap-3">
                        <h2 class="text-3xl lg:text-4xl font-semibold text-gray-900 font-display">Start a course</h2>
                        <span class="hidden lg:inline-flex items-center justify-center size-10 rounded-full bg-gray-300 group-hover:bg-blue-600 transition-colors">
                            <Icon name="tabler:arrow-up-right" class="size-5 text-gray-600 group-hover:text-white" />
                        </span>
                    </div>
                    <p class="mt-6 text-lg text-gray-600 max-w-md">
                        Join 30+ course organizers using Atlas materials.
                    </p>
                </div>
            </a>
        </div>
    </section>
</Default>
