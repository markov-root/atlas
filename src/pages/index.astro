---
import Default from "@/layouts/Default.astro";
import Button from "@/components/Button.astro"
import { getLatestTextbook } from "@/i18n/content";

const textbook = await getLatestTextbook();
---
<Default title="" description="">
    <div class="mx-auto max-w-7xl px-6 py-16 sm:py-24 lg:px-8">
        <h1 class="max-w-2xl text-4xl font-semibold tracking-tight text-balance text-gray-900 sm:text-6xl lg:col-span-2 xl:col-auto dark:text-white">
            Your up-to-date book on technical AI Safety.
        </h1>
        <div class="mt-6 max-w-xl lg:mt-0 xl:col-end-1 xl:row-start-1">
            <div class="mt-10 flex items-center gap-x-6">
                <Button link="/read">Read →</Button>
                <Button link="/teach" variant="outline">Teach a course</Button>
            </div>
        </div>
    </div>
</Default>
