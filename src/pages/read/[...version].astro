---
import type { Chapter, Textbook } from '@/textbook-loader';
import Default from "@/layouts/Default.astro"
import { Icon } from 'astro-icon/components'
import Button from "@/components/Button.astro"
import { formatReadingTime } from "@/textbook-loader/utils"
import { getTextbooks, getLatestTextbook } from "@/lib/textbooks";

interface Props {
  textbook: Textbook
}

export async function getStaticPaths() {
  const textbooks = await getTextbooks();
  const paths: { params: { version?: string }; props: { textbook: Textbook } }[] = [];

  for (const textbook of textbooks) {
    paths.push({
      params: { version: textbook.data.version },
      props: { textbook: textbook.data }
    });
  }

  // Default version (no version in URL) - use latest
  if (textbooks.length > 0) {
    const latest = await getLatestTextbook();
    paths.push({
      params: { version: undefined },
      props: { textbook: latest }
    });
  }

  return paths;
}

const { textbook } = Astro.props;

const isAppendixSection = (section: { title: string }) => section.title.toLowerCase().includes('appendix');

// Collect all appendix sections with their chapter info
const appendixSections = textbook.chapters.flatMap(chapter =>
  chapter.sections
    .filter(isAppendixSection)
    .map(section => ({ section, chapter }))
);
---
<Default title="Chapters" description="We've gathered the most important knowledge on AI safety into a single, comprehensive resource.">
    <header class="bg-white py-24 sm:py-32 border-b border-gray-300">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="mx-auto max-w-2xl lg:mx-0">
          <h2 class="text-5xl font-semibold tracking-tight text-gray-900 sm:text-7xl font-display">Chapters</h2>
          <p class="mt-8 text-lg font-medium text-pretty text-gray-700 sm:text-xl/8">
              We've gathered the most important knowledge on AI safety into a single, comprehensive resource.
          </p>
          <ul class="mt-8">
              <li class="flex items-center space-x-2">
                  <Icon name="tabler:clock" class="w-7 h-auto" />
                  <span class="text-lg">
                      {formatReadingTime(textbook.readingTimeInSeconds)}
                  </span>
              </li>
          </ul>

          <div class="flex gap-4 mt-12">
            <Button large link={`/chapters/${textbook.version}/${textbook.chapters[0].slug}/${textbook.chapters[0].sections[0].slug}`}>
                <span>Start reading</span>
            </Button>
            {textbook.pdfLink && (
              <Button large variant="outline" link={textbook.pdfLink}>
                  Download
              </Button>
            )}
          </div>
        </div>
      </div>
    </header>

    {textbook.chapters.map((chapter: Chapter, index: number) => {
        const sections = chapter.sections.filter(s => !isAppendixSection(s));
        if (sections.length === 0) return null;
        return (
    <section class:list={["py-16 sm:py-24 border-b border-gray-300", index % 2 === 0 ? 'bg-gray-100' : 'bg-white']}>
        <div class="mx-auto max-w-7xl px-6 lg:px-8">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-10">
                <div>
                    <h2 class="text-2xl/7 font-bold text-gray-900 sm:text-3xl sm:tracking-tight font-display">
                        {chapter.number}.
                        <a class="hover:text-brand-700 transition-colors" href={`/chapters/${textbook.version}/${chapter.slug}/${sections[0].slug}/`}>{chapter.title}</a>
                    </h2>
                    {chapter.meta.description && <p class="max-w-3xl text-lg text-gray-700 mt-3 text-balance">{chapter.meta.description}</p>}
                </div>
                <Button variant={index % 2 === 0 ? "white" : "gray"} link={`/chapters/${textbook.version}/${chapter.slug}/${sections[0].slug}/`}>
                    Read chapter &rarr;
                </Button>
            </div>
            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                {sections.map(section => (
                    <a
                        href={`/chapters/${textbook.version}/${chapter.slug}/${section.slug}`}
                        class:list={[
                            "group relative flex flex-col rounded-xl border p-5 transition-all hover:shadow-md hover:-translate-y-0.5",
                            index % 2 === 0
                                ? "bg-white border-gray-200 hover:border-brand-300"
                                : "bg-gray-50 border-gray-200 hover:border-brand-300"
                        ]}
                    >
                        <h3 class="font-semibold text-gray-900 group-hover:text-brand-700 transition-colors">
                            <span class="text-brand-600">{chapter.number}.{section.number}</span> {section.title}
                        </h3>
                        {section.readingTimeInSeconds && (
                            <span class="mt-2 text-sm text-gray-600">
                                {formatReadingTime(section.readingTimeInSeconds)}
                            </span>
                        )}
                    </a>
                ))}
            </div>
        </div>
    </section>
        );
    })}

    {appendixSections.length > 0 && (
    <section class:list={["py-16 sm:py-24 border-b border-gray-300", textbook.chapters.length % 2 === 0 ? 'bg-gray-100' : 'bg-white']}>
        <div class="mx-auto max-w-7xl px-6 lg:px-8">
            <h2 class="text-3xl font-bold tracking-tight sm:text-4xl font-display mb-10 text-gray-900">Appendixes</h2>
            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                {appendixSections.map(({ section, chapter }) => (
                    <a
                        href={`/chapters/${textbook.version}/${chapter.slug}/${section.slug}/`}
                        class:list={[
                            "group relative flex flex-col rounded-xl border p-5 transition-all hover:shadow-md hover:-translate-y-0.5 hover:border-brand-300",
                            textbook.chapters.length % 2 === 0
                                ? "bg-white border-gray-200"
                                : "bg-gray-50 border-gray-200"
                        ]}
                    >
                        <span class="text-xs font-medium text-gray-600 uppercase tracking-wide">
                            {chapter.title}
                        </span>
                        <h3 class="mt-1 font-semibold text-gray-900 group-hover:text-brand-700 transition-colors">
                            {section.title.replace(/^Appendix:\s*/i, '')}
                        </h3>
                        {section.readingTimeInSeconds && (
                            <span class="mt-3 text-sm text-gray-600">
                                {formatReadingTime(section.readingTimeInSeconds)}
                            </span>
                        )}
                    </a>
                ))}
            </div>
        </div>
    </section>
    )}
</Default>
