---
import type { Chapter, Textbook } from '@/textbook-loader';
import Default from "@/layouts/Default.astro"
import Header from "@/components/Header.astro"
import GrainOverlay from "@/components/GrainOverlay.astro"
import { Icon } from 'astro-icon/components'
import { formatReadingTime } from "@/textbook-loader/utils"
import { getTextbooks, getLatestTextbook } from "@/lib/textbooks";

interface Props {
  textbook: Textbook
}

export async function getStaticPaths() {
  const textbooks = await getTextbooks();
  const paths: { params: { version?: string }; props: { textbook: Textbook } }[] = [];

  for (const textbook of textbooks) {
    paths.push({
      params: { version: textbook.data.version },
      props: { textbook: textbook.data }
    });
  }

  // Default version (no version in URL) - use latest
  if (textbooks.length > 0) {
    const latest = await getLatestTextbook();
    paths.push({
      params: { version: undefined },
      props: { textbook: latest }
    });
  }

  return paths;
}

const { textbook } = Astro.props;

const firstChapterUrl = `/chapters/${textbook.version}/${textbook.chapters[0].slug}/${textbook.chapters[0].sections[0].slug}`;
---
<Default title="Read the Textbook" description="Explore all chapters of the Atlas AI Safety textbook. From capabilities and risks to alignment and governance—self-study at your own pace." noHeader>
    <!-- Navbar -->
    <div class="sm:mx-4 mt-4">
        <Header class="bg-white rounded-3xl" />
    </div>

    <!-- Hero Section -->
    <section class="sm:mx-4 mt-4 rounded-3xl overflow-hidden">
        <div class="grid lg:grid-cols-2">
            <!-- Left: Hero content -->
            <div class="bg-blue-600 text-white lg:rounded-tl-3xl lg:rounded-bl-3xl flex justify-end relative overflow-hidden">
                <GrainOverlay />
                <div class="w-full max-w-[40rem] px-6 py-12 lg:px-8 lg:py-16 flex flex-col justify-between h-full min-h-[400px] lg:min-h-[50vh] relative z-10">
                    <div class="max-w-md">
                        <h1 class="text-4xl lg:text-5xl font-semibold text-balance font-display leading-tight">
                            Chapters
                        </h1>
                        <p class="mt-4 text-base lg:text-lg text-white/80 leading-relaxed">
                            We've gathered the most important knowledge on AI safety into a single, comprehensive resource.
                        </p>
                    </div>
                    <div class="flex items-center gap-6 text-sm text-white/70">
                        <span class="flex items-center gap-2">
                            <Icon name="tabler:book" class="size-5" />
                            {textbook.chapters.length} chapters
                        </span>
                        <span class="flex items-center gap-2">
                            <Icon name="tabler:clock" class="size-5" />
                            {formatReadingTime(textbook.readingTimeInSeconds)}
                        </span>
                    </div>
                </div>
            </div>

            <!-- Right: Start reading CTA -->
            <a href={firstChapterUrl} class="bg-white lg:rounded-tr-3xl lg:rounded-br-3xl flex items-center group hover:bg-gray-50 transition-colors">
                <div class="w-full max-w-[40rem] px-6 py-12 lg:px-8 lg:py-16 relative">
                    <span class="absolute top-10 right-6 lg:hidden inline-flex items-center justify-center size-10 rounded-full bg-gray-300 group-hover:bg-blue-600 transition-colors">
                        <Icon name="tabler:arrow-up-right" class="size-5 text-gray-600 group-hover:text-white" />
                    </span>
                    <p class="text-sm font-medium text-gray-500">Ready to begin?</p>
                    <div class="mt-2 flex items-center gap-3">
                        <h2 class="text-2xl lg:text-3xl font-semibold text-gray-900 font-display">Start reading</h2>
                        <span class="hidden lg:inline-flex items-center justify-center size-10 rounded-full bg-gray-300 group-hover:bg-blue-600 transition-colors">
                            <Icon name="tabler:arrow-up-right" class="size-5 text-gray-600 group-hover:text-white" />
                        </span>
                    </div>
                    <p class="mt-4 text-base lg:text-lg text-gray-600">
                        Begin with {textbook.chapters[0].title} and work through at your own pace.
                    </p>
                    {textbook.pdfLink && (
                        <p class="mt-6 text-sm text-gray-500">
                            Or <a href={textbook.pdfLink} class="underline hover:text-gray-900 transition-colors">download the PDF</a>
                        </p>
                    )}
                </div>
            </a>
        </div>
    </section>

    <!-- Chapters List -->
    <section class="sm:mx-4 mt-4">
        <div class="grid lg:grid-cols-2">
            <!-- Left: Sticky panel -->
            <div class="lg:sticky lg:top-4 lg:self-start lg:mb-4">
                <div class="bg-white lg:h-[calc(100vh-2rem)] rounded-3xl lg:rounded-r-none flex justify-end overflow-hidden">
                    <div class="w-full max-w-[40rem] px-6 py-12 lg:px-8 lg:py-16 flex flex-col justify-between h-full">
                        <div class="max-w-md">
                            <h2 class="text-3xl lg:text-4xl font-semibold text-gray-900 font-display leading-tight">
                                Table of Contents
                            </h2>
                            <p class="mt-4 text-base lg:text-lg text-gray-600 leading-relaxed">
                                {textbook.chapters.length} chapters covering the foundations of AI safety, from core concepts to cutting-edge research.
                            </p>
                        </div>
                        <div class="flex items-center gap-6 text-sm text-gray-500 mt-8 lg:mt-0">
                            <span class="flex items-center gap-2">
                                <Icon name="tabler:book" class="size-5" />
                                {textbook.chapters.length} chapters
                            </span>
                            <span class="flex items-center gap-2">
                                <Icon name="tabler:clock" class="size-5" />
                                {formatReadingTime(textbook.readingTimeInSeconds)}
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right: Scrolling chapters -->
            <div class="lg:mb-4">
                <div class="bg-gray-100 rounded-3xl lg:rounded-l-none relative overflow-hidden">
                    <GrainOverlay opacity={0.3} />
                    <!-- Invisible spacer to align with left heading -->
                    <div class="hidden lg:block relative z-10 px-6 pt-12 lg:pt-16 lg:px-8" aria-hidden="true">
                        <div class="w-full max-w-[40rem]">
                            <h2 class="text-3xl lg:text-4xl font-semibold font-display leading-tight invisible">
                                Table of Contents
                            </h2>
                            <p class="mt-4 text-base lg:text-lg leading-relaxed invisible">
                                {textbook.chapters.length} chapters covering the foundations of AI safety, from core concepts to cutting-edge research.
                            </p>
                        </div>
                    </div>
                    {textbook.chapters.map((chapter: Chapter) => {
                        const sections = chapter.sections;
                        if (sections.length === 0) return null;
                        const chapterUrl = `/chapters/${textbook.version}/${chapter.slug}/${sections[0].slug}/`;
                        return (
                            <div class="border-b border-gray-200 last:border-b-0 relative z-10">
                                <div class="w-full max-w-[40rem] px-6 py-10 lg:px-8 lg:py-12">
                                    <!-- Chapter header -->
                                    <div class="mb-6">
                                        <span class="text-sm font-medium text-gray-700">Chapter {chapter.number}</span>
                                        <h3 class="mt-1 text-xl lg:text-2xl font-semibold text-gray-900 font-display">
                                            <a href={chapterUrl} class="hover:text-blue-600 transition-colors">{chapter.title}</a>
                                        </h3>
                                        {chapter.meta.description && (
                                            <p class="mt-2 text-sm text-gray-600">
                                                {chapter.meta.description}
                                            </p>
                                        )}
                                    </div>
                                    <!-- Sections -->
                                    <div class="flex flex-col gap-2">
                                        {sections.map(section => (
                                            <a
                                                href={`/chapters/${textbook.version}/${chapter.slug}/${section.slug}`}
                                                class="flex items-center justify-between px-4 py-3 bg-white rounded-xl hover:bg-gray-50 transition-colors group"
                                            >
                                                <div class="flex-1 min-w-0 flex items-center justify-between gap-4">
                                                    <span class="text-sm font-semibold text-gray-900 group-hover:text-blue-600 transition-colors">
                                                        {chapter.number}.{section.number} {section.title}
                                                    </span>
                                                    {section.readingTimeInSeconds && (
                                                        <span class="text-xs text-gray-500 shrink-0">
                                                            {formatReadingTime(section.readingTimeInSeconds)}
                                                        </span>
                                                    )}
                                                </div>
                                                <Icon name="tabler:chevron-right" class="size-5 text-gray-400 group-hover:text-blue-600 transition-colors shrink-0 ml-4" />
                                            </a>
                                        ))}
                                    </div>
                                </div>
                            </div>
                        );
                    })}
                </div>
            </div>
        </div>
    </section>

    <!-- Bottom CTA -->
    <section class="sm:mx-4 mt-4 mb-4">
        <a href={firstChapterUrl} class="block bg-white rounded-3xl px-6 py-16 lg:px-8 lg:py-20 group hover:bg-gray-50 transition-colors relative">
            <span class="absolute top-10 right-6 lg:hidden inline-flex items-center justify-center size-10 rounded-full bg-gray-300 group-hover:bg-blue-600 transition-colors">
                <Icon name="tabler:arrow-up-right" class="size-5 text-gray-600 group-hover:text-white" />
            </span>
            <div class="max-w-7xl mx-auto flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">
                <div>
                    <div class="flex items-center gap-3">
                        <h2 class="text-2xl lg:text-3xl font-semibold text-gray-900 font-display">Ready to start?</h2>
                        <span class="hidden lg:inline-flex items-center justify-center size-10 rounded-full bg-gray-300 group-hover:bg-blue-600 transition-colors">
                            <Icon name="tabler:arrow-up-right" class="size-5 text-gray-600 group-hover:text-white" />
                        </span>
                    </div>
                    <p class="mt-3 text-base lg:text-lg text-gray-600">
                        Begin with Chapter 1: {textbook.chapters[0].title}
                    </p>
                </div>
            </div>
        </a>
    </section>
</Default>
