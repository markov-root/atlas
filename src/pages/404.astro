---
import Default from "@/layouts/Default.astro";
import Button from "@/components/Button.astro";
import { Icon } from "astro-icon/components";
import { getFirstChapterUrl } from '@/lib/textbooks';

const readUrl = await getFirstChapterUrl();
---

<Default title="Page not found" description="The page you are looking for does not exist.">
    <div class="min-h-[60vh] flex flex-col items-center justify-center px-6 py-24 lg:py-32">
        <p class="text-base font-semibold text-brand-600">404</p>
        <h1 class="mt-4 text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl font-display">
            Page not found
        </h1>
        <p class="mt-6 text-base text-gray-600">
            The page you are looking for does not exist.
        </p>
        <div class="mt-10 flex flex-col sm:flex-row items-center gap-4">
            <Button link="/" variant="primary">
                Go back home
            </Button>
        </div>
        <div class="mt-10 flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm font-semibold">
            <a href={readUrl} class="text-brand-600 hover:text-brand-500">
                Read <Icon name="tabler:arrow-right" class="size-4 inline" />
            </a>
            <a href="/teach" class="text-brand-600 hover:text-brand-500">
                Teach <Icon name="tabler:arrow-right" class="size-4 inline" />
            </a>
            <a href="/get-certified" class="text-brand-600 hover:text-brand-500">
                Get certified <Icon name="tabler:arrow-right" class="size-4 inline" />
            </a>
        </div>
    </div>
</Default>
