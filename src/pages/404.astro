---
import Default from "@/layouts/Default.astro";
import Button from "@/components/Button.astro";
---

<Default title="Page not found" description="The page you are looking for does not exist.">
    <div class="min-h-[60vh] flex flex-col items-center justify-center px-6 py-24 lg:py-32">
        <p class="text-base font-semibold text-brand-600">404</p>
        <h1 class="mt-4 text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl dark:text-white">
            Page not found
        </h1>
        <p class="mt-6 text-base text-gray-600 dark:text-gray-400">
            The page you are looking for does not exist.
        </p>
        <div class="mt-10 flex flex-col sm:flex-row items-center gap-4">
            <Button link="/" variant="primary">
                Go back home
            </Button>
        </div>
        <div class="mt-10 flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm font-semibold">
            <a href="/read" class="text-brand-600 hover:text-brand-500">
                Read <span aria-hidden="true">&rarr;</span>
            </a>
            <a href="/teach" class="text-brand-600 hover:text-brand-500">
                Teach <span aria-hidden="true">&rarr;</span>
            </a>
            <a href="/join-study-group" class="text-brand-600 hover:text-brand-500">
                Get certified <span aria-hidden="true">&rarr;</span>
            </a>
        </div>
    </div>
</Default>
