---
import Default from "@/layouts/Default.astro";
import Button from "@/components/Button.astro";
---

<Default title="Get certified" description="AI safety certification coming soon.">
    <div class="min-h-[60vh] flex flex-col items-center justify-center px-6 py-24 lg:py-32">
        <h1 class="text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl font-display">
            Coming soon...
        </h1>
        <p class="mt-6 text-base text-gray-600 text-center max-w-md">
            We're working on a certification program to help you demonstrate your AI safety knowledge.
        </p>
        <div class="mt-10">
            <Button link="/" variant="primary">
                Go back home
            </Button>
        </div>
    </div>
</Default>
