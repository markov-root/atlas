---
import BaseHead from '@/components/BaseHead.astro'
import Footer from '@/components/Footer.astro'
import Logomark from '@/components/brand/Logomark.astro';
import ChevronRight from "@/components/icons/ChevronRight.astro"
import ChevronDown from "@/components/icons/ChevronDown.astro"
import Search from '@/components/Search.astro';
import type { Section, Chapter, Textbook } from '@/textbook-loader';

interface Breadcrumb {
  text: string;
  url: string;
}

interface Props {
  title: string;
  description: string;
  activeSection: Section
  textbook: Textbook
  breadcrumbs: Breadcrumb[]
}

const { title, description, activeSection, textbook, breadcrumbs } = Astro.props
---
<html lang="en" class="h-full">
	<head>
		<script is:inline>document.documentElement.classList.add('js')</script>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<BaseHead title={title} description={description} />
		<slot name="head" />
	</head>
	<body class="h-full">
<el-dialog>
  <dialog id="sidebar" class="backdrop:bg-transparent lg:hidden">
    <el-dialog-backdrop class="fixed inset-0 bg-gray-900/80 transition-opacity duration-300 ease-linear data-closed:opacity-0"></el-dialog-backdrop>

    <div tabindex="0" class="fixed inset-0 flex focus:outline-none">
      <el-dialog-panel class="group/dialog-panel relative mr-16 flex w-full max-w-xs flex-1 transform transition duration-300 ease-in-out data-closed:-translate-x-full">
        <div class="absolute top-0 left-full flex w-16 justify-center pt-5 duration-300 ease-in-out group-data-closed/dialog-panel:opacity-0">
          <button type="button" command="close" commandfor="sidebar" class="-m-2.5 p-2.5">
            <span class="sr-only">Close sidebar</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" data-slot="icon" aria-hidden="true" class="size-6 text-white">
              <path d="M6 18 18 6M6 6l12 12" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
        </div>

        <!-- Sidebar component, swap this element with another sidebar if you like -->
        <div class="relative flex grow flex-col gap-y-5 overflow-y-auto bg-white px-6 pb-4       ">
          <a href="/" class="relative flex h-16 shrink-0 items-center">
              <Logomark class="h-8 w-auto text-brand-600" />
          </a>
          <nav class="relative flex flex-1 flex-col">
            <ul role="list" class="flex flex-1 flex-col gap-y-7">
              <li>
                <ul role="list" class="-mx-2 space-y-1">
                </ul>
              </li>
            </ul>
          </nav>
        </div>
      </el-dialog-panel>
    </div>
  </dialog>
</el-dialog>

<!-- Static sidebar for desktop -->
<div class="hidden lg:fixed lg:inset-y-0 lg:z-50 lg:flex lg:w-72 xl:w-80 lg:flex-col ">
    <!-- Sidebar component, swap this element with another sidebar if you like -->
    <div class="flex grow flex-col gap-y-5 overflow-y-auto border-r border-gray-200 bg-white pb-4  ">
        <a href="/" class="flex shrink-0 items-center gap-x-2 border-b border-b-gray-200 px-4  h-16">
            <Logomark class="h-8 w-auto text-brand-600" />
            <span class="uppercase font-bold">AI Safety Atlas</span>
        </a>
        <nav class="flex flex-1 flex-col space-y-4 pl-0.5">
            {textbook.chapters.map((chapter: Chapter) => (
            <details class="block px-4 group" open={activeSection.chapterNumber === chapter.number}>
                <summary class="text-lg flex justify-between items-center">
                    <span class="group-open:text-brand-700 text-gray-700 font-semibold">
                        {chapter.number}. {chapter.title}
                    </span>

                    <ChevronRight class="group-open:hidden block h-5" />
                    <ChevronDown class="group-open:block hidden h-5" />
                </summary>

                <ul class="border-l pl-4 mt-1 border-gray-400 space-y-1">
                    {chapter.sections.map((section: Section) => (
                    <li class={activeSection.chapterNumber === chapter.number && activeSection.number === section.number ? 'text-brand-700' : ''}>
                        <a href={`/chapters/${textbook.version}/${chapter.slug}/${section.slug}`}>
                            {section.number}. {section.title}
                        </a>
                    </li>
                    ))}
                </ul>
            </details>
            ))}
        </nav>
    </div>
</div>

<div class="lg:pl-72 xl:pl-80">
    <div id="reading-progress-nav" class="sticky top-0 z-40 lg:px-8 border-b-2 border-gray-200 bg-white">
        <div class="lg:mx-auto lg:max-w-7xl">
            <div class="flex h-16 items-center gap-x-4 bg-white px-4 shadow-xs sm:gap-x-6 sm:px-6 lg:px-0 lg:shadow-none">
                {breadcrumbs && (
                <ol role="list" class="flex items-center space-x-4">
                    {breadcrumbs.map((item, k) => (
                    <li>
                        <div class:list={[k > 0 ? 'flex items-center' : '']}>
                            {k > 0 && (
                            <svg viewBox="0 0 20 20" fill="currentColor" data-slot="icon" aria-hidden="true" class="size-5 shrink-0 text-gray-400">
                                <path d="M8.22 5.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L11.94 10 8.22 6.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" fill-rule="evenodd" />
                            </svg>
                            )}
                            <a href={item.url} class:list={["text-sm font-medium text-gray-700 hover:text-gray-700", k > 0 ? 'ml-4' : '']}>{item.text}</a>
                        </div>
                    </li>
                    ))}
                </ol>
                )}

                <div class="grow"></div>

                <div class="flex flex-1 items-center justify-center px-2 lg:ml-6 lg:justify-end">
                      <Search />
                     </div>
            </div>
        </div>
    </div>

    <main class="">
        <slot name="header" />
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10">
            <slot />
        </div>

        <Footer />
    </main>
</div>
<script>
import '@tailwindplus/elements'

const nav = document.getElementById('reading-progress-nav');
if (nav) {
    const brandColor = 'oklch(46.5% 0.127 252)';
    const brandLight = 'oklch(86.9% 0.042 252)';

    function updateProgress() {
        const scrollTop = window.scrollY;
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
        const clampedProgress = Math.min(100, Math.max(0, progress));

        if (scrollTop > 10) {
            nav.style.borderImage = `linear-gradient(to right, ${brandColor} ${clampedProgress}%, ${brandLight} ${clampedProgress}%) 1`;
        } else {
            nav.style.borderImage = '';
        }
    }

    window.addEventListener('scroll', updateProgress, { passive: true });
    updateProgress();
}
</script>
	</body>
</html>
