---
import BaseHead from '@/components/BaseHead.astro'
import Lockup from '@/components/brand/Lockup.astro';
import { Icon } from 'astro-icon/components'
import VersionSelector from '@/components/VersionSelector.astro';
import DocSearchProvider from '@/components/DocSearchProvider.astro';
import SearchTrigger from '@/components/SearchTrigger.astro';
import { ClientRouter } from 'astro:transitions';
import LoadingIndicator from 'astro-loading-indicator/component';
import type { Section, Chapter, Textbook } from '@/textbook-loader';

interface Breadcrumb {
  text: string;
  url: string;
}

interface Props {
  title: string;
  description: string;
  activeSection: Section
  textbook: Textbook
  breadcrumbs: Breadcrumb[]
  markdownUrl?: string
  image?: string
}

const { title, description, activeSection, textbook, breadcrumbs, markdownUrl, image } = Astro.props

// Compute prev/next section URLs
const allSections: { chapter: Chapter; section: Section }[] = [];
textbook.chapters.forEach((chapter: Chapter) => {
    chapter.sections.forEach((section: Section) => {
        allSections.push({ chapter, section });
    });
});

const currentIndex = allSections.findIndex(
    (s) => s.chapter.number === activeSection.chapterNumber && s.section.number === activeSection.number
);

const prevSection = currentIndex > 0 ? allSections[currentIndex - 1] : null;
const nextSection = currentIndex < allSections.length - 1 ? allSections[currentIndex + 1] : null;

const prevUrl = prevSection ? `/chapters/${textbook.version}/${prevSection.chapter.slug}/${prevSection.section.slug}` : null;
const nextUrl = nextSection ? `/chapters/${textbook.version}/${nextSection.chapter.slug}/${nextSection.section.slug}` : null;

const currentChapter = textbook.chapters.find((c: Chapter) => c.number === activeSection.chapterNumber);
---
<html lang="en" class="h-full">
	<head>
		<script is:inline>document.documentElement.classList.add('js')</script>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<BaseHead title={title} description={description} image={image} />
		<ClientRouter />
		<LoadingIndicator color="var(--color-brand-600)" height="3px" />
		<slot name="head" />
		<!-- Privacy-friendly analytics by Plausible -->
		<script async src="https://plausible.io/js/pa-iaFa7u9ahmpcy2YPhenNE.js"></script>
		<script is:inline>
			/* eslint-disable */
			window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
			plausible.init()
		</script>
	</head>
	<body class="noise-bg bg-gray-200">
<DocSearchProvider />
<!-- Reading progress bar -->
<div id="reading-progress" class="hidden lg:block fixed top-0 left-0 right-0 h-1 z-50">
    <div id="reading-progress-bar" class="h-full bg-brand-600 transition-[width] duration-100" style="width: 0%"></div>
</div>

<!-- Desktop layout -->
<div class="hidden lg:flex lg:gap-4 lg:p-4 max-w-[100rem] mx-auto">
    <!-- Sidebar bubble -->
    <aside class="w-72 xl:w-80 shrink-0">
        <div class="sticky top-4 flex flex-col gap-4 max-h-[calc(100vh-2rem)]">
            <!-- Logo bubble -->
            <div class="bg-white rounded-3xl px-6 flex items-center h-14 shrink-0">
                <a href="/" class="block">
                    <Lockup />
                </a>
            </div>

            <!-- Sidebar nav bubble -->
            <div class="bg-white rounded-3xl flex-1 overflow-hidden flex flex-col min-h-0">
                <nav class="flex-1 overflow-y-auto px-4 py-4 space-y-2">
                    {textbook.chapters.map((chapter: Chapter) => (
                    <details class="group" name="sidebar-chapters" open={activeSection.chapterNumber === chapter.number}>
                        <summary class="flex justify-between items-center px-2 py-2 rounded-lg hover:bg-gray-50 cursor-pointer">
                            <span class:list={[
                                "text-sm font-semibold",
                                activeSection.chapterNumber === chapter.number ? "text-brand-700" : "text-gray-700"
                            ]}>
                                {chapter.number}. {chapter.title}
                            </span>
                            <Icon name="tabler:chevron-right" class="group-open:hidden block size-4 text-gray-400" />
                            <Icon name="tabler:chevron-down" class="group-open:block hidden size-4 text-gray-400" />
                        </summary>

                        <ul class="mt-1 ml-3 border-l border-gray-200 pl-3 space-y-0.5">
                            {chapter.sections.map((section: Section) => (
                            <li>
                                <a
                                    href={`/chapters/${textbook.version}/${chapter.slug}/${section.slug}`}
                                    class:list={[
                                        "block px-2 py-1.5 text-sm rounded-lg transition-colors",
                                        activeSection.chapterNumber === chapter.number && activeSection.number === section.number
                                            ? "text-brand-700 bg-brand-50"
                                            : "text-gray-600 hover:bg-gray-50 hover:text-gray-900"
                                    ]}
                                >
                                    {section.number}. {section.title}
                                </a>
                            </li>
                            ))}
                        </ul>
                    </details>
                    ))}
                </nav>
            </div>
        </div>
    </aside>

    <!-- Main content area -->
    <div class="flex-1 flex flex-col gap-4 min-w-0">
        <!-- Navbar bubble (wrapper masks scrolling content behind it) -->
        <div class="sticky top-0 z-30 bg-gray-200 pt-4 pb-4 -mt-4 -mb-4">
        <nav class="bg-white rounded-3xl px-6 flex items-center h-14 shrink-0">
            <div class="flex items-center gap-4 w-full">
                <ol role="list" class="flex items-center space-x-4">
                    <li>
                        <VersionSelector currentVersion={textbook.version} />
                    </li>
                    {breadcrumbs && breadcrumbs.map((item, k) => (
                    <li>
                        <div class="flex items-center">
                            <Icon name="tabler:chevron-right" class="size-4 shrink-0 text-gray-400" />
                            <a href={item.url} class="ml-4 text-sm font-medium text-gray-600 hover:text-gray-900">{item.text}</a>
                        </div>
                    </li>
                    ))}
                </ol>

                <div class="grow"></div>

                <SearchTrigger class="xl:hidden p-2 -m-2 text-gray-500 hover:text-gray-700">
                    <Icon name="tabler:search" class="size-5" />
                </SearchTrigger>
                <SearchTrigger class="hidden xl:flex items-center gap-2 w-full max-w-xs px-3 h-9 rounded-full text-sm bg-gray-100 text-gray-500 hover:bg-gray-200 transition-colors">
                    <Icon name="tabler:search" class="size-4 shrink-0" />
                    <span class="flex-1 text-left">Search...</span>
                    <kbd class="hidden sm:inline-flex items-center gap-0.5 px-1.5 h-5 rounded text-xs font-medium bg-gray-200 text-gray-400">
                        <span class="text-[10px]">⌘</span>K
                    </kbd>
                </SearchTrigger>
            </div>
        </nav>
        </div>

        <!-- Content area with ToC outside -->
        <div class="flex gap-4 overflow-clip">
            <!-- Content bubble -->
            <main id="reader-content" class="bg-white rounded-3xl min-w-0 max-w-4xl w-full shadow-sm">
                <!-- Normal content view -->
                <div id="main-content-view">
                    <slot name="header" />
                    <div class="px-6 lg:px-16 py-10">
                        <slot />
                    </div>
                </div>
                <!-- NoteBox drill-down view (hidden by default) -->
                <div id="notebox-drilldown" class="hidden">
                    <div class="py-6 px-6 lg:px-16 border-b border-gray-200">
                        <a href="#" id="notebox-back" class="inline-flex items-center gap-2 text-gray-600 hover:text-gray-900 transition-colors">
                            <Icon name="tabler:arrow-left" class="size-5" />
                            <span>Back</span>
                        </a>
                        <h1 id="notebox-title" class="mt-4 text-2xl lg:text-3xl font-semibold tracking-tight text-gray-900 font-display"></h1>
                        <p id="notebox-meta" class="mt-2 text-gray-600 text-sm"></p>
                    </div>
                    <div id="notebox-body" class="px-6 lg:px-16 py-10 prose prose-a:text-brand-600 lg:prose-lg">
                    </div>
                </div>
            </main>

            <!-- ToC + audio player in the gray area (outside bubble) -->
            <div class="hidden lg:block flex-1">
                <div class="sticky top-[5.5rem] max-h-[calc(100vh-5.5rem-1rem)] flex flex-col gap-4">
                <!-- Desktop audio player (persists across navigations) -->
                <div id="desktop-audio-player" class="hidden shrink-0 bg-white rounded-2xl p-4" transition:persist="audio-player">
                    <div class="space-y-3">
                        <!-- Title + close -->
                        <div class="flex items-center justify-between">
                            <p id="desktop-track-title" class="text-sm font-medium text-gray-900 truncate flex-1 min-w-0 mr-2"></p>
                            <button type="button" data-audio-close class="shrink-0 p-1 text-gray-400 hover:text-gray-700 transition-colors" title="Close player">
                                <svg class="size-4" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 6L6 18M6 6l12 12"/></svg>
                            </button>
                        </div>
                        <!-- Play + progress bar -->
                        <div class="flex items-center gap-3">
                            <button type="button" data-audio-playpause class="shrink-0 p-2.5 bg-brand-600 text-white rounded-full hover:bg-brand-700 transition-colors shadow-sm" title="Play/Pause">
                                <svg class="size-4 audio-icon-play" viewBox="0 0 24 24"><path fill="currentColor" d="M6 4v16a1 1 0 0 0 1.524.852l13-8a1 1 0 0 0 0-1.704l-13-8A1 1 0 0 0 6 4"/></svg>
                                <svg class="size-4 audio-icon-pause hidden" viewBox="0 0 24 24"><path fill="currentColor" d="M9 4H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h2a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2m8 0h-2a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h2a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2"/></svg>
                            </button>
                            <div class="flex-1 min-w-0 space-y-1">
                                <div class="relative h-1.5 bg-gray-200 rounded-full cursor-pointer group" data-audio-seek="desktop">
                                    <div id="desktop-progress-bar" class="absolute inset-y-0 left-0 bg-brand-600 rounded-full pointer-events-none" style="width: 0%"></div>
                                    <div id="desktop-progress-handle" class="absolute top-1/2 -translate-y-1/2 -translate-x-1/2 w-3 h-3 bg-brand-600 rounded-full opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none" style="left: 0%"></div>
                                </div>
                                <div class="flex justify-between text-xs text-gray-500 tabular-nums">
                                    <span id="desktop-time-current">0:00</span>
                                    <span id="desktop-time-duration">0:00</span>
                                </div>
                            </div>
                            <select data-audio-speed class="audio-speed shrink-0">
                                <option value="0.5">0.5x</option>
                                <option value="0.75">0.75x</option>
                                <option value="1" selected>1x</option>
                                <option value="1.25">1.25x</option>
                                <option value="1.5">1.5x</option>
                                <option value="1.75">1.75x</option>
                                <option value="2">2x</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="flex-1 overflow-y-auto min-h-0">
                    <slot name="toc" />
                </div>
                {markdownUrl && (
                <div class="shrink-0 pl-4 py-3 border-t border-gray-300">
                    <button type="button" data-copy-markdown data-markdown-url={markdownUrl} class="flex items-center gap-1.5 text-sm text-gray-600 hover:text-gray-900 transition-colors cursor-pointer">
                        <Icon name="tabler:clipboard" class="size-4" />
                        <span data-copy-label>Copy markdown</span>
                    </button>
                </div>
                )}
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Mobile layout -->
<div id="mobile-layout" class="lg:hidden pb-[5.75rem]">
    <main>
        <!-- Normal content view -->
        <div id="mobile-main-content-view">
            <slot name="header" />
            <slot name="mobile-toc" />
            {markdownUrl && (
            <div class="mt-2 mx-4 px-4 py-3 bg-white rounded-2xl">
                <button type="button" data-copy-markdown data-markdown-url={markdownUrl} class="flex items-center gap-1.5 text-sm text-gray-600 hover:text-gray-900 transition-colors cursor-pointer">
                    <Icon name="tabler:clipboard" class="size-4" />
                    <span data-copy-label>Copy markdown</span>
                </button>
            </div>
            )}
            <div class="mt-4 bg-white rounded-3xl px-6 py-10">
                <slot />
            </div>
        </div>
        <!-- NoteBox drill-down view (hidden by default) -->
        <div id="mobile-notebox-drilldown" class="hidden">
            <div class="bg-white rounded-3xl">
                <div class="py-6 px-6 border-b border-gray-200">
                    <a href="#" class="notebox-back-mobile inline-flex items-center gap-2 text-gray-600 hover:text-gray-900 transition-colors">
                        <Icon name="tabler:arrow-left" class="size-5" />
                        <span>Back</span>
                    </a>
                    <h1 id="mobile-notebox-title" class="mt-4 text-2xl font-semibold tracking-tight text-gray-900 font-display"></h1>
                    <p id="mobile-notebox-meta" class="mt-2 text-gray-600 text-sm"></p>
                </div>
                <div id="mobile-notebox-body" class="px-6 py-10 prose prose-a:text-brand-600">
                </div>
            </div>
        </div>
    </main>
</div>

<!-- Mobile bottom bar -->
<div class="fixed bottom-0 inset-x-0 z-50 lg:hidden safe-area-bottom">
    <div class="bg-white/80 backdrop-blur-xl border-t border-gray-200/60">
        <!-- Section navigation row -->
        <div class="flex items-center h-11 px-1">
            {prevUrl ? (
                <a href={prevUrl} class="flex items-center justify-center w-10 h-10 text-gray-500 active:text-gray-900 shrink-0">
                    <span class="sr-only">Previous section</span>
                    <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
                    </svg>
                </a>
            ) : (
                <span class="flex items-center justify-center w-10 h-10 text-gray-300 shrink-0">
                    <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
                    </svg>
                </span>
            )}

            <div class="flex-1 flex items-center justify-center min-w-0 px-1">
                <select id="mobile-section-select" class="bg-transparent border-none text-[13px] font-medium text-gray-900 py-1 focus:outline-none focus:ring-0 appearance-none cursor-pointer text-center truncate w-full">
                    {currentChapter?.sections.map((section: Section) => (
                        <option
                            value={`/chapters/${textbook.version}/${currentChapter.slug}/${section.slug}`}
                            selected={activeSection.number === section.number}
                        >
                            {activeSection.chapterNumber}.{section.number} {section.title}
                        </option>
                    ))}
                </select>
            </div>

            {nextUrl ? (
                <a href={nextUrl} class="flex items-center justify-center w-10 h-10 text-gray-500 active:text-gray-900 shrink-0">
                    <span class="sr-only">Next section</span>
                    <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
                    </svg>
                </a>
            ) : (
                <span class="flex items-center justify-center w-10 h-10 text-gray-300 shrink-0">
                    <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
                    </svg>
                </span>
            )}
        </div>

        <!-- Divider -->
        <div class="mx-3 border-t border-gray-100"></div>

        <!-- Main navigation row -->
        <div class="flex items-center h-11 px-2">
            <!-- Home -->
            <a href="/" class="flex items-center justify-center w-10 h-10 text-gray-500 active:text-gray-900 shrink-0" aria-label="Home">
                <svg class="size-[18px]" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
                </svg>
            </a>

            <!-- Chapter selector -->
            <div class="flex-1 flex items-center justify-center min-w-0 h-8 bg-gray-100 rounded-lg px-3 mx-1">
                <select id="mobile-chapter-select" class="bg-transparent border-none text-[13px] font-medium text-gray-700 py-0 focus:outline-none focus:ring-0 appearance-none cursor-pointer text-center truncate w-full">
                    {textbook.chapters.map((chapter: Chapter) => (
                        <option
                            value={`/chapters/${textbook.version}/${chapter.slug}/${chapter.sections[0]?.slug}`}
                            selected={activeSection.chapterNumber === chapter.number}
                        >
                            Ch. {chapter.number}: {chapter.title}
                        </option>
                    ))}
                </select>
                <svg class="size-3.5 text-gray-400 shrink-0 pointer-events-none -ml-1" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
                </svg>
            </div>

            <!-- Search button -->
            <button
                type="button"
                class="flex items-center justify-center w-10 h-10 text-gray-500 active:text-gray-900 shrink-0"
                data-docsearch-trigger
                aria-label="Search"
            >
                <svg class="size-[18px]" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
                </svg>
            </button>
        </div>
    </div>
</div>

<!-- Audio element at body level — always accessible regardless of viewport -->
<audio id="audio-element" preload="none" transition:persist="audio-element"></audio>


<script>
import '../lib/reader';
</script>
	</body>
</html>
