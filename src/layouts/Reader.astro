---
import BaseHead from '@/components/BaseHead.astro'
import Lockup from '@/components/brand/Lockup.astro';
import { Icon } from 'astro-icon/components'
import VersionSelector from '@/components/VersionSelector.astro';
import DocSearchProvider from '@/components/DocSearchProvider.astro';
import SearchTrigger from '@/components/SearchTrigger.astro';
import type { Section, Chapter, Textbook } from '@/textbook-loader';

interface Breadcrumb {
  text: string;
  url: string;
}

interface Props {
  title: string;
  description: string;
  activeSection: Section
  textbook: Textbook
  breadcrumbs: Breadcrumb[]
}

const { title, description, activeSection, textbook, breadcrumbs } = Astro.props

// Compute prev/next section URLs
const allSections: { chapter: Chapter; section: Section }[] = [];
textbook.chapters.forEach((chapter: Chapter) => {
    chapter.sections.forEach((section: Section) => {
        allSections.push({ chapter, section });
    });
});

const currentIndex = allSections.findIndex(
    (s) => s.chapter.number === activeSection.chapterNumber && s.section.number === activeSection.number
);

const prevSection = currentIndex > 0 ? allSections[currentIndex - 1] : null;
const nextSection = currentIndex < allSections.length - 1 ? allSections[currentIndex + 1] : null;

const prevUrl = prevSection ? `/chapters/${textbook.version}/${prevSection.chapter.slug}/${prevSection.section.slug}` : null;
const nextUrl = nextSection ? `/chapters/${textbook.version}/${nextSection.chapter.slug}/${nextSection.section.slug}` : null;

const currentChapter = textbook.chapters.find((c: Chapter) => c.number === activeSection.chapterNumber);
---
<html lang="en" class="h-full lg:overflow-clip">
	<head>
		<script is:inline>document.documentElement.classList.add('js')</script>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<BaseHead title={title} description={description} />
		<slot name="head" />
		<!-- Privacy-friendly analytics by Plausible -->
		<script async src="https://plausible.io/js/pa-iaFa7u9ahmpcy2YPhenNE.js"></script>
		<script is:inline>
			window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
			plausible.init()
		</script>
	</head>
	<body class="noise-bg bg-gray-200 lg:h-screen lg:overflow-clip">
<DocSearchProvider />
<!-- Reading progress bar -->
<div id="reading-progress" class="hidden lg:block fixed top-0 left-0 right-0 h-1 z-50">
    <div id="reading-progress-bar" class="h-full bg-brand-600 transition-[width] duration-100" style="width: 0%"></div>
</div>

<!-- Desktop layout -->
<div class="hidden lg:flex lg:gap-4 lg:p-4 lg:h-screen max-w-[100rem] mx-auto overflow-clip">
    <!-- Sidebar bubble -->
    <aside class="w-72 xl:w-80 shrink-0 flex flex-col gap-4">
        <!-- Logo bubble -->
        <div class="bg-white rounded-3xl px-6 flex items-center h-14">
            <a href="/" class="block">
                <Lockup />
            </a>
        </div>

        <!-- Sidebar nav bubble -->
        <div class="bg-white rounded-3xl flex-1 overflow-hidden flex flex-col min-h-0">
            <nav class="flex-1 overflow-y-auto px-4 py-4 space-y-2">
                {textbook.chapters.map((chapter: Chapter) => (
                <details class="group" name="sidebar-chapters" open={activeSection.chapterNumber === chapter.number}>
                    <summary class="flex justify-between items-center px-2 py-2 rounded-lg hover:bg-gray-50 cursor-pointer">
                        <span class:list={[
                            "text-sm font-semibold",
                            activeSection.chapterNumber === chapter.number ? "text-brand-700" : "text-gray-700"
                        ]}>
                            {chapter.number}. {chapter.title}
                        </span>
                        <Icon name="tabler:chevron-right" class="group-open:hidden block size-4 text-gray-400" />
                        <Icon name="tabler:chevron-down" class="group-open:block hidden size-4 text-gray-400" />
                    </summary>

                    <ul class="mt-1 ml-3 border-l border-gray-200 pl-3 space-y-0.5">
                        {chapter.sections.map((section: Section) => (
                        <li>
                            <a
                                href={`/chapters/${textbook.version}/${chapter.slug}/${section.slug}`}
                                class:list={[
                                    "block px-2 py-1.5 text-sm rounded-lg transition-colors",
                                    activeSection.chapterNumber === chapter.number && activeSection.number === section.number
                                        ? "text-brand-700 bg-brand-50"
                                        : "text-gray-600 hover:bg-gray-50 hover:text-gray-900"
                                ]}
                            >
                                {section.number}. {section.title}
                            </a>
                        </li>
                        ))}
                    </ul>
                </details>
                ))}
            </nav>
        </div>
    </aside>

    <!-- Main content area -->
    <div class="flex-1 flex flex-col gap-4 min-w-0 overflow-clip">
        <!-- Navbar bubble -->
        <nav class="bg-white rounded-3xl px-6 flex items-center h-14 shrink-0">
            <div class="flex items-center gap-4 w-full">
                <ol role="list" class="flex items-center space-x-4">
                    <li>
                        <VersionSelector currentVersion={textbook.version} />
                    </li>
                    {breadcrumbs && breadcrumbs.map((item, k) => (
                    <li>
                        <div class="flex items-center">
                            <Icon name="tabler:chevron-right" class="size-4 shrink-0 text-gray-400" />
                            <a href={item.url} class="ml-4 text-sm font-medium text-gray-600 hover:text-gray-900">{item.text}</a>
                        </div>
                    </li>
                    ))}
                </ol>

                <div class="grow"></div>

                <SearchTrigger class="xl:hidden p-2 -m-2 text-gray-500 hover:text-gray-700">
                    <Icon name="tabler:search" class="size-5" />
                </SearchTrigger>
                <SearchTrigger class="hidden xl:flex items-center gap-2 w-full max-w-xs px-3 h-9 rounded-full text-sm bg-gray-100 text-gray-500 hover:bg-gray-200 transition-colors">
                    <Icon name="tabler:search" class="size-4 shrink-0" />
                    <span class="flex-1 text-left">Search...</span>
                    <kbd class="hidden sm:inline-flex items-center gap-0.5 px-1.5 h-5 rounded text-xs font-medium bg-gray-200 text-gray-400">
                        <span class="text-[10px]">⌘</span>K
                    </kbd>
                </SearchTrigger>
            </div>
        </nav>

        <!-- Content area with ToC outside -->
        <div class="flex-1 flex gap-4 min-h-0 overflow-clip">
            <!-- Content bubble -->
            <main id="reader-content" class="bg-white rounded-3xl overflow-y-auto min-w-0 max-w-4xl w-full scroll-pt-8 scroll-smooth">
                <!-- Normal content view -->
                <div id="main-content-view">
                    <slot name="header" />
                    <div class="px-6 lg:px-16 py-10">
                        <slot />
                    </div>
                </div>
                <!-- NoteBox drill-down view (hidden by default) -->
                <div id="notebox-drilldown" class="hidden">
                    <div class="py-6 px-6 lg:px-16 border-b border-gray-200">
                        <a href="#" id="notebox-back" class="inline-flex items-center gap-2 text-gray-600 hover:text-gray-900 transition-colors">
                            <Icon name="tabler:arrow-left" class="size-5" />
                            <span>Back</span>
                        </a>
                        <h1 id="notebox-title" class="mt-4 text-2xl lg:text-3xl font-semibold tracking-tight text-gray-900 font-display"></h1>
                        <p id="notebox-meta" class="mt-2 text-gray-600 text-sm"></p>
                    </div>
                    <div id="notebox-body" class="px-6 lg:px-16 py-10 prose prose-a:text-brand-600 lg:prose-lg">
                    </div>
                </div>
            </main>

            <!-- ToC in the gray area (outside bubble) -->
            <slot name="toc" />
        </div>
    </div>
</div>

<!-- Mobile layout -->
<div id="mobile-layout" class="lg:hidden pb-24">
    <main>
        <!-- Normal content view -->
        <div id="mobile-main-content-view">
            <slot name="header" />
            <slot name="mobile-toc" />
            <div class="mt-4 bg-white rounded-3xl px-6 py-10">
                <slot />
            </div>
        </div>
        <!-- NoteBox drill-down view (hidden by default) -->
        <div id="mobile-notebox-drilldown" class="hidden">
            <div class="bg-white rounded-3xl">
                <div class="py-6 px-6 border-b border-gray-200">
                    <a href="#" class="notebox-back-mobile inline-flex items-center gap-2 text-gray-600 hover:text-gray-900 transition-colors">
                        <Icon name="tabler:arrow-left" class="size-5" />
                        <span>Back</span>
                    </a>
                    <h1 id="mobile-notebox-title" class="mt-4 text-2xl font-semibold tracking-tight text-gray-900 font-display"></h1>
                    <p id="mobile-notebox-meta" class="mt-2 text-gray-600 text-sm"></p>
                </div>
                <div id="mobile-notebox-body" class="px-6 py-10 prose prose-a:text-brand-600">
                </div>
            </div>
        </div>
    </main>
</div>

<!-- Mobile bottom bar -->
<div class="fixed bottom-0 inset-x-0 z-50 lg:hidden safe-area-bottom">
    <div class="flex flex-col">
        <!-- Section row (top): [Prev] [Section select] [Next] as three distinct containers -->
        <div class="flex items-center gap-2 px-2 py-2 bg-brand-100 rounded-t-2xl">
            {prevUrl ? (
                <a href={prevUrl} class="flex items-center justify-center w-12 h-10 text-brand-700 active:text-brand-900 shrink-0">
                    <span class="sr-only">Previous section</span>
                    <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
                    </svg>
                </a>
            ) : (
                <span class="flex items-center justify-center w-12 h-10 text-brand-400 shrink-0">
                    <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
                    </svg>
                </span>
            )}

            <div class="flex-1 flex items-center justify-center min-w-0 h-10 bg-white/30 rounded-xl px-3">
                <select id="mobile-section-select" class="bg-transparent border-none text-sm font-medium text-brand-800 py-1 focus:outline-none focus:ring-0 appearance-none cursor-pointer text-center truncate w-full">
                    {currentChapter?.sections.map((section: Section) => (
                        <option
                            value={`/chapters/${textbook.version}/${currentChapter.slug}/${section.slug}`}
                            selected={activeSection.number === section.number}
                        >
                            {activeSection.chapterNumber}.{section.number} {section.title}
                        </option>
                    ))}
                </select>
                <svg class="size-4 text-brand-500 shrink-0 pointer-events-none" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
                </svg>
            </div>

            {nextUrl ? (
                <a href={nextUrl} class="flex items-center justify-center w-12 h-10 text-brand-700 active:text-brand-900 shrink-0">
                    <span class="sr-only">Next section</span>
                    <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
                    </svg>
                </a>
            ) : (
                <span class="flex items-center justify-center w-12 h-10 text-brand-400 shrink-0">
                    <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
                    </svg>
                </span>
            )}
        </div>

        <!-- Navigation row (bottom): Home | Chapter | Search -->
        <div class="flex items-center gap-2 h-14 px-2 bg-brand-200">
            <!-- Home -->
            <a href="/" class="flex flex-col items-center justify-center w-14 h-12 text-brand-700 active:text-brand-900 shrink-0">
                <svg class="size-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
                </svg>
                <span class="text-[10px] mt-0.5">Home</span>
            </a>

            <!-- Chapter selector -->
            <div class="flex-1 flex items-center justify-center min-w-0 h-10 bg-brand-100 rounded-xl px-3">
                <select id="mobile-chapter-select" class="bg-transparent border-none text-sm font-medium text-brand-800 py-1 focus:outline-none focus:ring-0 appearance-none cursor-pointer text-center truncate w-full">
                    {textbook.chapters.map((chapter: Chapter) => (
                        <option
                            value={`/chapters/${textbook.version}/${chapter.slug}/${chapter.sections[0]?.slug}`}
                            selected={activeSection.chapterNumber === chapter.number}
                        >
                            Ch. {chapter.number}: {chapter.title}
                        </option>
                    ))}
                </select>
                <svg class="size-4 text-brand-500 shrink-0 pointer-events-none" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
                </svg>
            </div>

            <!-- Search button -->
            <button
                type="button"
                class="flex flex-col items-center justify-center w-14 h-12 text-brand-700 active:text-brand-900 shrink-0"
                data-docsearch-trigger
                aria-label="Search"
            >
                <svg class="size-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
                </svg>
                <span class="text-[10px] mt-0.5">Search</span>
            </button>
        </div>
    </div>
</div>

<script>
const progressBar = document.getElementById('reading-progress-bar');
const content = document.getElementById('reader-content');

if (progressBar && content) {
    function updateProgress() {
        const scrollTop = content.scrollTop;
        const scrollHeight = content.scrollHeight - content.clientHeight;
        const progress = scrollHeight > 0 ? (scrollTop / scrollHeight) * 100 : 0;
        const clampedProgress = Math.min(100, Math.max(0, progress));
        progressBar.style.width = `${clampedProgress}%`;
    }

    content.addEventListener('scroll', updateProgress, { passive: true });
    updateProgress();
}

// NoteBox drill-down functionality
const noteboxDrilldown = {
    // Desktop elements
    mainView: document.getElementById('main-content-view'),
    drilldownView: document.getElementById('notebox-drilldown'),
    drilldownTitle: document.getElementById('notebox-title'),
    drilldownMeta: document.getElementById('notebox-meta'),
    drilldownBody: document.getElementById('notebox-body'),
    backBtn: document.getElementById('notebox-back'),
    // Mobile elements
    mobileMainView: document.getElementById('mobile-main-content-view'),
    mobileDrilldownView: document.getElementById('mobile-notebox-drilldown'),
    mobileDrilldownTitle: document.getElementById('mobile-notebox-title'),
    mobileDrilldownMeta: document.getElementById('mobile-notebox-meta'),
    mobileDrilldownBody: document.getElementById('mobile-notebox-body'),
    // State
    savedScrollPosition: 0,
    mobileSavedScrollPosition: 0,
    isInDrilldown: false,

    init() {
        // Handle notebox trigger clicks
        document.addEventListener('click', (e) => {
            const trigger = (e.target as HTMLElement).closest('.notebox-trigger');
            if (!trigger) return;

            e.preventDefault();
            const wrapper = trigger.closest('.notebox-wrapper');
            const noteboxId = wrapper?.getAttribute('data-notebox-id');
            if (noteboxId) {
                history.pushState({ notebox: noteboxId }, '', `#${noteboxId}`);
                this.showNotebox(noteboxId);
            }
        });

        // Handle back button clicks
        this.backBtn?.addEventListener('click', (e) => {
            e.preventDefault();
            history.back();
        });
        document.querySelectorAll('.notebox-back-mobile').forEach(btn => {
            btn.addEventListener('click', (e) => {
                e.preventDefault();
                history.back();
            });
        });

        // Handle browser back/forward
        window.addEventListener('popstate', () => {
            this.handleHashChange();
        });

        // Handle initial hash on page load
        this.handleHashChange();
    },

    handleHashChange() {
        const hash = window.location.hash.slice(1);
        if (hash && hash.startsWith('notebox-')) {
            this.showNotebox(hash);
        } else if (this.isInDrilldown) {
            // Only restore scroll if we were actually in a drilldown
            this.hideNotebox();
        }
    },

    showNotebox(noteboxId: string) {
        const wrapper = document.querySelector(`[data-notebox-id="${noteboxId}"]`);
        if (!wrapper) return;

        const contentDiv = wrapper.querySelector('.notebox-content') as HTMLElement;
        const title = contentDiv?.getAttribute('data-notebox-title') || '';
        const readingTime = contentDiv?.getAttribute('data-notebox-time') || '';
        const metaText = `Optional · ${readingTime} read`;
        const contentHtml = contentDiv?.innerHTML || '';

        this.isInDrilldown = true;

        // Desktop
        if (this.mainView && this.drilldownView && this.drilldownTitle && this.drilldownBody && content) {
            this.savedScrollPosition = content.scrollTop;
            this.mainView.classList.add('hidden');
            this.drilldownView.classList.remove('hidden');
            this.drilldownTitle.textContent = title;
            if (this.drilldownMeta) this.drilldownMeta.textContent = metaText;
            this.drilldownBody.innerHTML = contentHtml;
            content.scrollTo({ top: 0, behavior: 'instant' });
        }

        // Mobile
        if (this.mobileMainView && this.mobileDrilldownView && this.mobileDrilldownTitle && this.mobileDrilldownBody) {
            this.mobileSavedScrollPosition = window.scrollY;
            this.mobileMainView.classList.add('hidden');
            this.mobileDrilldownView.classList.remove('hidden');
            this.mobileDrilldownTitle.textContent = title;
            if (this.mobileDrilldownMeta) this.mobileDrilldownMeta.textContent = metaText;
            this.mobileDrilldownBody.innerHTML = contentHtml;
            window.scrollTo(0, 0);
        }
    },

    hideNotebox() {
        this.isInDrilldown = false;

        // Desktop
        if (this.mainView && this.drilldownView && content) {
            this.drilldownView.classList.add('hidden');
            this.mainView.classList.remove('hidden');
            content.scrollTo({ top: this.savedScrollPosition, behavior: 'instant' });
        }

        // Mobile
        if (this.mobileMainView && this.mobileDrilldownView) {
            this.mobileDrilldownView.classList.add('hidden');
            this.mobileMainView.classList.remove('hidden');
            window.scrollTo(0, this.mobileSavedScrollPosition);
        }
    }
};

noteboxDrilldown.init();

// Mobile section navigation
const mobileSectionSelect = document.getElementById('mobile-section-select') as HTMLSelectElement | null;
if (mobileSectionSelect) {
    mobileSectionSelect.addEventListener('change', () => {
        const url = mobileSectionSelect.value;
        if (url && url.startsWith('/')) {
            window.location.href = url;
        }
    });
}

// Mobile chapter navigation
const mobileChapterSelect = document.getElementById('mobile-chapter-select') as HTMLSelectElement | null;
if (mobileChapterSelect) {
    mobileChapterSelect.addEventListener('change', () => {
        const url = mobileChapterSelect.value;
        if (url && url.startsWith('/')) {
            window.location.href = url;
        }
    });
}

</script>
	</body>
</html>
