---
import BaseHead from '@/components/BaseHead.astro'
import Lockup from '@/components/brand/Lockup.astro';
import { Icon } from 'astro-icon/components'
import VersionSelector from '@/components/VersionSelector.astro';
import AlgoliaSearch from '@/components/AlgoliaSearch.astro';
import type { Section, Chapter, Textbook } from '@/textbook-loader';

interface Breadcrumb {
  text: string;
  url: string;
}

interface Props {
  title: string;
  description: string;
  activeSection: Section
  textbook: Textbook
  breadcrumbs: Breadcrumb[]
}

const { title, description, activeSection, textbook, breadcrumbs } = Astro.props

// Compute prev/next section URLs
const allSections: { chapter: Chapter; section: Section }[] = [];
textbook.chapters.forEach((chapter: Chapter) => {
    chapter.sections.forEach((section: Section) => {
        allSections.push({ chapter, section });
    });
});

const currentIndex = allSections.findIndex(
    (s) => s.chapter.number === activeSection.chapterNumber && s.section.number === activeSection.number
);

const prevSection = currentIndex > 0 ? allSections[currentIndex - 1] : null;
const nextSection = currentIndex < allSections.length - 1 ? allSections[currentIndex + 1] : null;

const prevUrl = prevSection ? `/chapters/${textbook.version}/${prevSection.chapter.slug}/${prevSection.section.slug}` : null;
const nextUrl = nextSection ? `/chapters/${textbook.version}/${nextSection.chapter.slug}/${nextSection.section.slug}` : null;

const currentChapter = textbook.chapters.find((c: Chapter) => c.number === activeSection.chapterNumber);
---
<html lang="en" class="h-full">
	<head>
		<script is:inline>document.documentElement.classList.add('js')</script>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<BaseHead title={title} description={description} />
		<slot name="head" />
	</head>
	<body class="noise-bg bg-gray-200 lg:h-screen lg:overflow-hidden">
<!-- Reading progress bar -->
<div id="reading-progress" class="hidden lg:block fixed top-0 left-0 right-0 h-1 z-50">
    <div id="reading-progress-bar" class="h-full bg-brand-600 transition-[width] duration-100" style="width: 0%"></div>
</div>

<!-- Mobile sidebar dialog -->
<el-dialog>
  <dialog id="sidebar" class="backdrop:bg-transparent lg:hidden">
    <el-dialog-backdrop class="fixed inset-0 bg-gray-900/80 transition-opacity duration-300 ease-linear data-closed:opacity-0"></el-dialog-backdrop>

    <div tabindex="0" class="fixed inset-0 flex focus:outline-none">
      <el-dialog-panel class="group/dialog-panel relative mr-16 flex w-full max-w-xs flex-1 transform transition duration-300 ease-in-out data-closed:-translate-x-full">
        <div class="absolute top-0 left-full flex w-16 justify-center pt-5 duration-300 ease-in-out group-data-closed/dialog-panel:opacity-0">
          <button type="button" command="close" commandfor="sidebar" class="-m-2.5 p-2.5">
            <span class="sr-only">Close sidebar</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" data-slot="icon" aria-hidden="true" class="size-6 text-white">
              <path d="M6 18 18 6M6 6l12 12" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
        </div>

        <div class="relative flex grow flex-col gap-y-5 overflow-y-auto bg-white px-6 pb-4">
          <div>
            <a href="/" class="relative flex h-16 shrink-0 items-center">
                <Lockup />
            </a>
            <VersionSelector currentVersion={textbook.version} class="-mt-2" />
          </div>
          <nav class="relative flex flex-1 flex-col">
            <ul role="list" class="flex flex-1 flex-col gap-y-7">
              <li>
                <ul role="list" class="-mx-2 space-y-1">
                </ul>
              </li>
            </ul>
          </nav>
        </div>
      </el-dialog-panel>
    </div>
  </dialog>
</el-dialog>

<!-- Desktop layout -->
<div class="hidden lg:flex lg:gap-4 lg:p-4 lg:h-screen">
    <!-- Sidebar bubble -->
    <aside class="w-72 xl:w-80 shrink-0 flex flex-col gap-4">
        <!-- Logo bubble -->
        <div class="bg-white rounded-3xl px-6 flex items-center h-14">
            <a href="/" class="block">
                <Lockup />
            </a>
        </div>

        <!-- Sidebar nav bubble -->
        <div class="bg-white rounded-3xl flex-1 overflow-hidden flex flex-col min-h-0">
            <nav class="flex-1 overflow-y-auto px-4 py-4 space-y-2">
                {textbook.chapters.map((chapter: Chapter) => (
                <details class="group" name="sidebar-chapters" open={activeSection.chapterNumber === chapter.number}>
                    <summary class="flex justify-between items-center px-2 py-2 rounded-lg hover:bg-gray-50 cursor-pointer">
                        <span class:list={[
                            "text-sm font-semibold",
                            activeSection.chapterNumber === chapter.number ? "text-brand-700" : "text-gray-700"
                        ]}>
                            {chapter.number}. {chapter.title}
                        </span>
                        <Icon name="tabler:chevron-right" class="group-open:hidden block size-4 text-gray-400" />
                        <Icon name="tabler:chevron-down" class="group-open:block hidden size-4 text-gray-400" />
                    </summary>

                    <ul class="mt-1 ml-3 border-l border-gray-200 pl-3 space-y-0.5">
                        {chapter.sections.map((section: Section) => (
                        <li>
                            <a
                                href={`/chapters/${textbook.version}/${chapter.slug}/${section.slug}`}
                                class:list={[
                                    "block px-2 py-1.5 text-sm rounded-lg transition-colors",
                                    activeSection.chapterNumber === chapter.number && activeSection.number === section.number
                                        ? "text-brand-700 bg-brand-50"
                                        : "text-gray-600 hover:bg-gray-50 hover:text-gray-900"
                                ]}
                            >
                                {section.number}. {section.title}
                            </a>
                        </li>
                        ))}
                    </ul>
                </details>
                ))}
            </nav>
        </div>
    </aside>

    <!-- Main content area -->
    <div class="flex-1 flex flex-col gap-4 min-w-0">
        <!-- Navbar bubble -->
        <nav class="bg-white rounded-3xl px-6 flex items-center h-14 shrink-0">
            <div class="flex items-center gap-4 w-full">
                <ol role="list" class="flex items-center space-x-4">
                    <li>
                        <VersionSelector currentVersion={textbook.version} />
                    </li>
                    {breadcrumbs && breadcrumbs.map((item, k) => (
                    <li>
                        <div class="flex items-center">
                            <Icon name="tabler:chevron-right" class="size-4 shrink-0 text-gray-400" />
                            <a href={item.url} class="ml-4 text-sm font-medium text-gray-600 hover:text-gray-900">{item.text}</a>
                        </div>
                    </li>
                    ))}
                </ol>

                <div class="grow"></div>

                <AlgoliaSearch id="reader-search" class="w-full max-w-xs" />
            </div>
        </nav>

        <!-- Content area with ToC outside -->
        <div class="flex-1 flex gap-4 min-h-0">
            <!-- Content bubble -->
            <main id="reader-content" class="bg-white rounded-3xl overflow-y-auto min-w-0 max-w-4xl w-full scroll-pt-8">
                <slot name="header" />
                <div class="px-6 lg:px-16 py-10">
                    <slot />
                </div>
            </main>

            <!-- ToC in the gray area (outside bubble) -->
            <slot name="toc" />
        </div>
    </div>
</div>

<!-- Mobile layout -->
<div class="lg:hidden pb-24">
    <main>
        <slot name="header" />
        <div class="mt-4 bg-white rounded-3xl px-6 py-10">
            <slot />
        </div>
    </main>
</div>

<!-- Mobile bottom bar -->
<div class="fixed bottom-0 inset-x-0 z-50 lg:hidden safe-area-bottom">
    <div class="flex flex-col">
        <!-- Section row (top): [Prev] [Section select] [Next] as three distinct containers -->
        <div class="flex items-center gap-2 px-2 py-2 bg-gray-100 rounded-t-2xl">
            {prevUrl ? (
                <a href={prevUrl} class="flex items-center justify-center w-12 h-10 bg-white rounded-xl text-gray-600 active:bg-gray-50 shrink-0 shadow-sm">
                    <span class="sr-only">Previous section</span>
                    <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
                    </svg>
                </a>
            ) : (
                <span class="flex items-center justify-center w-12 h-10 bg-white/50 rounded-xl text-gray-300 shrink-0">
                    <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
                    </svg>
                </span>
            )}

            <div class="flex-1 flex items-center justify-center min-w-0 h-10 bg-white rounded-xl shadow-sm px-3">
                <select id="mobile-section-select" class="bg-transparent border-none text-sm font-medium text-gray-700 py-1 focus:outline-none focus:ring-0 appearance-none cursor-pointer text-center truncate w-full">
                    {currentChapter?.sections.map((section: Section) => (
                        <option
                            value={`/chapters/${textbook.version}/${currentChapter.slug}/${section.slug}`}
                            selected={activeSection.number === section.number}
                        >
                            {activeSection.chapterNumber}.{section.number} {section.title}
                        </option>
                    ))}
                </select>
                <svg class="size-4 text-gray-400 shrink-0 pointer-events-none" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
                </svg>
            </div>

            {nextUrl ? (
                <a href={nextUrl} class="flex items-center justify-center w-12 h-10 bg-white rounded-xl text-gray-600 active:bg-gray-50 shrink-0 shadow-sm">
                    <span class="sr-only">Next section</span>
                    <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
                    </svg>
                </a>
            ) : (
                <span class="flex items-center justify-center w-12 h-10 bg-white/50 rounded-xl text-gray-300 shrink-0">
                    <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
                    </svg>
                </span>
            )}
        </div>

        <!-- Navigation row (bottom): Home | Chapter | Search -->
        <div class="flex items-center h-14 px-2 bg-white border-t border-gray-200">
            <!-- Home -->
            <a href="/" class="flex items-center justify-center w-14 h-14 text-gray-400 active:text-gray-600 active:bg-gray-100 rounded-xl shrink-0">
                <span class="sr-only">Home</span>
                <svg class="size-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
                </svg>
            </a>

            <!-- Chapter selector -->
            <div class="flex items-center h-14 flex-1 justify-center min-w-0 active:bg-gray-100 rounded-xl mx-1">
                <select id="mobile-chapter-select" class="bg-transparent border-none text-sm text-gray-500 py-4 pr-6 pl-4 focus:outline-none focus:ring-0 appearance-none cursor-pointer truncate w-full text-center">
                    {textbook.chapters.map((chapter: Chapter) => (
                        <option
                            value={`/chapters/${textbook.version}/${chapter.slug}/${chapter.sections[0]?.slug}`}
                            selected={activeSection.chapterNumber === chapter.number}
                        >
                            {chapter.number}. {chapter.title}
                        </option>
                    ))}
                </select>
                <svg class="size-4 text-gray-400 shrink-0 -ml-5 mr-1 pointer-events-none" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
                </svg>
            </div>

            <!-- Search button -->
            <button type="button" command="show-modal" commandfor="mobile-search-dialog" class="flex items-center justify-center w-14 h-14 text-gray-400 active:text-gray-600 active:bg-gray-100 rounded-xl shrink-0">
                <span class="sr-only">Search</span>
                <svg class="size-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
                </svg>
            </button>
        </div>
    </div>
</div>

<!-- Mobile search dialog -->
<el-dialog>
    <dialog id="mobile-search-dialog" class="backdrop:bg-transparent lg:hidden">
        <el-dialog-backdrop class="fixed inset-0 bg-gray-900/80 transition duration-200 data-closed:opacity-0"></el-dialog-backdrop>
        <el-dialog-panel class="fixed inset-x-4 top-20 mx-auto max-w-xl rounded-xl bg-white p-4 shadow-2xl ring-1 ring-black/5 transition duration-200 data-closed:scale-95 data-closed:opacity-0">
            <AlgoliaSearch id="mobile-reader-search" />
        </el-dialog-panel>
    </dialog>
</el-dialog>
<script>
import '@tailwindplus/elements'

const progressBar = document.getElementById('reading-progress-bar');
const content = document.getElementById('reader-content');

if (progressBar && content) {
    function updateProgress() {
        const scrollTop = content.scrollTop;
        const scrollHeight = content.scrollHeight - content.clientHeight;
        const progress = scrollHeight > 0 ? (scrollTop / scrollHeight) * 100 : 0;
        const clampedProgress = Math.min(100, Math.max(0, progress));
        progressBar.style.width = `${clampedProgress}%`;
    }

    content.addEventListener('scroll', updateProgress, { passive: true });
    updateProgress();

    // Handle anchor links within the scrollable content
    document.addEventListener('click', (e) => {
        const link = (e.target as HTMLElement).closest('a[href^="#"]');
        if (!link) return;

        const hash = link.getAttribute('href');
        if (!hash || hash === '#') return;

        const target = document.querySelector(hash);
        if (!target || !content.contains(target)) return;

        e.preventDefault();
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        history.pushState(null, '', hash);
    });

    // Handle initial hash on page load
    if (window.location.hash) {
        const target = document.querySelector(window.location.hash);
        if (target && content.contains(target)) {
            setTimeout(() => target.scrollIntoView({ block: 'start' }), 100);
        }
    }
}

// Mobile section navigation
const mobileSectionSelect = document.getElementById('mobile-section-select') as HTMLSelectElement | null;
if (mobileSectionSelect) {
    mobileSectionSelect.addEventListener('change', () => {
        const url = mobileSectionSelect.value;
        if (url && url.startsWith('/')) {
            window.location.href = url;
        }
    });
}

// Mobile chapter navigation
const mobileChapterSelect = document.getElementById('mobile-chapter-select') as HTMLSelectElement | null;
if (mobileChapterSelect) {
    mobileChapterSelect.addEventListener('change', () => {
        const url = mobileChapterSelect.value;
        if (url && url.startsWith('/')) {
            window.location.href = url;
        }
    });
}


// Focus search input when mobile dialog opens
const mobileSearchDialog = document.getElementById('mobile-search-dialog') as HTMLDialogElement | null;
const mobileSearchElDialog = mobileSearchDialog?.closest('el-dialog');

if (mobileSearchDialog) {
    mobileSearchElDialog?.addEventListener('open', () => {
        setTimeout(() => {
            const input = mobileSearchDialog.querySelector('.aa-Input') as HTMLInputElement;
            input?.focus();
        }, 50);
    });
}
</script>
	</body>
</html>
