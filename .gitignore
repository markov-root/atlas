# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

service-account.json

convert.js
# Carve-out: textbook content cache (.cache/docs/) is committed so
# contributors can build without Google credentials. Everything else
# under .cache/ stays ignored. See .cache/docs/README.md.
.cache/*
!.cache/docs/
.claude

public/uc/
src/assets/uc/
previous-version-w-docusaurus
public/logos/

# Local-only docs:
#   - TODO.md is the maintainer's tactical task tracker
#   - lessons/ is the per-session process journal (agent working memory).
#     Decision rationale that's publicly valuable lives in PRINCIPLES /
#     ARCHITECTURE / ROADMAP instead.
/docs/TODO.md
/docs/lessons/

# Raw data dumps fed in during planning (Formspree exports, ancient
# pre-Astro courses JSON, etc.). Useful as working input for intake
# scripts; not for the public repo.
/dumps/

# CocoIndex Code (ccc)
/.cocoindex_code/

# software-engineering document-index cache (derived)
.engineering/

# Locally staged read-along audio. Large and reproducible via
# scripts/copy-chapter-audio.sh; the .words.json timings beside them ARE
# committed.
public/audio/ch*/*.mp3

# Playwright MCP scratch. The browser tools resolve their output directory
# against the working directory, so driving a browser from this checkout
# drops screenshots, page-*.yml snapshots and console logs in here. Nothing
# in it is worth keeping; prefer an absolute path outside the repo.
.playwright-mcp/

# Derived citation outputs. `data/citations/sources.yaml` IS committed — it is
# the source of truth, and it accumulates resolver metadata that costs real time
# and other people's rate limits to rebuild. These three are regenerated from it
# in about 6 seconds, so committing them would add ~760 KB of churn to a repo
# task:0019 is trying to shrink, for no gain.
data/citations/bibliography.bib
data/citations/bibliography.json
data/citations/citation-report.md
