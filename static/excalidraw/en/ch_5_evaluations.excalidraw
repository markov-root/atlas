      "versionNonce": 1288352468,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1734996865835,
      "link": null,
      "locked": false,
      "text": "Models in this\nregion are not\nthemselves\ndangerous, but\ndangerous to scale\nfurther",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Models in this region are not themselves dangerous, but dangerous to scale further",
      "autoResize": false,
      "lineHeight": 1.25
    },
