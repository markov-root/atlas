      "updated": 1732313985285,
      "link": null,
      "locked": false,
      "text": "A mirror is a piece of\nglass that reflects\nlight. If you smash a\nmirror, you can't see\nanything.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "Afzr_kNdbJ5NuboTTou55",
      "originalText": "A mirror is a piece of glass that reflects light. If you smash a mirror, you can't see anything.",
      "autoResize": true,
      "lineHeight": 1.25
    },
