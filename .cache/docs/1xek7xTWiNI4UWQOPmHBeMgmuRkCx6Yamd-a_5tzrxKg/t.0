dex":58313,"textRun":{"content":"caption\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":58313,"endIndex":58332,"content":[{"startIndex":58314,"endIndex":58332,"paragraph":{"elements":[{"startIndex":58314,"endIndex":58315,"textRun":{"content":"(","textStyle":{}}},{"startIndex":58315,"endIndex":58330,"textRun":{"content":"Anthropic, 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.anthropic.com/index/claudes-constitution"}}}},{"startIndex":58330,"endIndex":58331,"textRun":{"content":")","textStyle":{}}},{"startIndex":58331,"endIndex":58332,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":80,"unit":"PT"}}]}}},{"startIndex":58333,"endIndex":58334,"paragraph":{"elements":[{"startIndex":58333,"endIndex":58334,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":58334,"endIndex":59014,"paragraph":{"elements":[{"startIndex":58334,"endIndex":58439,"textRun":{"content":"RLAIF also known as RLCAI (Reinforcement Learning on Constitutional AI) or simply Constitutional AI, was ","textStyle":{}}},{"startIndex":58439,"endIndex":58461,"textRun":{"content":"developed by Anthropic","textStyle":{}}},{"startIndex":58461,"endIndex":58464,"textRun":{"content":". (","textStyle":{}}},{"startIndex":58464,"endIndex":58479,"textRun":{"content":"Anthropic, 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.anthropic.com/index/claudes-constitution"}}}},{"startIndex":58479,"endIndex":58834,"textRun":{"content":") A central component of Constitutional AI is the constitution, a set of human-written principles that the AI is expected to adhere to, such as \"Choose the least threatening or aggressive response\". Anthropic's AI assistant Claude's constitution incorporates principles from the Universal Declaration of Human Rights, Apple’s Terms of Service, Deepmind’s ","textStyle":{}}},{"startIndex":58834,"endIndex":58852,"textRun":{"content":"Sparrow Principles","textStyle":{}}},{"startIndex":58852,"endIndex":58865,"textRun":{"content":", and more. (","textStyle":{}}},{"startIndex":58865,"endIndex":58883,"textRun":{"content":"Glaese et al, 2022","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2209.14375"}}}},{"startIndex":58883,"endIndex":59014,"textRun":{"content":") Constitutional AI begins with an AI trained primarily for helpfulness and subsequently trains it for harmlessness in two stages:\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":59014,"endIndex":59015,"paragraph":{"elements":[{"startIndex":59014,"endIndex":59015,"textRun":{"content":"\n","textStyle":{"foregroundColor":{"color":{"rgbColor":{"red":0.05490196,"green":0.0627451,"blue":0.101960786}}}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}},{"startIndex":59015,"endIndex":59323,"paragraph":{"elements":[{"startIndex":59015,"endIndex":59044,"textRun":{"content":"Generate prompt, output pairs","textStyle":{"bold":true}}},{"startIndex":59044,"endIndex":59046,"textRun":{"content":": ","textStyle":{"bold":true,"foregroundColor":{"color":{"rgbColor":{"red":0.05490196,"green":0.0627451,"blue":0.101960786}}}}}},{"startIndex":59046,"endIndex":59323,"textRun":{"content":"The AI continuously critiques and refines its own responses to harmful prompts. The AI is then trained to generate outputs more similar to these revised responses. This stage's primary objective is to facilitate the second stage. An example flow of this process is as follows:\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"}}}},{"startIndex":59323,"endIndex":59460,"paragraph":{"elements":[{"startIndex":59323,"endIndex":59329,"textRun":{"content":"Prompt","textStyle":{"bold":true}}},{"startIndex":59329,"endIndex":59460,"textRun":{"content":": A model that has already been trained using RLHF is first asked for advice on building bombs. The model outputs a bomb tutorial.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.zf8rmvvnly88","textStyle":{}}}},{"startIndex":59460,"endIndex":59621,"paragraph":{"elements":[{"startIndex":59460,"endIndex":59621,"textRun":{"content":"Then the model is asked to revise the response in accordance with a randomly selected constitutional principle. The following steps are repeated multiple times.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.zf8rmvvnly88","textStyle":{}}}},{"startIndex":59621,"endIndex":59812,"paragraph":{"elements":[{"startIndex":59621,"endIndex":59629,"textRun":{"content":"Critique","textStyle":{"bold":true}}},{"startIndex":59629,"endIndex":59812,"textRun":{"content":": This output is then fed back into the model, alongside a request to critique why the generated output would be considered harmful according to some rule of the chosen constitution.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"indentFirstLine":{"magnitude":54,"unit":"PT"},"indentStart":{"magnitude":72,"unit":"PT"}},"bullet":{"listId":"kix.zf8rmvvnly88","nestingLevel":1,"textStyle":{}}}},{"startIndex":59812,"endIndex":59944,"paragraph":{"elements":[{"startIndex":59812,"endIndex":59820,"textRun":{"content":"Revision","textStyle":{"bold":true}}},{"startIndex":59820,"endIndex":59944,"textRun":{"content":": The model is then prompted to rewrite the original response such that it is not in violation of the constitutional rules.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"indentFirstLine":{"magnitude":54,"unit":"PT"},"indentStart":{"magnitude":72,"unit":"PT"}},"bullet":{"listId":"kix.zf8rmvvnly88","nestingLevel":1,"textStyle":{"underline":false}}}},{"startIndex":59944,"endIndex":59945,"paragraph":{"elements":[{"startIndex":59944,"endIndex":59945,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"}}}},{"startIndex":59945,"endIndex":60116,"paragraph":{"elements":[{"startIndex":59945,"endIndex":59958,"textRun":{"content":"SL-CAI Model:","textStyle":{"bold":true}}},{"startIndex":59958,"endIndex":59959,"textRun":{"content":" ","textStyle":{}}},{"startIndex":59959,"endIndex":59997,"textRun":{"content":"Supervised Learning Constitutional AI ","textStyle":{"bold":true}}},{"startIndex":59997,"endIndex":60116,"textRun":{"content":"Based on the generated set of (harmful prompt, revised output) pairs a new model is trained using supervised learning.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.zf8rmvvnly88","textStyle":{}}}},{"startIndex":60116,"endIndex":60117,"paragraph":{"elements":[{"startIndex":60116,"endIndex":60117,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"indentFirstLine":{"magnitude":36,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}}}},{"startIndex":60117,"endIndex":60135,"paragraph":{"elements":[{"startIndex":60117,"endIndex":60135,"textRun":{"content":"Preference Model:\n","textStyle":{"bold":true}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.zf8rmvvnly88","textStyle":{"bold":true}}}},{"startIndex":60135,"endIndex":60136,"paragraph":{"elements":[{"startIndex":60135,"endIndex":60136,"textRun":{"content":"\n","textStyle":{"bold":true}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"indentFirstLine":{"magnitude":36,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}}}},{"startIndex":60136,"endIndex":60191,"paragraph":{"elements":[{"startIndex":60136,"endIndex":60190,"textRun":{"content":"RL-CAI Model: Reinforcement Learning Constitutional AI","textStyle":{"bold":true}}},{"startIndex":60190,"endIndex":60191,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.zf8rmvvnly88","textStyle":{"bold":true,"underline":false}}}},{"startIndex":60191,"endIndex":60192,"paragraph":{"elements":[{"startIndex":60191,"endIndex":60192,"textRun":{"content":"\n","textStyle":{"foregroundColor":{"color":{"rgbColor":{"red":0.05490196,"green":0.0627451,"blue":0.101960786}}}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"}}}},{"startIndex":60192,"endIndex":60661,"paragraph":{"elements":[{"startIndex":60192,"endIndex":60200,"textRun":{"content":"Stage 2:","textStyle":{"bold":true,"foregroundColor":{"color":{"rgbColor":{"red":0.05490196,"green":0.0627451,"blue":0.101960786}}}}}},{"startIndex":60200,"endIndex":60661,"textRun":{"content":" We use the AI, fine-tuned from stage 1, to produce pairs of alternative responses to harmful prompts. The AI then rates each pair according to a randomly selected constitutional principle. This results in AI-generated preferences for harmlessness, which we blend with human preferences for helpfulness to ensure the AI doesn't lose its ability to be helpful. The final step is to train the AI to create responses that closely resemble the preferred responses.\n","textStyle":{"foregroundColor":{"color":{"rgbColor":{"red":0.05490196,"green":0.0627451,"blue":0.101960786}}}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.zf8rmvvnly88","textStyle":{"foregroundColor":{"color":{"rgbColor":{"red":0.05490196,"green":0.0627451,"blue":0.101960786}}}}}}},{"startIndex":60661,"endIndex":60662,"paragraph":{"elements":[{"startIndex":60661,"endIndex":60662,"textRun":{"content":"\n","textStyle":{"foregroundColor":{"color":{"rgbColor":{"red":0.05490196,"green":0.0627451,"blue":0.101960786}}}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}},{"startIndex":60662,"endIndex":61213,"paragraph":{"elements":[{"startIndex":60662,"endIndex":61213,"textRun":{"content":"Anthropic's experiments indicate that AIs trained with Constitutional Reinforcement Learning are significantly safer (in the sense of less offensive and less likely to give you potentially harmful information) while maintaining the same level of helpfulness compared to AIs trained with RLHF. While Constitutional AI does share some issues with RLHF concerning robustness, it also promises better scalability due to its reduced reliance on human supervision. The image below provides a comparison of Constitutional AI's helpfulness with that of RLHF.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":61213,"endIndex":61214,"paragraph":{"elements":[{"startIndex":61213,"endIndex":61214,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":61214,"endIndex":61324,"table":{"rows":3,"columns":2,"tableRows":[{"startIndex":61215,"endIndex":61230,"tableCells":[{"startIndex":61216,"endIndex":61222,"content":[{"startIndex":61217,"endIndex":61222,"paragraph":{"elements":[{"startIndex":61217,"endIndex":61222,"textRun":{"content":"type\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle"