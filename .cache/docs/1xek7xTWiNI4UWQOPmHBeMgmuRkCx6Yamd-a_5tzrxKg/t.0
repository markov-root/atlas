width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":54701,"endIndex":54765,"content":[{"startIndex":54702,"endIndex":54765,"paragraph":{"elements":[{"startIndex":54702,"endIndex":54751,"textRun":{"content":"Aligning language models to follow instructions (","textStyle":{}}},{"startIndex":54751,"endIndex":54763,"textRun":{"content":"OpenAI, 2022","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://openai.com/research/instruction-following"}}}},{"startIndex":54763,"endIndex":54765,"textRun":{"content":")\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":80,"unit":"PT"}}]}}},{"startIndex":54766,"endIndex":54767,"paragraph":{"elements":[{"startIndex":54766,"endIndex":54767,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}},{"startIndex":54767,"endIndex":54965,"paragraph":{"elements":[{"startIndex":54767,"endIndex":54772,"textRun":{"content":"Step ","textStyle":{"bold":true,"foregroundColor":{"color":{"rgbColor":{"red":0.05490196,"green":0.0627451,"blue":0.101960786}}}}}},{"startIndex":54772,"endIndex":54773,"textRun":{"content":"0","textStyle":{"bold":true}}},{"startIndex":54773,"endIndex":54775,"textRun":{"content":": ","textStyle":{"bold":true,"foregroundColor":{"color":{"rgbColor":{"red":0.05490196,"green":0.0627451,"blue":0.101960786}}}}}},{"startIndex":54775,"endIndex":54790,"textRun":{"content":"Semi-Supervised","textStyle":{"bold":true}}},{"startIndex":54790,"endIndex":54815,"textRun":{"content":" Generative Pre-training:","textStyle":{"bold":true,"foregroundColor":{"color":{"rgbColor":{"red":0.05490196,"green":0.0627451,"blue":0.101960786}}}}}},{"startIndex":54815,"endIndex":54964,"textRun":{"content":" The LLM is initially trained using a massive amount of internet text data, where the task is to predict the next word in a natural language context.","textStyle":{"foregroundColor":{"color":{"rgbColor":{"red":0.05490196,"green":0.0627451,"blue":0.101960786}}}}}},{"startIndex":54964,"endIndex":54965,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"},"shading":{"backgroundColor":{"color":{"rgbColor":{"red":1,"green":1,"blue":1}}}}},"bullet":{"listId":"kix.31z5r79twzht","textStyle":{}}}},{"startIndex":54965,"endIndex":55264,"paragraph":{"elements":[{"startIndex":54965,"endIndex":54970,"textRun":{"content":"Step ","textStyle":{"bold":true,"foregroundColor":{"color":{"rgbColor":{"red":0.05490196,"green":0.0627451,"blue":0.101960786}}}}}},{"startIndex":54970,"endIndex":54971,"textRun":{"content":"1","textStyle":{"bold":true}}},{"startIndex":54971,"endIndex":54973,"textRun":{"content":": ","textStyle":{"bold":true,"foregroundColor":{"color":{"rgbColor":{"red":0.05490196,"green":0.0627451,"blue":0.101960786}}}}}},{"startIndex":54973,"endIndex":54983,"textRun":{"content":"Supervised","textStyle":{"bold":true}}},{"startIndex":54983,"endIndex":54984,"textRun":{"content":" ","textStyle":{"bold":true,"foregroundColor":{"color":{"rgbColor":{"red":0.05490196,"green":0.0627451,"blue":0.101960786}}}}}},{"startIndex":54984,"endIndex":54995,"textRun":{"content":"Fine-tuning","textStyle":{"bold":true}}},{"startIndex":54995,"endIndex":54996,"textRun":{"content":":","textStyle":{"bold":true,"foregroundColor":{"color":{"rgbColor":{"red":0.05490196,"green":0.0627451,"blue":0.101960786}}}}}},{"startIndex":54996,"endIndex":55264,"textRun":{"content":" A fine-tuning dataset is created by presenting a prompt to a human and asking them to write a response. This process yields a dataset of (prompt, output) pairs. This dataset is then used to fine-tune the LLM through supervised learning, a form of behavioral cloning.\n","textStyle":{"foregroundColor":{"color":{"rgbColor":{"red":0.05490196,"green":0.0627451,"blue":0.101960786}}}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"},"shading":{"backgroundColor":{"color":{"rgbColor":{"red":1,"green":1,"blue":1}}}}},"bullet":{"listId":"kix.gaeeh6ir24g8","textStyle":{}}}},{"startIndex":55264,"endIndex":55568,"paragraph":{"elements":[{"startIndex":55264,"endIndex":55269,"textRun":{"content":"Step ","textStyle":{"bold":true,"foregroundColor":{"color":{"rgbColor":{"red":0.05490196,"green":0.0627451,"blue":0.101960786}}}}}},{"startIndex":55269,"endIndex":55270,"textRun":{"content":"2","textStyle":{"bold":true}}},{"startIndex":55270,"endIndex":55271,"textRun":{"content":":","textStyle":{"bold":true,"foregroundColor":{"color":{"rgbColor":{"red":0.05490196,"green":0.0627451,"blue":0.101960786}}}}}},{"startIndex":55271,"endIndex":55272,"textRun":{"content":" ","textStyle":{"foregroundColor":{"color":{"rgbColor":{"red":0.05490196,"green":0.0627451,"blue":0.101960786}}}}}},{"startIndex":55272,"endIndex":55280,"textRun":{"content":"Train a ","textStyle":{"bold":true,"foregroundColor":{"color":{"rgbColor":{"red":0.05490196,"green":0.0627451,"blue":0.101960786}}}}}},{"startIndex":55280,"endIndex":55294,"textRun":{"content":"Reward Model: ","textStyle":{"bold":true}}},{"startIndex":55294,"endIndex":55567,"textRun":{"content":"We train an additional reward model. We initially prompt the fine-tuned LLM and gather several output samples for the same prompt. A human then ranks these samples from best to worst. This ranking is used to train the reward model to predict what a human would rank higher.","textStyle":{}}},{"startIndex":55567,"endIndex":55568,"textRun":{"content":"\n","textStyle":{"bold":true}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"},"shading":{"backgroundColor":{"color":{"rgbColor":{"red":1,"green":1,"blue":1}}}}},"bullet":{"listId":"kix.bqqcj1pck2zt","textStyle":{}}}},{"startIndex":55568,"endIndex":55850,"paragraph":{"elements":[{"startIndex":55568,"endIndex":55576,"textRun":{"content":"Step 3: ","textStyle":{"bold":true}}},{"startIndex":55576,"endIndex":55599,"textRun":{"content":"Reinforcement learning:","textStyle":{"bold":true,"foregroundColor":{"color":{"rgbColor":{"red":0.05490196,"green":0.0627451,"blue":0.101960786}}}}}},{"startIndex":55599,"endIndex":55669,"textRun":{"content":" Once we have both a fine-tuned LLM and a reward model, we can employ ","textStyle":{"foregroundColor":{"color":{"rgbColor":{"red":0.05490196,"green":0.0627451,"blue":0.101960786}}}}}},{"startIndex":55669,"endIndex":55703,"textRun":{"content":"Proximal Policy Optimization (PPO)","textStyle":{}}},{"startIndex":55703,"endIndex":55850,"textRun":{"content":"-based reinforcement learning to encourage the fine-tuned model to maximize the reward that the reward model, which mimics human rankings, offers.\n","textStyle":{"foregroundColor":{"color":{"rgbColor":{"red":0.05490196,"green":0.0627451,"blue":0.101960786}}}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"},"shading":{"backgroundColor":{"color":{"rgbColor":{"red":1,"green":1,"blue":1}}}}},"bullet":{"listId":"kix.bqqcj1pck2zt","textStyle":{"bold":true,"underline":false}}}},{"startIndex":55850,"endIndex":55851,"paragraph":{"elements":[{"startIndex":55850,"endIndex":55851,"textRun":{"content":"\n","textStyle":{"bold":true,"underline":true}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}},{"startIndex":55851,"endIndex":55886,"paragraph":{"elements":[{"startIndex":55851,"endIndex":55886,"textRun":{"content":"Reward hacking in feedback methods\n","textStyle":{"bold":true,"underline":true}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}},{"startIndex":55886,"endIndex":55887,"paragraph":{"elements":[{"startIndex":55886,"endIndex":55887,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}},{"startIndex":55887,"endIndex":56511,"paragraph":{"elements":[{"startIndex":55887,"endIndex":56511,"textRun":{"content":"While the feedback based mechanisms do make models safer, they do not make them immune to reward hacking. The effectiveness of an algorithm heavily relies on the human evaluator's intuition about what constitutes the correct behavior. If the human lacks a thorough understanding of the task, they may not provide beneficial feedback. Further, in certain domains, our system might lead to agents developing policies that deceive the evaluators. For instance, a robot intended to grasp objects merely positioned its manipulator between the camera and the object, making it seem as if it was executing the task as shown below.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":56511,"endIndex":56512,"paragraph":{"elements":[{"startIndex":56511,"endIndex":56512,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":56512,"endIndex":56631,"table":{"rows":3,"columns":2,"tableRows":[{"startIndex":56513,"endIndex":56528,"tableCells":[{"startIndex":56514,"endIndex":56520,"content":[{"startIndex":56515,"endIndex":56520,"paragraph":{"elements":[{"startIndex":56515,"endIndex":56520,"textRun":{"content":"type\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"