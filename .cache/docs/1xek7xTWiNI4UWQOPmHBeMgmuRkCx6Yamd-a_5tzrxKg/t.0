"endIndex":3615,"paragraph":{"elements":[{"startIndex":3607,"endIndex":3615,"textRun":{"content":"caption\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":3615,"endIndex":3693,"content":[{"startIndex":3616,"endIndex":3693,"paragraph":{"elements":[{"startIndex":3616,"endIndex":3693,"textRun":{"content":"Optional video showcasing robotic hand trained using reinforcement learning.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":60,"unit":"PT"}},{"widthType":"FIXED_WIDTH","width":{"magnitude":371.25,"unit":"PT"}}]}}},{"startIndex":3694,"endIndex":3695,"paragraph":{"elements":[{"startIndex":3694,"endIndex":3695,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":3695,"endIndex":3751,"paragraph":{"elements":[{"startIndex":3695,"endIndex":3751,"textRun":{"content":"Some examples of real-world applications of RL include:\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}},{"startIndex":3751,"endIndex":3991,"paragraph":{"elements":[{"startIndex":3751,"endIndex":3766,"textRun":{"content":"Robotic systems","textStyle":{"bold":true}}},{"startIndex":3766,"endIndex":3991,"textRun":{"content":": RL has been applied to tasks such as controlling physical robots in real-time, and enabling them to learn more complicated movements. RL can enable robotic systems to learn complex tasks and adapt to changing environments.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.7jyxkyrzxhfe","textStyle":{}}}},{"startIndex":3991,"endIndex":4267,"paragraph":{"elements":[{"startIndex":3991,"endIndex":4010,"textRun":{"content":"Recommender Systems","textStyle":{"bold":true}}},{"startIndex":4010,"endIndex":4267,"textRun":{"content":": RL can be applied to recommender systems, which interact with billions of users and aim to provide personalized recommendations. RL algorithms can learn to optimize the recommendation policy based on user feedback and improve the overall user experience.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.au6s087f08e0","textStyle":{}}}},{"startIndex":4267,"endIndex":4724,"paragraph":{"elements":[{"startIndex":4267,"endIndex":4289,"textRun":{"content":"Game playing systems: ","textStyle":{"bold":true}}},{"startIndex":4289,"endIndex":4553,"textRun":{"content":"In the early 2010s RL-based systems started to beat humans at a few very simple Atari games, like Pong and Breakout. Over the years, there have been many models that have utilized RL to defeat world masters in both board and video games. These include models like ","textStyle":{}}},{"startIndex":4553,"endIndex":4560,"textRun":{"content":"AlphaGo","textStyle":{}}},{"startIndex":4560,"endIndex":4562,"textRun":{"content":" (","textStyle":{}}},{"startIndex":4562,"endIndex":4576,"textRun":{"content":"DeepMind, 2016","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.deepmind.com/research/highlighted-research/alphago"}}}},{"startIndex":4576,"endIndex":4579,"textRun":{"content":"), ","textStyle":{}}},{"startIndex":4579,"endIndex":4588,"textRun":{"content":"AlphaZero","textStyle":{}}},{"startIndex":4588,"endIndex":4590,"textRun":{"content":" (","textStyle":{}}},{"startIndex":4590,"endIndex":4604,"textRun":{"content":"DeepMind, 2018","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.deepmind.com/blog/alphazero-shedding-new-light-on-chess-shogi-and-go"}}}},{"startIndex":4604,"endIndex":4607,"textRun":{"content":"), ","textStyle":{}}},{"startIndex":4607,"endIndex":4618,"textRun":{"content":"OpenAI Five","textStyle":{}}},{"startIndex":4618,"endIndex":4620,"textRun":{"content":" (","textStyle":{}}},{"startIndex":4620,"endIndex":4632,"textRun":{"content":"OpenAI, 2019","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://openai.com/research/openai-five-defeats-dota-2-world-champions"}}}},{"startIndex":4632,"endIndex":4635,"textRun":{"content":"), ","textStyle":{}}},{"startIndex":4635,"endIndex":4644,"textRun":{"content":"AlphaStar","textStyle":{}}},{"startIndex":4644,"endIndex":4646,"textRun":{"content":" (","textStyle":{}}},{"startIndex":4646,"endIndex":4660,"textRun":{"content":"DeepMind, 2019","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.deepmind.com/blog/alphastar-mastering-the-real-time-strategy-game-starcraft-ii"}}}},{"startIndex":4660,"endIndex":4663,"textRun":{"content":"), ","textStyle":{}}},{"startIndex":4663,"endIndex":4669,"textRun":{"content":"MuZero","textStyle":{}}},{"startIndex":4669,"endIndex":4671,"textRun":{"content":" (","textStyle":{}}},{"startIndex":4671,"endIndex":4685,"textRun":{"content":"DeepMind, 2020","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.deepmind.com/blog/muzero-mastering-go-chess-shogi-and-atari-without-rules"}}}},{"startIndex":4685,"endIndex":4691,"textRun":{"content":") and ","textStyle":{}}},{"startIndex":4691,"endIndex":4704,"textRun":{"content":"EfficientZero","textStyle":{}}},{"startIndex":4704,"endIndex":4706,"textRun":{"content":" (","textStyle":{}}},{"startIndex":4706,"endIndex":4721,"textRun":{"content":"Ye et al., 2021","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2111.00210"}}}},{"startIndex":4721,"endIndex":4724,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.mzvnkgodr4i4","textStyle":{}}}},{"startIndex":4724,"endIndex":4725,"paragraph":{"elements":[{"startIndex":4724,"endIndex":4725,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}},{"startIndex":4725,"endIndex":5304,"paragraph":{"elements":[{"startIndex":4725,"endIndex":5303,"textRun":{"content":"RL is different from supervised learning as it begins with a high-level description of \"what\" to do but allows the agent to experiment and learn from experience the best \"how\". In RL, the agent learns through interaction with an environment and receives feedback in the form of rewards or punishments based on its actions. RL is focused on learning a set of rules that recommend the best action to take in a given state to maximize long-term rewards. In contrast, supervised learning typically involves learning from explicitly provided labels or correct answers for each input.","textStyle":{}}},{"startIndex":5303,"endIndex":5304,"textRun":{"content":"\n","textStyle":{"italic":true}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}},{"startIndex":5304,"endIndex":5305,"paragraph":{"elements":[{"startIndex":5304,"endIndex":5305,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}},{"startIndex":5305,"endIndex":5315,"paragraph":{"elements":[{"startIndex":5305,"endIndex":5315,"textRun":{"content":"Core Loop\n","textStyle":{}}}],"paragraphStyle":{"headingId":"h.9c90l7ez6bxd","namedStyleType":"HEADING_2","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}},{"startIndex":5315,"endIndex":5316,"paragraph":{"elements":[{"startIndex":5315,"endIndex":5316,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}},{"startIndex":5316,"endIndex":5509,"paragraph":{"elements":[{"startIndex":5316,"endIndex":5504,"textRun":{"content":"The overall functioning of RL is relatively straightforward. The two main components are the agent itself, and the environment within which the agent lives and operates. At each time step ","textStyle":{}}},{"startIndex":5504,"endIndex":5507,"equation":{}},{"startIndex":5507,"endIndex":5509,"textRun":{"content":":\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}},{"startIndex":5509,"endIndex":5510,"paragraph":{"elements":[{"startIndex":5509,"endIndex":5510,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}},{"startIndex":5510,"endIndex":5549,"paragraph":{"elements":[{"startIndex":5510,"endIndex":5549,"textRun":{"content":"The agent then takes some action $a_t$\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.q7uz6jwl6irz","textStyle":{}}}},{"startIndex":5549,"endIndex":5618,"paragraph":{"elements":[{"startIndex":5549,"endIndex":5618,"textRun":{"content":"The environment state $s_t$ changes depending upon the action $a_t$.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.q7uz6jwl6irz","textStyle":{"underline":false}}}},{"startIndex":5618,"endIndex":5688,"paragraph":{"elements":[{"startIndex":5618,"endIndex":5688,"textRun":{"content":"The environment then outputs an observation $o_t$ and a reward $r_t$.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.q7uz6jwl6irz","textStyle":{"underline":false}}}},{"startIndex":5688,"endIndex":5689,"paragraph":{"elements":[{"startIndex":5688,"endIndex":5689,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}},{"startIndex":5689,"endIndex":6148,"paragraph":{"elements":[{"startIndex":5689,"endIndex":6148,"textRun":{"content":"A history is the sequence of past observations, actions and rewards that have been taken up until time $t: h_t = (a_1, o_1, r_1, ..., a_t, o_t, r_t)$. The state of the world is generally some function of the history: $s_t = f(h_t)$. The World State is the full true state of the world used to determine how the world generates the next observation and reward. The agent might either get the entire world state as an observation $o_t$, or some partial subset.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}},{"startIndex":6148,"endIndex":6149,"paragraph":{"elements":[{"startIndex":6148,"endIndex":6149,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}},{"startIndex":6149,"endIndex":6338,"paragraph":{"elements":[{"startIndex":6149,"endIndex":6338,"textRun":{"content":"The world goes from one state $s_t$ to the next $s_(t+1)$ either based on natural environmental dynamics, or the agent's actions. State transitions can be both deterministic or stochastic.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}},{"startIndex":6338,"endIndex":6339,"paragraph":{"elements":[{"startIndex":6338,"endIndex":6339,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":6339,"endIndex":6486,"paragraph":{"elements":[{"startIndex":6339,"endIndex":6486,"textRun":{"content":"This loop continues until a terminal condition is reached or can run indefinitely. Following is a diagram that succinctly captures the RL process:\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":6486,"endIndex":6487,"paragraph":{"elements":[{"startIndex":6486,"endIndex":6487,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}