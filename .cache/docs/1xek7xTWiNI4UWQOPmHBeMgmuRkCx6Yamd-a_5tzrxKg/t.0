:{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":61568,"endIndex":61798,"tableCells":[{"startIndex":61569,"endIndex":61578,"content":[{"startIndex":61570,"endIndex":61578,"paragraph":{"elements":[{"startIndex":61570,"endIndex":61578,"textRun":{"content":"caption\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":61578,"endIndex":61798,"content":[{"startIndex":61579,"endIndex":61798,"paragraph":{"elements":[{"startIndex":61579,"endIndex":61798,"textRun":{"content":"An overview of various types of challenges with RLHF. Since RLHF is composed of three parts: the human feedback, the reward model, and the policy, the arising biases can be categorized according to these three sources.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":80,"unit":"PT"}}]}}},{"startIndex":61799,"endIndex":61800,"paragraph":{"elements":[{"startIndex":61799,"endIndex":61800,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":61800,"endIndex":61909,"paragraph":{"elements":[{"startIndex":61800,"endIndex":61909,"textRun":{"content":"This section outlines some of these challenges, emphasizing the need for advanced techniques and strategies.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":61909,"endIndex":61910,"paragraph":{"elements":[{"startIndex":61909,"endIndex":61910,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":61910,"endIndex":61937,"paragraph":{"elements":[{"startIndex":61910,"endIndex":61937,"textRun":{"content":"Limits with Human Feedback\n","textStyle":{"bold":true}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":61937,"endIndex":61938,"paragraph":{"elements":[{"startIndex":61937,"endIndex":61938,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":61938,"endIndex":62297,"paragraph":{"elements":[{"startIndex":61938,"endIndex":61959,"textRun":{"content":"Misaligned Evaluators","textStyle":{"bold":true}}},{"startIndex":61959,"endIndex":62297,"textRun":{"content":": Firstly, the annotators might themselves be misaligned, malicious, or biased distribution of evaluators (i.e. not representative of the distribution of future users in the real world). Malicious individuals can poison the model during training via backdoor attacks that can be added to the model if no countermeasures are put in place.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":62297,"endIndex":62298,"paragraph":{"elements":[{"startIndex":62297,"endIndex":62298,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":62298,"endIndex":62810,"paragraph":{"elements":[{"startIndex":62298,"endIndex":62321,"textRun":{"content":"Difficulty of Oversight","textStyle":{"bold":true}}},{"startIndex":62321,"endIndex":62810,"textRun":{"content":": Humans struggle to evaluate model performance on complex tasks and can be easily misled by model outputs. Human evaluators can be manipulated to return a positive reward even if the true value should be negative. For instance, the more convincing a bot seems, the more reward it may receive even if its answers are false (and this might be a reason why ChatGPT answers might be so long by default). Techniques to mitigate these issues are discussed in the \"Scalable Oversight\" chapters.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":62810,"endIndex":62811,"paragraph":{"elements":[{"startIndex":62810,"endIndex":62811,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":62811,"endIndex":63019,"paragraph":{"elements":[{"startIndex":62811,"endIndex":62835,"textRun":{"content":"Feedback type limitation","textStyle":{"bold":true}}},{"startIndex":62835,"endIndex":63019,"textRun":{"content":": Even if the annotators were in perfect capability of expressing their preferences, the training procedure might not enable them to express the full extent of their desires, because:\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":63019,"endIndex":63020,"paragraph":{"elements":[{"startIndex":63019,"endIndex":63020,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":63020,"endIndex":63162,"paragraph":{"elements":[{"startIndex":63020,"endIndex":63162,"textRun":{"content":"The examples they are given may not be representative of the complete set of situations in which the model will find itself after deployment.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.ok9h0o5hgb2p","textStyle":{"underline":false}}}},{"startIndex":63162,"endIndex":63338,"paragraph":{"elements":[{"startIndex":63162,"endIndex":63312,"textRun":{"content":"The options for the feedback are limited (comparing two examples, or using a grading system, can yield very different results, as shown in the paper (","textStyle":{}}},{"startIndex":63312,"endIndex":63335,"textRun":{"content":"Ethayarajh et al., 2022","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2205.11930"}}}},{"startIndex":63335,"endIndex":63338,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.ok9h0o5hgb2p","textStyle":{"underline":false}}}},{"startIndex":63338,"endIndex":63339,"paragraph":{"elements":[{"startIndex":63338,"endIndex":63339,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":63339,"endIndex":63637,"paragraph":{"elements":[{"startIndex":63339,"endIndex":63369,"textRun":{"content":"Limits with the Reward Model. ","textStyle":{"bold":true}}},{"startIndex":63369,"endIndex":63637,"textRun":{"content":"Let’s assume the feedback process to be frictionless. Perfect annotators, perfect evaluations. In that scenario, would the reward model be able to accurately translate their feedback in order to shape the policy accordingly ? It turns out it is not such an easy task.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":63637,"endIndex":64091,"paragraph":{"elements":[{"startIndex":63637,"endIndex":63917,"textRun":{"content":"Problem misspecification: (or the Reward Function/Values Mismatch) Accurately reflecting diverse human values in a reward function is complex. Indeed, human preferences are complex by nature: they depend on context and personality, but also fluctuate in time and can sometimes be ","textStyle":{}}},{"startIndex":63917,"endIndex":63927,"textRun":{"content":"irrational","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.mdpi.com/2624-960X/3/1/14"}}}},{"startIndex":63927,"endIndex":64091,"textRun":{"content":". Expecting the reward model to converge to a single function which maps perfectly all human preferences is delusional. This is again the misspecification problem.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.apgt8zgtu9kc","textStyle":{}}}},{"startIndex":64091,"endIndex":64567,"paragraph":{"elements":[{"startIndex":64091,"endIndex":64567,"textRun":{"content":"Misgeneralization hacking (Imperfect Reward Proxy): Since the model is given a finite number of examples and since there is an infinite number of ways to fit this data, the model’s behavior on new examples is always an extrapolation, and there is no theoretical guarantee that it will never deviate from what is expected. There may be terrible answers (such as gibberish phrases for language models) which yield a positive reward unexpectedly. This is called reward hacking. \n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.apgt8zgtu9kc","textStyle":{}}}},{"startIndex":64567,"endIndex":65018,"paragraph":{"elements":[{"startIndex":64567,"endIndex":65018,"textRun":{"content":"Joint Reward Model and policy training: On a more technical aspect, the stability and convergence of the training scheme are not always ensured. Since we are optimizing the policy on a reward that is being optimized at the same time, uncertainties and undesirable dependencies can arise which impact the robustness of the model. These issues are not specific to RLHF but must be solved if we expect deployed models to be fully aligned with our needs.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.apgt8zgtu9kc","textStyle":{}}}},{"startIndex":65018,"endIndex":65019,"paragraph":{"elements":[{"startIndex":65018,"endIndex":65019,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":65019,"endIndex":65197,"paragraph":{"elements":[{"startIndex":65019,"endIndex":65042,"textRun":{"content":"Limits with the Policy.","textStyle":{"bold":true}}},{"startIndex":65042,"endIndex":65043,"textRun":{"content":" ","textStyle":{}}},{"startIndex":65043,"endIndex":65197,"textRun":{"content":"Let’s assume the feedback and the reward model accurately represent human preferences. The next difficulty is ensuring the policy is correctly optimized.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":65197,"endIndex":66077,"paragraph":{"elements":[{"startIndex":65197,"endIndex":66063,"textRun":{"content":"RL difficulties: RL is hard. This can lead to reward hacking and biases, such as mode collapse, where the model shows a drastic bias towards specific patterns. Mode collapse is a known issue in RL: an output which always returns a positive reward will drive the model to return the same answer and new paths will not be explored. Consequently, the reward model will not see new samples to learn from. Anyhow, the joint training of the reward model and the policy induces a bias in the learning phase since both depend on each other. There can also be an initial bias in the base model used for the training. For instance, chatGPT was fine-tuned from an initial GPT base trained in part on the web. Even though RLHF was used to remove any controversial statements from the model, there still remains a risk for the model to output problematic content it saw online. (","textStyle":{}}},{"startIndex":66063,"endIndex":66075,"textRun":{"content":"OpenAI, 2022","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://openai.com/index/chatgpt/"}}}},{"startIndex":66075,"endIndex":66077,"textRun":{"content":")\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.vvx6jjhx70s8","textStyle":{}}}},{"startIndex":66077,"endIndex":66357,"paragraph":{"elements":[{"startIndex":66077,"endIndex":66357,"textRun":{"content":"Policy Misgeneralization: Effective policies during training might fail to generalize well in real-world scenarios. For instance, phenomena like \"Jailbreak\" show that models like BingChat and ChatGPT can perform learned actions, even if trained not to respond to certain queries.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.vvx6jjhx70s8","textStyle":{}}}},{"startIndex":66357,"endIndex":66726,"paragraph":{"elements":[{"startIndex":66357,"endIndex":66726,"textRun":{"content":"Distributional Challenge: Larger RLHF models tend to develop harmful self-preservation tendencies and sycophancy, which is the insincere agreement with user opinions. This behavior indicates a trend towards instrumental convergence. Additionally, RLHF can incentivize deceptive behaviors, as illustrated by the robotic hand experiment in Christiano et al's 2017 study.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.vvx6jjhx70s8","textStyle":{}}}},{"startIndex":66726,"endIndex":66727,"paragraph":{"elements":[{"startIndex":66726,"endIndex":66727,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":66727,"endIndex":66778,"paragraph":{"elements":[{"startIndex":66727,"endIndex":66778,"textRun":{"content":"Those theoretical problems have real consequences:\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":66778,"endIndex":66779,"paragraph":{"elements":[{"startIndex":66778,"endIndex":66779,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":66779,"endIndex":67008,"paragraph":{"elements":[{"startIndex":66779,"endIndex":66848,"textRun":{"content":"RLHF has not succeeded in making LLMs robustly helpful and harmless. ","textStyle":{"bold":true}}},{"startIndex":66848,"endIndex":67008,"textRun":{"content":"Despite the continuous advancements in natural language processing and the development of RLHF, LLMs have not yet achieved robust helpfulness and harmlessness.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":67008,"endIndex":67009,"paragraph":{"elements":[{"startIndex":67008,"endIndex":67009,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":67009,"endIndex":67327,"paragraph":{"elements":[{"startIndex":67009,"endIndex":67134,"textRun":{"content":"Hallucinations remain a significant issue, as illustrated by GPT-4's tendency to generate nonsensical or untruthful content (","textStyle":{}}},{"startIndex":67134,"endIndex":67146,"textRun":{"content":"OpenAI, 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://cdn.openai.com/papers/gpt-4-system-card.pdf"}}}},{"startIndex":67146,"endIndex":67309,"textRun":{"content":"). These hallucinations can lead to overreliance on LLMs, consequently degrading system performance and failing to meet user expectations in real-world scenarios (","textStyle":{}}},{"startIndex":67309,"endIndex":67324,"textRun":{"content":"Ji et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2202.03629"}}}},{"startIndex":67324,"endIndex":67327,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":67327,"endIndex":67328,"paragraph":{"elements":[{"startIndex":67327,"endIndex":67328,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":67328,"endIndex":67744,"paragraph":{"elements":[{"startIndex":67328,"endIndex":67552,"textRun":{"content":"Additionally, biases within LLMs persist, often reflecting misaligned opinions between the LLM and various demographic groups in the United States, as seen with the left-leaning tendencies of some human feedback-tuned LLMs (","textStyle":{}}},{"startIndex":67552,"endIndex":67574,"textRun":{"content":"Santurkar et al., 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2303.17548"}}}},{"startIndex":67574,"endIndex":67724,"textRun":{"content":"). These biases can be harmful, producing discriminatory language and perpetuating negative stereotypes, as demonstrated by GPT-3's anti-Muslim bias (","textStyle":{}}},{"startIndex":67724,"endIndex":67741,"textRun":{"content":"Abid et al., 2021","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2101.05783"}}}},{"startIndex":67741,"endIndex":67744,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":67744,"endIndex":67745,"paragraph":{"elements":[{"startIndex":67744,"endIndex":67745,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":67745,"endIndex":68918,"paragraph":{"elements":[{"startIndex":67745,"endIndex":67908,"textRun":{"content":"Moreover, jailbreaking of chatbots poses a significant risk, with websites listing prompts to bypass safety measures like Chat GPT \"DAN\" (and other \"Jailbreaks\") (","textStyle":{}}},{"startIndex":67908,"endIndex":67922,"textRun":{"content":"Takemoto, 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2401.09798"}}}},{"startIndex":67922,"endIndex":68005,"textRun":{"content":"). Privacy threats from application-integrated LLMs are now more severe than ever (","textStyle":{}}},{"startIndex":68005,"endIndex":68020,"textRun":{"content":"Li et al., 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2304.05197"}}}},{"startIndex":68020,"endIndex":68146,"textRun":{"content":"). For instance, Italy banned ChatGPT due to privacy considerations under the EU’s General Data Protection Regulation (GDPR) (","textStyle":{}}},{"startIndex":68146,"endIndex":68155,"textRun":{"content":"BBC, 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.bbc.com/news/technology-65139406"}}}},{"startIndex":68155,"endIndex":68918,"textRun":{"content":"). The ability to find jailbreaks is supported by a recent paper titled \"Fundamental Limitations of Alignment in Large Language Models.\" The paper presents early theoretical results that indicate any alignment process, such as RLHF, which reduces undesired behavior without eliminating it completely, cannot be safe against adversarial prompting. The authors find that by prompting the model to behave as a specific persona, behaviors that are generally very unlikely to be exhibited by the model can be brought to the forefront. This is not a complete demonstration as their framework is based on the notion of personas, but it strongly suggests that naive pretraining without dataset curation followed by RLHF may not be sufficient against adversarial attacks.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":68918,"endIndex":68919,"paragraph":{"elements":[{"startIndex":68918,"endIndex":68919,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":68919,"endIndex":69702,"paragraph":{"elements":[{"startIndex":68919,"endIndex":69254,"textRun":{"content":"The security of sensitive private information in large language models (LLMs) is a pressing concern, especially when user-generated data, such as emails and smart keyboard inputs, are utilized for training. In fact, several recent papers have demonstrated that foundation models can be easily queried to retrieve personal information (","textStyle":{}}},{"startIndex":69254,"endIndex":69273,"textRun":{"content":"Carlini et al, 2020","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2012.07805"}}}},{"startIndex":69273,"endIndex":69275,"textRun":{"content":"; ","textStyle":{}}},{"startIndex":69275,"endIndex":69292,"textRun":{"content":"Inan et al., 2021","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2101.05405"}}}},{"startIndex":69292,"endIndex":69294,"textRun":{"content":"; ","textStyle":{}}},{"startIndex":69294,"endIndex":69310,"textRun":{"content":"Pan et al., 2020","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://ieeexplore.ieee.org/document/9152761"}}}},{"startIndex":69310,"endIndex":69487,"textRun":{"content":") and those problems are still present in “aligned” models such as GPT4, which has the potential to be used to attempt to identify individuals when augmented with outside data (","textStyle":{}}},{"startIndex":69487,"endIndex":69499,"textRun":{"content":"OpenAI, 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://cdn.openai.com/papers/gpt-4-system-card.pdf"}}}},{"startIndex":69499,"endIndex":69517,"textRun":{"content":"). As exposed by (","textStyle":{}}},{"startIndex":69517,"endIndex":69539,"textRun":{"content":"El-Mhamdi et al., 2021","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2101.05405"}}}},{"startIndex":69539,"endIndex":69702,"textRun":{"content":"), LLM may exhibit a fundamental incompatibility of high accuracy with both security and privacy, given the current understanding in adversarial machine learning.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":69702,"endIndex":69757,"paragraph":{"elements":[{"startIndex":69702,"endIndex":69757,"textRun":{"content":"RLHF may be able to make worst-case performance worse.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":69757,"endIndex":69758,"paragraph":{"elements":[{"startIndex":69757,"endIndex":69758,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":69758,"endIndex":70336,"paragraph":{"elements":[{"startIndex":69758,"endIndex":69815,"textRun":{"content":"RLHF may decrease the robustness to adversarial attacks (","textStyle":{}}},{"startIndex":69815,"endIndex":69832,"textRun":{"content":"Wolf et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2304.11082"}}}},{"startIndex":69832,"endIndex":70050,"textRun":{"content":"), by sharpening the distinction between desired and undesired behaviors, potentially making LLMs more susceptible to adversarial prompting. The increased distinction between behaviors is linked to the Waluigi Effect (","textStyle":{}}},{"startIndex":70050,"endIndex":70061,"textRun":{"content":"Nardo, 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.alignmentforum.org/posts/D7PumeYTDPfBTp3i7/the-waluigi-effect-mega-post"}}}},{"startIndex":70061,"endIndex":70336,"textRun":{"content":"), where after training an LLM to satisfy a desirable property P, it becomes easier to elicit the chatbot into satisfying the exact opposite of property P. Theoretical arguments such as this one seem to push for the ineffectiveness of RLHF in eliminating deceptive personas.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":70336,"endIndex":70337,"paragraph":{"elements":[{"startIndex":70336,"endIndex":70337,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":70337,"endIndex":71064,"paragraph":{"elements":[{"startIndex":70337,"endIndex":70621,"textRun":{"content":"Some of those problems may get worse as systems become more capable. RLHF has been found to increase the autonomy of LLMs without decreasing undesirable metrics such as convergent instrumental goal following (e.g., actively expressing a preference not to be shut down) or sycophancy (","textStyle":{}}},{"startIndex":70621,"endIndex":70639,"textRun":{"content":"Perez et al., 2022","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2212.09251"}}}},{"startIndex":70639,"endIndex":70993,"textRun":{"content":"). Those undesirable metrics increase with the number of RLHF steps, indicating that current models are becoming more agentic in potentially concerning ways as they scale. More generally RL from human-derived reward signals may increase drive for longer-horizon planning, deception, and agentic behavior, which are prerequisites for deceptive alignment (","textStyle":{}}},{"startIndex":70993,"endIndex":71014,"textRun":{"content":"Hubinger et al., 2019","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/1906.01820"}}}},{"startIndex":71014,"endIndex":71064,"textRun":{"content":"), and ultimately risks of large scale accidents.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":71064,"endIndex":71065,"paragraph":{"elements":[{"startIndex":71064,"endIndex":71065,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":71065,"endIndex":71492,"paragraph":{"elements":[{"startIndex":71065,"endIndex":71104,"textRun":{"content":"Conclusion on the Limitations of RLHF. ","textStyle":{"bold":true}}},{"startIndex":71104,"endIndex":71492,"textRun":{"content":"Despite requiring extensive human feedback, RLHF still faces numerous failures, and resolving these issues may require significantly more effort. As AI systems evolve, the demand for complex data grows, potentially making data acquisition prohibitively expensive. Additionally, as we push computational boundaries, the availability of qualified annotators could become a limiting factor.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":71492,"endIndex":71493,"paragraph":{"elements":[{"startIndex":71492,"endIndex":71493,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":71493,"endIndex":71864,"paragraph":{"elements":[{"startIndex":71493,"endIndex":71839,"textRun":{"content":"Overall, just because the model is instruction tuned does not mean that the training process is safe, and RLHF needs to be incorporated into a broader technical safety framework (for example, Responsible Scaling Policies or the Preparedness Framework are partial attempts to be such frameworks, or the paper \"Model evaluation for extreme risks\" (","textStyle":{}}},{"startIndex":71839,"endIndex":71860,"textRun":{"content":"Shevlane et al., 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2305.15324"}}}},{"startIndex":71860,"endIndex":71864,"textRun":{"content":")).\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":71864,"endIndex":71865,"paragraph":{"elements":[{"startIndex":71864,"endIndex":71865,"textRun":{"content":"\n","textStyle":{"fontSize":{"magnitude":11,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Merriweather","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":115,"direction":"LEFT_TO_RIGHT","shading":{"backgroundColor":{}}}}},{"startIndex":71865,"endIndex":73378,"table":{"rows":4,"columns":2,"tableRows":[{"startIndex":71866,"endIndex":71882,"tableCells":[{"startIndex":71867,"endIndex":71873,"content":[{"startIndex":71868,"endIndex":71873,"paragraph":{"elements":[{"startIndex":71868,"endIndex":71873,"textRun":{"content":"type\n","textStyle":{"fontSize":{"magnitude":11,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Merriweather","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":71873,"endIndex":71882,"content":[{"startIndex":71874,"endIndex":71882,"paragraph":{"elements":[{"startIndex":71874,"endIndex":71882,"textRun":{"content":"noteBox\n","textStyle":{"fontSize":{"magnitude":11,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Merriweather","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":71882,"endIndex":71923,"tableCells":[{"startIndex":71883,"endIndex":71890,"content":[{"startIndex":71884,"endIndex":71890,"paragraph":{"elements":[{"startIndex":71884,"endIndex":71890,"textRun":{"content":"title\n","textStyle":{"fontSize":{"magnitude":11,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Merriweather","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":71890,"endIndex":71923,"content":[{"startIndex":71891,"endIndex":71923,"paragraph":{"elements":[{"startIndex":71891,"endIndex":71922,"textRun":{"content":"Instruction tuning vs alignment","textStyle":{}}},{"startIndex":71922,"endIndex":71923,"textRun":{"content":"\n","textStyle":{"fontSize":{"magnitude":11,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Merriweather","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":71923,"endIndex":71941,"tableCells":[{"startIndex":71924,"endIndex":71935,"content":[{"startIndex":71925,"endIndex":71935,"paragraph":{"elements":[{"startIndex":71925,"endIndex":71935,"textRun":{"content":"collapsed\n","textStyle":{"fontSize":{"magnitude":11,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Merriweather","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":71935,"endIndex":71941,"content":[{"startIndex":71936,"endIndex":71941,"paragraph":{"elements":[{"startIndex":71936,"endIndex":71941,"textRun":{"content":"True\n","textStyle":{"fontSize":{"magnitude":11,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Merriweather","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":71941,"endIndex":73377,"tableCells":[{"startIndex":71942,"endIndex":71951,"content":[{"startIndex":71943,"endIndex":71951,"paragraph":{"elements":[{"startIndex":71943,"endIndex":71951,"textRun":{"content":"content\n","textStyle":{"fontSize":{"magnitude":11,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Merriweather","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":71951,"endIndex":73377,"content":[{"startIndex":71952,"endIndex":72421,"paragraph":{"elements":[{"startIndex":71952,"endIndex":72421,"textRun":{"content":"Instruction Tuning is a process where the model is fine-tuned (via RL or supervised learning) to better understand and follow human instructions. This involves training the model on a dataset that contains a variety of instructions and their desired outcomes. The primary goal of Instruction Tuning is to enhance the AI's ability to interpret and execute commands as intended by users. This improves user experience and broadens the model's applicability. For example:\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":72421,"endIndex":72422,"paragraph":{"elements":[{"startIndex":72421,"endIndex":72422,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":72422,"endIndex":72495,"table":{"rows":3,"columns":2,"tableRows":[{"startIndex":72423,"endIndex":72438,"tableCells":[{"startIndex":72424,"endIndex":72430,"content":[{"startIndex":72425,"endIndex":72430,"paragraph":{"elements":[{"startIndex":72425,"endIndex":72430,"textRun":{"content":"type\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":72430,"endIndex":72438,"content":[{"startIndex":72431,"endIndex":72438,"paragraph":{"elements":[{"startIndex":72431,"endIndex":72438,"textRun":{"content":"figure\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":72438,"endIndex":72452,"tableCells":[{"startIndex":72439,"endIndex":72448,"content":[{"startIndex":72440,"endIndex":72448,"paragraph":{"elements":[{"startIndex":72440,"endIndex":72448,"textRun":{"content":"content\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":72448,"endIndex":72452,"content":[{"startIndex":72449,"endIndex":72450,"paragraph":{"elements":[{"startIndex":72449,"endIndex":72450,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false}}},{"startIndex":72450,"endIndex":72452,"paragraph":{"elements":[{"startIndex":72450,"endIndex":72451,"inlineObjectElement":{"inlineObjectId":"kix.3xaab3i11nfp","textStyle":{}}},{"startIndex":72451,"endIndex":72452,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":72452,"endIndex":72494,"tableCells":[{"startIndex":72453,"endIndex":72462,"content":[{"startIndex":72454,"endIndex":72462,"paragraph":{"elements":[{"startIndex":72454,"endIndex":72462,"textRun":{"content":"caption\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":72462,"endIndex":72494,"content":[{"startIndex":72463,"endIndex":72494,"paragraph":{"elements":[{"startIndex":72463,"endIndex":72494,"textRun":{"content":"Example of instruction tuning.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":80,"unit":"PT"}}]}}},{"startIndex":72495,"endIndex":72496,"paragraph":{"elements":[{"startIndex":72495,"endIndex":72496,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":72496,"endIndex":72965,"paragraph":{"elements":[{"startIndex":72496,"endIndex":72965,"textRun":{"content":"Alignment in AI refers to the process of ensuring that an AI's actions and decisions are congruent with human values and ethics. It involves aligning the AI's goals and behaviors with what is beneficial or acceptable to humans.  Instruction tuning is a technique for pursuing a very superficial case of 'outer alignment,' but it’s not clear that instruction tuning helps for inner alignment, which is what real AI safety researchers are more centrally concerned about.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":72965,"endIndex":72966,"paragraph":{"elements":[{"startIndex":72965,"endIndex":72966,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":72966,"endIndex":73377,"paragraph":{"elements":[{"startIndex":72966,"endIndex":73376,"textRun":{"content":"To sum up, just because a model has undergone an instruction tuning technique like the RLHF process, it doesn't necessarily mean that the model is aligned. The term \"aligned model\" is often used, but it is advisable to adopt the more accurate terminology \"Instruction-tuned,\" rather than \"aligned model,\" to avoid confusion and more accurately represent the specific training process the model has experienced.","textStyle":{}}},{"startIndex":73376,"endIndex":73377,"textRun":{"content":"\n","textStyle":{"fontSize":{"magnitude":11,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Merriweather","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":60,"unit":"PT"}}]}}},{"startIndex":73378,"endIndex":73379,"paragraph":{"elements":[{"startIndex":73378,"endIndex":73379,"textRun":{"content":"\n","textStyle":{"fontSize":{"magnitude":11,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Merriweather","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spaceAbove":{"magnitude":12,"unit":"PT"},"spaceBelow":{"magnitude":12,"unit":"PT"},"shading":{"backgroundColor":{}}}}},{"startIndex":73379,"endIndex":73445,"table":{"rows":3,"columns":2,"tableRows":[{"startIndex":73380,"endIndex":73395,"tableCells":[{"startIndex":73381,"endIndex":73387,"content":[{"startIndex":73382,"endIndex":73387,"paragraph":{"elements":[{"startIndex":73382,"endIndex":73387,"textRun":{"content":"type\n","textStyle":{"fontSize":{"magnitude":11,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Merriweather","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":73387,"endIndex":73395,"content":[{"startIndex":73388,"endIndex":73395,"paragraph":{"elements":[{"startIndex":73388,"endIndex":73395,"textRun":{"content":"figure\n","textStyle":{"fontSize":{"magnitude":11,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Merriweather","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":73395,"endIndex":73409,"tableCells":[{"startIndex":73396,"endIndex":73405,"content":[{"startIndex":73397,"endIndex":73405,"paragraph":{"elements":[{"startIndex":73397,"endIndex":73405,"textRun":{"content":"content\n","textStyle":{"fontSize":{"magnitude":11,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Merriweather","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":73405,"endIndex":73409,"content":[{"startIndex":73406,"endIndex":73407,"paragraph":{"elements":[{"startIndex":73406,"endIndex":73407,"textRun":{"content":"\n","textStyle":{"fontSize":{"magnitude":11,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Merriweather","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false}}},{"startIndex":73407,"endIndex":73409,"paragraph":{"elements":[{"startIndex":73407,"endIndex":73408,"inlineObjectElement":{"inlineObjectId":"kix.nqxip1qnrp62","textStyle":{}}},{"startIndex":73408,"endIndex":73409,"textRun":{"content":"\n","textStyle":{"fontSize":{"magnitude":11,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Merriweather","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":73409,"endIndex":73444,"tableCells":[{"startIndex":73410,"endIndex":73419,"content":[{"startIndex":73411,"endIndex":73419,"paragraph":{"elements":[{"startIndex":73411,"endIndex":73419,"textRun":{"content":"caption\n","textStyle":{"fontSize":{"magnitude":11,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Merriweather","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":73419,"endIndex":73444,"content":[{"startIndex":73420,"endIndex":73444,"paragraph":{"elements":[{"startIndex":73420,"endIndex":73421,"textRun":{"content":"(","textStyle":{}}},{"startIndex":73421,"endIndex":73442,"textRun":{"content":"Rafailov et al., 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2305.18290"}}}},{"startIndex":73442,"endIndex":73444,"textRun":{"content":")\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":80,"unit":"PT"}}]}}},{"startIndex":73445,"endIndex":73446,"paragraph":{"elements":[{"startIndex":73445,"endIndex":73446,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":73446,"endIndex":74127,"paragraph":{"elements":[{"startIndex":73446,"endIndex":73482,"textRun":{"content":"Direct Preference Optimization (DPO)","textStyle":{"bold":true}}},{"startIndex":73482,"endIndex":74127,"textRun":{"content":": Reinforcement Learning from Human Feedback (RLHF) has demonstrated effectiveness, as showcased by ChatGPT and Llama 2, but it's a complex and sensitive process, and also has some bad alignment properties. RLHF involves a three-step procedure, whereas DPO simplifies this to two steps. The paper titled \"Direct Preference Optimization: Your Language Model is Secretly a Reward Model\" presents an algorithm that aligns language models with human preferences without the need for explicit reward modeling and reinforcement learning. DPO employs a straightforward classification objective, circumventing the need for an intermediary reward model.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":74127,"endIndex":74128,"paragraph":{"elements":[{"startIndex":74127,"endIndex":74128,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":74128,"endIndex":74205,"paragraph":{"elements":[{"startIndex":74128,"endIndex":74205,"textRun":{"content":"RLHF, the method it proposes to replace, traditionally involves three steps:\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":74205,"endIndex":74336,"paragraph":{"elements":[{"startIndex":74205,"endIndex":74227,"textRun":{"content":"Supervised fine-tuning","textStyle":{"bold":true}}},{"startIndex":74227,"endIndex":74336,"textRun":{"content":": Initially, the model is trained on a dataset comprising prompts and their corresponding desired responses.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.bvepnev20ve9","textStyle":{"underline":false}}}},{"startIndex":74336,"endIndex":74500,"paragraph":{"elements":[{"startIndex":74336,"endIndex":74351,"textRun":{"content":"Reward modeling","textStyle":{"bold":true}}},{"startIndex":74351,"endIndex":74500,"textRun":{"content":": Human evaluators assess the model's outputs, and this feedback informs a reward model, which is trained to discern the preferred types of outputs.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.bvepnev20ve9","textStyle":{"underline":false}}}},{"startIndex":74500,"endIndex":74683,"paragraph":{"elements":[{"startIndex":74500,"endIndex":74534,"textRun":{"content":"Proximal policy optimization (PPO)","textStyle":{"bold":true}}},{"startIndex":74534,"endIndex":74683,"textRun":{"content":": The model generates outputs, which are evaluated by the reward model, and the PPO algorithm adjusts the model's policy based on these evaluations.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.bvepnev20ve9","textStyle":{"underline":false}}}},{"startIndex":74683,"endIndex":74684,"paragraph":{"elements":[{"startIndex":74683,"endIndex":74684,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":74684,"endIndex":74987,"paragraph":{"elements":[{"startIndex":74684,"endIndex":74987,"textRun":{"content":"DPO retains the initial supervised fine-tuning step but replaces the subsequent two steps with a single step of fine-tuning on preference data, by using a new clever loss. DPO effectively increases the likelihood of preferred actions while reducing the likelihood of undesired ones, with a single loss:\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":74987,"endIndex":74988,"paragraph":{"elements":[{"startIndex":74987,"endIndex":74988,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":74988,"endIndex":75157,"table":{"rows":3,"columns":2,"tableRows":[{"startIndex":74989,"endIndex":75004,"tableCells":[{"startIndex":74990,"endIndex":74996,"content":[{"startIndex":74991,"endIndex":74996,"paragraph":{"elements":[{"startIndex":74991,"endIndex":74996,"textRun":{"content":"type\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":74996,"endIndex":75004,"content":[{"startIndex":74997,"endIndex":75004,"paragraph":{"elements":[{"startIndex":74997,"endIndex":75004,"textRun":{"content":"figure\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":75004,"endIndex":75018,"tableCells":[{"startIndex":75005,"endIndex":75014,"content":[{"startIndex":75006,"endIndex":75014,"paragraph":{"elements":[{"startIndex":75006,"endIndex":75014,"textRun":{"content":"content\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":75014,"endIndex":75018,"content":[{"startIndex":75015,"endIndex":75016,"paragraph":{"elements":[{"startIndex":75015,"endIndex":75016,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}},{"startIndex":75016,"endIndex":75018,"paragraph":{"elements":[{"startIndex":75016,"endIndex":75017,"inlineObjectElement":{"inlineObjectId":"kix.8ss6kxuo2nob","textStyle":{}}},{"startIndex":75017,"endIndex":75018,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":75018,"endIndex":75156,"tableCells":[{"startIndex":75019,"endIndex":75028,"content":[{"startIndex":75020,"endIndex":75028,"paragraph":{"elements":[{"startIndex":75020,"endIndex":75028,"textRun":{"content":"caption\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":75028,"endIndex":75156,"content":[{"startIndex":75029,"endIndex":75156,"paragraph":{"elements":[{"startIndex":75029,"endIndex":75156,"textRun":{"content":"DPO increases the probability of the preferred action $y_w$ while decreasing the probability of the dispreferred action $y_l$.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":80,"unit":"PT"}}]}}},{"startIndex":75157,"endIndex":75158,"paragraph":{"elements":[{"startIndex":75157,"endIndex":75158,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":75158,"endIndex":75326,"paragraph":{"elements":[{"startIndex":75158,"endIndex":75326,"textRun":{"content":"Preference dataset creation: We first sample a pair of continuation by asking a question, the AI proposes to continuations, we label one of them good and the other bad\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.t12yzn5zj1b1","textStyle":{}}}},{"startIndex":75326,"endIndex":75442,"paragraph":{"elements":[{"startIndex":75326,"endIndex":75442,"textRun":{"content":"Logits collection. We run the base model model on the 2 continuations. We run the new model on  the 2 continuations\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.t12yzn5zj1b1","textStyle":{}}}},{"startIndex":75442,"endIndex":75519,"paragraph":{"elements":[{"startIndex":75442,"endIndex":75519,"textRun":{"content":"Optimization. We backprop through the new model and optimize the above loss.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.t12yzn5zj1b1","textStyle":{}}}},{"startIndex":75519,"endIndex":75520,"paragraph":{"elements":[{"startIndex":75519,"endIndex":75520,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":75520,"endIndex":75655,"paragraph":{"elements":[{"startIndex":75520,"endIndex":75655,"textRun":{"content":"By eliminating the step of creating a reward model, DPO greatly simplifies the fine-tuning process and has shown to perform very well.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":75655,"endIndex":75656,"paragraph":{"elements":[{"startIndex":75655,"endIndex":75656,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":75656,"endIndex":75941,"paragraph":{"elements":[{"startIndex":75656,"endIndex":75941,"textRun":{"content":"This process can then be iterated. This involves creating a new preference dataset (ie, we ask a question, and we sample the new AI two times, and then we label the text that we prefer between the two, and then we apply the DPO loss) Then, this cycle is repeated to enhance the model.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":75941,"endIndex":75942,"paragraph":{"elements":[{"startIndex":75941,"endIndex":75942,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":75942,"endIndex":76681,"paragraph":{"elements":[{"startIndex":75942,"endIndex":76681,"textRun":{"content":"An important aspect of DPO is that the reward is implicit: it aligns with preferences without the need to construct a separate reward model. This approach addresses the challenge of specifying a utility function and responds to criticisms such as those by Alex Turner, who argues that robust grading (ie , robust reward modeling) is an unnecessarily complex and unnatural task that might be harder than the entire AI alignment problem itself. Turner's critique, found in \"Inner and Outer Alignment Decompose One Hard Problem Into Two Extremely Hard Problems,\" suggests that finding a safe and robust numerical objective for a highly intelligent agent to optimize directly is a formidable challenge—one challenge that DPO could  to bypass.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":76681,"endIndex":76682,"paragraph":{"elements":[{"startIndex":76681,"endIndex":76682,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":76682,"endIndex":76740,"paragraph":{"elements":[{"startIndex":76682,"endIndex":76740,"textRun":{"content":"Expanding the Scope of the Paper with Various Adaptations\n","textStyle":{"bold":true}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":76740,"endIndex":76741,"paragraph":{"elements":[{"startIndex":76740,"endIndex":76741,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":76741,"endIndex":77486,"paragraph":{"elements":[{"startIndex":76741,"endIndex":76971,"textRun":{"content":"This paper offers a foundation that could be enhanced through various adaptations. For instance, integrating its approach with the insights from Tomasz Korbak et al.'s paper, \"Pretraining Language Models with Human Preferences,\" (","textStyle":{}}},{"startIndex":76971,"endIndex":76990,"textRun":{"content":"Korbak et al., 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2302.08582"}}}},{"startIndex":76990,"endIndex":77241,"textRun":{"content":") could augment its robustness. Furthermore, the utilization of boolean preference data has its limitations. Providing feedback in natural language, as shown to be more sample-efficient in the study \"Training Language Models with Language Feedback,\" (","textStyle":{}}},{"startIndex":77241,"endIndex":77262,"textRun":{"content":"Scheurer et al., 2022","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2204.14146"}}}},{"startIndex":77262,"endIndex":77486,"textRun":{"content":") could enhance the effectiveness of the process. Remarkably, with just 100 samples of human-written feedback, this approach enabled the fine-tuning of a GPT-3 model to achieve nearly human-level summarization capabilities.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":77486,"endIndex":77487,"paragraph":{"elements":[{"startIndex":77486,"endIndex":77487,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":77487,"endIndex":78071,"paragraph":{"elements":[{"startIndex":77487,"endIndex":78071,"textRun":{"content":"Looking towards the future, a speculative process that could mitigate the specification gaming would be to train the model much like a child, and that would actively inquire and learn from human interactions. This approach would closely mirror child development, during which a child is progressively more aligned and more capable. And just as in the development of children, it would be crucial to ensure that at no point does the AI's capabilities outpace its level of alignment, maintaining a balance between ability and ethical comprehension throughout its developmental journey.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}]},"documentStyle":{"background":{"color":{}},"pageNumberStart":1,"marginTop":{"magnitude":72,"unit":"PT"},"marginBottom":{"magnitude":72,"unit":"PT"},"marginRight":{"magnitude":72,"unit":"PT"},"marginLeft":{"magnitude":72,"unit":"PT"},"pageSize":{"height":{"magnitude":841.8897637795277,"unit":"PT"},"width":{"magnitude":595.2755905511812,"unit":"PT"}},"marginHeader":{"magnitude":36,"unit":"PT"},"marginFooter":{"magnitude":36,"unit":"PT"},"useCustomHeaderFooterMargins":true,"documentFormat":{"documentMode":"PAGELESS"}},"namedStyles":{"styles":[{"namedStyleType":"NORMAL_TEXT","textStyle":{"bold":false,"italic":false,"underline":false,"strikethrough":false,"smallCaps":false,"backgroundColor":{},"foregroundColor":{"color":{"rgbColor":{"red":0.05490196,"green":0.0627451,"blue":0.101960786}}},"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400},"baselineOffset":"NONE"},"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"JUSTIFIED","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":true,"shading":{"backgroundColor":{}},"pageBreakBefore":false}},{"namedStyleType":"HEADING_1","textStyle":{"bold":true,"fontSize":{"magnitude":20,"unit":"PT"}},"paragraphStyle":{"headingId":"h.4qtu063xgs5m","namedStyleType":"HEADING_1","direction":"LEFT_TO_RIGHT","keepLinesTogether":true,"keepWithNext":true}},{"namedStyleType":"HEADING_2","textStyle":{"bold":true,"fontSize":{"magnitude":17,"unit":"PT"}},"paragraphStyle":{"headingId":"h.sjwmu6fs61e8","namedStyleType":"HEADING_2","direction":"LEFT_TO_RIGHT","keepLinesTogether":true,"keepWithNext":true,"shading":{"backgroundColor":{}}}},{"namedStyleType":"HEADING_3","textStyle":{"bold":true,"fontSize":{"magnitude":14,"unit":"PT"}},"paragraphStyle":{"headingId":"h.i7dbblbhaje4","namedStyleType":"HEADING_3","direction":"LEFT_TO_RIGHT","keepLinesTogether":true,"keepWithNext":true}},{"namedStyleType":"HEADING_4","textStyle":{"bold":true,"fontSize":{"magnitude":14,"unit":"PT"}},"paragraphStyle":{"headingId":"h.808yh97x6psq","namedStyleType":"HEADING_4","direction":"LEFT_TO_RIGHT","keepLinesTogether":true,"keepWithNext":true}},{"namedStyleType":"HEADING_5","textStyle":{"bold":true,"underline":true},"paragraphStyle":{"headingId":"h.aeg47tyb3sfw","namedStyleType":"HEADING_5","direction":"LEFT_TO_RIGHT","keepLinesTogether":true,"keepWithNext":true}},{"namedStyleType":"HEADING_6","textStyle":{"italic":true,"foregroundColor":{"color":{"rgbColor":{"red":0.4,"green":0.4,"blue":0.4}}},"fontSize":{"magnitude":11,"unit":"PT"}},"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","spa