unit":"PT"},"weightedFontFamily":{"fontFamily":"Merriweather","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":29248,"endIndex":29373,"content":[{"startIndex":29249,"endIndex":29373,"paragraph":{"elements":[{"startIndex":29249,"endIndex":29373,"textRun":{"content":"Reward tampering refers to instances where an AI agent inappropriately influences or manipulates the reward process itself.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":80,"unit":"PT"}}]}}},{"startIndex":29374,"endIndex":29375,"paragraph":{"elements":[{"startIndex":29374,"endIndex":29375,"textRun":{"content":"\n","textStyle":{"fontSize":{"magnitude":11,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Merriweather","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":115,"direction":"LEFT_TO_RIGHT","shading":{"backgroundColor":{}}}}},{"startIndex":29375,"endIndex":29376,"paragraph":{"elements":[{"startIndex":29375,"endIndex":29376,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":29376,"endIndex":29377,"paragraph":{"elements":[{"startIndex":29376,"endIndex":29377,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":29377,"endIndex":29443,"paragraph":{"elements":[{"startIndex":29377,"endIndex":29443,"textRun":{"content":"The problem of getting some intended task done can be split into:\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":29443,"endIndex":29496,"paragraph":{"elements":[{"startIndex":29443,"endIndex":29496,"textRun":{"content":"Designing an agent that is good at optimizing reward\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.awd99g9lq1b","textStyle":{}}}},{"startIndex":29496,"endIndex":29663,"paragraph":{"elements":[{"startIndex":29496,"endIndex":29663,"textRun":{"content":"Designing a reward process that provides the agent with suitable rewards. The reward process can be understood by breaking it down even further. The process includes:\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.awd99g9lq1b","textStyle":{}}}},{"startIndex":29663,"endIndex":29694,"paragraph":{"elements":[{"startIndex":29663,"endIndex":29694,"textRun":{"content":"An implemented reward function\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":54,"unit":"PT"},"indentStart":{"magnitude":72,"unit":"PT"}},"bullet":{"listId":"kix.awd99g9lq1b","nestingLevel":1,"textStyle":{}}}},{"startIndex":29694,"endIndex":29755,"paragraph":{"elements":[{"startIndex":29694,"endIndex":29755,"textRun":{"content":"A mechanism for collecting appropriate sensory data as input\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":54,"unit":"PT"},"indentStart":{"magnitude":72,"unit":"PT"}},"bullet":{"listId":"kix.awd99g9lq1b","nestingLevel":1,"textStyle":{}}}},{"startIndex":29755,"endIndex":29817,"paragraph":{"elements":[{"startIndex":29755,"endIndex":29817,"textRun":{"content":"A way for the user to potentially update the reward function.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":54,"unit":"PT"},"indentStart":{"magnitude":72,"unit":"PT"}},"bullet":{"listId":"kix.awd99g9lq1b","nestingLevel":1,"textStyle":{}}}},{"startIndex":29817,"endIndex":29818,"paragraph":{"elements":[{"startIndex":29817,"endIndex":29818,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":29818,"endIndex":30431,"paragraph":{"elements":[{"startIndex":29818,"endIndex":30431,"textRun":{"content":"Reward tampering involves the agent interfering with various parts of this reward process. An agent might distort the feedback received from the reward model, altering the information used to update its behavior. It could also manipulate the reward model's implementation, altering the code or hardware to change reward computations. In some cases, agents engaging in reward tampering may even directly modify the reward values before processing in the machine register. Depending on what exactly is being tampered with we get various degrees of reward tampering. These can be distinguished from the image below.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":30431,"endIndex":30432,"paragraph":{"elements":[{"startIndex":30431,"endIndex":30432,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":30432,"