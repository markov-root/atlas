{"body":{"content":[{"endIndex":1,"sectionBreak":{"sectionStyle":{"columnSeparatorStyle":"NONE","contentDirection":"LEFT_TO_RIGHT","sectionType":"CONTINUOUS"}}},{"startIndex":1,"endIndex":34,"paragraph":{"elements":[{"startIndex":1,"endIndex":9,"textRun":{"content":"Chapter ","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.05490196,"green":0.0627451,"blue":0.101960786}}}}}},{"startIndex":9,"endIndex":10,"textRun":{"content":"6","textStyle":{"underline":true}}},{"startIndex":10,"endIndex":13,"textRun":{"content":" - ","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.05490196,"green":0.0627451,"blue":0.101960786}}}}}},{"startIndex":13,"endIndex":14,"textRun":{"content":"S","textStyle":{"underline":true}}},{"startIndex":14,"endIndex":34,"textRun":{"content":"pecification Gaming\n","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.05490196,"green":0.0627451,"blue":0.101960786}}}}}}],"paragraphStyle":{"headingId":"h.7deium5tg7rk","namedStyleType":"TITLE","alignment":"CENTER","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}},{"startIndex":34,"endIndex":237,"paragraph":{"elements":[{"startIndex":34,"endIndex":237,"textRun":{"content":"It's nearly impossible to perfectly tell an AI what we want. Powerful AI systems learn to exploit the gaps in our instructions, leading to unintended and often harmful behaviors despite safety measures.\n","textStyle":{}}}],"paragraphStyle":{"headingId":"h.1jnwn6gshfw5","namedStyleType":"SUBTITLE","lineSpacing":115,"direction":"LEFT_TO_RIGHT","shading":{"backgroundColor":{}}}}},{"startIndex":237,"endIndex":238,"paragraph":{"elements":[{"startIndex":237,"endIndex":238,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false}}},{"startIndex":238,"endIndex":251,"paragraph":{"elements":[{"startIndex":238,"endIndex":250,"textRun":{"content":"Introduction","textStyle":{"bold":true,"foregroundColor":{"color":{"rgbColor":{"red":0.05490196,"green":0.0627451,"blue":0.101960786}}},"fontSize":{"magnitude":23,"unit":"PT"}}}},{"startIndex":250,"endIndex":251,"textRun":{"content":"\n","textStyle":{"foregroundColor":{"color":{"rgbColor":{"red":0.05490196,"green":0.0627451,"blue":0.101960786}}}}}}],"paragraphStyle":{"headingId":"h.3wdeyjsal7da","namedStyleType":"HEADING_1","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false}}},{"startIndex":251,"endIndex":252,"paragraph":{"elements":[{"startIndex":251,"endIndex":252,"textRun":{"content":"\n","textStyle":{"fontSize":{"magnitude":11,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Merriweather","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":115,"direction":"LEFT_TO_RIGHT","shading":{"backgroundColor":{}}}}},{"startIndex":252,"endIndex":476,"table":{"rows":2,"columns":2,"tableRows":[{"startIndex":253,"endIndex":281,"tableCells":[{"startIndex":254,"endIndex":260,"content":[{"startIndex":255,"endIndex":260,"paragraph":{"elements":[{"startIndex":255,"endIndex":260,"textRun":{"content":"type\n","textStyle":{"fontSize":{"magnitude":11,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Merriweather","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":260,"endIndex":281,"content":[{"startIndex":261,"endIndex":281,"paragraph":{"elements":[{"startIndex":261,"endIndex":281,"textRun":{"content":"section-description\n","textStyle":{"fontSize":{"magnitude":11,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Merriweather","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":281,"endIndex":475,"tableCells":[{"startIndex":282,"endIndex":291,"content":[{"startIndex":283,"endIndex":291,"paragraph":{"elements":[{"startIndex":283,"endIndex":291,"textRun":{"content":"content\n","textStyle":{"fontSize":{"magnitude":11,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Merriweather","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":291,"endIndex":475,"content":[{"startIndex":292,"endIndex":475,"paragraph":{"elements":[{"startIndex":292,"endIndex":475,"textRun":{"content":"We can tell an AI what to do, but we can’t perfectly tell it what we mean. Smart AIs learn to exploit the gaps in our instructions, doing exactly what we said but not what we wanted.\n","textStyle":{"fontSize":{"magnitude":11,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Merriweather","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":115,"direction":"LEFT_TO_RIGHT","shading":{"backgroundColor":{}}}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":80,"unit":"PT"}}]}}},{"startIndex":476,"endIndex":477,"paragraph":{"elements":[{"startIndex":476,"endIndex":477,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":115,"direction":"LEFT_TO_RIGHT","shading":{"backgroundColor":{}}}}},{"startIndex":477,"endIndex":744,"paragraph":{"elements":[{"startIndex":477,"endIndex":499,"textRun":{"content":"Reinforcement Learning","textStyle":{"bold":true}}},{"startIndex":499,"endIndex":744,"textRun":{"content":": The chapter starts with a reminder of some reinforcement learning concepts. This includes a quick dive into the concept of rewards and reward functions. This section lays the groundwork for explaining why reward design is extremely important.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"}}}},{"startIndex":744,"endIndex":745,"paragraph":{"elements":[{"startIndex":744,"endIndex":745,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"indentFirstLine":{"magnitude":36,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}}}},{"startIndex":745,"endIndex":994,"paragraph":{"elements":[{"startIndex":745,"endIndex":757,"textRun":{"content":"Optimization","textStyle":{"bold":true}}},{"startIndex":757,"endIndex":994,"textRun":{"content":": This section briefly introduces the concept of Goodhart's Law. It provides some motivation behind understanding why rewards are difficult to specify in a way such that they do not collapse in the face of immense optimization pressure.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"}}}},{"startIndex":994,"endIndex":995,"paragraph":{"elements":[{"startIndex":994,"endIndex":995,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"indentFirstLine":{"magnitude":36,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}}}},{"startIndex":995,"endIndex":1447,"paragraph":{"elements":[{"startIndex":995,"endIndex":1018,"textRun":{"content":"Reward misspecification","textStyle":{"bold":true}}},{"startIndex":1018,"endIndex":1447,"textRun":{"content":": With a solid grasp of the notion of rewards and optimization the readers are introduced to one of the core challenges of alignment - reward misspecification. This is also known as the Outer Alignment problem. The section begins by discussing the necessity of good reward design in addition to algorithm design. This is followed by concrete examples of reward specification failures such as reward hacking and reward tampering.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"}}}},{"startIndex":1447,"endIndex":1448,"paragraph":{"elements":[{"startIndex":1447,"endIndex":1448,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"indentFirstLine":{"magnitude":36,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}}}},{"startIndex":1448,"endIndex":1883,"paragraph":{"elements":[{"startIndex":1448,"endIndex":1469,"textRun":{"content":"Learning by Imitation","textStyle":{"bold":true}}},{"startIndex":1469,"endIndex":1883,"textRun":{"content":": This section focuses on some proposed solutions to reward misspecification that rely on learning reward functions through imitating human behavior. It examines proposals such as imitation learning (IL), behavioral cloning (BC), and inverse reinforcement learning (IRL). Each section also contains an examination of possible issues and limitations of these approaches as they pertain to resolving reward hacking.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"}}}},{"startIndex":1883,"endIndex":1884,"paragraph":{"elements":[{"startIndex":1883,"endIndex":1884,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"indentFirstLine":{"magnitude":36,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}}}},{"startIndex":1884,"endIndex":2353,"paragraph":{"elements":[{"startIndex":1884,"endIndex":1904,"textRun":{"content":"Learning by Feedback","textStyle":{"bold":true}}},{"startIndex":1904,"endIndex":2353,"textRun":{"content":": The final section investigates proposals aiming to rectify reward misspecification by providing feedback to the machine learning models. The section also provides a comprehensive insight into how current large language models (LLMs) are trained. The discussion covers reward modeling, reinforcement learning from human feedback (RLHF), reinforcement learning from artificial intelligence feedback (RLAIF), and the limitations of these approaches.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"}}}},{"startIndex":2353,"endIndex":2354,"paragraph":{"elements":[{"startIndex":2353,"endIndex":2354,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}},{"startIndex":2354,"endIndex":2377,"paragraph":{"elements":[{"startIndex":2354,"endIndex":2377,"textRun":{"content":"Reinforcement Learning\n","textStyle":{"foregroundColor":{"color":{"rgbColor":{"red":0.05490196,"green":0.0627451,"blue":0.101960786}}}}}}],"paragraphStyle":{"headingId":"h.xcxlry7dz6ou","namedStyleType":"HEADING_1","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}},{"startIndex":2377,"endIndex":2378,"paragraph":{"elements":[{"startIndex":2377,"endIndex":2378,"textRun":{"content":"\n","textStyle":{"fontSize":{"magnitude":11,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Merriweather","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":115,"direction":"LEFT_TO_RIGHT","shading":{"backgroundColor":{}}}}},{"startIndex":2378,"endIndex":2644,"table":{"rows":2,"columns":2,"tableRows":[{"startIndex":2379,"endIndex":2407,"tableCells":[{"startIndex":2380,"endIndex":2386,"content":[{"startIndex":2381,"endIndex":2386,"paragraph":{"elements":[{"startIndex":2381,"endIndex":2386,"textRun":{"content":"type\n","t