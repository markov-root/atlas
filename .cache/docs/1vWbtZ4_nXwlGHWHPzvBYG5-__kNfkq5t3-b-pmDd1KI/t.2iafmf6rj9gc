paragraph":{"elements":[{"startIndex":131591,"endIndex":131599,"textRun":{"content":"caption\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":131599,"endIndex":131830,"content":[{"startIndex":131600,"endIndex":131830,"paragraph":{"elements":[{"startIndex":131600,"endIndex":131830,"textRun":{"content":"An illustration of a framework that we think is robustly good at managing risks. AI Risks are too numerous and too heterogeneous. To address these risks, we need an adaptive framework that can be robust and evolve as AI advances.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":80,"unit":"PT"}}]}}},{"startIndex":131831,"endIndex":131832,"paragraph":{"elements":[{"startIndex":131831,"endIndex":131832,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":131832,"endIndex":131849,"paragraph":{"elements":[{"startIndex":131832,"endIndex":131848,"textRun":{"content":"Defense-in-Depth","textStyle":{"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}},{"startIndex":131848,"endIndex":131849,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"headingId":"h.iofuz6yo5gha","namedStyleType":"HEADING_2","lineSpacing":120.00001,"direction":"LEFT_TO_RIGHT","keepLinesTogether":false,"keepWithNext":false}}},{"startIndex":131849,"endIndex":132634,"paragraph":{"elements":[{"startIndex":131849,"endIndex":131958,"textRun":{"content":"Defense-in-depth means layering multiple independent protections so that if one fails, others provide backup.","textStyle":{"bold":true}}},{"startIndex":131958,"endIndex":132079,"textRun":{"content":" This is one meta-philosophy underlying effective AI safety: multiple independent layers of protection working together. ","textStyle":{}}},{"startIndex":132079,"endIndex":132609,"textRun":{"content":"Think about it like designing a medieval castle - walls, moats, towers, and inner baileys created redundant barriers where breaching one layer didn't mean total compromise. Modern cybersecurity applies the same logic: firewalls, encryption, access controls, and monitoring systems operate simultaneously, each addressing different attack vectors. No single security measure is perfect, but multiple imperfect defenses working together can create robust protection. This is also commonly known as the swiss cheese model of safety (","textStyle":{}}},{"startIndex":132609,"endIndex":132631,"textRun":{"content":"Hendrycks et al., 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2306.12001"}}}},{"startIndex":132631,"endIndex":132633,"textRun":{"content":").","textStyle":{}}},{"startIndex":132633,"endIndex":132634,"textRun":{"content":"\n","textStyle":{"bold":true}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","spaceAbove":{"magnitude":12,"unit":"PT"},"spaceBelow":{"magnitude":12,"unit":"PT"}}}},{"startIndex":132634,"endIndex":132964,"table":{"rows":3,"columns":2,"tableRows":[{"startIndex":132635,"endIndex":132650,"tableCells":[{"startIndex":132636,"endIndex":132642,"content":[{"startIndex":132637,"endIndex":132642,"paragraph":{"elements":[{"startIndex":132637,"endIndex":132642,"textRun":{"content":"type\n","textStyle":{"bold":true}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}}}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":132642,"endIndex":132650,"content":[{"startIndex":132643,"endIndex":132650,"paragraph":{"elements":[{"startIndex":132643,"endIndex":132650,"textRun":{"content":"figure\n","textStyle":{"bold":true}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}}}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":132650,"endIndex":132664,"tableCells":[{"startIndex":132651,"endIndex":132660,"content":[{"startIndex":132652,"endIndex":132660,"paragraph":{"elements":[{"startIndex":132652,"endIndex":132660,"textRun":{"content":"content\n","textStyle":{"bold":true}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}}}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":132660,"endIndex":132664,"content":[{"startIndex":132661,"endIndex":132662,"paragraph":{"elements":[{"startIndex":132661,"endIndex":132662,"textRun":{"content":"\n","textStyle":{"bold":true}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}}}}},{"startIndex":132662,"endIndex":132664,"paragraph":{"elements":[{"startIndex":132662,"endIndex":132663,"inlineObjectElement":{"inlineObjectId":"kix.a2cjqia76wt6","textStyle":{}}},{"startIndex":132663,"endIndex":132664,"textRun":{"content":"\n","textStyle":{"bold":true}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":132664,"endIndex":132963,"tableCells":[{"startIndex":132665,"endIndex":132674,"content":[{"startIndex":132666,"endIndex":132674,"paragraph":{"elements":[{"startIndex":132666,"endIndex":132674,"textRun":{"content":"caption\n","textStyle":{"bold":true}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}}}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":132674,"endIndex":132963,"content":[{"startIndex":132675,"endIndex":132963,"paragraph":{"elements":[{"startIndex":132675,"endIndex":132836,"textRun":{"content":"An example analogy of defense in depth from history, where castles progressively built up more layers of security to ensure that the core was never compromised (","textStyle":{}}},{"startIndex":132836,"endIndex":132865,"textRun":{"content":"Encyclopedia Britannica, 2025","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.britannica.com/technology/military-technology/The-castle"}}}},{"startIndex":132865,"endIndex":132962,"textRun":{"content":"). This layered philosophy is already applied in cybersecurity, and can be extended to AI safety.","textStyle":{}}},{"startIndex":132962,"endIndex":132963,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":80,"unit":"PT"}}]}}},{"startIndex":132964,"endIndex":132965,"paragraph":{"elements":[{"startIndex":132964,"endIndex":132965,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":132965,"endIndex":132966,"paragraph":{"elements":[{"startIndex":132965,"endIndex":132966,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":132966,"endIndex":133670,"paragraph":{"elements":[{"startIndex":132966,"endIndex":133051,"textRun":{"content":"Defense-in-depth relies on combinatorial explosion when layers are truly independent.","textStyle":{"bold":true}}},{"startIndex":133051,"endIndex":133655,"textRun":{"content":" If each defensive layer has a 1 percent failure rate and an attacker must breach all five layers simultaneously, the overall failure probability becomes $0.01^5$ - vanishingly small. This works like PIN security: a three-digit PIN is trivially weak, but a twelve-digit PIN becomes very secure because combinatorial difficulty grows exponentially. One core requirement is layer independence - if breaking one layer automatically breaks others, or if attackers get feedback about which layer failed, they can brute force each barrier sequentially in linear time rather than facing exponential difficulty (","textStyle":{}}},{"startIndex":133655,"endIndex":133667,"textRun":{"content":"Gleave, 2025","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.youtube.com/watch?v=BfXi3_QSWek"}}}},{"startIndex":133667,"endIndex":133669,"textRun":{"content":").","textStyle":{}}},{"startIndex":133669,"endIndex":133670,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":133670,"endIndex":133671,"paragraph":{"elements":[{"startIndex":133670,"en