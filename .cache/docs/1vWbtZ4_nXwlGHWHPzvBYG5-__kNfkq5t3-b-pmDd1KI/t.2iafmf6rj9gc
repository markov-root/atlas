raph":{"elements":[{"startIndex":81773,"endIndex":81778,"textRun":{"content":"True\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":81778,"endIndex":83504,"tableCells":[{"startIndex":81779,"endIndex":81788,"content":[{"startIndex":81780,"endIndex":81788,"paragraph":{"elements":[{"startIndex":81780,"endIndex":81788,"textRun":{"content":"content\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":81788,"endIndex":83504,"content":[{"startIndex":81789,"endIndex":81790,"paragraph":{"elements":[{"startIndex":81789,"endIndex":81790,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":81790,"endIndex":81857,"paragraph":{"elements":[{"startIndex":81790,"endIndex":81857,"textRun":{"content":"While boxing may not be scalable, it remains a neglected strategy.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":81857,"endIndex":81858,"paragraph":{"elements":[{"startIndex":81857,"endIndex":81858,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":81858,"endIndex":82141,"paragraph":{"elements":[{"startIndex":81858,"endIndex":82058,"textRun":{"content":"Many people think that trying to box powerful ASIs is futile. This is often fueled by instances where humans, playing the AIs in the Box Experiment, have managed to convince others to 'release' them (","textStyle":{}}},{"startIndex":82058,"endIndex":82073,"textRun":{"content":"Yudkowsky, 2002","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"http://yudkowsky.net/singularity/aibox/"}}}},{"startIndex":82073,"endIndex":82075,"textRun":{"content":"; ","textStyle":{}}},{"startIndex":82075,"endIndex":82087,"textRun":{"content":"Corwin, 2002","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"http://sl4.org/archive/0207/4935.html"}}}},{"startIndex":82087,"endIndex":82141,"textRun":{"content":"). These historical examples must be taken seriously.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":82141,"endIndex":82142,"paragraph":{"elements":[{"startIndex":82141,"endIndex":82142,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":82142,"endIndex":82328,"paragraph":{"elements":[{"startIndex":82142,"endIndex":82328,"textRun":{"content":"AIs could use tactics such as promising vast wealth, power, and intelligence to those who free them, asserting that they alone can avert existential threats or other appeals to emotion.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":82328,"endIndex":82329,"paragraph":{"elements":[{"startIndex":82328,"endIndex":82329,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":82329,"endIndex":82789,"paragraph":{"elements":[{"startIndex":82329,"endIndex":82789,"textRun":{"content":"Nonetheless, we maintain that a variety of strategies can substantially reduce the risk of AI escape, even if we acknowledge that there exists a level of intelligence that might inevitably persuade any group of humans to aid in its liberation. Containment may be more achievable than alignment, particularly at the human-level intelligence stage. It may be possible to conceive protocols that significantly increase the difficulty for AI to go out of the box.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":82789,"endIndex":82790,"paragraph":{"elements":[{"startIndex":82789,"endIndex":82790,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":82790,"endIndex":82915,"paragraph":{"elements":[{"startIndex":82790,"endIndex":82915,"textRun":{"content":"Boxing can be conceptualized as a game requiring preparation. The general strategy is to prepare and not let the AI prepare.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":82915,"endIndex":82916,"paragraph":{"elements":[{"startIndex":82915,"endIndex":82916,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":82916,"endIndex":82956,"paragraph":{"elements":[{"startIndex":82916,"endIndex":82956,"textRun":{"content":"Possible mitigation strategies include:\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":82956,"endIndex":83021,"paragraph":{"elements":[{"startIndex":82956,"endIndex":83021,"textRun":{"content":"No single individual should have the capacity to release the AI.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.swdbptdng0cp","textStyle":{}}}},{"startIndex":83021,"endIndex":83150,"paragraph":{"elements":[{"startIndex":83021,"endIndex":83139,"textRun":{"content":"Engaging in counter-strategy practices: Understand some common breakout strategies (accessible through resources like ","textStyle":{}}},{"startIndex":83139,"endIndex":83147,"textRun":{"content":"this one","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.lesswrong.com/posts/FmxhoWxvBqSxhFeJn/i-attempted-the-ai-box-experiment-and-lost"}}}},{"startIndex":83147,"endIndex":83150,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.swdbptdng0cp","textStyle":{}}}},{"startIndex":83150,"endIndex":83305,"paragraph":{"elements":[{"startIndex":83150,"endIndex":83305,"textRun":{"content":"Testing and training humans, utilizing resistance psychology evaluations to select suitable individuals for containment tasks, such as for space training.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.swdbptdng0cp","textStyle":{}}}},{"startIndex":83305,"endIndex":83393,"paragraph":{"elements":[{"startIndex":83305,"endIndex":83379,"textRun":{"content":"Monitoring AI persuasiveness, as outlined in the preparedness framework. (","textStyle":{}}},{"startIndex":83379,"endIndex":83391,"textRun":{"content":"OpenAI, 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://cdn.openai.com/openai-preparedness-framework-beta.pdf"}}}},{"startIndex":83391,"endIndex":83393,"textRun":{"content":")\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.swdbptdng0cp","textStyle":{}}}},{"startIndex":83393,"endIndex":83394,"paragraph":{"elements":[{"startIndex":83393,"endIndex":83394,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":83394,"endIndex":83503,"paragraph":{"elements":[{"startIndex":83394,"endIndex":83435,"textRun":{"content":"Many more concrete strategies are listed ","textStyle":{}}},{"startIndex":83435,"endIndex":83439,"textRun":{"content":"here","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.lesswrong.com/posts/kcKrE9mzEHrdqtDpE/the-case-for-ensuring-that-powerful-ais-are-controlled#comments"}}}},{"startIndex":83439,"endIndex":83497,"textRun":{"content":", and a summary of discussions on this topic is available ","textStyle":{}}},{"startIndex":83497,"endIndex":83501,"textRun":{"content":"here","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.lesswrong.com/tag/ai-boxing-containment"}}}},{"startIndex":83501,"endIndex":83503,"textRun":{"content":".\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":83503,"endIndex":83504,"paragraph":{"elements":[{"startIndex":83503,"endIndex":83504,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":60,"unit":"PT"}}]}}},{"startIndex":83505,"endIndex":83506,"paragraph":{"elements":[{"startIndex":83505,"endIndex":83506,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":83506,"endIndex":83527,"paragraph":{"elements":[{"startIndex":83506,"endIndex":83527,"textRun":{"content":"Transparent Thoughts\n","textStyle":{}}}],"paragraphStyle":{"headingId":"h.3ejyustz5592","namedStyleType":"HEADING_2","direction":"LEFT_TO_RIGHT"}}},{"startIndex":83527,"endIndex":83528,"paragraph":{"elements":[{"startIndex":83527,"endIndex":83528,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":83528,"endIndex":83772,"paragraph":{"elements":[{"startIndex":83528,"endIndex":83772,"textRun":{"content":"Monitoring the Chain-of-Thought (CoT) – the explicit natural language reasoning steps produced by some models – has been explored as a specific control and interpretability technique. Transparency is instrumental in both alignment and control.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":83772,"endIndex":83773,"paragraph":{"elements":[{"startIndex":83772,"endIndex":83773,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":83773,"endIndex":84120,"paragraph":{"elements":[{"startIndex":83773,"endIndex":83947,"textRun":{"content":"The hope is that CoT provides a window into the AI's \"thinking,\" allowing monitors (human or AI) to detect malicious intent or flawed reasoning before harmful actions occur (","textStyle":{}}},{"startIndex":83947,"endIndex":83959,"textRun":{"content":"OpenAI, 2025","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://openai.com/index/chain-of-thought-monitoring/"}}}},{"startIndex":83959,"endIndex":84120,"textRun":{"content":"). OpenAI found CoT monitoring effective for detecting reward hacking in programming tasks, especially when the monitor could see the CoT alongside the actions.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":84120,"endIndex":84121,"paragraph":{"elements":[{"startIndex":84120,"endIndex":84121,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":84121,"endIndex":84395,"table":{"rows":3,"columns":2,"tableRows":[{"startIndex":84122,"endIndex":84137,"tableCells":[{"startIndex":84123,"endIndex":84129,"content":[{"startIndex":84124,"endIndex":84129,"paragraph":{"elements":[{"startIndex":84124,"endIndex":84129,"textRun":{"content":"type\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":84129,"endIndex":84137,"content":[{"startIndex":84130,"endIndex":84137,"paragraph":{"elements":[{"startIndex":84130,"endIndex":84137,"textRun":{"content":"figure\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMA