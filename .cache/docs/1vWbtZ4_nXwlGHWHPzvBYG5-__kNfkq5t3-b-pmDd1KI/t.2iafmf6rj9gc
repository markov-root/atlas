Style":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":80,"unit":"PT"}}]}}},{"startIndex":4020,"endIndex":4021,"paragraph":{"elements":[{"startIndex":4020,"endIndex":4021,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":4021,"endIndex":4033,"paragraph":{"elements":[{"startIndex":4021,"endIndex":4033,"textRun":{"content":"Definitions\n","textStyle":{"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}}],"paragraphStyle":{"headingId":"h.kyz8esvzhwmo","namedStyleType":"HEADING_1","direction":"LEFT_TO_RIGHT","keepLinesTogether":false,"keepWithNext":false}}},{"startIndex":4033,"endIndex":4034,"paragraph":{"elements":[{"startIndex":4033,"endIndex":4034,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":4034,"endIndex":4262,"table":{"rows":2,"columns":2,"tableRows":[{"startIndex":4035,"endIndex":4063,"tableCells":[{"startIndex":4036,"endIndex":4042,"content":[{"startIndex":4037,"endIndex":4042,"paragraph":{"elements":[{"startIndex":4037,"endIndex":4042,"textRun":{"content":"type\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}}}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":4042,"endIndex":4063,"content":[{"startIndex":4043,"endIndex":4063,"paragraph":{"elements":[{"startIndex":4043,"endIndex":4063,"textRun":{"content":"section-description\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}}}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":4063,"endIndex":4261,"tableCells":[{"startIndex":4064,"endIndex":4073,"content":[{"startIndex":4065,"endIndex":4073,"paragraph":{"elements":[{"startIndex":4065,"endIndex":4073,"textRun":{"content":"content\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}}}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":4073,"endIndex":4261,"content":[{"startIndex":4074,"endIndex":4261,"paragraph":{"elements":[{"startIndex":4074,"endIndex":4261,"textRun":{"content":"Before we can build solutions, we must agree on the problem. Differentiating between AI safety, alignment, ethics, and control helps us build targeted effective strategies for each task.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":80,"unit":"PT"}}]}}},{"startIndex":4262,"endIndex":4263,"paragraph":{"elements":[{"startIndex":4262,"endIndex":4263,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":4263,"endIndex":5097,"paragraph":{"elements":[{"startIndex":4263,"endIndex":4354,"textRun":{"content":"How we define problems directly impacts which strategies we pursue in solving that problem.","textStyle":{"bold":true}}},{"startIndex":4354,"endIndex":4593,"textRun":{"content":" In a new and evolving field like AI safety, clearly defined terms are essential for effective communication and research. Ambiguity leads to miscommunication, hinders collaboration, obscures disagreements, and facilitates safety washing (","textStyle":{}}},{"startIndex":4593,"endIndex":4609,"textRun":{"content":"Ren et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2407.21792"}}}},{"startIndex":4609,"endIndex":4610,"textRun":{"content":";","textStyle":{}}},{"startIndex":4610,"endIndex":4622,"textRun":{"content":" Lizka, 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://forum.effectivealtruism.org/posts/f2qojPr8NaMPo2KJC/beware-safety-washing"}}}},{"startIndex":4622,"endIndex":5097,"textRun":{"content":"). The terms we use reflect our assumptions about the nature of the problems we're trying to solve and shape the solutions we develop. Terms like \"alignment\" and \"safety\" are used with varying meanings, reflecting different underlying assumptions about the nature of the problem and the research goals. The goal of this section is to explain different perspectives on these words, what specific safety strategies aim to achieve, and establish how our text will utilize them.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":5097,"endIndex":5098,"paragraph":{"elements":[{"startIndex":5097,"endIndex":5098,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":5098,"endIndex":5108,"paragraph":{"elements":[{"startIndex":5098,"endIndex":5108,"textRun":{"content":"AI Safety\n","textStyle":{"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}}],"paragraphStyle":{"headingId":"h.o2lu0bfy5ulz","namedStyleType":"HEADING_2","lineSpacing":120.00001,"direction":"LEFT_TO_RIGHT","keepLinesTogether":false,"keepWithNext":false}}},{"startIndex":5108,"endIndex":5109,"paragraph":{"elements":[{"startIndex":5108,"endIndex":5109,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":5109,"endIndex":5402,"table":{"rows":4,"columns":2,"tableRows":[{"startIndex":5110,"endIndex":5129,"tableCells":[{"startIndex":5111,"endIndex":5117,"content":[{"startIndex":5112,"endIndex":5117,"paragraph":{"elements":[{"startIndex":5112,"endIndex":5117,"textRun":{"content":"type\n","textStyle":{"bold":true}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":