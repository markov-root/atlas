wStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":80,"unit":"PT"}}]}}},{"startIndex":139707,"endIndex":139708,"paragraph":{"elements":[{"startIndex":139707,"endIndex":139708,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":139708,"endIndex":140360,"paragraph":{"elements":[{"startIndex":139708,"endIndex":139793,"textRun":{"content":"The effectiveness of d/acc depends on maintaining favorable offense-defense balances.","textStyle":{"bold":true}}},{"startIndex":139793,"endIndex":140328,"textRun":{"content":" The feasibility of d/acc as a strategy hinges on whether defensive technologies can outpace offensive capabilities across domains. Historical precedents are mixed - some fields like traditional cybersecurity often favor defenders who can patch vulnerabilities, while others like biosecurity traditionally favor attackers who need fewer resources to create threats than defenders need to counter them. The key challenge for d/acc implementation lies in identifying and supporting technologies that shift these balances toward defense (","textStyle":{}}},{"startIndex":140328,"endIndex":140342,"textRun":{"content":"Bernardi, 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://airesilience.substack.com/p/a-policy-agenda-for-defensive-acceleration"}}}},{"startIndex":140342,"endIndex":140344,"textRun":{"content":"; ","textStyle":{}}},{"startIndex":140344,"endIndex":140357,"textRun":{"content":"Buterin, 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://vitalik.eth.limo/general/2023/11/27/techno_optimism.html"}}}},{"startIndex":140357,"endIndex":140360,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedS