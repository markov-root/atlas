startIndex":45743,"endIndex":45809,"content":[{"startIndex":45744,"endIndex":45809,"paragraph":{"elements":[{"startIndex":45744,"endIndex":45809,"textRun":{"content":"The impossible challenge of creating tamper-resistant safeguards\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":45809,"endIndex":45827,"tableCells":[{"startIndex":45810,"endIndex":45821,"content":[{"startIndex":45811,"endIndex":45821,"paragraph":{"elements":[{"startIndex":45811,"endIndex":45821,"textRun":{"content":"collapsed\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":45821,"endIndex":45827,"content":[{"startIndex":45822,"endIndex":45827,"paragraph":{"elements":[{"startIndex":45822,"endIndex":45827,"textRun":{"content":"True\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":45827,"endIndex":46949,"tableCells":[{"startIndex":45828,"endIndex":45837,"content":[{"startIndex":45829,"endIndex":45837,"paragraph":{"elements":[{"startIndex":45829,"endIndex":45837,"textRun":{"content":"content\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":45837,"endIndex":46949,"content":[{"startIndex":45838,"endIndex":45839,"paragraph":{"elements":[{"startIndex":45838,"endIndex":45839,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":45839,"endIndex":45950,"paragraph":{"elements":[{"startIndex":45839,"endIndex":45950,"textRun":{"content":"A major challenge for open-weight models is that adversaries can fine-tune them to remove built-in safeguards.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":45950,"endIndex":45951,"paragraph":{"elements":[{"startIndex":45950,"endIndex":45951,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":45951,"endIndex":46484,"paragraph":{"elements":[{"startIndex":45951,"endIndex":46039,"textRun":{"content":"Why can't we just instruction-tune powerful models and then release them as open weight?","textStyle":{"bold":true}}},{"startIndex":46039,"endIndex":46393,"textRun":{"content":" Once a model is freely accessible, even if it has been fine-tuned to include security filters, removing these filters is relatively straightforward. Some studies have shown that a few hundred euros are sufficient to bypass all safety barriers currently in place on available open-source models simply by fine-tuning the model with a few toxic examples (","textStyle":{}}},{"startIndex":46393,"endIndex":46412,"textRun":{"content":"Lermen et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2310.20624"}}}},{"startIndex":46412,"endIndex":46484,"textRun":{"content":"). This is why placing models behind APIs is a strategic middle ground.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":46484,"endIndex":46485,"paragraph":{"elements":[{"startIndex":46484,"endIndex":46485,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":46485,"endIndex":46948,"paragraph":{"elements":[{"startIndex":46485,"endIndex":46537,"textRun":{"content":"Tamper-Resistant Safeguards as a research direction.","textStyle":{"bold":true}}},{"startIndex":46537,"endIndex":46717,"textRun":{"content":" Research into tamper-resistant safeguards, such as the TAR method, aims to make safety mechanisms (like refusal or knowledge restriction) robust against such fine-tuning attacks (","textStyle":{}}},{"startIndex":46717,"endIndex":46738,"textRun":{"content":"Tamirisa et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2408.00761"}}}},{"startIndex":46738,"endIndex":46948,"textRun":{"content":"). TAR has shown promise in resisting extensive fine-tuning while preserving general capabilities, though fundamental limitations in defending against sophisticated attacks exploiting benign variations remain.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":46948,"endIndex":46949,"paragraph":{"elements":[{"startIndex":46948,"endIndex":46949,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":60,"unit":"PT"}}]}}},{"startIndex":46950,"endIndex":46951,"paragraph":{"elements":[{"startIndex":46950,"endIndex":46951,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":46951,"endIndex":46978,"paragraph":{"elements":[{"startIndex":46951,"endIndex":46978,"textRun":{"content":"Socio-technical Strategies\n","textStyle":{"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}}],"paragraphStyle":{"headingId":"h.gstcb9nbea9q","namedStyleType":"HEADING_2","lineSpacing":120.00001,"direction":"LEFT_TO_RIGHT","keepLinesTogether":false,"keepWithNext":false}}},{"startIndex":46978,"endIndex":46979,"paragraph":{"elements":[{"startIndex":46978,"endIndex":46979,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":46979,"endIndex":47300,"paragraph":{"elements":[{"startIndex":46979,"endIndex":47300,"textRun":{"content":"The previous strategies focus on reducing risks from models that are not yet widely available, such as models capable of advanced cyberattacks or engineering pathogens. However, what about models that enable deep fakes, misinformation campaigns, or privacy violations? Many of these models are already widely accessible.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":47300,"endIndex":47301,"paragraph":{"elements":[{"startIndex":47300,"endIndex":47301,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":47301,"endIndex":47757,"paragraph":{"elements":[{"startIndex":47301,"endIndex":47757,"textRun":{"content":"Unfortunately, it is already too easy to use open-source models to do things like creating sexualized images of people from a few photos of them. There is no purely technical solution to counter such problems. For example, adding defenses (like adversarial noise) to photos published online to make them unreadable by AI will probably not scale, and empirically, every type of defense has been bypassed by attacks in the literature of adversarial attacks.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":47757,"endIndex":47758,"paragraph":{"elements":[{"startIndex":47757,"endIndex":47758,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":47758,"endIndex":47898,"paragraph":{"elements":[{"startIndex":47758,"endIndex":47879,"textRun":{"content":"The primary solution is to regulate and establish strict norms against this type of behavior. Some potential approaches (","textStyle":{}}},{"startIndex":47879,"endIndex":47895,"textRun":{"content":"Control AI, 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://controlai.com/deepfakes/deepfakes-policy"}}}},{"startIndex":47895,"endIndex":47898,"textRun":{"content":"):\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":47898,"endIndex":48159,"paragraph":{"elements":[{"startIndex":47898,"endIndex":47917,"textRun":{"content":"Laws and penalties:","textStyle":{"bold":true}}},{"startIndex":47917,"endIndex":48159,"textRun":{"content":" Enact and enforce laws making it illegal to create and share non-consensual deep fake pornography or use AI for stalking, harassment, privacy violations, intellectual property, or misinformation. Impose significant penalties as a deterrent.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.em841qdb75xk","textStyle":{}}}},{"startIndex":48159,"endIndex":48371,"paragraph":{"elements":[{"startIndex":48159,"endIndex":48178,"textRun":{"content":"Content moderation:","textStyle":{"bold":true}}},{"startIndex":48178,"endIndex":48371,"textRun":{"content":" Require online platforms to proactively detect and remove AI-generated problematic content, misinformation, and privacy-violating material. Hold platforms accountable for failure to moderate.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.em841qdb75xk","textStyle":{}}}},{"startIndex":48371,"endIndex":48507,"paragraph":{"elements":[{"startIndex":48371,"endIndex":48384,"textRun":{"content":"Watermarking:","textStyle":{"bold":true}}},{"startIndex":48384,"endIndex":48507,"textRun":{"content":" Encourage or require \"watermarking\" of AI-generated content. Develop standards for digital provenance and authentication.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.em841qdb75xk","textStyle":{}}}},{"startIndex":48507,"endIndex":48694,"paragraph":{"elements":[{"startIndex":48507,"endIndex":48531,"textRun":{"content":"Education and awareness:","textStyle":{"bold":true}}},{"startIndex":48531,"endIndex":48694,"textRun":{"content":" Launch public education campaigns about the risks of deep fakes, misinformation, and AI privacy threats. Teach people to be critical consumers of online content.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.em841qdb75xk","textStyle":{}}}},{"startIndex":48694,"endIndex":48850,"paragraph":{"elements":[{"startIndex":48694,"endIndex":48703,"textRun":{"content":"Research:","textStyle":{"bold":true}}},{"startIndex":48703,"endIndex":48850,"textRun":{"content":" Support research into technical methods of detecting AI-generated content, identifying manipulated media, and preserving privacy from AI systems.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.em841qdb75xk","textStyle":{}}}},{"startIndex":48850,"endIndex":48851,"paragraph":{"elements":[{"startIndex":48850,"endIndex":48851,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":48851,"endIndex":49530,"paragraph":{"elements":[{"startIndex":48851,"endIndex":48942,"textRun":{"content":"These elements can be combined with other strategies and layers to attain defense in depth.","textStyle":{"bold":true}}},{"startIndex":48942,"endIndex":49136,"textRun":{"content":" For instance, AI-powered systems can screen phone calls in real-time, analyzing voice patterns, call frequency, and conversational cues to identify likely scams and alert users or block calls (","textStyle":{}}},{"startIndex":49136,"endIndex":49149,"textRun":{"content":"Neuralt, 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.neuralt.com/news-insights/protect-your-subscribers-against-scam-calls-with-ai-powered-scamblock"}}}},{"startIndex":49149,"endIndex":49173,"textRun":{"content":"). Chatbots like Daisy (","textStyle":{}}},{"startIndex":49173,"endIndex":49193,"textRun":{"content":"Anna Desmarais, 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://fr.euronews.com/next/2024/03/08/decouvrez-daisy-le-chatbot-mamie-qui-fait-perdre-du-temps-aux-fraudeurs-au-telephone"}}}},{"startIndex":49193,"endIndex":49530,"textRun":{"content":") and services like Jolly Roger Telephone employ AI to engage scammers in lengthy, unproductive conversations, wasting their time and diverting them from potential victims. These represent practical, defense-oriented applications of AI against common forms of misuse. But this is only an early step, and it is far from being sufficient.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":49530,"endIndex":49531,"paragraph":{"elements":[{"startIndex":49530,"endIndex":49531,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":49531,"endIndex":49709,"paragraph":{"elements":[{"startIndex":49531,"endIndex":49709,"textRun":{"content":"Ultimately, a combination of legal frameworks, platform policies, social norms, and technological tools will be needed to mitigate the risks posed by widely available AI models.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":49709,"endIndex":49710,"paragraph":{"elements":[{"startIndex":49709,"endIndex":49710,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":49710,"endIndex":49732,"paragraph":{"elements":[{"startIndex":49710,"endIndex":49732,"textRun":{"content":"AGI Safety Strategies\n","textStyle":{}}}],"paragraphStyle":{"headingId":"h.xz6lnrpi8iun","namedStyleType":"HEADING_1","direction":"LEFT_TO_RIGHT","keepLinesTogether":false,"keepWithNext":false}}},{"startIndex":49732,"endIndex":49733,"paragraph":{"elements":[{"startIndex":49732,"endIndex":49733,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":49733,"endIndex":49946,"table":{"rows":2,"columns":2,"tableRows":[{"startIndex":49734,"endIndex":49762,"tableCells":[{"startIndex":49735,"endIndex":49741,"content":[{"startIndex":49736,"endIndex":49741,"paragraph":{"elements":[{"startIndex":49736,"endIndex":49741,"textRun":{"content":"type\n","textStyle":{"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":49741,"endIndex":49762,"content":[{"startIndex":49742,"endIndex":49762,"paragraph":{"elements":[{"startIndex":49742,"endIndex":49762,"textRun":{"content":"section-description\n","textStyle":{"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":49762,"endIndex":49945,"tableCells":[{"startIndex":49763,"endIndex":49772,"content":[{"startIndex":49764,"endIndex":49772,"paragraph":{"elements":[{"startIndex":49764,"endIndex":49772,"textRun":{"content":"content\n","textStyle":{"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":49772,"endIndex":49945,"content":[{"startIndex":49773,"endIndex":49945,"paragraph":{"elements":[{"startIndex":49773,"endIndex":49944,"textRun":{"content":"For human-level AI, safety work focuses on research into alignment, maintaining control through monitoring and containment, and iteratively fixing discovered misalignment.","textStyle":{}}},{"startIndex":49944,"endIndex":49945,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":59.25,"unit":"PT"}},{"widthType":"FIXED_WIDTH","width":{"magnitude":408.75,"unit":"PT"}}]}}},{"startIndex":49946,"endIndex":49947,"paragraph":{"elements":[{"startIndex":49946,"endIndex":49947,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":49947,"endIndex":49948,"paragraph":{"elements":[{"startIndex":49947,"endIndex":49948,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":49948,"endIndex":50377,"paragraph":{"elements":[{"startIndex":49948,"endIndex":50377,"textRun":{"content":"Unlike misuse, where human intent is the driver of harm, AGI safety is primarily concerned with the behavior of the AI system itself. The core problems are alignment and control: ensuring that these highly capable, potentially autonomous systems reliably understand and pursue goals consistent with human values and intentions, rather than developing and acting on misaligned objectives that could lead to catastrophic outcomes.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":50377,"endIndex":50378,"paragraph":{"elements":[{"startIndex":50377,"endIndex":50378,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":50378,"endIndex":50728,"paragraph":{"elements":[{"startIndex":50378,"endIndex":50728,"textRun":{"content":"This section explores strategies for AGI safety, which, as we explained in the definitions section, includes but is not limited to just alignment. We distinguish safety strategies that would apply to human-level AGI from safety strategies that guarantee us safety from ASI. This section focuses on the former, and the next section will focus on ASI.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":50728,"endIndex":50729,"paragraph":{"elements":[{"startIndex":50728,"endIndex":50729,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":50729,"endIndex":51383,"paragraph":{"elements":[{"startIndex":50729,"endIndex":50821,"textRun":{"content":"AGI safety strategies operate under fundamentally different constraints than ASI approaches.","textStyle":{"bold":true}}},{"startIndex":50821,"endIndex":51383,"textRun":{"content":" When dealing with systems at near-human-level intelligence, we can theoretically retain meaningful oversight capabilities and can iterate on safety measures through trial and error. Humans can still evaluate outputs, understand reasoning processes, and provide feedback that improves system behavior. This creates strategic opportunities that disappear once AI generality and capability surpass human comprehension across most domains. It is debated whether any of the safety strategies intended for human-level AGI will continue to work for superintelligence.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":51383,"endIndex":51384,"paragraph":{"elements":[{"startIndex":51383,"endIndex":51384,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":51384,"endIndex":52087,"paragraph":{"elements":[{"startIndex":51384,"endIndex":51492,"textRun":{"content":"Strategies for AGI and ASI safety often get conflated, stemming from uncertainty about transition timelines.","textStyle":{"bold":true}}},{"startIndex":51492,"endIndex":51682,"textRun":{"content":" Timelines are hotly debated in AI research. Some researchers expect rapid capability gains that could compress the period for how long AIs remain human-level into months rather than years (","textStyle":{}}},{"startIndex":51682,"endIndex":51694,"textRun":{"content":"Soares, 2022","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.alignmentforum.org/posts/GNhMPAWcfBCASy8e6/a-central-ai-alignment-problem-capabilities-generalization"}}}},{"startIndex":51694,"endIndex":51696,"textRun":{"content":"; ","textStyle":{}}},{"startIndex":51696,"endIndex":51711,"textRun":{"content":"Yudkowsky, 2022","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.alignmentforum.org/posts/uMQ3cqWDPHhjtiesc/agi-ruin-a-list-of-lethalities"}}}},{"startIndex":51711,"endIndex":51713,"textRun":{"content":"; ","textStyle":{}}},{"startIndex":51713,"endIndex":51735,"textRun":{"content":"Kokotajlo et al., 2025","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://ai-2027.com/"}}}},{"startIndex":51735,"endIndex":52087,"textRun":{"content":"). If the transition from human-level to vastly superhuman intelligence happens quickly, AGI-specific strategies might never have time for deployment. However, if we do have a meaningful period of human-level operation, we have safety options that won't exist at superintelligent levels, making this distinction important for strategic considerations.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":52087,"endIndex":52088,"paragraph":{"elements":[{"startIndex":52087,"endIndex":52088,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":52088,"endIndex":52102,"paragraph":{"elements":[{"startIndex":52088,"endIndex":52102,"textRun":{"content":"Initial Ideas\n","textStyle":{}}}],"paragraphStyle":{"headingId":"h.fhj5crwi7ppo","namedStyleType":"HEADING_2","direction":"LEFT_TO_RIGHT"}}},{"startIndex":52102,"endIndex":52103,"paragraph":{"elements":[{"startIndex":52102,"endIndex":52103,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":120.00001,"direction":"LEFT_TO_RIGHT"}}},{"startIndex":52103,"endIndex":52525,"paragraph":{"elements":[{"startIndex":52103,"endIndex":52525,"textRun":{"content":"When people first encounter AI safety, they often suggest the same intuitive solutions that people explored years ago. These early approaches seemed logical and drew from familiar concepts like science fiction, physical security, and human development. None are sufficient for advanced AI systems, but understanding why they fall short helps explain what makes coming up with strategies for AI safety genuinely difficult.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":52525,"endIndex":52526,"paragraph":{"elements":[{"startIndex":52525,"endIndex":52526,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":52526,"endIndex":53317,"paragraph":{"elements":[{"startIndex":52526,"endIndex":52609,"textRun":{"content":"The strategy to use explicit rules fails because rules can't cover every situation.","textStyle":{"bold":true}}},{"startIndex":52609,"endIndex":53317,"textRun":{"content":" One very common example of this is something like Asimov's Laws: don't harm humans, obey human orders (unless they conflict with law one), and protect yourself (unless it conflicts with the first two). This appeals to our legal thinking - write clear rules, then follow them. But what counts as \"harm\"? If you order an AI to lie to someone, does deception cause harm? If honesty hurts feelings, does truth become harmful? The AI faces impossible contradictions with no resolution method. Asimov knew this - every story in \"I, Robot\" shows scenarios where the laws produce disasters. The fundamental problem: we can't write rules comprehensive enough to cover every situation an advanced AI might encounter.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":53317,"endIndex":53318,"paragraph":{"elements":[{"startIndex":53317,"endIndex":53318,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":53318,"endIndex":53470,"table":{"rows":3,"columns":2,"tableRows":[{"startIndex":53319,"endIndex":53333,"tableCells":[{"startIndex":53320,"endIndex":53326,"content":[{"startIndex":53321,"endIndex":53326,"paragraph":{"elements":[{"startIndex":53321,"endIndex":53326,"textRun":{"content":"type\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":53326,"endIndex":53333,"content":[{"startIndex":53327,"endIndex":53333,"paragraph":{"elements":[{"startIndex":53327,"endIndex":53333,"textRun":{"content":"video\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":53333,"endIndex":53387,"tableCells":[{"startIndex":53334,"endIndex":53342,"content":[{"startIndex":53335,"endIndex":53342,"paragraph":{"elements":[{"startIndex":53335,"endIndex":53342,"textRun":{"content":"source\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":53342,"endIndex":53387,"content":[{"startIndex":53343,"endIndex":53387,"paragraph":{"elements":[{"startIndex":53343,"endIndex":53387,"textRun":{"content":"https://www.youtube.com/watch?v=7PKx3kS7f4A\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":53387,"endIndex":53469,"tableCells":[{"startIndex":53388,"endIndex":53397,"content":[{"startIndex":53389,"endIndex":53397,"paragraph":{"elements":[{"startIndex":53389,"endIndex":53397,"textRun":{"content":"caption\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":53397,"endIndex":53469,"content":[{"startIndex":53398,"endIndex":53469,"paragraph":{"elements":[{"startIndex":53398,"endIndex":53469,"textRun":{"content":"Optional video for the question - Why can't we just use Asimov's laws?\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":80,"unit":"PT"}}]}}},{"startIndex":53470,"endIndex":53471,"paragraph":{"elements":[{"startIndex":53470,"endIndex":53471,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":53471,"endIndex":54895,"paragraph":{"elements":[{"startIndex":53471,"endIndex":53562,"textRun":{"content":"The strategy to “raise it like a child\" assumes AI can develop human-like moral intuitions.","textStyle":{"bold":true}}},{"startIndex":53562,"endIndex":54511,"textRun":{"content":" Human children learn ethics through years of feedback and social interaction - why not train AI the same way? Start simple and gradually teach right from wrong through examples and reinforcement. This feels natural because it mirrors human development. The problem is that AI systems lack the evolutionary foundation that makes human moral development possible. Human children arrive with neural circuitry shaped by millions of years of social evolution - innate capacities for empathy, fairness, and social learning. AI systems develop through completely different processes, usually by predicting text or maximizing rewards. They don't experience human-like emotions or social bonds. An AI might learn to say ethical things, or even deeply understand ethics, without developing genuine care for human welfare. Even humans sometimes fail at moral development - psychopaths understand ethical principles but aren't motivated enough to act by them (","textStyle":{}}},{"startIndex":54511,"endIndex":54527,"textRun":{"content":"Cima et al, 2010","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://pmc.ncbi.nlm.nih.gov/articles/PMC2840845/"}}}},{"startIndex":54527,"endIndex":54895,"textRun":{"content":"). If we can't guarantee moral development in human children with evolutionary programming, we shouldn't expect it in artificial systems with alien architectures. Several people have argued that a sufficiently advanced AGI will be able to understand human moral values, the disagreement is usually around whether the AI would internalize them enough to abide by them.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":54895,"endIndex":54896,"paragraph":{"elements":[{"startIndex":54895,"endIndex":54896,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":54896,"endIndex":55056,"table":{"rows":3,"columns":2,"tableRows":[{"startIndex":54897,"endIndex":54911,"tableCells":[{"startIndex":54898,"endIndex":54904,"content":[{"startIndex":54899,"endIndex":54904,"paragraph":{"elements":[{"startIndex":54899,"endIndex":54904,"textRun":{"content":"type\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{