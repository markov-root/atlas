"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":121271,"endIndex":121273,"content":[{"startIndex":121272,"endIndex":121273,"paragraph":{"elements":[{"startIndex":121272,"endIndex":121273,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":121273,"endIndex":121305,"tableCells":[{"startIndex":121274,"endIndex":121286,"content":[{"startIndex":121275,"endIndex":121286,"paragraph":{"elements":[{"startIndex":121275,"endIndex":121286,"textRun":{"content":"source-url\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":121286,"endIndex":121305,"content":[{"startIndex":121287,"endIndex":121305,"paragraph":{"elements":[{"startIndex":121287,"endIndex":121289,"textRun":{"content":" (","textStyle":{}}},{"startIndex":121289,"endIndex":121303,"textRun":{"content":"Hassabis, 2025","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.businessinsider.com/google-deepmind-ceo-demis-hassabis-anthropic-ceo-ai-pressure-worries-2025-2"}}}},{"startIndex":121303,"endIndex":121305,"textRun":{"content":")\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":121305,"endIndex":121541,"tableCells":[{"startIndex":121306,"endIndex":121315,"content":[{"startIndex":121307,"endIndex":121315,"paragraph":{"elements":[{"startIndex":121307,"endIndex":121315,"textRun":{"content":"content\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":121315,"endIndex":121541,"content":[{"startIndex":121316,"endIndex":121540,"paragraph":{"elements":[{"startIndex":121316,"endIndex":121540,"textRun":{"content":"My hope is, you know, I've talked a lot in the past about a kind of CERN for AGI type setup, where basically an international research collaboration on the last few steps that we need to take towards building the first AGIs\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":121540,"endIndex":121541,"paragraph":{"elements":[{"startIndex":121540,"endIndex":121541,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":80,"unit":"PT"}}]}}},{"startIndex":121542,"endIndex":121543,"paragraph":{"elements":[{"startIndex":121542,"endIndex":121543,"textRun":{"content":"\n","textStyle":{"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":120.00001,"direction":"LEFT_TO_RIGHT"}}},{"startIndex":121543,"endIndex":122691,"paragraph":{"elements":[{"startIndex":121543,"endIndex":121567,"textRun":{"content":"CERN vs Intelsat for AI.","textStyle":{"bold":true}}},{"startIndex":121567,"endIndex":122203,"textRun":{"content":" An alternative model is that of Intelsat, the international consortium created in the 1960s to govern the deployment of global satellite communications. Unlike CERN, which is a model for collaborative research, Intelsat was created to manage a shared, operational technology with immense commercial and strategic value. At the time, there was a risk that a single superpower would monopolize satellite technology. Intelsat resolved this by creating an international treaty-based organization that pooled resources, shared access to the technology, and distributed its benefits among member states. This emerging framework proposed by (","textStyle":{}}},{"startIndex":122203,"endIndex":122224,"textRun":{"content":"MacAskill at al, 2025","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.forethought.org/research/intelsat-as-a-model-for-international-agi-governance"}}}},{"startIndex":122224,"endIndex":122691,"textRun":{"content":") may be also relevant to AGI, as the primary challenge is not just one of pure scientific discovery, but of managing the intense competitive race for a dual-use technology and preventing a single actor from achieving a dangerous monopoly. While a CERN-like body addresses the need for collaborative safety research, and MAGIC addresses the competition and incentives, an Intelsat-like body would focus on joint governance, equitable access, and strategic stability.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":122691,"endIndex":122692,"paragraph":{"elements":[{"startIndex":122691,"endIndex":122692,"textRun":{"content":"\n","textStyle":{"backgroundColor":{"color":{"rgbColor":{"red":1,"green":1,"blue":1}}},"foregroundColor":{"color":{"rgbColor":{"red":0.101960786,"green":0.10980392,"blue":0.11764706}}}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":120.00001,"direction":"LEFT_TO_RIGHT"}}},{"startIndex":122692,"endIndex":123150,"paragraph":{"elements":[{"startIndex":122692,"endIndex":122708,"textRun":{"content":"In summary, the ","textStyle":{"backgroundColor":{"color":{"rgbColor":{"red":1,"green":1,"blue":1}}},"foregroundColor":{"color":{"rgbColor":{"red":0.101960786,"green":0.10980392,"blue":0.11764706}}}}}},{"startIndex":122708,"endIndex":122712,"textRun":{"content":"CERN","textStyle":{"bold":true,"backgroundColor":{"color":{"rgbColor":{"red":1,"green":1,"blue":1}}},"foregroundColor":{"color":{"rgbColor":{"red":0.101960786,"green":0.10980392,"blue":0.11764706}}}}}},{"startIndex":122712,"endIndex":122725,"textRun":{"content":" is best for ","textStyle":{"backgroundColor":{"color":{"rgbColor":{"red":1,"green":1,"blue":1}}},"foregroundColor":{"color":{"rgbColor":{"red":0.101960786,"green":0.10980392,"blue":0.11764706}}}}}},{"startIndex":122725,"endIndex":122759,"textRun":{"content":"pre-AGI/ASI research collaboration","textStyle":{"italic":true,"backgroundColor":{"color":{"rgbColor":{"red":1,"green":1,"blue":1}}},"foregroundColor":{"color":{"rgbColor":{"red":0.101960786,"green":0.10980392,"blue":0.11764706}}}}}},{"startIndex":122759,"endIndex":122806,"textRun":{"content":" on safety problems. It's a science model. The ","textStyle":{"backgroundColor":{"color":{"rgbColor":{"red":1,"green":1,"blue":1}}},"foregroundColor":{"color":{"rgbColor":{"red":0.101960786,"green":0.10980392,"blue":0.11764706}}}}}},{"startIndex":122806,"endIndex":122828,"textRun":{"content":"MAGIC (in Narrow Path)","textStyle":{"bold":true,"backgroundColor":{"color":{"rgbColor":{"red":1,"green":1,"blue":1}}},"foregroundColor":{"color":{"rgbColor":{"red":0.101960786,"green":0.10980392,"blue":0.11764706}}}}}},{"startIndex":122828,"endIndex":122845,"textRun":{"content":" is suited for a ","textStyle":{"backgroundColor":{"color":{"rgbColor":{"red":1,"green":1,"blue":1}}},"foregroundColor":{"color":{"rgbColor":{"red":0.101960786,"green":0.10980392,"blue":0.11764706}}}}}},{"startIndex":122845,"endIndex":122897,"textRun":{"content":"monopolistic, final-stage development and deployment","textStyle":{"italic":true,"backgroundColor":{"color":{"rgbColor":{"red":1,"green":1,"blue":1}}},"foregroundColor":{"color":{"rgbColor":{"red":0.101960786,"green":0.10980392,"blue":0.11764706}}}}}},{"startIndex":122897,"endIndex":122951,"textRun":{"content":" of the first ASI. It's a control/monopoly model. The ","textStyle":{"backgroundColor":{"color":{"rgbColor":{"red":1,"green":1,"blue":1}}},"foregroundColor":{"color":{"rgbColor":{"red":0.101960786,"green":0.10980392,"blue":0.11764706}}}}}},{"startIndex":122951,"endIndex":122959,"textRun":{"content":"Intelsat","textStyle":{"bold":true,"backgroundColor":{"color":{"rgbColor":{"red":1,"green":1,"blue":1}}},"foregroundColor":{"color":{"rgbColor":{"red":0.101960786,"green":0.10980392,"blue":0.11764706}}}}}},{"startIndex":122959,"endIndex":122972,"textRun":{"content":" is aimed at ","textStyle":{"backgroundColor":{"color":{"rgbColor":{"red":1,"green":1,"blue":1}}},"foregroundColor":{"color":{"rgbColor":{"red":0.101960786,"green":0.10980392,"blue":0.11764706}}}}}},{"startIndex":122972,"endIndex":123032,"textRun":{"content":"governing a globally impactful, deployed dual-use technology","textStyle":{"italic":true,"backgroundColor":{"color":{"rgbColor":{"red":1,"green":1,"blue":1}}},"foregroundColor":{"color":{"rgbColor":{"red":0.101960786,"green":0.10980392,"blue":0.11764706}}}}}},{"startIndex":123032,"endIndex":123149,"textRun":{"content":" where preventing a race and ensuring shared access/benefits is key. It's a geopolitical/commercial governance model.","textStyle":{"backgroundColor":{"color":{"rgbColor":{"red":1,"green":1,"blue":1}}},"foregroundColor":{"color":{"rgbColor":{"red":0.101960786,"green":0.10980392,"blue":0.11764706}}}}}},{"startIndex":123149,"endIndex":123150,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":120.00001,"direction":"LEFT_TO_RIGHT"}}},{"startIndex":123150,"endIndex":123151,"paragraph":{"elements":[{"startIndex":123150,"endIndex":123151,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":123151,"endIndex":124122,"paragraph":{"elements":[{"startIndex":123151,"endIndex":123177,"textRun":{"content":"The myth of inevitability.","textStyle":{"bold":true}}},{"startIndex":123177,"endIndex":123465,"textRun":{"content":" History shows that international cooperation on high-stakes risks is entirely achievable. When the cost of inaction is too catastrophic, humanity has consistently come together to establish binding and verifiable rules to prevent global disasters or profound harms to human dignity. The ","textStyle":{}}},{"startIndex":123465,"endIndex":123515,"textRun":{"content":"Treaty on the Non-Proliferation of Nuclear Weapons","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://disarmament.unoda.org/wmd/nuclear/npt/"}}}},{"startIndex":123515,"endIndex":123531,"textRun":{"content":" (1968) and the ","textStyle":{}}},{"startIndex":123531,"endIndex":123560,"textRun":{"content":"Biological Weapons Convention","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://disarmament.unoda.org/biological-weapons/about/history/"}}}},{"startIndex":123560,"endIndex":123708,"textRun":{"content":" (1975) were negotiated and ratified at the height of the Cold War, proving that cooperation is possible despite mutual distrust and hostility. The ","textStyle":{}}},{"startIndex":123708,"endIndex":123725,"textRun":{"content":"Montreal Protocol","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://ozone.unep.org/treaties/montreal-protocol"}}}},{"startIndex":123725,"endIndex":123827,"textRun":{"content":" (1987) averted a global environmental catastrophe by phasing out ozone-depleting substances, and the ","textStyle":{}}},{"startIndex":123827,"endIndex":123858,"textRun":{"content":"UN Declaration on Human Cloning","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://press.un.org/en/2005/ga10333.doc.htm"}}}},{"startIndex":123858,"endIndex":124043,"textRun":{"content":" (2005) established a crucial global norm to safeguard human dignity from the potential harms of reproductive cloning. In the face of global, irreversible threats that know no borders, ","textStyle":{}}},{"startIndex":124043,"endIndex":124068,"textRun":{"content":"international cooperation","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://aigi.ox.ac.uk/publications/in-which-areas-of-technical-ai-safety-could-geopolitical-rivals-cooperate/"}}}},{"startIndex":124068,"endIndex":124122,"textRun":{"content":" is the most rational form of national self-interest.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":124122,"endIndex":124123,"paragraph":{"elements":[{"startIndex":124122,"endIndex":124123,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":124123,"endIndex":124134,"paragraph":{"elements":[{"startIndex":124123,"endIndex":124134,"textRun":{"content":"Deterrence\n","textStyle":{"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}}],"paragraphStyle":{"headingId":"h.6n286k8rfowx","namedStyleType":"HEADING_2","lineSpacing":120.00001,"direction":"LEFT_TO_RIGHT","keepLinesTogether":false,"keepWithNext":false}}},{"startIndex":124134,"endIndex":124135,"paragraph":{"elements":[{"startIndex":124134,"endIndex":124135,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":124135,"endIndex":124821,"paragraph":{"elements":[{"startIndex":124135,"endIndex":124286,"textRun":{"content":"Mutual Assured AI Malfunction (MAIM) is a deterrence regime where any state's attempt at unilateral ASI dominance would be met with sabotage by rivals.","textStyle":{"bold":true}}},{"startIndex":124286,"endIndex":124796,"textRun":{"content":" Unlike many safety approaches that focus on technical solutions alone, MAIM acknowledges the inherently competitive international environment in which AI development occurs. It combines deterrence (MAIM) with nonproliferation efforts and national competitiveness frameworks, viewing ASI development as fundamentally geopolitical and requiring state-level strategic management. This framework doesn't hope for global cooperation but instead creates incentives that align national interests with global safety (","textStyle":{}}},{"startIndex":124796,"endIndex":124818,"textRun":{"content":"Hendrycks et al., 2025","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.nationalsecurity.ai/"}}}},{"startIndex":124818,"endIndex":124821,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":124821,"endIndex":124822,"paragraph":{"elements":[{"startIndex":124821,"endIndex":124822,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":124822,"endIndex":125467,"paragraph":{"elements":[{"startIndex":124822,"endIndex":124875,"textRun":{"content":"A race for AI-enabled dominance endangers all states.","textStyle":{"bold":true}}},{"startIndex":124875,"endIndex":125467,"textRun":{"content":" If, in a hurried bid for superiority, one state inadvertently loses control of its AI, it jeopardizes the security of all states. Alternatively, if the same state succeeds in producing and controlling a highly capable AI, it likewise poses a direct threat to the survival of its peers. In either event, states seeking to secure their own survival may threaten to sabotage destabilizing AI projects for deterrence. A state could try to disrupt such an AI project with interventions ranging from covert operations that degrade training runs to physical damage that disables AI infrastructure.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":125467,"endIndex":125468,"paragraph":{"elements":[{"startIndex":125467,"endIndex":125468,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":125468,"endIndex":125826,"table":{"rows":3,"columns":2,"tableRows":[{"startIndex":125469,"endIndex":125484,"tableCells":[{"startIndex":125470,"endIndex":125476,"content":[{"startIndex":125471,"endIndex":125476,"paragraph":{"elements":[{"startIndex":125471,"endIndex":125476,"textRun":{"content":"type\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":125476,"endIndex":125484,"content":[{"startIndex":125477,"endIndex":125484,"paragraph":{"elements":[{"startIndex":125477,"endIndex":125484,"textRun":{"content":"figure\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TE