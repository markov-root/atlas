rt":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":33514,"endIndex":33611,"content":[{"startIndex":33515,"endIndex":33611,"paragraph":{"elements":[{"startIndex":33515,"endIndex":33611,"textRun":{"content":"Cybersecurity in AI: Weight security levels (WSL) and Algorithmic Secrets Security Levels (SSL)\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":33611,"endIndex":33629,"tableCells":[{"startIndex":33612,"endIndex":33623,"content":[{"startIndex":33613,"endIndex":33623,"paragraph":{"elements":[{"startIndex":33613,"endIndex":33623,"textRun":{"content":"collapsed\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":33623,"endIndex":33629,"content":[{"startIndex":33624,"endIndex":33629,"paragraph":{"elements":[{"startIndex":33624,"endIndex":33629,"textRun":{"content":"True\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":33629,"endIndex":37577,"tableCells":[{"startIndex":33630,"endIndex":33639,"content":[{"startIndex":33631,"endIndex":33639,"paragraph":{"elements":[{"startIndex":33631,"endIndex":33639,"textRun":{"content":"content\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":33639,"endIndex":37577,"content":[{"startIndex":33640,"endIndex":33641,"paragraph":{"elements":[{"startIndex":33640,"endIndex":33641,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":33641,"endIndex":33908,"paragraph":{"elements":[{"startIndex":33641,"endIndex":33855,"textRun":{"content":"Researchers have proposed formalizing security in AI using tiered frameworks that distinguish between protecting model weights (WSL) and algorithmic secrets (SSL) against various operational capacity threats (OC) (","textStyle":{}}},{"startIndex":33855,"endIndex":33872,"textRun":{"content":"Nevo et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.rand.org/pubs/research_reports/RRA2849-1.html"}}}},{"startIndex":33872,"endIndex":33873,"textRun":{"content":";","textStyle":{}}},{"startIndex":33873,"endIndex":33893,"textRun":{"content":" Snyder et al., 2020","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.rand.org/pubs/research_reports/RR2703.html"}}}},{"startIndex":33893,"endIndex":33894,"textRun":{"content":";","textStyle":{}}},{"startIndex":33894,"endIndex":33905,"textRun":{"content":" Dean, 2025","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://ai-2027.com/research/security-forecast"}}}},{"startIndex":33905,"endIndex":33908,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":33908,"endIndex":33909,"paragraph":{"elements":[{"startIndex":33908,"endIndex":33909,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":33909,"endIndex":34673,"paragraph":{"elements":[{"startIndex":33909,"endIndex":34073,"textRun":{"content":"Protecting weights (Model Weight Security Levels (WSL)) versus algorithmic secrets Algorithmic Secrets Security Levels (SSL) presents different security challenges.","textStyle":{"bold":true}}},{"startIndex":34073,"endIndex":34660,"textRun":{"content":" While model weights represent significant data volume (making exfiltration bandwidth-intensive), algorithmic secrets might be concisely explained in a short document or small code snippet (making them easier to exfiltrate through conventional means). Operational capacity (OC) basically defines the increasing sophistication of potential attackers, and the corresponding security level defines the ability to protect against them. For example, SSL1 and WSL1 correspond to the ability to robustly defend (95% probability) against OC1 attempts trying to steal frontier AI model weights  (","textStyle":{}}},{"startIndex":34660,"endIndex":34670,"textRun":{"content":"Dean, 2025","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://ai-2027.com/research/security-forecast"}}}},{"startIndex":34670,"endIndex":34673,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":34673,"endIndex":34836,"paragraph":{"elements":[{"startIndex":34673,"endIndex":34694,"textRun":{"content":"OC1: Amateur attempts","textStyle":{"bold":true}}},{"startIndex":34694,"endIndex":34836,"textRun":{"content":" - Hobbyist hackers or \"spray and pray\" attacks with budgets up to $1,000, lasting several days, with no preexisting infrastructure or access\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.1pyvuvhrxz4k","textStyle":{}}}},{"startIndex":34836,"endIndex":35035,"paragraph":{"elements":[{"startIndex":34836,"endIndex":34875,"textRun":{"content":"OC2: Professional opportunistic efforts","textStyle":{"bold":true}}},{"startIndex":34875,"endIndex":35035,"textRun":{"content":" - Individual professional hackers or groups executing untargeted attacks with budgets up to $10,000, lasting several weeks, with personal cyber infrastructure\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.1pyvuvhrxz4k","textStyle":{}}}},{"startIndex":35035,"endIndex":35260,"paragraph":{"elements":[{"startIndex":35035,"endIndex":35081,"textRun":{"content":"OC3: Cybercrime syndicates and insider threats","textStyle":{"bold":true}}},{"startIndex":35081,"endIndex":35260,"textRun":{"content":" - Criminal groups, terrorist organizations, disgruntled employees with budgets up to $1 million, lasting several months, with either significant infrastructure or insider access\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.1pyvuvhrxz4k","textStyle":{}}}},{"startIndex":35260,"endIndex":35469,"paragraph":{"elements":[{"startIndex":35260,"endIndex":35322,"textRun":{"content":"OC4: Standard operations by leading cyber-capable institutions","textStyle":{"bold":true}}},{"startIndex":35322,"endIndex":35469,"textRun":{"content":" - State-sponsored groups and intelligence agencies with budgets up to $10 million, year-long operations, vast infrastructure, and state resources\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.1pyvuvhrxz4k","textStyle":{}}}},{"startIndex":35469,"endIndex":35680,"paragraph":{"elements":[{"startIndex":35469,"endIndex":35531,"textRun":{"content":"OC5: Top-priority operations by the most capable nation-states","textStyle":{"bold":true}}},{"startIndex":35531,"endIndex":35680,"textRun":{"content":" - The world's most sophisticated actors with budgets up to $1 billion, multi-year operations, and state-level infrastructure developed over decades\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.1pyvuvhrxz4k","textStyle":{}}}},{"startIndex":35680,"endIndex":35681,"paragraph":{"elements":[{"startIndex":35680,"endIndex":35681,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":35681,"endIndex":35736,"paragraph":{"elements":[{"startIndex":35681,"endIndex":35723,"textRun":{"content":"Excerpt from AI 2027 - Security forecast (","textStyle":{}}},{"startIndex":35723,"endIndex":35733,"textRun":{"content":"Dean, 2025","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://ai-2027.com/research/security-forecast"}}}},{"startIndex":35733,"endIndex":35736,"textRun":{"content":"):\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":35736,"endIndex":35737,"paragraph":{"elements":[{"startIndex":35736,"endIndex":35737,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":35737,"endIndex":36512,"paragraph":{"elements":[{"startIndex":35737,"endIndex":35738,"textRun":{"content":"“","textStyle":{}}},{"startIndex":35738,"endIndex":36510,"textRun":{"content":"Frontier AI companies in the US had startup-level security not long ago, and achieving WSL3 is particularly challenging due to insider threats (OC3) being difficult to defend against. In December 2024 leading AI companies in the US, like OpenAI and Anthropic are startups with noteworthy but nonetheless early-stage efforts to increase security. Given the assumption that around 1000 of their current employees are able to interact with model weights as part of their daily research, and key aspects of their security measures probably relying on protocols such as NVIDIA’s confidential computing, we expect that their insider-threat mitigations are still holding them to the WSL2 standard. More established tech companies like Google might be at WSL3 on frontier weights.","textStyle":{"italic":true}}},{"startIndex":36510,"endIndex":36512,"textRun":{"content":"”\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":36512,"endIndex":36513,"paragraph":{"elements":[{"startIndex":36512,"endIndex":36513,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":36513,"endIndex":36918,"paragraph":{"elements":[{"startIndex":36513,"endIndex":36905,"textRun":{"content":"Here is a series of surveys conducted as part of the AI 2027 report to get a sense of where companies and research stand relative to these security levels. All surveys are from the Workshop Poll. 2024. \"Poll of Participants.\" Unpublished data from the AI Security Scenario Planning interactive session, FAR.Labs AI Security Workshop, Berkeley, CA, November 16, 2024. N=30, response rate 90% (","textStyle":{}}},{"startIndex":36905,"endIndex":36915,"textRun":{"content":"Dean, 2025","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://ai-2027.com/research/security-forecast"}}}},{"startIndex":36915,"endIndex":36918,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":36918,"endIndex":36919,"paragraph":{"elements":[{"startIndex":36918,"endIndex":36919,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":36919,"endIndex":37176,"table":{"rows":3,"columns":2,"tableRows":[{"startIndex":36920,"endIndex":36935,"tableCells":[{"startIndex":36921,"endIndex":36927,"content":[{"startIndex":36922,"endIndex":36927,"paragraph":{"elements":[{"startIndex":36922,"endIndex":36927,"textRun":{"content":"type\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpa