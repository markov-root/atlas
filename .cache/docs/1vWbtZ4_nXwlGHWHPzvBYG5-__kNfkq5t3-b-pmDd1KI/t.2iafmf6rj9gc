:5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":10806,"endIndex":11037,"content":[{"startIndex":10807,"endIndex":11036,"paragraph":{"elements":[{"startIndex":10807,"endIndex":11036,"textRun":{"content":"The study and application of moral principles to AI development and deployment, addressing questions of fairness, transparency, accountability, privacy, autonomy, and other human values that AI systems should respect or promote.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}},{"startIndex":11036,"endIndex":11037,"paragraph":{"elements":[{"startIndex":11036,"endIndex":11037,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":80,"unit":"PT"}}]}}},{"startIndex":11038,"endIndex":11039,"paragraph":{"elements":[{"startIndex":11038,"endIndex":11039,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":11039,"endIndex":11659,"paragraph":{"elements":[{"startIndex":11039,"endIndex":11137,"textRun":{"content":"AI ethics is the field that examines the moral principles and societal implications of AI systems.","textStyle":{"bold":true}}},{"startIndex":11137,"endIndex":11604,"textRun":{"content":" It addresses the ethical considerations of potential societal upheavals resulting from AI advancements and the moral frameworks necessary to navigate these changes. The core of AI ethics lies in ensuring that AI developments are aligned with human dignity, fairness, and societal well-being, through a deep understanding of their broader societal impact. Research in AI ethics would encompass, for example, privacy norms, identifying and mitigating bias in systems (","textStyle":{}}},{"startIndex":11604,"endIndex":11622,"textRun":{"content":"Huang et al., 2022","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://ieeexplore.ieee.org/abstract/document/9844014"}}}},{"startIndex":11622,"endIndex":11623,"textRun":{"content":";","textStyle":{}}},{"startIndex":11623,"endIndex":11637,"textRun":{"content":" Harvard, 2025","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://careerservices.fas.harvard.edu/blog/2025/05/01/what-is-ai-ethics/"}}}},{"startIndex":11637,"endIndex":11638,"textRun":{"content":";","textStyle":{}}},{"startIndex":11638,"endIndex":11656,"textRun":{"content":" Khan et al., 2022","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2109.07906"}}}},{"startIndex":11656,"endIndex":11659,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":11659,"endIndex":11660,"paragraph":{"elements":[{"startIndex":11659,"endIndex":11660,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":11660,"endIndex":12098,"paragraph":{"elements":[{"startIndex":11660,"endIndex":11919,"textRun":{"content":"Ethics complements technical safety approaches by providing normative guidance on what constitutes beneficial AI outcomes. Alignment focuses on ensuring AI systems pursue intended objectives, research in ethics focuses on which objectives are worth pursuing (","textStyle":{}}},{"startIndex":11919,"endIndex":11937,"textRun":{"content":"Huang et al., 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://ieeexplore.ieee.org/abstract/document/9844014"}}}},{"startIndex":11937,"endIndex":11938,"textRun":{"content":";","textStyle":{}}},{"startIndex":11938,"endIndex":11963,"textRun":{"content":" LaCroix & Luccioni, 2022","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2204.05151"}}}},{"startIndex":11963,"endIndex":12098,"textRun":{"content":"). AI ethics might also include discussions of digital rights and potentially even the rights of digital minds, and AIs in the future.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":12098,"endIndex":12099,"paragraph":{"elements":[{"startIndex":12098,"endIndex":12099,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":12099,"endIndex":12270,"paragraph":{"elements":[{"startIndex":12099,"endIndex":12270,"textRun":{"content":"This chapter focuses primarily on safety frameworks as they inform technical safety and governance strategies rather than exploring ethics, meta-ethics or digital rights.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":12270,"endIndex":12271,"paragraph":{"elements":[{"startIndex":12270,"endIndex":12271,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":12271,"endIndex":12282,"paragraph":{"elements":[{"startIndex":12271,"endIndex":12282,"textRun":{"content":"AI Control\n","textStyle":{}}}],"paragraphStyle":{"headingId":"h.ttjh2azhd9ub","namedStyleType":"HEADING_2","direction":"LEFT_TO_RIGHT"}}},{"startIndex":12282,"endIndex":12283,"paragraph":{"elements":[{"startIndex":12282,"endIndex":12283,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":12283,"endIndex":12661,"table":{"rows":4,"columns":2,"tableRows":[{"startIndex":12284,"endIndex":12303,"tableCells":[{"startIndex":12285,"end