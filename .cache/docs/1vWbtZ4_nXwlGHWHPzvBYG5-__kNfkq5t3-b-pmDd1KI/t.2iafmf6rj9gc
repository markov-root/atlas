},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":170572,"endIndex":170576,"content":[{"startIndex":170573,"endIndex":170574,"paragraph":{"elements":[{"startIndex":170573,"endIndex":170574,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}},{"startIndex":170574,"endIndex":170576,"paragraph":{"elements":[{"startIndex":170574,"endIndex":170575,"inlineObjectElement":{"inlineObjectId":"kix.o4pa3h7k45e6","textStyle":{}}},{"startIndex":170575,"endIndex":170576,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":170576,"endIndex":170631,"tableCells":[{"startIndex":170577,"endIndex":170586,"content":[{"startIndex":170578,"endIndex":170586,"paragraph":{"elements":[{"startIndex":170578,"endIndex":170586,"textRun":{"content":"caption\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":170586,"endIndex":170631,"content":[{"startIndex":170587,"endIndex":170631,"paragraph":{"elements":[{"startIndex":170587,"endIndex":170631,"textRun":{"content":"A combined flow chart of safety strategies.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":80,"unit":"PT"}}]}}},{"startIndex":170632,"endIndex":170633,"paragraph":{"elements":[{"startIndex":170632,"endIndex":170633,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":170633,"endIndex":171196,"paragraph":{"elements":[{"startIndex":170633,"endIndex":170771,"textRun":{"content":"Of course, even this fragile plan is the ideal plan on paper. It might be the case that this plan is insufficient or completely different.","textStyle":{"bold":true}}},{"startIndex":170771,"endIndex":171195,"textRun":{"content":" For example, in one scenario from the AI-2027 forecast, humanity survives not because of a grand strategic plan, but despite the failure of most governance, coordination, and deterrence efforts. Instead, a scary 'warning shot' event galvanizes the leading labs to slow down and implement just enough technical mitigations to avert disaster—mitigations that prove insufficient in the scenario branches where we lose control.","textStyle":{}}},{"startIndex":171195,"endIndex":171196,"textRun":{"content":"\n","textStyle":{"bold":true,"italic":true}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":171196,"endIndex":171197,"paragraph":{"elements":[{"startIndex":171196,"endIndex":171197,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":171197,"endIndex":171208,"paragraph":{"elements":[{"startIndex":171197,"endIndex":171208,"textRun":{"content":"Challenges\n","textStyle":{}}}],"paragraphStyle":{"headingId":"h.ta7opv55hwg2","namedStyleType":"HEADING_1","direction":"LEFT_TO_RIGHT"}}},{"startIndex":171208,"endIndex":171209,"paragraph":{"elements":[{"startIndex":171208,"endIndex":171209,"textRun":{"content":"\n","textStyle":{"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}}],"paragraphStyle":{"headingId":"h.7w6byt321vqo","namedStyleType":"HEADING_1","direction":"LEFT_TO_RIGHT","keepLinesTogether":false,"keepWithNext":false}}},{"startIndex":171209,"endIndex":171415,"table":{"rows":2,"columns":2,"tableRows":[{"startIndex":171210,"endIndex":171238,"tableCells":[{"startIndex":171211,"endIndex":171217,"content":[{"startIndex":171212,"endIndex":171217,"paragraph":{"elements":[{"startIndex":171212,"endIndex":171217,"textRun":{"content":"type\n","textStyle":{"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":171217,"endIndex":171238,"content":[{"startIndex":171218,"endIndex":171238,"paragraph":{"elements":[{"startIndex":171218,"endIndex":171238,"textRun":{"content":"section-description\n","textStyle":{"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":171238,"endIndex":171414,"tableCells":[{"startIndex":171239,"endIndex":171248,"content":[{"startIndex":171240,"endIndex":171248,"paragraph":{"elements":[{"startIndex":171240,"endIndex":171248,"textRun":{"content":"content\n","textStyle":{"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":171248,"endIndex":171414,"content":[{"startIndex":171249,"endIndex":171414,"paragraph":{"elements":[{"startIndex":171249,"endIndex":171413,"textRun":{"content":"AI safety is uniquely difficult because we must build reliable safeguards for opaque, rapidly evolving systems in a field with high-stakes geopolitical competition.","textStyle":{}}},{"startIndex":171413,"endIndex":171414,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":59.25,"unit":"PT"}},{"widthType":"FIXED_WIDTH","width":{"magnitude":408.75,"unit":"PT"}}]}}},{"startIndex":171415,"endIndex":171416,"paragraph":{"elements":[{"startIndex":171415,"endIndex":171416,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":171416,"endIndex":171675,"paragraph":{"elements":[{"startIndex":171416,"endIndex":171675,"textRun":{"content":"Developing strategies to ensure the safety of increasingly capable AI systems presents unique and significant challenges. These difficulties stem from the nature of AI itself, the current state of the research field, and the complexity of the risks involved.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":171675,"endIndex":171676,"paragraph":{"elements":[{"startIndex":171675,"endIndex":171676,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":171676,"endIndex":171847,"table":{"rows":6,"columns":2,"tableRows":[{"startIndex":171677,"endIndex":171691,"tableCells":[{"startIndex":171678,"endIndex":171684,"content":[{"startIndex":171679,"endIndex":171684,"paragraph":{"elements":[{"startIndex":171679,"endIndex":171684,"textRun":{"content":"type\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":171684,"endIndex":171691,"content":[{"startIndex":171685,"endIndex":171691,"paragraph":{"elements":[{"startIndex":171685,"endIndex":171691,"textRun":{"content":"quote\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":171691,"endIndex":171713,"tableCells":[{"startIndex":171692,"endIndex":171701,"content":[{"startIndex":171693,"endIndex":171701,"paragraph":{"elements":[{"startIndex":171693,"endIndex":171701,"textRun":{"content":"speaker\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":171701,"endIndex":171713,"content":[{"startIndex":171702,"endIndex":171713,"paragraph":{"elements":[{"startIndex":171702,"endIndex":171713,"textRun":{"content":" Anthropic\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":171713,"endIndex":171726,"tableCells":[{"startIndex":171714,"endIndex":171724,"content":[{"startIndex":171715,"endIndex":171724,"paragraph":{"elements":[{"startIndex":171715,"endIndex":171724,"textRun":{"content":"position\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":171724,"endIndex":171726,"content":[{"startIndex":171725,"endIndex":171726,"paragraph":{"elements":[{"startIndex":171725,"endIndex":171726,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":171726,"endIndex":171740,"tableCells":[{"startIndex":171727,"endIndex":171733,"content":[{"startIndex":171728,"endIndex":171733,"paragraph":{"elements":[{"startIndex":171728,"endIndex":171733,"textRun":{"content":"date\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":171733,"endIndex":171740,"content":[{"startIndex":171734,"endIndex":171740,"paragraph":{"elements":[{"startIndex":171734,"endIndex":171740,"textRun":{"content":" 2023\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":171740,"endIndex":171773,"tableCells":[{"startIndex":171741,"endIndex":171753,"content":[{"startIndex":171742,"endIndex":171753,"paragraph":{"elements":[{"startIndex":171742,"endIndex":171753,"textRun":{"content":"source-url\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":171753,"endIndex":171773,"content":[{"startIndex":171754,"endIndex":171773,"paragraph":{"elements":[{"startIndex":171754,"endIndex":171756,"textRun":{"content":" (","textStyle":{}}},{"startIndex":171756,"endIndex":171771,"textRun":{"content":"Anthropic, 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.anthropic.com/news/core-views-on-ai-safety"}}}},{"startIndex":171771,"endIndex":171773,"textRun":{"content":")\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":171773,"endIndex":171846,"tableCells":[{"startIndex":171774,"endIndex":171783,"content":[{"startIndex":171775,"endIndex":171783,"paragraph":{"elements":[{"startIndex":171775,"endIndex":171783,"textRun":{"content":"content\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":171783,"endIndex":171846,"content":[{"startIndex":171784,"endIndex":171845,"paragraph":{"elements":[{"startIndex":171784,"endIndex":171845,"textRun":{"content":"We do not know how to train systems to robustly behave well.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":171845,"endIndex":171846,"paragraph":{"elements":[{"startIndex":171845,"endIndex":171846,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":80,"unit":"PT"}}]}}},{"startIndex":171847,"endIndex":171848,"paragraph":{"elements":[{"startIndex":171847,"endIndex":171848,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":171848,"endIndex":171874,"paragraph":{"elements":[{"startIndex":171848,"endIndex":171874,"textRun":{"content":"The Nature of the Problem\n","textStyle":{}}}],"paragraphStyle":{"headingId":"h.qo6f3kwcg227","namedStyleType":"HEADING_2","direction":"LEFT_TO_RIGHT"}}},{"startIndex":171874,"endIndex":171875,"paragraph":{"elements":[{"startIndex":171874,"endIndex":171875,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":171875,"endIndex":171949,"paragraph":{"elements":[{"startIndex":171875,"endIndex":171949,"textRun":{"content":"Several intrinsic properties make AI safety a particularly hard problem :\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":171949,"endIndex":171950,"paragraph":{"elements":[{"startIndex":171949,"endIndex":171950,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":171950,"endIndex":172341,"paragraph":{"elements":[{"startIndex":171950,"endIndex":172013,"textRun":{"content":"AI risk is an emerging problem that is still poorly understood.","textStyle":{"bold":true}}},{"startIndex":172013,"endIndex":172341,"textRun":{"content":" AI risk is a relatively new field dealing with rapidly evolving technology. Our understanding of the full spectrum of potential failure modes and long-term consequences is incomplete. Devising robust safeguards for technologies that do not yet exist, but which could have profoundly negative outcomes, is inherently difficult.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":172341,"endIndex":172342,"paragraph":{"elements":[{"startIndex":172341,"endIndex":172342,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":172342,"endIndex":172848,"paragraph":{"elements":[{"startIndex":172342,"endIndex":172378,"textRun":{"content":"The field is still pre-paradigmatic.","textStyle":{"bold":true}}},{"startIndex":172378,"endIndex":172563,"textRun":{"content":" There is currently no single, universally accepted paradigm for AI safety. Researchers disagree on fundamental aspects, including the most likely threat models (e.g., sudden takeover (","textStyle":{}}},{"startIndex":172563,"endIndex":172578,"textRun":{"content":"Yudkowsky, 2022","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.alignmentforum.org/posts/uMQ3cqWDPHhjtiesc/agi-ruin-a-list-of-lethalities"}}}},{"startIndex":172578,"endIndex":172609,"textRun":{"content":") vs. gradual loss of control (","textStyle":{}}},{"startIndex":172609,"endIndex":172621,"textRun":{"content":"Critch, 2021","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.alignmentforum.org/posts/LpM3EAakwYdS6aRKf/what-multipolar-failure-looks-like-and-robust-agent-agnostic"}}}},{"startIndex":172621,"endIndex":172848,"textRun":{"content":")), and the most promising solution paths.  The research agendas of some researchers seem scarcely useful to others, and one of the favorite activities of alignment researchers is to criticize each other’s plan constructively.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":172848,"endIndex":172849,"paragraph":{"elements":[{"startIndex":172848,"endIndex":172849,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":172849,"endIndex":173307,"paragraph":{"elements":[{"startIndex":172849,"endIndex":172897,"textRun":{"content":"AIs are black boxes that are trained, not built.","textStyle":{"bold":true}}},{"startIndex":172897,"endIndex":173307,"textRun":{"content":" Modern deep learning models are \"black boxes.\" While we know how to train them, the specific algorithms they learn and their internal decision-making processes remain largely opaque. These models lack the apparent modularity common in traditional software engineering, making it difficult to decompose, analyze, or verify their behavior. Progress in interpretability has yet to fully overcome this challenge.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":173307,"endIndex":173308,"paragraph":{"elements":[{"startIndex":173307,"endIndex":173308,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":173308,"endIndex":174117,"paragraph":{"elements":[{"startIndex":173308,"endIndex":173353,"textRun":{"content":"Complexity is the source of many blind spots.","textStyle":{"bold":true}}},{"startIndex":173353,"endIndex":173574,"textRun":{"content":" The sheer complexity of large AI models means that unexpected and potentially harmful behaviors can emerge without warning. Issues like \"glitch tokens\", e.g., \"SolidGoldMagikarp\", causing erratic behavior in GPT models (","textStyle":{}}},{"startIndex":173574,"endIndex":173598,"textRun":{"content":"Rumbelow & Watkins, 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.alignmentforum.org/posts/aPeJE8bSo6rAFoLqg/solidgoldmagikarp-plus-prompt-generation"}}}},{"startIndex":173598,"endIndex":174117,"textRun":{"content":"),  demonstrate how unforeseen interactions between components (like tokenizers and training data) can lead to failures. When GPT encounters this infrequent word, it behaves unpredictably and erratically. This phenomenon occurs because GPT uses a tokenizer to break down sentences into tokens (sets of letters such as words or combinations of letters and numbers), and the token \"SolidGoldMagikarp\" was present in the tokenizer's dataset but not in the GPT model's dataset. This blind spot is not an isolated incident.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":174117,"endIndex":174118,"paragraph":{"elements":[{"startIndex":174117,"endIndex":174118,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":174118,"endIndex":174613,"paragraph":{"elements":[{"startIndex":174118,"endIndex":174169,"textRun":{"content":"Creating an exhaustive risk framework is difficult.","textStyle":{"bold":true}}},{"startIndex":174169,"endIndex":174272,"textRun":{"content":" There are many, many different classifications of risk scenarios that focus on various types of harm (","textStyle":{}}},{"startIndex":174272,"endIndex":174293,"textRun":{"content":"Critch & Russel, 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2306.06924"}}}},{"startIndex":174293,"endIndex":174294,"textRun":{"content":";","textStyle":{}}},{"startIndex":174294,"endIndex":174317,"textRun":{"content":" Hendrycks et al., 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2306.12001"}}}},{"startIndex":174317,"endIndex":174319,"textRun":{"content":"; ","textStyle":{}}},{"startIndex":174319,"endIndex":174340,"textRun":{"content":"Slattery et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2408.12622"}}}},{"startIndex":174340,"endIndex":174600,"textRun":{"content":"). Proposing a solid single-risk model beyond criticism is extremely difficult, and the risk scenarios often contain a degree of vagueness. No scenario captures most of the probability mass, and there is a wide diversity of potentially catastrophic scenarios (","textStyle":{}}},{"startIndex":174600,"endIndex":174610,"textRun":{"content":"Pace, 2020","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.alignmentforum.org/posts/6jkGf5WEKMpMFXZp2/what-failure-looks-like-distilling-the-discussion"}}}},{"startIndex":174610,"endIndex":174613,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":174613,"endIndex":174614,"paragraph":{"elements":[{"startIndex":174613,"endIndex":174614,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":174614,"endIndex":175119,"paragraph":{"elements":[{"startIndex":174614,"endIndex":174677,"textRun":{"content":"Some arguments that seem initially appealing may be misleading.","textStyle":{"bold":true}}},{"startIndex":174677,"endIndex":174726,"textRun":{"content":" For example, the principal author of the paper (","textStyle":{}}},{"startIndex":174726,"endIndex":174745,"textRun":{"content":"Turner et al., 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/1912.01683"}}}},{"startIndex":174745,"endIndex":174889,"textRun":{"content":") presenting a mathematical result on instrumental convergence, Alex Turner, now believes his theorem is a poor way to think about the problem (","textStyle":{}}},{"startIndex":174889,"endIndex":174901,"textRun":{"content":"Turner, 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.lesswrong.com/posts/dqSwccGTWyBgxrR58/turntrout-s-shortform-feed?commentId=Sw89AxHGJ5j7E7ETf"}}}},{"startIndex":174901,"endIndex":174994,"textRun":{"content":"). Some other classical arguments have been criticized recently, like the counting argument (","textStyle":{}}},{"startIndex":174994,"endIndex":175012,"textRun":{"content":"AI Optimists, 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://optimists.ai/2023/11/28/ai-is-easy-to-control/"}}}},{"startIndex":175012,"endIndex":175119,"textRun":{"content":") or the utility maximization frameworks, which will be discussed in the chapter \"Goal Misgeneralization\".\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":175119,"endIndex":175120,"paragraph":{"elements":[{"startIndex":175119,"endIndex":175120,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":175120,"endIndex":175511,"paragraph":{"elements":[{"startIndex":175120,"endIndex":175141,"textRun":{"content":"We may not have time.","textStyle":{"bold":true}}},{"startIndex":175141,"endIndex":175511,"textRun":{"content":" Many experts in the field believe that AGI, and shortly after ASI, could arrive before 2030. We need to solve these massive problems, or at least set the strategy for the launch, before it happens. For example, the scenario AI-2027, is based on a detailed forecasting of timelines of AGI arrival, and argues for a strong likelihood of ASI before the end of the decade.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":175511,"endIndex":175512,"paragraph":{"elements":[{"startIndex":175511,"endIndex":175512,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":175512,"endIndex":176192,"paragraph":{"elements":[{"startIndex":175512,"endIndex":175572,"textRun":{"content":"Many essential terms in AI safety are complicated to define.","textStyle":{"bold":true}}},{"startIndex":175572,"endIndex":176024,"textRun":{"content":" They often require knowledge in philosophy (epistemology, theory of mind) and AI. For instance, to determine if an AI is an agent, one must clarify \"what does agency mean?\" which, as we'll see in later chapters, requires nuance and may be an intrinsically ill-defined and fuzzy term. Some topics in AI safety are so challenging to grasp and are thought to be non-scientific in the machine learning community, such as discussing situational awareness (","textStyle":{}}},{"startIndex":176024,"endIndex":176036,"textRun":{"content":"Hinton, 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.youtube.com/watch?v=N1TEjTeQeg0"}}}},{"startIndex":176036,"endIndex":176192,"textRun":{"content":") or why AI might be able to \"really understand\". These concepts are far from consensus among philosophers and AI researchers and require a lot of caution.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":176192,"endIndex":176193,"paragraph":{"elements":[{"startIndex":176192,"endIndex":176193,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":176193,"endIndex":176618,"paragraph":{"elements":[{"startIndex":176193,"endIndex":176234,"textRun":{"content":"A simple solution probably doesn’t exist.","textStyle":{"bold":true}}},{"startIndex":176234,"endIndex":176618,"textRun":{"content":" For instance, the response to climate change is not just one measure, like saving electricity in winter at home. A whole range of potentially different solutions must be applied. Just as there are various problems to consider when building an airplane, similarly, when training and deploying an AI, a range of issues could arise, requiring precautions and various security measures.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":176618,"endIndex":176619,"paragraph":{"elements":[{"startIndex":176618,"endIndex":176619,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":176619,"endIndex":177078,"paragraph":{"elements":[{"startIndex":176619,"endIndex":176648,"textRun":{"content":"AI safety is hard to measure.","textStyle":{"bold":true}}},{"startIndex":176648,"endIndex":177078,"textRun":{"content":" Working on the problem can lead to an illusion of understanding, thereby creating the illusion of control. AI safety lacks clear feedback loops. Progress in AI capability advancement is relatively easy to measure and benchmark, while progress in safety is comparatively harder to measure. For example, it’s much easier to monitor the inference speed than to monitor the truthfulness of a system or monitor its safety properties.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":177078,"endIndex":177079,"paragraph":{"elements":[{"startIndex":177078,"endIndex":177079,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":177079,"endIndex":177108,"paragraph":{"elements":[{"startIndex":177079,"endIndex":177108,"textRun":{"content":"Uncertainty and Disagreement\n","textStyle":{}}}],"paragraphStyle":{"headingId":"h.rwsz6f8z341r","namedStyleType":"HEADING_2","direction":"LEFT_TO_RIGHT"}}},{"startIndex":177108,"endIndex":177109,"paragraph":{"elements":[{"startIndex":177108,"endIndex":177109,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":177109,"endIndex":177305,"paragraph":{"elements":[{"startIndex":177109,"endIndex":177199,"textRun":{"content":"The pre-paradigmatic nature of AI safety leads to significant disagreements among experts.","textStyle":{"bold":true}}},{"startIndex":177199,"endIndex":177305,"textRun":{"content":" These differences in perspective are crucial to understanding when evaluating these proposed strategies.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":177305,"endIndex":177306,"paragraph":{"elements":[{"startIndex":177305,"endIndex":177306,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":177306,"endIndex":177910,"paragraph":{"elements":[{"startIndex":177306,"endIndex":177378,"textRun":{"content":"The consequences of failures in AI alignment are steeped in uncertainty.","textStyle":{"bold":true}}},{"startIndex":177378,"endIndex":177572,"textRun":{"content":" New insights could challenge many high-level considerations discussed in this textbook. For instance, Zvi Mowshowitz has compiled a list of central questions marked by significant uncertainty (","textStyle":{}}},{"startIndex":177572,"endIndex":177588,"textRun":{"content":"Mowshowitz, 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://thezvi.substack.com/p/the-crux-list"}}}},{"startIndex":177588,"endIndex":177910,"textRun":{"content":"). For example, what worlds count as catastrophic versus non-catastrophic? What would count as a non-catastrophic outcome? What is valuable? What do we care about? If answered differently, these questions could significantly alter one's estimate of the likelihood and severity of catastrophes stemming from unaligned AGI.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":177910,"endIndex":177911,"paragraph":{"elements":[{"startIndex":177910,"endIndex":177911,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":177911,"endIndex":178596,"paragraph":{"elements":[{"startIndex":177911,"endIndex":177932,"textRun":{"content":"Divergent Worldviews.","textStyle":{"bold":true}}},{"startIndex":177932,"endIndex":178284,"textRun":{"content":" These disagreements often stem from fundamentally different worldviews. Some experts, like Robin Hanson, may approach AI risk through economic or evolutionary lenses, potentially leading to different conclusions about takeoff speeds and the likelihood of stable control compared to those focusing on agent foundations or technical alignment failures (","textStyle":{}}},{"startIndex":178284,"endIndex":178296,"textRun":{"content":"Hanson, 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.overcomingbias.com/p/ai-risk-again"}}}},{"startIndex":178296,"endIndex":178511,"textRun":{"content":"). Others, like Richard Sutton, have expressed views suggesting an acceptance or even embrace of AI potentially succeeding humanity, framing it as a natural evolutionary step rather than an existential catastrophe (","textStyle":{}}},{"startIndex":178511,"endIndex":178523,"textRun":{"content":"Sutton, 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.youtube.com/watch?v=NgHFMolXs3U"}}}},{"startIndex":178523,"endIndex":178596,"textRun":{"content":"). These differing philosophical stances influence strategic priorities.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":178596,"endIndex":178597,"paragraph":{"elements":[{"startIndex":178596,"endIndex":178597,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":178597,"endIndex":178612,"paragraph":{"elements":[{"startIndex":178597,"endIndex":178611,"textRun":{"content":"Safety Washing","textStyle":{"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}},{"startIndex":178611,"endIndex":178612,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"headingId":"h.n1wmagno4poy","namedStyleType":"HEADING_2","lineSpacing":120.00001,"direction":"LEFT_TO_RIGHT","keepLinesTogether":false,"keepWithNext":false}}},{"startIndex":178612,"endIndex":178613,"paragraph":{"elements":[{"startIndex":178612,"endIndex":178613,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":178613,"endIndex":178887,"paragraph":{"elements":[{"startIndex":178613,"endIndex":178870,"textRun":{"content":"The combination of high stakes, public concern, and lack of consensus creates fertile ground for \"safety washing\"—the practice of misleadingly portraying AI products, research, or practices as safer or more aligned with safety goals than they actually are (","textStyle":{}}},{"startIndex":178870,"endIndex":178884,"textRun":{"content":"Vaintrob, 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.lesswrong.com/posts/PY3HEHc5fMQkTrQo4/beware-safety-washing"}}}},{"startIndex":178884,"endIndex":178887,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":178887,"endIndex":178888,"paragraph":{"elements":[{"startIndex":178887,"endIndex":178888,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":178888,"endIndex":179556,"paragraph":{"elements":[{"startIndex":178888,"endIndex":178940,"textRun":{"content":"Safety washing can create a false sense of security.","textStyle":{"bold":true}}},{"startIndex":178940,"endIndex":179387,"textRun":{"content":" Companies developing powerful AI face incentives to appear safety-conscious to appease the public, regulators, and potential employees. Safetywashing can involve overstating the safety benefits of certain features, focusing on less critical aspects of safety while downplaying existential risks, or funding/conducting research that primarily advances capabilities under the guise of safety. This can lead to insufficient risk mitigation efforts (","textStyle":{}}},{"startIndex":179387,"endIndex":179398,"textRun":{"content":"Lizka, 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://forum.effectivealtruism.org/posts/f2qojPr8NaMPo2KJC/beware-safety-washing"}}}},{"startIndex":179398,"endIndex":179556,"textRun":{"content":"). It can misdirect funding and talent towards less impactful work and make it harder to build a genuine scientific consensus on the true state of AI safety.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":179556,"endIndex":179557,"paragraph":{"elements":[{"startIndex":179556,"endIndex":179557,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":179557,"endIndex":180750,"paragraph":{"elements":[{"startIndex":179557,"endIndex":179596,"textRun":{"content":"Assessing progress in safety is tricky.","textStyle":{"bold":true}}},{"startIndex":179596,"endIndex":179997,"textRun":{"content":" Even with the intention to help, actions might have a net negative impact (e.g., from second-order effects, like accelerating deployment of dangerous technologies), and determining the contribution's impact is far from trivial. For example, the impact of reinforcement learning from human feedback (RLHF), currently used to instruction-tune and make ChatGPT safer, is still debated in the community (","textStyle":{}}},{"startIndex":179997,"endIndex":180013,"textRun":{"content":"Christiano, 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.alignmentforum.org/posts/vwu4kegAEZTBtpT6p/thoughts-on-the-impact-of-rlhf-research"}}}},{"startIndex":180013,"endIndex":180251,"textRun":{"content":"). One reason the impact of RLHF may be negative is that this technique may create an illusion of alignment that would make spotting deceptive alignment even more challenging. The alignment of the systems trained through RLHF is shallow (","textStyle":{}}},{"startIndex":180251,"endIndex":180270,"textRun":{"content":"Casper et al., 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2307.15217"}}}},{"startIndex":180270,"endIndex":180426,"textRun":{"content":"), and the alignment properties might break with future, more situationally aware models. Similarly, certain interpretability work faces dual-use concerns (","textStyle":{}}},{"startIndex":180426,"endIndex":180437,"textRun":{"content":"Wache, 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.lesswrong.com/posts/x2n7mBLryDXuLwGhx/technical-ai-safety-research-landscape-slides"}}}},{"startIndex":180437,"endIndex":180648,"textRun":{"content":"). Some argue that much current \"AI safety\" research solves easy problems that primarily benefit developers economically, potentially speeding up capabilities rather than meaningfully reducing existential risk (","textStyle":{}}},{"startIndex":180648,"endIndex":180660,"textRun":{"content":"catubc, 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.lesswrong.com/posts/vkzmbf4Mve4GNyJaF/the-case-for-stopping-ai-safety-research"}}}},{"startIndex":180660,"endIndex":180750,"textRun":{"content":"). As a consequence, even well-intentioned research might inadvertently accelerate risks.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":180750,"endIndex":180751,"paragraph":{"elements":[{"startIndex":180750,"endIndex":180751,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":180751,"endIndex":180762,"paragraph":{"elements":[{"startIndex":180751,"endIndex":180762,"textRun":{"content":"Conclusion\n","textStyle":{"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}}],"paragraphStyle":{"headingId":"h.mmmmvsgfdx5x","namedStyleType":"HEADING_1","direction":"LEFT_TO_RIGHT","keepLinesTogether":false,"keepWithNext":false}}},{"startIndex":180762,"endIndex":180763,"paragraph":{"elements":[{"startIndex":180762,"endIndex":180763,"textRun":{"content":"\n","textStyle":{"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}}],"paragraphStyle":{"headingId":"h.q47az5hw3amq","namedStyleType":"HEADING_1","direction":"LEFT_TO_RIGHT","keepLinesTogether":false,"keepWithNext":false}}},{"startIndex":180763,"endIndex":180981,"table":{"rows":2,"columns":2,"tableRows":[{"startIndex":180764,"endIndex":180792,"tableCells":[{"startIndex":180765,"endIndex":180771,"content":[{"startIndex":180766,"endIndex":180771,"paragraph":{"elements":[{"startIndex":180766,"endIndex":180771,"textRun":{"content":"type\n","textStyle":{"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":180771,"endIndex":180792,"content":[{"startIndex":180772,"endIndex":180792,"paragraph":{"elements":[{"startIndex":180772,"endIndex":180792,"textRun":{"content":"section-description\n","textStyle":{"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":180792,"endIndex":180980,"tableCells":[{"startIndex":180793,"endIndex":180802,"content":[{"startIndex":180794,"endIndex":180802,"paragraph":{"elements":[{"startIndex":180794,"endIndex":180802,"textRun":{"content":"content\n","textStyle":{"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":180802,"endIndex":180980,"content":[{"startIndex":180803,"endIndex":180980,"paragraph":{"elements":[{"startIndex":180803,"endIndex":180980,"textRun":{"content":"Navigating AI risk requires combining diverse strategies while acknowledging profound uncertainty; continued research into safety approaches themselves is a strategic priority.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":59.25,"unit":"PT"}},{"widthType":"FIXED_WIDTH","width":{"magnitude":408.75,"unit":"PT"}}]}}},{"startIndex":180981,"endIndex":180982,"paragraph":{"elements":[{"startIndex":180981,"endIndex":180982,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"headingId":"h.yvipxpj5ty7k","namedStyleType":"HEADING_1","direction":"LEFT_TO_RIGHT"}}},{"startIndex":180982,"endIndex":181299,"paragraph":{"elements":[{"startIndex":180982,"endIndex":181068,"textRun":{"content":"The strategic landscape for ensuring AI safety is vast, complex, and rapidly evolving.","textStyle":{"bold":true}}},{"startIndex":181068,"endIndex":181299,"textRun":{"content":" It spans a wide spectrum from controlling access to current models to prevent misuse, through intricate technical challenges in aligning AGI, to speculative geopolitical maneuvering and philosophical considerations regarding ASI.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":181299,"endIndex":181300,"paragraph":{"elements":[{"startIndex":181299,"endIndex":181300,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":181300,"endIndex":182219,"paragraph":{"elements":[{"startIndex":181300,"endIndex":181349,"textRun":{"content":"No single strategy appears sufficient on its own.","textStyle":{"bold":true}}},{"startIndex":181349,"endIndex":182219,"textRun":{"content":" Preventing misuse requires a combination of technical safeguards like circuit breakers and unlearning, access controls like monitored APIs and potentially KYC for compute, and careful consideration of release strategies, particularly regarding open-source models. Ensuring AGI safety involves pursuing alignment—attempting to instill the right goals—while simultaneously developing control mechanisms to mitigate harm even if alignment fails. This relies heavily on improving our ability to evaluate AI behavior and understand internal model workings, facing challenges like alignment faking and the fragility of transparency. Addressing potential risks from ASI pushes the boundaries further, involving strategies like automating alignment research, exploring inherently safe system designs, and navigating complex international coordination and deterrence scenarios.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":182219,"endIndex":182220,"paragraph":{"elements":[{"startIndex":182219,"endIndex":182220,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":182220,"endIndex":182754,"paragraph":{"elements":[{"startIndex":182220,"endIndex":182306,"textRun":{"content":"Underpinning all technical approaches is the need for robust systemic safety measures.","textStyle":{"bold":true}}},{"startIndex":182306,"endIndex":182754,"textRun":{"content":" Effective AI governance, encompassing international agreements on red lines or conditional commitments, alongside national regulations and compute oversight, is crucial. Within organizations, strong security practices, standardized risk management frameworks, transparency through documentation, and a culture prioritizing safety are essential. Building scientific and public consensus on the nature and severity of risks remains a key challenge.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":182754,"endIndex":182755,"paragraph":{"elements":[{"startIndex":182754,"endIndex":182755,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":182755,"endIndex":183442,"paragraph":{"elements":[{"startIndex":182755,"endIndex":182909,"textRun":{"content":"Fundamental tensions persist throughout the strategic landscape: centralization versus decentralization, speed versus safety, and openness versus control.","textStyle":{"bold":true}}},{"startIndex":182909,"endIndex":183442,"textRun":{"content":" Navigating these tradeoffs requires careful analysis, adaptation, and a willingness to engage with diverse perspectives and deep uncertainties. While the challenges are daunting, the ongoing research, dialogue, and development of new strategies offer pathways—albeit narrow and demanding—towards harnessing the transformative potential of AI safely and for the benefit of humanity. Continued vigilance, critical thinking, and collaborative effort across technical, policy, and societal domains will be paramount in the years ahead.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":183442,"endIndex":183443,"paragraph":{"elements":[{"startIndex":183442,"endIndex":183443,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":183443,"endIndex":183734,"paragraph":{"elements":[{"startIndex":183443,"endIndex":183734,"textRun":{"content":"Given the uncertainties and the pre-paradigmatic nature of the field, continued research into safety strategies themselves is essential. This includes refining existing approaches, developing new ones, and critically evaluating their effectiveness, scalability, and potential failure modes.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":183734,"endIndex":183735,"paragraph":{"elements":[{"startIndex":183734,"endIndex":183735,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":183735,"endIndex":183736,"paragraph":{"elements":[{"startIndex":183735,"endIndex":183736,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":183736,"endIndex":183737,"paragraph":{"elements":[{"startIndex":183736,"endIndex":183737,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":183737,"endIndex":183738,"paragraph":{"elements":[{"startIndex":183737,"endIndex":183738,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":183738,"endIndex":183768,"paragraph":{"elements":[{"startIndex":183738,"endIndex":183768,"textRun":{"content":"Appendix: Long-term questions\n","textStyle":{}}}],"paragraphStyle":{"headingId":"h.6v2ihfrd8x5l","namedStyleType":"HEADING_1","direction":"LEFT_TO_RIGHT"}}},{"startIndex":183768,"endIndex":183769,"paragraph":{"elements":[{"startIndex":183768,"endIndex":183769,"textRun":{"content":"\n","textStyle":{"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}}],"paragraphStyle":{"headingId":"h.k5e5c0149dd5","namedStyleType":"HEADING_1","direction":"LEFT_TO_RIGHT","keepLinesTogether":false,"keepWithNext":false}}},{"startIndex":183769,"endIndex":184011,"table":{"rows":2,"columns":2,"tableRows":[{"startIndex":183770,"endIndex":183798,"tableCells":[{"startIndex":183771,"endIndex":183777,"content":[{"startIndex":183772,"endIndex":183777,"paragraph":{"elements":[{"startIndex":183772,"endIndex":183777,"textRun":{"content":"type\n","textStyle":{"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":183777,"endIndex":183798,"content":[{"startIndex":183778,"endIndex":183798,"paragraph":{"elements":[{"startIndex":183778,"endIndex":183798,"textRun":{"content":"section-description\n","textStyle":{"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":183798,"endIndex":184010,"tableCells":[{"startIndex":183799,"endIndex":183808,"content":[{"startIndex":183800,"endIndex":183808,"paragraph":{"elements":[{"startIndex":183800,"endIndex":183808,"textRun":{"content":"content\n","textStyle":{"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":183808,"endIndex":184010,"content":[{"startIndex":183809,"endIndex":184010,"paragraph":{"elements":[{"startIndex":183809,"endIndex":184010,"textRun":{"content":"Solving alignment ultimately forces us to confront unresolved philosophical dilemmas: what values should AI serve, and should humanity's goal be its own survival or the creation of a worthy successor?\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":59.25,"unit":"PT"}},{"widthType":"FIXED_WIDTH","width":{"magnitude":408.75,"unit":"PT"}}]}}},{"startIndex":184011,"endIndex":184012,"paragraph":{"elements":[{"startIndex":184011,"endIndex":184012,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","shading":{"backgroundColor":{}}}}},{"startIndex":184012,"endIndex":184228,"paragraph":{"elements":[{"startIndex":184012,"endIndex":184228,"textRun":{"content":"The main chapter focuses on actionable strategies. This appendix explores the deeper, often unresolved philosophical questions that underpin the alignment problem, providing context for long-term strategic thinking.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":184228,"endIndex":184229,"paragraph":{"elements":[{"startIndex":184228,"endIndex":184229,"textRun":{"content":"\n","textStyle":{"backgroundColor":{"color":{"rgbColor":{"red":1,"green":1,"blue":1}}},"foregroundColor":{"color":{"rgbColor":{"red":0.101960786,"green":0.10980392,"blue":0.11764706}}},"fontSize":{"magnitude":10.5,"unit":"PT"}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":184229,"endIndex":184265,"paragraph":{"elements":[{"startIndex":184229,"endIndex":184265,"textRun":{"content":"Prioritize Flourishing or Survival?\n","textStyle":{}}}],"paragraphStyle":{"headingId":"h.7igzrucu9qt2","namedStyleType":"HEADING_2","direction":"LEFT_TO_RIGHT"}}},{"startIndex":184265,"endIndex":184266,"paragraph":{"elements":[{"startIndex":184265,"endIndex":184266,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":184266,"endIndex":184333,"paragraph":{"elements":[{"startIndex":184266,"endIndex":184333,"textRun":{"content":"Mitigating catastrophic AI risks is not enough to make AI go well.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":184333,"endIndex":184334,"paragraph":{"elements":[{"startIndex":184333,"endIndex":184334,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":184334,"endIndex":185072,"paragraph":{"elements":[{"startIndex":184334,"endIndex":184511,"textRun":{"content":"A strategic question, with significant implications for resource allocation, is the tension between ensuring humanity’s long-term survival and shaping the quality of its future.","textStyle":{"bold":true}}},{"startIndex":184511,"endIndex":184876,"textRun":{"content":" Much of the AI safety field, for historical reasons, has focused on mitigating those risks—ensuring that we survive the transition to superintelligence. However, a complementary approach, championed by researchers like William MacAskill at Forethought, argues that merely surviving is not enough; we must also work to ensure that the future is one of flourishing (","textStyle":{}}},{"startIndex":184876,"endIndex":184893,"textRun":{"content":"Forethought, 2025","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.forethought.org/research/better-futures"}}}},{"startIndex":184893,"endIndex":185072,"textRun":{"content":"). This raises a difficult question: given limited resources, is it prudent to focus on achieving a \"great\" future when so much work remains to be done to simply secure a future?\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":185072,"endIndex":185073,"paragraph":{"elements":[{"startIndex":185072,"endIndex":185073,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":185073,"endIndex":185340,"table":{"rows":3,"columns":2,"tableRows":[{"startIndex":185074,"endIndex":185089,"tableCells":[{"startIndex":185075,"endIndex":185081,"content":[{"startIndex":185076,"endIndex":185081,"paragraph":{"elements":[{"startIndex":185076,"endIndex":185081,"textRun":{"content":"type\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":185081,"endIndex":185089,"content":[{"startIndex":185082,"endIndex":185089,"paragraph":{"elements":[{"startIndex":185082,"endIndex":185089,"textRun":{"content":"figure\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":185089,"endIndex":185103,"tableCells":[{"startIndex":185090,"endIndex":185099,"content":[{"startIndex":185091,"endIndex":185099,"paragraph":{"elements":[{"startIndex":185091,"endIndex":185099,"textRun":{"content":"content\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":185099,"endIndex":185103,"content":[{"startIndex":185100,"endIndex":185101,"paragraph":{"elements":[{"startIndex":185100,"endIndex":185101,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}},{"startIndex":185101,"endIndex":185103,"paragraph":{"elements":[{"startIndex":185101,"endIndex":185102,"inlineObjectElement":{"inlineObjectId":"kix.6nxrdeiqqhpr","textStyle":{}}},{"startIndex":185102,"endIndex":185103,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":185103,"endIndex":185339,"tableCells":[{"startIndex":185104,"endIndex":185113,"content":[{"startIndex":185105,"endIndex":185113,"paragraph":{"elements":[{"startIndex":185105,"endIndex":185113,"textRun":{"content":"caption\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":185113,"endIndex":185339,"content":[{"startIndex":185114,"endIndex":185339,"paragraph":{"elements":[{"startIndex":185114,"endIndex":185339,"textRun":{"content":"“Well, even if we survive, we probably just get a future that’s a small fraction as good as it could have been.  We could, instead, try to help guide society to be on track to a truly wonderful future.” - William MacAskill.\u000b\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":80,"unit":"PT"}}]}}},{"startIndex":185340,"endIndex":185341,"paragraph":{"elements":[{"startIndex":185340,"endIndex":185341,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":185341,"endIndex":186191,"paragraph":{"elements":[{"startIndex":185341,"endIndex":186191,"textRun":{"content":"The case for prioritizing flourishing stems from the concern that even a future free from existential catastrophe could fall drastically short of its potential. Without deliberate effort, society may not naturally converge on a morally good outcome; instead, it could settle into a state of mediocrity or even lock in subtle but major moral errors. To avoid the historical dangers of rigid utopian movements, this line of thinking advocates not for a specific, narrow vision of an ideal world, but for achieving \"viatopia\"—a state where society has the wisdom, coordination, and stability to guide itself towards the best possible futures, whatever they may be. A viatopian state would be characterized by very low existential risk, the flourishing of diverse moral viewpoints, and the capacity for thoughtful, reflective collective decision-making.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":186191,"endIndex":186192,"paragraph":{"elements":[{"startIndex":186191,"endIndex":186192,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":186192,"endIndex":186609,"paragraph":{"elements":[{"startIndex":186192,"endIndex":186609,"textRun":{"content":"The strategic implication is a choice of emphasis: should we design AI systems solely as contained tools to solve immediate problems and prevent catastrophe? Or should we also prioritize developing AI that enhances human reasoning, facilitates better coordination, and helps us deliberate on the very values we should instill in our successors, thereby steering us closer to a state of viatopia? The debate is open. \n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":186609,"endIndex":186610,"paragraph":{"elements":[{"startIndex":186609,"endIndex":186610,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":186610,"endIndex":186629,"paragraph":{"elements":[{"startIndex":186610,"endIndex":186629,"textRun":{"content":"Alignment to what?\n","textStyle":{}}}],"paragraphStyle":{"headingId":"h.jyqc24pbpvvr","namedStyleType":"HEADING_2","lineSpacing":120.00001,"direction":"LEFT_TO_RIGHT","keepLinesTogether":false,"keepWithNext":false}}},{"startIndex":186629,"endIndex":186630,"paragraph":{"elements":[{"startIndex":186629,"endIndex":186630,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":186630,"endIndex":187412,"paragraph":{"elements":[{"startIndex":186630,"endIndex":186786,"textRun":{"content":"Coherent Extrapolated Volition (CEV) attempts to identify what humans would collectively want if we were smarter, more informed, and more morally developed.","textStyle":{"bold":true}}},{"startIndex":186786,"endIndex":187394,"textRun":{"content":" It proposes that instead of directly programming specific values into a superintelligent AI, we should program it to figure out what humans would want if we overcame our cognitive limitations. When we train AI systems on current human preferences, we risk encoding our biases, contradictions, and shortsightedness. CEV instead asks: what \"would we want\" if we knew more, thought faster, or were more the people we wished to be, and had grown up further together? Essentially, picture the ideal version of humanity that could theoretically exist in the future. Tell the AI to take actions according to that (","textStyle":{}}},{"startIndex":187394,"endIndex":187409,"textRun":{"content":"Yudkowsky, 2004","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://intelligence.org/files/CEV.pdf"}}}},{"startIndex":187409,"endIndex":187412,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":120.00001,"direction":"LEFT_TO_RIGHT"}}},{"startIndex":187412,"endIndex":187413,"paragraph":{"elements":[{"startIndex":187412,"endIndex":187413,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":187413,"endIndex":188082,"paragraph":{"elements":[{"startIndex":187413,"endIndex":188082,"textRun":{"content":"CEV tried to create a path for AI to respect our deeper intentions rather than our immediate desires. The practical implementation of CEV remains speculative. It would require sophisticated modeling of human psychology, ethical development, and social dynamics—capabilities beyond current AI systems. Modern approaches like RLHF (Reinforcement Learning from Human Feedback) can be seen as primitive precursors that align AI with current human preferences rather than extrapolated ones. Constitutional AI frameworks move slightly closer to CEV by trying to encode higher-level principles rather than specific preferences, but still fall far short of full extrapolation.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":120.00001,"direction":"LEFT_TO_RIGHT"}}},{"startIndex":188082,"endIndex":188083,"paragraph":{"elements":[{"startIndex":188082,"endIndex":188083,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":188083,"endIndex":189029,"paragraph":{"elements":[{"startIndex":188083,"endIndex":188259,"textRun":{"content":"Coherent Aggregated Volition (CAV) finds a coherent set of goals and beliefs that best represent humanity's current values without attempting to extrapolate future development.","textStyle":{"bold":true}}},{"startIndex":188259,"endIndex":189012,"textRun":{"content":" Ben Goertzel proposed this alternative to CEV, focusing on current human values rather than speculating about our idealized future selves. CAV treats goals and beliefs together as \"gobs\" (goal and belief sets) and seeks to find a maximally consistent, compact set that maintains similarity to diverse human perspectives. Unlike CEV, which assumes our values would converge if we became more enlightened, CAV acknowledges that fundamental value differences might persist. It aims to create a coherent aggregation that balances different perspectives rather than trying to predict how those perspectives might evolve. This makes CAV potentially more feasible to implement, as it works with observable current values rather than hypothetical future ones (","textStyle":{}}},{"startIndex":189012,"endIndex":189026,"textRun":{"content":"Goertzel, 2010","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://multiverseaccordingtoben.blogspot.com/2010/03/coherent-aggregated-volition-toward.html"}}}},{"startIndex":189026,"endIndex":189029,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":120.00001,"direction":"LEFT_TO_RIGHT"}}},{"startIndex":189029,"endIndex":189030,"paragraph":{"elements":[{"startIndex":189029,"endIndex":189030,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":189030,"endIndex":190278,"paragraph":{"elements":[{"startIndex":189030,"endIndex":189206,"textRun":{"content":"Coherent Blended Volition (CBV) emphasizes that human values should be creatively \"blended\" through human-guided processes rather than algorithmically averaged or extrapolated.","textStyle":{"bold":true}}},{"startIndex":189206,"endIndex":189971,"textRun":{"content":" CBV refines CAV by addressing potential misinterpretations. When discussing value aggregation, many assume it means simple averaging or majority voting. CBV instead proposes a creative blending process that produces new, harmonious value systems that all participants would recognize as adequately representing their contributions. The concept draws from cognitive science theories of conceptual blending, where new ideas emerge from the creative combination of existing ones. In this framework, the process of determining AI values would be guided by humans through collaborative processes rather than delegated to AI systems. This addresses concerns about AI paternalism, where machines might override human autonomy in the name of our \"extrapolated\" interests (","textStyle":{}}},{"startIndex":189971,"endIndex":189992,"textRun":{"content":"Goertzel & Pitt, 2012","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://jetpress.org/v22/goertzel-pitt.htm"}}}},{"startIndex":189992,"endIndex":190206,"textRun":{"content":"). CBV connects to contemporary discussions about participatory AI governance and democratic oversight of AI development. Systems like vTaiwan have implemented CBV-like processes for technology policy development (","textStyle":{}}},{"startIndex":190206,"endIndex":190219,"textRun":{"content":"vTaiwan, 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://info.vtaiwan.tw/"}}}},{"startIndex":190219,"endIndex":190278,"textRun":{"content":"), showing how human-guided blending can work in practice.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":120.00001,"direction":"LEFT_TO_RIGHT"}}},{"startIndex":190278,"endIndex":190279,"paragraph":{"elements":[{"startIndex":190278,"endIndex":190279,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":190279,"endIndex":190298,"paragraph":{"elements":[{"startIndex":190279,"endIndex":190298,"textRun":{"content":"Alignment to whom?\n","textStyle":{}}}],"paragraphStyle":{"headingId":"h.bgviqkz5fsci","namedStyleType":"HEADING_2","lineSpacing":120.00001,"direction":"LEFT_TO_RIGHT","keepLinesTogether":false,"keepWithNext":false}}},{"startIndex":190298,"endIndex":190299,"paragraph":{"elements":[{"startIndex":190298,"endIndex":190299,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":190299,"endIndex":191809,"paragraph":{"elements":[{"startIndex":190299,"endIndex":190407,"textRun":{"content":"Single-Single Alignment: Getting a single AI system to reliably pursue the goals of a single human operator.","textStyle":{"bold":true}}},{"startIndex":190407,"endIndex":190981,"textRun":{"content":" We haven't even solved this, and it presents significant challenges. An AI could be aligned to follow literal commands (like \"fetch coffee\"), interpret intended meaning (understanding that \"fetch coffee\" means making it the way you prefer it), pursue what you should have wanted (like suggesting tea if coffee would be unhealthy), or act in your best interests regardless of commands. Following literal commands often leads to failures of specification that we talk about later in the section. Most often, researchers use the word alignment to mean the \"intent alignment\" (","textStyle":{}}},{"startIndex":190981,"endIndex":190997,"textRun":{"content":"Christiano, 2018","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://ai-alignment.com/clarifying-ai-alignment-cec47cd69dd6"}}}},{"startIndex":190997,"endIndex":191167,"textRun":{"content":"), and some more philosophical discussions go into the third - do what I (or humanity) would have wanted. This involves things like coherent extrapolated volition (CEV) (","textStyle":{}}},{"startIndex":191167,"endIndex":191182,"textRun":{"content":"Yudkowsky, 2004","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://intelligence.org/files/CEV.pdf"}}}},{"startIndex":191182,"endIndex":191221,"textRun":{"content":"), coherent aggregated volition (CAV) (","textStyle":{}}},{"startIndex":191221,"endIndex":191235,"textRun":{"content":"Goertzel, 2010","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://multiverseaccordingtoben.blogspot.com/2010/03/coherent-aggregated-volition-toward.html"}}}},{"startIndex":191235,"endIndex":191809,"textRun":{"content":"), and various other lines of thought that go into meta-ethics discourse. We will not be talking extensively about philosophical discourse in this text and will stick largely to intent alignment and a machine learning perspective. When we use the word \"alignment\" in this text, we will basically be referring to problems and failures from single-single alignment. Other types of alignment have been historically very under-researched, because people have mostly been working with the idea of a singular superintelligence that interacts with humanity as a singular monolith.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":120.00001,"direction":"LEFT_TO_RIGHT"}}},{"startIndex":191809,"endIndex":191810,"paragraph":{"elements":[{"startIndex":191809,"endIndex":191810,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":191810,"endIndex":192327,"paragraph":{"elements":[{"startIndex":191810,"endIndex":191866,"textRun":{"content":"Single-Multi Alignment - Aligning Many AIs to One Human.","textStyle":{"bold":true}}},{"startIndex":191866,"endIndex":192327,"textRun":{"content":" If we think ASI will be composed of smaller intelligences which are working together, delegating tasks, and functioning together as a superorganism, then all of the problems of single single alignment would still remain because we still need to figure out single-single before we attempt single-multi. Ideally, we don't want any single human (or a very small group of humans) to be in charge of a superintelligence (assuming benevolent dictators don't exist).\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":120.00001,"direction":"LEFT_TO_RIGHT"}}},{"startIndex":192327,"endIndex":192328,"paragraph":{"elements":[{"startIndex":192327,"endIndex":192328,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":192328,"endIndex":192951,"paragraph":{"elements":[{"startIndex":192328,"endIndex":192384,"textRun":{"content":"Multi-Single alignment - aligning one AI to many humans.","textStyle":{"bold":true}}},{"startIndex":192384,"endIndex":192951,"textRun":{"content":" When multiple humans share control of a single AI system, we face the challenge of whose values and preferences should take priority. Rather than trying to literally aggregate everyone's individual preferences (which could lead to contradictions or lowest-common-denominator outcomes), a more promising approach is aligning the AI to higher-level principles and institutional values - similar to how democratic institutions operate according to principles like transparency and accountability rather than trying to directly optimize for every citizen's preferences.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":120.00001,"direction":"LEFT_TO_RIGHT"}}},{"startIndex":192951,"endIndex":192952,"paragraph":{"elements":[{"startIndex":192951,"endIndex":192952,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":192952,"endIndex":193598,"paragraph":{"elements":[{"startIndex":192952,"endIndex":193021,"textRun":{"content":"Multi-Multi Alignment - aligning many AIs to many humans to many AIs.","textStyle":{"bold":true}}},{"startIndex":193021,"endIndex":193598,"textRun":{"content":" This is the most complicated scenario involving multiple AI systems interacting with multiple humans. Here, the distinction between misalignment risk (AIs gaining illegitimate power over humans) and misuse risk (humans using AIs to gain illegitimate power over others) begins to blur. The key challenge becomes preventing problematic concentrations of power while enabling beneficial cooperation between humans and AIs. This requires careful system design that promotes aligned behavior not just at the individual level but across the entire network of human-AI interactions.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":120.00001,"direction":"LEFT_TO_RIGHT"}}},{"startIndex":193598,"endIndex":193599,"paragraph":{"elements":[{"startIndex":193598,"endIndex":193599,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":193599,"endIndex":193627,"paragraph":{"elements":[{"startIndex":193599,"endIndex":193627,"textRun":{"content":"Questions for the Long Term\n","textStyle":{}}}],"paragraphStyle":{"headingId":"h.txvxa21lg0gc","namedStyleType":"HEADING_2","direction":"LEFT_TO_RIGHT"}}},{"startIndex":193627,"endIndex":193628,"paragraph":{"elements":[{"startIndex":193627,"endIndex":193628,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":193628,"endIndex":194773,"paragraph":{"elements":[{"startIndex":193628,"endIndex":193693,"textRun":{"content":"It is unclear if solving single-single alignment would be enough.","textStyle":{"bold":true}}},{"startIndex":193693,"endIndex":194192,"textRun":{"content":" Even if we could ensure that every AI system is perfectly aligned with its respective human principal's intentions, we would still face serious risks when these systems interact. This is because different principals may have conflicting interests, or because the systems may fail to coordinate effectively even when their goals align. Perfect individual alignment cannot guarantee safe collective behavior, just as aligning every driver with traffic laws doesn't prevent traffic jams or accidents (","textStyle":{}}},{"startIndex":194192,"endIndex":194212,"textRun":{"content":"Hammond et al., 2025","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2502.14143"}}}},{"startIndex":194212,"endIndex":194773,"textRun":{"content":"). Essentially, if we have three subproblems of alignment within a single agent, then we have three more sub-problems of miscoordination, conflict, and collusion when these individual agents start interacting with each other. Each represents a different way multi-agent systems can fail, even if the individual agents appear to function correctly in isolation. There are yet more ways, even beyond this, when we start to consider emergent effects of interactions between complex systems and gradual disempowerment, like we talked about in the chapter on risks.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":194773,"endIndex":194774,"paragraph":{"elements":[{"startIndex":194773,"endIndex":194774,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":194774,"endIndex":195186,"paragraph":{"elements":[{"startIndex":194774,"endIndex":195186,"textRun":{"content":"Even if the technical challenges of AI alignment are overcome, a host of profound and heavily debated philosophical questions remain. Solving AI safety, particularly for Artificial Superintelligence (ASI), may necessitate confronting deep-seated issues regarding values, consciousness, and the ultimate purpose of existence. Aligning ASI forces us to ask fundamental questions about what future we truly desire.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":195186,"endIndex":195578,"paragraph":{"elements":[{"startIndex":195186,"endIndex":195213,"textRun":{"content":"What should we align AI to?","textStyle":{"bold":true}}},{"startIndex":195213,"endIndex":195390,"textRun":{"content":" What specific values or ethical principles should an ASI be aligned with? Given the diversity of human values, is agreement even possible? Alternatively, if we cannot agree on ","textStyle":{}}},{"startIndex":195390,"endIndex":195395,"textRun":{"content":"final","textStyle":{"italic":true}}},{"startIndex":195395,"endIndex":195420,"textRun":{"content":" values, can we agree on ","textStyle":{}}},{"startIndex":195420,"endIndex":195429,"textRun":{"content":"processes","textStyle":{"italic":true}}},{"startIndex":195429,"endIndex":195578,"textRun":{"content":" or principles (like deliberation, fairness, or corrigibility) that could lead an ASI towards acceptable values or allow for future value evolution?\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.ricj65v23fv0","textStyle":{"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}}},{"startIndex":195578,"endIndex":196450,"paragraph":{"elements":[{"startIndex":195578,"endIndex":195642,"textRun":{"content":"The Purpose of Alignment: Human Perpetuity vs. Worthy Successor?","textStyle":{"bold":true}}},{"startIndex":195642,"endIndex":195713,"textRun":{"content":" Should the primary goal be the indefinite survival and flourishing of ","textStyle":{}}},{"startIndex":195713,"endIndex":195721,"textRun":{"content":"humanity","textStyle":{"italic":true}}},{"startIndex":195721,"endIndex":195824,"textRun":{"content":" as we know it? Or, should we consider the possibility of creating a \"Worthy Successor\"? Dan Faggella (","textStyle":{}}},{"startIndex":195824,"endIndex":195838,"textRun":{"content":"Faggella, 2025","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://danfaggella.com/worthy/"}}}},{"startIndex":195838,"endIndex":196173,"textRun":{"content":") proposes this concept: an ASI potentially possessing capabilities and moral value superior to humanity's, which might be rationally preferred to guide the future. Defining and verifying the criteria for such a successor (e.g., enhanced sentience, cosmic exploration capabilities) poses immense challenges. Some, like Richard Sutton (","textStyle":{}}},{"startIndex":196173,"endIndex":196185,"textRun":{"content":"Sutton, 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"http://incompleteideas.net/Talks/waic3.pdf"}}}},{"startIndex":196185,"endIndex":196450,"textRun":{"content":"), argue that succession to AI, our \"mind children,\" is inevitable and highly desirable. Sutton suggests we should embrace and plan for this succession rather than resisting it out of fear, questioning why we would want potentially greater beings kept subservient.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.ricj65v23fv0","textStyle":{"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}}},{"startIndex":196450,"endIndex":196872,"paragraph":{"elements":[{"startIndex":196450,"endIndex":196478,"textRun":{"content":"Should we give rights to AI?","textStyle":{"bold":true}}},{"startIndex":196478,"endIndex":196621,"textRun":{"content":" Could advanced AI systems become conscious? This first requires a clearer understanding of consciousness itself, which remains elusive. If AI ","textStyle":{}}},{"startIndex":196621,"endIndex":196624,"textRun":{"content":"can","textStyle":{"italic":true}}},{"startIndex":196624,"endIndex":196861,"textRun":{"content":" possess consciousness or consciousness-like properties, what moral status should we assign to these digital minds? Should they have rights or moral consideration? Such topics are outside the scope of this textbook, but are researched by","textStyle":{}}},{"startIndex":196861,"endIndex":196862,"textRun":{"content":" ","textStyle":{"link":{"url":"https://eleosai.org/"}}}},{"startIndex":196862,"endIndex":196870,"textRun":{"content":"Eleos AI","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://eleosai.org/"}}}},{"startIndex":196870,"endIndex":196872,"textRun":{"content":".\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.ricj65v23fv0","textStyle":{"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}}},{"startIndex":196872,"endIndex":197095,"paragraph":{"elements":[{"startIndex":196872,"endIndex":196891,"textRun":{"content":"What about animals?","textStyle":{"bold":true}}},{"startIndex":196891,"endIndex":197095,"textRun":{"content":" How should the interests of non-human entities be factored into AI alignment? Should alignment goals explicitly include animal welfare, ecosystem preservation, or the flourishing of other forms of life?\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.ricj65v23fv0","textStyle":{"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}}},{"startIndex":197095,"endIndex":197096,"paragraph":{"elements":[{"startIndex":197095,"endIndex":197096,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":197096,"endIndex":197470,"table":{"rows":6,"columns":2,"tableRows":[{"startIndex":197097,"endIndex":197111,"tableCells":[{"startIndex":197098,"endIndex":197104,"content":[{"startIndex":197099,"endIndex":197104,"paragraph":{"elements":[{"startIndex":197099,"endIndex":197104,"textRun":{"content":"type\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":197104,"endIndex":197111,"content":[{"startIndex":197105,"endIndex":197111,"paragraph":{"elements":[{"startIndex":197105,"endIndex":197111,"textRun":{"content":"quote\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":197111,"endIndex":197135,"tableCells":[{"startIndex":197112,"endIndex":197121,"content":[{"startIndex":197113,"endIndex":197121,"paragraph":{"elements":[{"startIndex":197113,"endIndex":197121,"textRun":{"content":"speaker\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":197121,"endIndex":197135,"content":[{"startIndex":197122,"endIndex":197135,"paragraph":{"elements":[{"startIndex":197122,"endIndex":197135,"textRun":{"content":" Rich Sutton\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBo