le":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":21851,"endIndex":21920,"content":[{"startIndex":21852,"endIndex":21920,"paragraph":{"elements":[{"startIndex":21852,"endIndex":21920,"textRun":{"content":"Ensuring a positive offense-defense balance in an open-source world\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":21920,"endIndex":21938,"tableCells":[{"startIndex":21921,"endIndex":21932,"content":[{"startIndex":21922,"endIndex":21932,"paragraph":{"elements":[{"startIndex":21922,"endIndex":21932,"textRun":{"content":"collapsed\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":21932,"endIndex":21938,"content":[{"startIndex":21933,"endIndex":21938,"paragraph":{"elements":[{"startIndex":21933,"endIndex":21938,"textRun":{"content":"True\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":21938,"endIndex":26846,"tableCells":[{"startIndex":21939,"endIndex":21948,"content":[{"startIndex":21940,"endIndex":21948,"paragraph":{"elements":[{"startIndex":21940,"endIndex":21948,"textRun":{"content":"content\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":21948,"endIndex":26846,"content":[{"startIndex":21949,"endIndex":21950,"paragraph":{"elements":[{"startIndex":21949,"endIndex":21950,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":21950,"endIndex":22814,"paragraph":{"elements":[{"startIndex":21950,"endIndex":22025,"textRun":{"content":"The offense-defense balance shapes access decisions for frontier AI models.","textStyle":{"bold":true}}},{"startIndex":22025,"endIndex":22486,"textRun":{"content":" This concept refers to the relative ease with which defenders can protect against attackers versus how easily attackers can exploit vulnerabilities. Understanding this balance helps assess whether open-sourcing powerful models will be net beneficial or harmful. In traditional software development, open sourcing typically strengthens defense—increased transparency allows a broader community to identify and patch vulnerabilities, enhancing overall security (","textStyle":{}}},{"startIndex":22486,"endIndex":22504,"textRun":{"content":"Seger et al., 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2311.09227"}}}},{"startIndex":22504,"endIndex":22814,"textRun":{"content":"). However, frontier AI models may fundamentally change this dynamic. Unlike conventional software bugs that can be patched, these models introduce novel risks that resist simple fixes. For example, once a harmful capability is discovered in an open model, it cannot be \"unlearned\" across all deployed copies.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":22814,"endIndex":22815,"paragraph":{"elements":[{"startIndex":22814,"endIndex":22815,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":22815,"endIndex":23068,"paragraph":{"elements":[{"startIndex":22815,"endIndex":23068,"textRun":{"content":"The specific benefits and risks of open foundation models derive from their distinctive properties compared to closed models: broader access, greater customizability, local inference ability, inability to rescind access, and poor monitoring capability.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":23068,"endIndex":23069,"paragraph":{"elements":[{"startIndex":23068,"endIndex":23069,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":23069,"endIndex":23103,"paragraph":{"elements":[{"startIndex":23069,"endIndex":23103,"textRun":{"content":"Arguments for increased openness:\n","textStyle":{"bold":true,"underline":true}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":23103,"endIndex":23475,"paragraph":{"elements":[{"startIndex":23103,"endIndex":23138,"textRun":{"content":"Democratization of decision-making.","textStyle":{"bold":true}}},{"startIndex":23138,"endIndex":23434,"textRun":{"content":" When models are exclusively controlled by well-resourced companies, these entities unilaterally determine acceptable use cases and content policies. Open models distribute this power more broadly. This prevents power concentration, value lock-in, and better reflects diverse societal interests (","textStyle":{}}},{"startIndex":23434,"endIndex":23452,"textRun":{"content":"Kapoor et al, 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2403.07918"}}}},{"startIndex":23452,"endIndex":23454,"textRun":{"content":"; ","textStyle":{}}},{"startIndex":23454,"endIndex":23472,"textRun":{"content":"Eiras et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2404.17047"}}}},{"startIndex":23472,"endIndex":23475,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.myis7tehhwwx","textStyle":{}}}},{"startIndex":23475,"endIndex":23846,"paragraph":{"elements":[{"startIndex":23475,"endIndex":23503,"textRun":{"content":"Accelerated safety research.","textStyle":{"bold":true}}},{"startIndex":23503,"endIndex":23809,"textRun":{"content":" Open model weights enable safety research that requires direct model access, including interpretability studies that would be impossible through API access alone. Research on representation control, activation engineering, and safety mechanisms has advanced significantly through access to model weights (","textStyle":{}}},{"startIndex":23809,"endIndex":23823,"textRun":{"content":"Millidge, 2025","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.beren.io/2023-11-05-Open-source-AI-has-been-vital-for-alignment/"}}}},{"startIndex":23823,"endIndex":23824,"textRun":{"content":";","textStyle":{}}},{"startIndex":23824,"endIndex":23843,"textRun":{"content":" Eiras et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2404.17047"}}}},{"startIndex":23843,"endIndex":23846,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.myis7tehhwwx","textStyle":{}}}},{"startIndex":23846,"endIndex":24230,"paragraph":{"elements":[{"startIndex":23846,"endIndex":23888,"textRun":{"content":"Enhanced scientific and academic research.","textStyle":{"bold":true}}},{"startIndex":23888,"endIndex":24208,"textRun":{"content":" Greater access empowers the broader research community in all fields. In AI specifically, things like scientific reproducibility also depend on persistent access to specific model versions—when models are open, researchers can preserve specific versions for long-term studies on model behavior, bias, and capabilities (","textStyle":{}}},{"startIndex":24208,"endIndex":24227,"textRun":{"content":"Kapoor et al., 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2403.07918"}}}},{"startIndex":24227,"endIndex":24230,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.myis7tehhwwx","textStyle":{}}}},{"startIndex":24230,"endIndex":24666,"paragraph":{"elements":[{"startIndex":24230,"endIndex":24266,"textRun":{"content":"Greater inclusion for diverse needs.","textStyle":{"bold":true}}},{"startIndex":24266,"endIndex":24432,"textRun":{"content":" Greater access allows for giving people equal access to the benefits of AI by tailoring foundation models to things like underrepresented languages and communities (","textStyle":{}}},{"startIndex":24432,"endIndex":24450,"textRun":{"content":"Kapoor et al, 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2403.07918"}}}},{"startIndex":24450,"endIndex":24638,"textRun":{"content":"). This also allows smaller organizations and developers from diverse regions to build on these technologies without prohibitive costs. It might also help prevent algorithmic monoculture (","textStyle":{}}},{"startIndex":24638,"endIndex":24664,"textRun":{"content":"Kleinberg & Raghavan, 2021","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2101.05853"}}}},{"startIndex":24664,"endIndex":24666,"textRun":{"content":")\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.myis7tehhwwx","textStyle":{}}}},{"startIndex":24666,"endIndex":25041,"paragraph":{"elements":[{"startIndex":24666,"endIndex":24707,"textRun":{"content":"Improved transparency and accountability.","textStyle":{"bold":true}}},{"startIndex":24707,"endIndex":24888,"textRun":{"content":" Widely available model weights enable external researchers, auditors, and journalists to investigate foundation models more deeply. This might prevent concerns from safetywashing (","textStyle":{}}},{"startIndex":24888,"endIndex":24904,"textRun":{"content":"Ren et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2407.21792"}}}},{"startIndex":24904,"endIndex":25041,"textRun":{"content":"), and is especially valuable given that the history of digital technology shows broader scrutiny reveals concerns missed by developers.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.myis7tehhwwx","textStyle":{}}}},{"startIndex":25041,"endIndex":25227,"paragraph":{"elements":[{"startIndex":25041,"endIndex":25070,"textRun":{"content":"Reduced market concentration.","textStyle":{"bold":true}}},{"startIndex":25070,"endIndex":25227,"textRun":{"content":" Open foundation models can mitigate harmful monocultures by allowing more diverse downstream model behavior, reducing the severity of homogeneous failures.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.myis7tehhwwx","textStyle":{}}}},{"startIndex":25227,"endIndex":25228,"paragraph":{"elements":[{"startIndex":25227,"endIndex":25228,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":25228,"endIndex":25261,"paragraph":{"elements":[{"startIndex":25228,"endIndex":25261,"textRun":{"content":"Arguments for increased closure:\n","textStyle":{"bold":true,"underline":true}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":25261,"endIndex":25533,"paragraph":{"elements":[{"startIndex":25261,"endIndex":25311,"textRun":{"content":"Irreversible release with very fragile safeguards.","textStyle":{"bold":true}}},{"startIndex":25311,"endIndex":25509,"textRun":{"content":" Once released, open models cannot be recalled if safety issues emerge. Unlike closed APIs, safeguards can be trivially removed, and models can be fine-tuned for harmful purposes without oversight (","textStyle":{}}},{"startIndex":25509,"endIndex":25530,"textRun":{"content":"Solaiman et al., 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2302.04844"}}}},{"startIndex":25530,"endIndex":25533,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.yfb13896c1s8","textStyle":{}}}},{"startIndex":25533,"endIndex":25921,"paragraph":{"elements":[{"startIndex":25533,"endIndex":25564,"textRun":{"content":"Enabling sophisticated attacks.","textStyle":{"bold":true}}},{"startIndex":25564,"endIndex":25737,"textRun":{"content":" White-box access allows malicious actors to more effectively understand and exploit model vulnerabilities for cyberattacks or to bypass security measures in other systems (","textStyle":{}}},{"startIndex":25737,"endIndex":25759,"textRun":{"content":"Shevlane & Dafoe, 2020","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2001.00463"}}}},{"startIndex":25759,"endIndex":25900,"textRun":{"content":"). Open weights could aid in developing bioweapons, chemical weapons, or advanced cyber capabilities that closed models can better restrict (","textStyle":{}}},{"startIndex":25900,"endIndex":25918,"textRun":{"content":"Seger et al., 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2311.09227"}}}},{"startIndex":25918,"endIndex":25921,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.yfb13896c1s8","textStyle":{}}}},{"startIndex":25921,"endIndex":26162,"paragraph":{"elements":[{"startIndex":25921,"endIndex":25955,"textRun":{"content":"Proliferation of unresolved flaws.","textStyle":{"bold":true}}},{"startIndex":25955,"endIndex":26141,"textRun":{"content":" When models are open-sourced, biases, security vulnerabilities, and other flaws can propagate widely. There's no reliable mechanism to ensure downstream users implement safety updates (","textStyle":{}}},{"startIndex":26141,"endIndex":26159,"textRun":{"content":"Seger et al., 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2311.09227"}}}},{"startIndex":26159,"endIndex":26162,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.yfb13896c1s8","textStyle":{}}}},{"startIndex":26162,"endIndex":26424,"paragraph":{"elements":[{"startIndex":26162,"endIndex":26189,"textRun":{"content":"Increased misuse potential.","textStyle":{"bold":true}}},{"startIndex":26189,"endIndex":26338,"textRun":{"content":" Open models facilitate specific harms that closed models better constrain—things like non-consensual intimate imagery, child exploitation material (","textStyle":{}}},{"startIndex":26338,"endIndex":26353,"textRun":{"content":"Hai et al, 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://hai.stanford.edu/sites/default/files/2024-03/Response-NTIA-RFC-Open-Foundation-Models.pdf"}}}},{"startIndex":26353,"endIndex":26402,"textRun":{"content":"), and certain forms of targeted disinformation (","textStyle":{}}},{"startIndex":26402,"endIndex":26421,"textRun":{"content":"Kapoor et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2403.07918"}}}},{"startIndex":26421,"endIndex":26424,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.yfb13896c1s8","textStyle":{}}}},{"startIndex":26424,"endIndex":26425,"paragraph":{"elements":[{"startIndex":26424,"endIndex":26425,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":26425,"endIndex":26845,"paragraph":{"elements":[{"startIndex":26425,"endIndex":26530,"textRun":{"content":"Alternative release strategies offer potential middle grounds. Various proposals suggest staged release (","textStyle":{}}},{"startIndex":26530,"endIndex":26551,"textRun":{"content":"Solaiman et al., 2019","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/1908.09203"}}}},{"startIndex":26551,"endIndex":26672,"textRun":{"content":"), gated access with know-your-customer requirements, research APIs for qualified researchers, and trusted partnerships (","textStyle":{}}},{"startIndex":26672,"endIndex":26690,"textRun":{"content":"Seger et al., 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2311.09227"}}}},{"startIndex":26690,"endIndex":26845,"textRun":{"content":"). As capabilities advance, a graduated access framework that adapts controls to specific risks may prove most effective for balancing access with safety.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":26845,"endIndex":26846,"paragraph":{"elements":[{"startIndex":26845,"endIndex":26846,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":60,"unit":"PT"}}]}}},{"startIndex":26847,"endIndex":26848,"paragraph":{"elements":[{"startIndex":26847,"endIndex":26848,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":26848,"endIndex":31447,"table":{"rows":4,"columns":2,"tableRows":[{"startIndex":26849,"endIndex":26865,"tableCells":[{"startIndex":26850,"endIndex":26856,"content":[{"startIndex":26851,"endIndex":26856,"paragraph":{"elements":[{"startIndex":26851,"endIndex":26856,"textRun":{"content":"type\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":26856,"endIndex":26865,"content":[{"startIndex":26857,"endIndex":26865,"paragraph":{"elements":[{"startIndex":26857,"endIndex":26865,"textRun":{"content":"noteBox\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"space