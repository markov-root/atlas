dding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":7280,"endIndex":7286,"content":[{"startIndex":7281,"endIndex":7286,"paragraph":{"elements":[{"startIndex":7281,"endIndex":7286,"textRun":{"content":"True\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":7286,"endIndex":10714,"tableCells":[{"startIndex":7287,"endIndex":7296,"content":[{"startIndex":7288,"endIndex":7296,"paragraph":{"elements":[{"startIndex":7288,"endIndex":7296,"textRun":{"content":"content\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":7296,"endIndex":10714,"content":[{"startIndex":7297,"endIndex":7298,"paragraph":{"elements":[{"startIndex":7297,"endIndex":7298,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":7298,"endIndex":7913,"paragraph":{"elements":[{"startIndex":7298,"endIndex":7397,"textRun":{"content":"Broader definitions of alignment encompass the entire challenge of creating beneficial AI outcomes.","textStyle":{"bold":true}}},{"startIndex":7397,"endIndex":7502,"textRun":{"content":" These approaches focus on ensuring that AI systems understand and properly implement human preferences (","textStyle":{}}},{"startIndex":7502,"endIndex":7518,"textRun":{"content":"Christiano, 2018","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.alignmentforum.org/posts/ZeE7EKHTFMBs8eMxn/clarifying-ai-alignment"}}}},{"startIndex":7518,"endIndex":7564,"textRun":{"content":"), address complex value learning challenges (","textStyle":{}}},{"startIndex":7564,"endIndex":7575,"textRun":{"content":"Dewey, 2011","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://intelligence.org/files/LearningValue.pdf"}}}},{"startIndex":7575,"endIndex":7650,"textRun":{"content":"), and incorporate robustness aspects, such as resistance to jailbreaking (","textStyle":{}}},{"startIndex":7650,"endIndex":7669,"textRun":{"content":"Jonker et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.ibm.com/think/topics/ai-alignment"}}}},{"startIndex":7669,"endIndex":7910,"textRun":{"content":"). This comprehensive view treats alignment as encompassing both the system's intent and its ability to understand human values - essentially addressing the full spectrum of what makes an AI system behave in ways that humans would approve of","textStyle":{}}},{"startIndex":7910,"endIndex":7911,"footnoteReference":{"footnoteId":"kix.olyisol6l2w0","footnoteNumber":"1","textStyle":{}}},{"startIndex":7911,"endIndex":7913,"textRun":{"content":".\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":7913,"endIndex":7914,"paragraph":{"elements":[{"startIndex":7913,"endIndex":7914,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":7914,"endIndex":8864,"paragraph":{"elements":[{"startIndex":7914,"endIndex":8026,"textRun":{"content":"Narrower definitions of alignment focus specifically on the AI's motivation and intent, independent of outcomes.","textStyle":{"bold":true}}},{"startIndex":8026,"endIndex":8114,"textRun":{"content":" Some definitions are much more narrow and focus specifically on the AI's motivation - \"","textStyle":{}}},{"startIndex":8114,"endIndex":8180,"textRun":{"content":"An AI (A) is trying to do what a human operator (H) wants it to do","textStyle":{"italic":true}}},{"startIndex":8180,"endIndex":8183,"textRun":{"content":"\" (","textStyle":{}}},{"startIndex":8183,"endIndex":8199,"textRun":{"content":"Christiano, 2018","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.alignmentforum.org/posts/ZeE7EKHTFMBs8eMxn/clarifying-ai-alignment"}}}},{"startIndex":8199,"endIndex":8864,"textRun":{"content":"). This emphasizes the AI's motivation rather than its competence or knowledge. Under this definition, an intent-aligned AI might still fail due to misunderstanding the operator's wishes or lacking knowledge about the world, but it is fundamentally trying to be helpful. Proponents argue this narrow focus isolates the core technical challenge of getting AI systems to adopt human goals, separate from broader issues like value clarification or capability robustness. That is, as long as the agent \"means well\", it is aligned, even if errors in its assumptions about the user's preferences or about the world at large, lead it to actions that are bad for the user.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":8864,"endIndex":8865,"paragraph":{"elements":[{"startIndex":8864,"endIndex":8865,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":8865,"endIndex":9227,"paragraph":{"elements":[{"startIndex":8865,"endIndex":9227,"textRun":{"content":"The choice of definition reflects underlying assumptions about AI risk and promising solutions. Focusing narrowly on intent alignment prioritizes research on inner/outer alignment problems, whereas broader views incorporate value learning or robustness research more centrally. These different approaches lead to other research priorities and safety strategies.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":9227,"endIndex":9228,"paragraph":{"elements":[{"startIndex":9227,"endIndex":9228,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":9228,"endIndex":10185,"paragraph":{"elements":[{"startIndex":9228,"endIndex":9313,"textRun":{"content":"Applying concepts like \"trying,\" \"wanting,\" or \"intent\" to AI systems is non-trivial.","textStyle":{"bold":true}}},{"startIndex":9313,"endIndex":10185,"textRun":{"content":" When we train AI systems, we specify an optimization objective (like maximizing a reward function), but this doesn't necessarily translate to the system \"intending\" to pursue that objective in a human-like way. As we explained in the previous chapter, specification failures occur when what we specify doesn't capture what we actually want (a well-intended pursuit of a bad goal). But solving this is insufficient; it could also pursue completely different goals altogether. As an analogy, think about how evolution \"optimized\" humans for genetic fitness (optimization objective), yet humans developed other goals (like art appreciation or contraception) that don't maximize reproductive fitness. Similarly, AI systems optimized for specific objectives may develop internal \"goals\" that don't directly align with those objectives, especially as they become more capable.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":10185,"endIndex":10186,"paragraph":{"elements":[{"startIndex":10185,"endIndex":10186,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":10186,"endIndex":10647,"paragraph":{"elements":[{"startIndex":10186,"endIndex":10261,"textRun":{"content":"\"Aligned to whom?\" remains a fundamental question with no consensus answer.","textStyle":{"bold":true}}},{"startIndex":10261,"endIndex":10313,"textRun":{"content":" Should AI systems align to the immediate operator (","textStyle":{}}},{"startIndex":10313,"endIndex":10329,"textRun":{"content":"Christiano, 2018","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.alignmentforum.org/posts/ZeE7EKHTFMBs8eMxn/clarifying-ai-alignment"}}}},{"startIndex":10329,"endIndex":10353,"textRun":{"content":"), the system designer (","textStyle":{}}},{"startIndex":10353,"endIndex":10362,"textRun":{"content":"Gil, 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://forum.effectivealtruism.org/posts/6aYfWyo9DKEheogf8/don-t-call-it-ai-alignment"}}}},{"startIndex":10362,"endIndex":10414,"textRun":{"content":"), a specific group of humans, humanity as a whole (","textStyle":{}}},{"startIndex":10414,"endIndex":10426,"textRun":{"content":"Miller, 2022","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://forum.effectivealtruism.org/posts/DXuwsXsqGq5GtmsB3/ai-alignment-with-humans-but-with-which-humans"}}}},{"startIndex":10426,"endIndex":10647,"textRun":{"content":"), objective ethical principles, or the operator's hypothetical informed preferences? There are no agreed-upon answers to any of these questions, just many different perspectives, each with its own set of pros and cons. \n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":10647,"endIndex":10648,"paragraph":{"elements":[{"startIndex":10647,"endIndex":10648,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":10648,"endIndex":10714,"paragraph":{"elements":[{"startIndex":10648,"endIndex":10714,"textRun":{"content":"We have tried to summarize some of the positions in the appendix.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":60,"unit":"PT"}}]}}},{"startIndex":10715,"endIndex":10716,"paragraph":{"elements":[{"startIndex":10715,"endIndex":10716,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":10716,"endIndex":10726,"paragraph":{"elements":[{"startIndex":10716,"endIndex":10726,"textRun":{"content":"AI Ethics\n","textStyle":{}}}],"paragraphStyle":{"headingId":"h.6rcnll75p8g6","namedStyleType":"HEADING_2","direction":"LEFT_TO_RIGHT"}}},{"startIndex":10726,"endIndex":10727,"paragraph":{"elements":[{"startIndex":10726,"endIndex":10727,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RI