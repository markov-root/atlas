},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":80,"unit":"PT"}}]}}},{"startIndex":197927,"endIndex":197928,"paragraph":{"elements":[{"startIndex":197927,"endIndex":197928,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":120.00001,"direction":"LEFT_TO_RIGHT"}}},{"startIndex":197928,"endIndex":197929,"paragraph":{"elements":[{"startIndex":197928,"endIndex":197929,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":197929,"endIndex":197930,"paragraph":{"elements":[{"startIndex":197929,"endIndex":197930,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":197930,"endIndex":197931,"paragraph":{"elements":[{"startIndex":197930,"endIndex":197931,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":197931,"endIndex":197932,"paragraph":{"elements":[{"startIndex":197931,"endIndex":197932,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}]},"footnotes":{"kix.olyisol6l2w0":{"footnoteId":"kix.olyisol6l2w0","content":[{"endIndex":742,"paragraph":{"elements":[{"endIndex":1,"textRun":{"content":" ","textStyle":{"fontSize":{"magnitude":10,"unit":"PT"}}}},{"startIndex":1,"endIndex":741,"textRun":{"content":"While AI alignment does not necessarily encompass all systemic risks and misuse, there is some overlap. Some alignment techniques could help mitigate specific misuse scenarios—for instance, alignment methods could ensure that models refuse to cooperate with users intending to use AI for harmful purposes, such as bioterrorism. Similarly, from a systemic risk perspective, a well-aligned AI might recognize and refuse to participate in problematic processes embedded within systems, such as financial markets. However, challenges remain, as malicious actors might attempt to circumvent these protections through targeted fine-tuning of models for harmful purposes, and in this case, even a perfectly aligned model wouldn't be able to resist","textStyle":{}}},{"startIndex":741,"endIndex":742,"textRun":{"content":"\n","textStyle":{"fontSize":{"magnitude":10,"unit":"PT"}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT"}}}]},"kix.i6r94t1rp80f":{"footnoteId":"kix.i6r94t1rp80f","content":[{"endIndex":316,"paragraph":{"elements":[{"endIndex":1,"textRun":{"content":" ","textStyle":{"fontSize":{"magnitude":10,"unit":"PT"}}}},{"startIndex":1,"endIndex":315,"textRun":{"content":"The Technology Readiness Levels from NASA is a scale from 1 to 9 to measure the maturity of a technology. Level 1 represents the earliest stage of technology development, characterized by basic principles observed and reported, and level 9 represents actual technology proven through successful mission operations.","textStyle":{}}},{"startIndex":315,"endIndex":316,"textRun":{"content":"\n","textStyle":{"fontSize":{"magnitude":10,"unit":"PT"}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT"}}}]},"kix.lmkrmgnu8xxo":{"footnoteId":"kix.lmkrmgnu8xxo","content":[{"endIndex":125,"paragraph":{"elements":[{"endIndex":1,"textRun":{"content":" ","textStyle":{"fontSize":{"magnitude":10,"unit":"PT"}}}},{"startIndex":1,"endIndex":124,"textRun":{"content":"Steganography is a hidden coded language. For example, the first letter of a sentence gives the next letter of the message.","textStyle":{}}},{"startIndex":124,"endIndex":125,"textRun":{"content":"\n","textStyle":{"fontSize":{"magnitude":10,"unit":"PT"}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT"}}}]},"kix.23va6f26urz2":{"footnoteId":"kix.23va6f26urz2","content":[{"endIndex":380,"paragraph":{"elements":[{"endIndex":1,"textRun":{"content":" ","textStyle":{"fontSize":{"magnitude":10,"unit":"PT"}}}},{"startIndex":1,"endIndex":379,"textRun":{"content":"For example, in the pharmaceutical industry for drug development, companies sometimes enter into co-development and profit-sharing agreements to share the risks and rewards of bringing a new drug to market. For example, in 2014, Pfizer and Merck entered into a global alliance to co-develop and co-commercialize an anti-PD-L1 antibody for the treatment of multiple cancer types.","textStyle":{}}},{"startIndex":379,"endIndex":380,"textRun":{"content":"\n","textStyle":{"fontSize":{"magnitude":10,"unit":"PT"}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT"}}}]}},"documentStyle":{"background":{"color":{}},"pageNumberStart":1,"marginTop":{"magnitude":72,"unit":"PT"},"marginBottom":{"magnitude":72,"unit":"PT"},"marginRight":{"magnitude":72,"unit":"PT"},"marginLeft":{"magnitude":72,"unit":"PT"},"pageSize":{"height":{"magnitude":841.8897637795277,"unit":"PT"},"width":{"magnitude":595.2755905511812,"unit":"PT"}},"m