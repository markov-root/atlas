agraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","shading":{"backgroundColor":{}}}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":80,"unit":"PT"}}]}}},{"startIndex":8023,"endIndex":8024,"paragraph":{"elements":[{"startIndex":8023,"endIndex":8024,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","shading":{"backgroundColor":{}}}}},{"startIndex":8024,"endIndex":8299,"paragraph":{"elements":[{"startIndex":8024,"endIndex":8298,"textRun":{"content":"This introduction gave you the general overview of many of the concepts that we will be talking about throughout this chapter. The sections will largely proceed in the order that we introduced the ideas above. We begin by exploring how benchmarks have shaped AI development.","textStyle":{}}},{"startIndex":8298,"endIndex":8299,"textRun":{"content":"\n","textStyle":{"bold":true}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","shading":{"backgroundColor":{}}}}},{"startIndex":8299,"endIndex":8300,"paragraph":{"elements":[{"startIndex":8299,"endIndex":8300,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}},{"startIndex":8300,"endIndex":8311,"paragraph":{"elements":[{"startIndex":8300,"endIndex":8311,"textRun":{"content":"Benchmarks\n","textStyle":{}}}],"paragraphStyle":{"headingId":"h.lj9suup9ij73","namedStyleType":"HEADING_1","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}},{"startIndex":8311,"endIndex":8312,"paragraph":{"elements":[{"startIndex":8311,"endIndex":8312,"textRun":{"content":"\n","textStyle":{"fontSize":{"magnitude":11,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Merriweather","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":115,"direction":"LEFT_TO_RIGHT","shading":{"backgroundColor":{}}}}},{"startIndex":8312,"endIndex":8539,"table":{"rows":2,"columns":2,"tableRows":[{"startIndex":8313,"endIndex":8341,"tableCells":[{"startIndex":8314,"endIndex":8320,"content":[{"startIndex":8315,"endIndex":8320,"paragraph":{"elements":[{"startIndex":8315,"endIndex":8320,"textRun":{"content":"type\n","textStyle":{"fontSize":{"magnitude":11,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Merriweather","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":8320,"endIndex":8341,"content":[{"startIndex":8321,"endIndex":8341,"paragraph":{"elements":[{"startIndex":8321,"endIndex":8341,"textRun":{"content":"section-description\n","textStyle":{"fontSize":{"magnitude":11,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Merriweather","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":8341,"endIndex":8538,"tableCells":[{"startIndex":8342,"endIndex":8351,"content":[{"startIndex":8343,"endIndex":8351,"paragraph":{"elements":[{"startIndex":8343,"endIndex":8351,"textRun":{"content":"content\n","textStyle":{"fontSize":{"magnitude":11,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Merriweather","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":8351,"endIndex":8538,"content":[{"startIndex":8352,"endIndex":8538,"paragraph":{"elements":[{"startIndex":8352,"endIndex":8538,"textRun":{"content":"Standardized measurement tools shape development and help us measure where we currently stand. Many benchmarks are being developed to measure both capabilities and safety of AI systems.\n","textStyle":{"fontSize":{"magnitude":11,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Merriweather","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":115,"direction":"LEFT_TO_RIGHT","shading":{"backgroundColor":{}}}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":80,"unit":"PT"}}]}}},{"startIndex":8539,"endIndex":8540,"paragraph":{"elements":[{"startIndex":8539,"endIndex":8540,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":115,"direction":"LEFT_TO_RIGHT","shading":{"backgroundColor":{}}}}},{"startIndex":8540,"endIndex":9068,"paragraph":{"elements":[{"startIndex":8540,"endIndex":8560,"textRun":{"content":"What is a benchmark?","textStyle":{"bold":true}}},{"startIndex":8560,"endIndex":9068,"textRun":{"content":" Imagine trying to build a bridge without measuring tape. Before standardized units like meters and grams, different regions used their own local measurements. Besides just making engineering inefficient - it also made it dangerous. Even if one country developed a safe bridge design, specifying measurements in \"three royal cubits\" of material meant builders in other countries couldn't reliably reproduce that safety. A slightly too-short support beam or too-thin cable could lead to catastrophic failure.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}},{"startIndex":9068,"endIndex":9069,"paragraph":{"elements":[{"startIndex":9068,"endIndex":9069,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}},{"startIndex":9069,"endIndex":9434,"paragraph":{"elements":[{"startIndex":9069,"endIndex":9152,"textRun":{"content":"AI basically had a similar problem before we started using standardized benchmarks.","textStyle":{}}},{"startIndex":9152,"endIndex":9153,"footnoteReference":{"footnoteId":"kix.gwmw2zfe5ml3","footnoteNumber":"1","textStyle":{}}},{"startIndex":9153,"endIndex":9434,"textRun":{"content":" A benchmark is a tool like a standardized test, which we can use to measure and compare what AI systems can and cannot do. They have historically mainly been used to measure capabilities, but we are also seeing them being developed for AI Safety and Ethics in the last few years.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}},{"startIndex":9434,"endIndex":9435,"paragraph":{"elements":[{"startIndex":9434,"endIndex":9435,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}},{"startIndex":9435,"endIndex":9436,"paragraph":{"elements":[{"startIndex":9435,"endIndex":9436,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}},{"startIndex":9436,"endIndex":9873,"paragraph":{"elements":[{"startIndex":9436,"endIndex":9495,"textRun":{"content":"How do benchmarks shape AI development and safety research?","textStyle":{"bold":true}}},{"startIndex":9495,"endIndex":9873,"textRun":{"content":" Benchmarks in AI are slightly different from other scientific fields. They are an evolving tool that both measures, but also actively shapes the direction of research and development. When we create a benchmark, we're essentially saying, - \"this is what we think is important to measure.\" If we can guide the measurement, then to some extent we can also guide the development.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}},{"startIndex":9873,"endIndex":9874,"paragraph":{"elements":[{"startIndex":9873,"endIndex":9874,"textRun":{"content":"\n","textStyle":{"weightedFontFamily":{"fontFamily":"Merriweather","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":115,"direction":"LEFT_TO_RIGHT","shading":{"backgroundColor":{}}}}},{"startIndex":9874,"endIndex":10081,"table":{"rows":6,"columns":2,"tableRows":[{"startIndex":9875,"endIndex":9889,"tableCells":[{"startIndex":9876,"endIndex":9882,"content":[{"startIndex":9877,"endIndex":9882,"paragraph":{"elements":[{"startIndex":9877,"endIndex":9882,"textRun":{"content":"type\n","textStyle":{"weightedFontFamily":{"fontFamily":"Merriweather","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":9882,"endIndex":9889,"content":[{"startIndex":9883,"endIndex":9889,"paragraph":{"elements":[{"startIndex":9883,"endIndex":9889,"textRun":{"content":"quote\n","textStyle":{"weightedFontFamily":{"fontFamily":"Merriweather","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":9889,"endIndex":9917,"tableCells":[{"startIndex":9890,"endIndex":9899,"content":[{"startIndex":9891,"endIndex":9899,"paragraph":{"elements":[{"startIndex":9891,"endIndex":9899,"textRun":{"content":"speaker\n","textStyle":{"weightedFontFamily":{"fontFamily":"Merri