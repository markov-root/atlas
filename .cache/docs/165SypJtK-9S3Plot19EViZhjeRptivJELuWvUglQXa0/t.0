ight":{"unit":"PT"}}},{"startIndex":13993,"endIndex":14046,"tableCells":[{"startIndex":13994,"endIndex":14001,"content":[{"startIndex":13995,"endIndex":14001,"paragraph":{"elements":[{"startIndex":13995,"endIndex":14001,"textRun":{"content":"title\n","textStyle":{"weightedFontFamily":{"fontFamily":"Merriweather","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}}}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":14001,"endIndex":14046,"content":[{"startIndex":14002,"endIndex":14046,"paragraph":{"elements":[{"startIndex":14002,"endIndex":14045,"textRun":{"content":"Examples of various capabilities benchmarks","textStyle":{}}},{"startIndex":14045,"endIndex":14046,"textRun":{"content":"\n","textStyle":{"weightedFontFamily":{"fontFamily":"Merriweather","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":14046,"endIndex":16884,"tableCells":[{"startIndex":14047,"endIndex":14056,"content":[{"startIndex":14048,"endIndex":14056,"paragraph":{"elements":[{"startIndex":14048,"endIndex":14056,"textRun":{"content":"content\n","textStyle":{"weightedFontFamily":{"fontFamily":"Merriweather","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}}}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":14056,"endIndex":16884,"content":[{"startIndex":14057,"endIndex":14448,"paragraph":{"elements":[{"startIndex":14057,"endIndex":14102,"textRun":{"content":"Benchmarking language and task understanding.","textStyle":{"bold":true}}},{"startIndex":14102,"endIndex":14163,"textRun":{"content":" General Language Understanding Evaluation (GLUE) benchmark (","textStyle":{}}},{"startIndex":14163,"endIndex":14180,"textRun":{"content":"Wang et al., 2018","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/1804.07461"}}}},{"startIndex":14180,"endIndex":14212,"textRun":{"content":"), and its successor SuperGLUE (","textStyle":{}}},{"startIndex":14212,"endIndex":14229,"textRun":{"content":"Wang et al., 2019","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/1905.00537"}}}},{"startIndex":14229,"endIndex":14282,"textRun":{"content":") test difficult language understanding tasks. SWAG (","textStyle":{}}},{"startIndex":14282,"endIndex":14302,"textRun":{"content":"Zellers et al., 2018","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/1808.05326"}}}},{"startIndex":14302,"endIndex":14320,"textRun":{"content":"), and HellaSwag (","textStyle":{}}},{"startIndex":14320,"endIndex":14340,"textRun":{"content":"Zellers et al., 2019","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/1905.07830"}}}},{"startIndex":14340,"endIndex":14448,"textRun":{"content":") tests specifically the ability to predict which event would naturally follow from a given story scenario.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":14448,"endIndex":14449,"paragraph":{"elements":[{"startIndex":14448,"endIndex":14449,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":14449,"endIndex":15203,"paragraph":{"elements":[{"startIndex":14449,"endIndex":14479,"textRun":{"content":"Broad cross domain evaluations","textStyle":{"bold":true}}},{"startIndex":14479,"endIndex":14544,"textRun":{"content":". The MMLU (Massive Multitask Language Understanding) benchmark (","textStyle":{}}},{"startIndex":14544,"endIndex":14566,"textRun":{"content":"Hendrycks et al., 2020","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2009.03300"}}}},{"startIndex":14566,"endIndex":14819,"textRun":{"content":") tests a model's knowledge across 57 subjects. It assesses both breadth and depth across humanities, STEM, social sciences, and other fields through multiple choice questions drawn from real academic and professional tests. The GPQA (Google Proof QA) (","textStyle":{}}},{"startIndex":14819,"endIndex":14836,"textRun":{"content":"Rein et al., 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2311.12022"}}}},{"startIndex":14836,"endIndex":15079,"textRun":{"content":") has multiple choice questions specifically designed so that correct answers can’t be found through simple internet searches. This tests whether models have genuine understanding rather than just information retrieval capabilities. BigBench (","textStyle":{}}},{"startIndex":15079,"endIndex":15102,"textRun":{"content":"Srivastava et al., 2022","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2206.04615"}}}},{"startIndex":15102,"endIndex":15203,"textRun":{"content":") is yet another example of benchmarks for measuring generality by testing on a wide range of tasks.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":15203,"endIndex":15204,"paragraph":{"elements":[{"startIndex":15203,"endIndex":15204,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":15204,"endIndex":16007,"paragraph":{"elements":[{"startIndex":15204,"endIndex":15254,"textRun":{"content":"Benchmarking mathematical and scientific reasoning","textStyle":{"bold":true}}},{"startIndex":15254,"endIndex":15367,"textRun":{"content":". For specifically testing mathematical reasoning, a couple of examples include - the Grade School Math (GSM8K) (","textStyle":{}}},{"startIndex":15367,"endIndex":15385,"textRun":{"content":"Cobbe et al., 2021","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2110.14168"}}}},{"startIndex":15385,"endIndex":15496,"textRun":{"content":") benchmark. This tests core mathematical concepts at an elementary school level. Another example is the MATH (","textStyle":{}}},{"startIndex":15496,"endIndex":15518,"textRun":{"content":"Hendrycks et al., 2021","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2103.03874"}}}},{"startIndex":15518,"endIndex":15989,"textRun":{"content":") benchmark similarly tests seven subjects including algebra, geometry, and precalculus focuses on competition-style problems. They also have multiple difficulty levels per subject. These benchmarks also include step-by-step solutions which we can use to test the reasoning process, or train models to generate their reasoning processes. Multilingual Grade School Math (MGSM) is the multilingual version translated 250 grade-school math problems from the GSM8K dataset. (","textStyle":{}}},{"startIndex":15989,"endIndex":16005,"textRun":{"content":"Shi et al., 2022","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2210.03057"}}}},{"startIndex":16005,"endIndex":16007,"textRun":{"content":")\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":16007,"endIndex":16008,"paragraph":{"elements":[{"startIndex":16007,"endIndex":16008,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":16008,"endIndex":16769,"paragraph":{"elements":[{"startIndex":16008,"endIndex":16035,"textRun":{"content":"Benchmarking SWE and coding","textStyle":{"bold":true}}},{"startIndex":16035,"endIndex":16089,"textRun":{"content":". The Automated Programming Progress Standard (APPS) (","textStyle":{}}},{"startIndex":16089,"endIndex":16111,"textRun":{"content":"Hendrycks et al., 2021","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2105.09938"}}}},{"startIndex":16111,"endIndex":16235,"textRun":{"content":") is a benchmark specifically for evaluating code generation from natural language task descriptions. Similarly, HumanEval (","textStyle":{}}},{"startIndex":16235,"endIndex":16251,"textRun":{"content":"Chen et al, 2021","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2107.03374"}}}},{"startIndex":16251,"endIndex":16322,"textRun":{"content":") tests python coding abilities, and its extensions like HumanEval-XL (","textStyle":{}}},{"startIndex":16322,"endIndex":16338,"textRun":{"content":"Peng et al.,2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2402.16694"}}}},{"startIndex":16338,"endIndex":16452,"textRun":{"content":") tests cross-lingual coding capabilities between 23 natural languages and 12 programming languages. HumanEval-V (","textStyle":{}}},{"startIndex":16452,"endIndex":16470,"textRun":{"content":"Zhang et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2410.12381"}}}},{"startIndex":16470,"endIndex":16599,"textRun":{"content":") tests coding tasks where the model must interpret both diagrams or charts, and textual descriptions to generate code. BigCode (","textStyle":{}}},{"startIndex":16599,"endIndex":16616,"textRun":{"content":"Zuho et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2406.15877"}}}},{"startIndex":16616,"endIndex":16769,"textRun":{"content":"), benchmarks code generation and tool usage by measuring a model’s ability to correctly use multiple Python libraries to solve complex coding problems.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":16769,"endIndex":16770,"paragraph":{"elements":[{"startIndex":16769,"endIndex":16770,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":16770,"endIndex":16883,"table":{"rows":3,"columns":2,"tableRows":[{"startIndex":16771,"en