":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":201119,"endIndex":201133,"tableCells":[{"startIndex":201120,"endIndex":201129,"content":[{"startIndex":201121,"endIndex":201129,"paragraph":{"elements":[{"startIndex":201121,"endIndex":201129,"textRun":{"content":"content\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":201129,"endIndex":201133,"content":[{"startIndex":201130,"endIndex":201131,"paragraph":{"elements":[{"startIndex":201130,"endIndex":201131,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}},{"startIndex":201131,"endIndex":201133,"paragraph":{"elements":[{"startIndex":201131,"endIndex":201132,"inlineObjectElement":{"inlineObjectId":"kix.qhideh3dolv","textStyle":{}}},{"startIndex":201132,"endIndex":201133,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":201133,"endIndex":201193,"tableCells":[{"startIndex":201134,"endIndex":201143,"content":[{"startIndex":201135,"endIndex":201143,"paragraph":{"elements":[{"startIndex":201135,"endIndex":201143,"textRun":{"content":"caption\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":201143,"endIndex":201193,"content":[{"startIndex":201144,"endIndex":201193,"paragraph":{"elements":[{"startIndex":201144,"endIndex":201173,"textRun":{"content":"Illustration of sandbagging (","textStyle":{}}},{"startIndex":201173,"endIndex":201191,"textRun":{"content":"van der Weij, 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.alignmentforum.org/posts/jsmNCj9QKcfdg8fJk/an-introduction-to-ai-sandbagging"}}}},{"startIndex":201191,"endIndex":201193,"textRun":{"content":")\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":80,"unit":"PT"}}]}}},{"startIndex":201194,"endIndex":201195,"paragraph":{"elements":[{"startIndex":201194,"endIndex":201195,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","shading":{"backgroundColor":{}}}}},{"startIndex":201195,"endIndex":202026,"paragraph":{"elements":[{"startIndex":201195,"endIndex":201232,"textRun":{"content":"Behavioral testing is not sufficient.","textStyle":{"bold":true}}},{"startIndex":201232,"endIndex":202026,"textRun":{"content":" We have talked about this numerous times in previous sections, but it's worth mentioning again. Watching what a model does can tell us a lot, but it's still like trying to understand how a person thinks by only observing their actions. Our heavy reliance on behavioral testing - analyzing model outputs - leaves us with significant blind spots about how models actually work. A model might give the right answers while using internal strategies we can't detect. So in addition to being limited by breadth due to combinatorial complexity of the number of things we need to test, we are also limited on the depth of evaluation until we make true progress on interpretability. Unless interpretability makes progress, evaluations have a definite upper limit on how much safety they can guarantee.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","shading":{"backgroundColor":{}}}}},{"startIndex":202026,"endIndex":202027,"paragraph":{"elements":[{"startIndex":202026,"endIndex":202027,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","shading":{"backgroundColor":{}}}}},{"startIndex":202027,"endIndex":202869,"paragraph":{"elements":[{"startIndex":202027,"endIndex":202177,"textRun":{"content":"Sandbagging refers to strategic underperformance on evaluations, where an AI system is intentionally made to appear less capable than it actually is. ","textStyle":{"bold":true}}},{"startIndex":202177,"endIndex":202423,"textRun":{"content":"There are concerns about AI systems themselves choosing to sandbag, independent of developer intentions. An AI system might deliberately hide its capabilities to avoid modifications or restrictions that would prevent it from achieving its goals (","textStyle":{}}},{"startIndex":202423,"endIndex":202437,"textRun":{"content":"Hubinger, 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.alignmentforum.org/posts/dBmfb76zx6wjPsBC7/when-can-we-trust-model-evaluations"}}}},{"startIndex":202437,"endIndex":202847,"textRun":{"content":"). We talked more about why this is a concern in the subsection on scheming. As evidence that is is possible, multiple frontier models including Claude 3.5 Sonnet, Claude 3 Opus, and OpenAI's o1 have been shown to be capable of sandbagging behavior. They deliberately underperformed on arithmetic tasks when they believed that high performance would trigger model unlearning[^footnote_in_context_sandbagging] (","textStyle":{}}},{"startIndex":202847,"endIndex":202866,"textRun":{"content":"Meinke et al., 2025","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2412.04984"}}}},{"startIndex":202866,"endIndex":202868,"textRun":{"content":").","textStyle":{}}},{"startIndex":202868,"endIndex":202869,"textRun":{"content":"\n","textStyle":{"bold":true}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","shading":{"backgroundColor":{}}}}},{"startIndex":202869,"endIndex":202870,"paragraph":{"elements":[{"startIndex":202869,"endIndex":202870,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","shading":{"backgroundColor":{}}}}},{"startIndex":202870,"endIndex":203377,"paragraph":{"elements":[{"startIndex":202870,"endIndex":203355,"textRun":{"content":"[^footnote_in_context_sandbagging]: This behavior was observed in a controlled evaluation setting where models were explicitly informed through the context window about potential unlearning consequences for high performance. The researchers noted: \"We have only shown that some models possess basic scheming capabilities if both the goal and the situational awareness are acquired in-context\" rather than demonstrating this behavior emerging spontaneously in more realistic scenarios (","textStyle":{}}},{"startIndex":203355,"endIndex":203374,"textRun":{"content":"Meinke et al., 2025","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2412.04984"}}}},{"startIndex":203374,"endIndex":203377,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","shading":{"backgroundColor":{}}}}},{"startIndex":203377,"endIndex":203378,"paragraph":{"elements":[{"startIndex":203377,"endIndex":203378,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","shading":{"backgroundColor":{}}}}},{"startIndex":203378,"endIndex":204425,"paragraph":{"elements":[{"startIndex":203378,"endIndex":203453,"textRun":{"content":"What does the potential for sandbagging imply for the field of evaluations?","textStyle":{"bold":true}}},{"startIndex":203453,"endIndex":203669,"textRun":{"content":" The possibility of sandbagging has big implications for how we approach AI evaluations, both now and in the future. Simply having access to model outputs (black-box testing) is insufficient for rigorous evaluation (","textStyle":{}}},{"startIndex":203669,"endIndex":203688,"textRun":{"content":"Casper et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2401.14446"}}}},{"startIndex":203688,"endIndex":204083,"textRun":{"content":"). Instead, evaluators need deeper access to model internals and training procedures to detect potential sandbagging attempts. This might require new institutional arrangements, such as trusted third-party evaluators with secured access to model weights and architectures. Supervised fine-tuning has shown to be promising as a way to greatly mitigate sandbagging and elicit hidden capabilities (","textStyle":{}}},{"startIndex":204083,"endIndex":204105,"textRun":{"content":"Greenblatt et al, 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2405.19550"}}}},{"startIndex":204105,"endIndex":204425,"textRun":{"content":"), but fine-tuning is not so easy to use in a comprehensive way on dangerous capability benchmarks, and not usable for dangerous propensity benchmarks. Without addressing this challenge, our ability to make informed decisions about AI development and deployment based on evaluation results becomes severely compromised.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","shading":{"backgroundColor":{}}}}},{"startIndex":204425,"endIndex":204426,"paragraph":{"elements":[{"startIndex":204425,"endIndex":204426,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","shading":{"backgroundColor":{}}}}},{"startIndex":204426,"endIndex":204447,"paragraph":{"elements":[{"startIndex":204426,"endIndex":204447,"textRun":{"content":"Systemic Limitations\n","textStyle":{}}}],"paragraphStyle":{"headingId":"h.li3ysrrd8hi6","namedStyleType":"HEADING_2","direction":"LEFT_TO_RIGHT"}}},{"startIndex":204447,"endIndex":204448,"paragraph":{"elements":[{"startIndex":204447,"endIndex":204448,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"shading":{"backgroundColor":{}}}}},{"startIndex":204448,"endIndex":204988,"paragraph":{"elements":[{"startIndex":204448,"endIndex":204617,"textRun":{"content":"Similar to how companies might engage in \"greenwashing\" by misleadingly portraying themselves as environmentally friendly, AI companies might engage in \"safety washing\".","textStyle":{"bold":true}}},{"startIndex":204617,"endIndex":204988,"textRun":{"content":" This means misrepresenting capability improvements as safety advancements. This happens when safety benchmarks have high correlation with general model capabilities and compute used for training. When a benchmark highly correlates with capabilities, improving performance on it may simply reflect that the model got more capable overall, rather than specifically safer.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":204988,"endIndex":204989,"paragraph":{"elements":[{"startIndex":204988,"endIndex":204989,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":204989,"endIndex":205368,"table":{"rows":3,"columns":2,"tableRows":[{"startIndex":204990,"endIndex":205005,"tableCells":[{"startIndex":204991,"endIndex":204997,"content":[{"startIndex":204992,"endIndex":204997,"paragraph":{"elements":[{"startIndex":204992,"endIndex":204997,"textRun":{"content":"type\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":204997,"endIndex":205005,"content":[{"startIndex":204998,"endIndex":205005,"paragraph":{"elements":[{"startIndex":204998,"endIndex":205005,"textRun":{"content":"figure\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":205005,"endIndex":205019,"tableCells":[{"startIndex":205006,"endIndex":205015,"content":[{"startIndex":205007,"endIndex":205015,"paragraph":{"elements":[{"startIndex":205007,"endIndex":205015,"textRun":{"content":"content\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":205015,"endIndex":205019,"content":[{"startIndex":205016,"endIndex":205017,"paragraph":{"elements":[{"startIndex":205016,"endIndex":205017,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}},{"startIndex":205017,"endIndex":205019,"paragraph":{"elements":[{"startIndex":205017,"endIndex":205018,"inlineObjectElement":{"inlineObjectId":"kix.w23k2w2mo40","textStyle":{}}},{"startIndex":205018,"endIndex":205019,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":205019,"endIndex":205367,"tableCells":[{"startIndex":205020,"endIndex":205029,"content":[{"startIndex":205021,"endIndex":205029,"paragraph":{"elements":[{"startIndex":205021,"endIndex":205029,"textRun":{"content":"caption\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":205029,"endIndex":205367,"content":[{"startIndex":205030,"endIndex":205367,"paragraph":{"elements":[{"startIndex":205030,"endIndex":205348,"textRun":{"content":"The tight connection between many safety properties and capabilities can enable safety washing, where capabilities advancements (e.g., training a larger model) can be advertised as progress on \"AI safety.\" This confuses the research community to the developments that have occurred, distorting the academic discourse (","textStyle":{}}},{"startIndex":205348,"endIndex":205364,"textRun":{"content":"Ren et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2407.21792"}}}},{"startIndex":205364,"endIndex":205367,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","shading":{"backgroundColor":{}}}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":80,"unit":"PT"}}]}}},{"startIndex":205368,"endIndex":205369,"paragraph":{"elements":[{"startIndex":205368,"endIndex":205369,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":205369,"endIndex":205476,"paragraph":{"elements":[{"startIndex":205369,"endIndex":205412,"textRun":{"content":"How does safety washing happen in practice?","textStyle":{"bold":true}}},{"startIndex":205412,"endIndex":205457,"textRun":{"content":" There are typically three ways this occurs (","textStyle":{}}},{"startIndex":205457,"endIndex":205473,"textRun":{"content":"Ren et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2407.21792"}}}},{"startIndex":205473,"endIndex":205476,"textRun":{"content":"):\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":205476,"endIndex":205477,"paragraph":{"elements":[{"startIndex":205476,"endIndex":205477,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":205477,"endIndex":205654,"paragraph":{"elements":[{"startIndex":205477,"endIndex":205498,"textRun":{"content":"Safety by association","textStyle":{"bold":true}}},{"startIndex":205498,"endIndex":205654,"textRun":{"content":": Research gets labeled as safety-relevant simply because it comes from safety teams or researchers, even if the work is essentially capabilities research.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.oz7t6of6ugwh","textStyle":{"underline":false}}}},{"startIndex":205654,"endIndex":205839,"paragraph":{"elements":[{"startIndex":205654,"endIndex":205670,"textRun":{"content":"Public relations","textStyle":{"bold":true}}},{"startIndex":205670,"endIndex":205839,"textRun":{"content":": Companies portray capability advancements as safety progress by highlighting correlated safety metrics, especially when facing public pressure or regulatory scrutiny.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.oz7t6of6ugwh","textStyle":{"underline":false}}}},{"startIndex":205839,"endIndex":205997,"paragraph":{"elements":[{"startIndex":205839,"endIndex":205857,"textRun":{"content":"Grant optimization","textStyle":{"bold":true}}},{"startIndex":205857,"endIndex":205997,"textRun":{"content":": Researchers frame capabilities work in safety terms to appeal to funders, even when the advances don't make differential safety progress.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.oz7t6of6ugwh","textStyle":{"underline":false}}}},{"startIndex":205997,"endIndex":205998,"paragraph":{"elements":[{"startIndex":205997,"endIndex":205998,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":205998,"endIndex":206814,"paragraph":{"elements":[{"startIndex":205998,"endIndex":206052,"textRun":{"content":"Capabilities correlations might enable safety washing.","textStyle":{"bold":true}}},{"startIndex":206052,"endIndex":206440,"textRun":{"content":" When safety benchmarks correlate strongly with capabilities, it becomes easy to misrepresent capability improvements as safety advances. For example, if a benchmark meant to measure \"truthfulness\" actually correlates 80% with general capabilities, then making models bigger and more capable will improve their \"truthfulness\" scores - even if they aren't becoming inherently more honest (","textStyle":{}}},{"startIndex":206440,"endIndex":206456,"textRun":{"content":"Ren et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2407.21792"}}}},{"startIndex":206456,"endIndex":206814,"textRun":{"content":"). This creates a systemic problem where organizations can claim safety improvements by simply scaling up their models. The solution isn't just establishing norms around benchmark use - these tend to be weak and easily ignored. Instead, we need evaluation methods that can empirically distinguish between capability improvements and genuine safety advances.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":206814,"endIndex":206815,"paragraph":{"elements":[{"startIndex":206814,"endIndex":206815,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"shading":{"backgroundColor":{}}}}},{"startIndex":206815,"endIndex":207163,"paragraph":{"elements":[{"startIndex":206815,"endIndex":206882,"textRun":{"content":"Companies and AI labs can also choose to sandbag their evaluations.","textStyle":{"bold":true}}},{"startIndex":206882,"endIndex":207163,"textRun":{"content":" We put another form of sandbagging here as systemic limitation to refer to corporations intentionally sandbagging to score better on evaluations. This is in contrast to misalignment/technical sandbagging as a limitation which points to when the model does it because of scheming.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":207163,"endIndex":207164,"paragraph":{"elements":[{"startIndex":207163,"endIndex":207164,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":207164,"endIndex":207935,"paragraph":{"elements":[{"startIndex":207164,"endIndex":207537,"textRun":{"content":"In the immediate term, developers face various pressures that could incentivize sandbagging during evaluations. Regulatory requirements and safety standards may impose capability thresholds above which additional oversight, restrictions, or costs are incurred. For instance, the EU AI Act requires more stringent controls and third-party auditing for high-risk AI systems (","textStyle":{}}},{"startIndex":207537,"endIndex":207562,"textRun":{"content":"European Commission, 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://artificialintelligenceact.eu/the-act/"}}}},{"startIndex":207562,"endIndex":207907,"textRun":{"content":"). This creates a direct financial incentive to appear below these thresholds. Current research shows that even today's language models can be made to selectively underperform in ways that are difficult to detect through standard evaluations, particularly on tests for dangerous capabilities while maintaining performance on general benchmarks (","textStyle":{}}},{"startIndex":207907,"endIndex":207932,"textRun":{"content":"van der Weij et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2406.07358"}}}},{"startIndex":207932,"endIndex":207935,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":207935,"endIndex":207936,"paragraph":{"elements":[{"startIndex":207935,"endIndex":207936,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","shading":{"backgroundColor":{}}}}},{"startIndex":207936,"endIndex":208624,"paragraph":{"elements":[{"startIndex":207936,"endIndex":208491,"textRun":{"content":"In the future, companies may want to downplay certain capabilities of their systems to avoid drawing regulatory attention or public concern, while still being able to deploy these capabilities in practice. This allows them to maintain development and deployment speed without triggering additional oversight. For example, if an AI system shows strong capabilities in areas that might raise security concerns, developers might be motivated to have it underperform specifically on those evaluations while maintaining high performance on general benchmarks (","textStyle":{}}},{"startIndex":208491,"endIndex":208516,"textRun":{"content":"van der Weij et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2406.07358"}}}},{"startIndex":208516,"endIndex":208624,"textRun":{"content":"). They might do this to maintain development and deployment speed without triggering additional oversight.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","shading":{"backgroundColor":{}}}}},{"startIndex":208624,"endIndex":208625,"paragraph":{"elements":[{"startIndex":208624,"endIndex":208625,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"shading":{"backgroundColor":{}}}}},{"startIndex":208625,"endIndex":209542,"paragraph":{"elements":[{"startIndex":208625,"endIndex":208667,"textRun":{"content":"The gap between evaluation and deployment.","textStyle":{"bold":true}}},{"startIndex":208667,"endIndex":209517,"textRun":{"content":" Current evaluation approaches often fail to capture the true complexity of real-world deployment contexts. While we can measure model performance in controlled settings, these evaluations rarely reflect how systems will behave when embedded in complex sociotechnical environments. A model that performs safely in isolated testing might behave very differently when interacting with real users, facing novel scenarios, or operating within broader societal systems. For instance, a medical advice model might perform well on standard benchmarks but pose serious risks when deployed in healthcare settings where users lack the expertise to validate its recommendations. This disconnect between evaluation and deployment contexts means we might miss critical safety issues that only emerge through complex human-AI interactions or system-level effects (","textStyle":{}}},{"startIndex":209517,"endIndex":209539,"textRun":{"content":"Weidinger et al., 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2310.11986"}}}},{"startIndex":209539,"endIndex":209542,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"shading":{"backgroundColor":{}}}}},{"startIndex":209542,"endIndex":209543,"paragraph":{"elements":[{"startIndex":209542,"endIndex":209543,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"shading":{"backgroundColor":{}}}}},{"startIndex":209543,"endIndex":210802,"paragraph":{"elements":[{"startIndex":209543,"endIndex":209587,"textRun":{"content":"The challenge of domain-specific evaluations","textStyle":{"bold":true}}},{"startIndex":209587,"endIndex":210802,"textRun":{"content":". Evaluating AI systems in high-stakes domains presents unique challenges that our current approaches struggle to address. Consider the evaluation of AI systems for potential misuse in biosecurity - this requires not just technical understanding of AI systems and evaluation methods, but also deep expertise in biology, biosafety protocols, and potential threat vectors. This combination of expertise is exceedingly rare, making thorough evaluation in these critical domains particularly challenging. Similar challenges arise in other specialized fields like cybersecurity, where the complexity of potential attack vectors and system vulnerabilities requires sophisticated domain knowledge to properly assess. The difficulty of finding evaluators with sufficient cross-domain expertise often leads to evaluations that miss important domain-specific risks or fail to anticipate novel forms of misuse. Besides just designing evaluations being challenging, running the evaluation for such high stakes domains is also challenging. We need to elicit the maximum capabilities of a model to generate pathogens or malware to test what it is capable of. This can be obviously problematic if not handled extremely carefully.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"shading":{"backgroundColor":{}}}}},{"startIndex":210802,"endIndex":210803,"paragraph":{"elements":[{"startIndex":210802,"endIndex":210803,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","shading":{"backgroundColor":{}}}}},{"startIndex":210803,"endIndex":210826,"paragraph":{"elements":[{"startIndex":210803,"endIndex":210826,"textRun":{"content":"Governance Limitations\n","textStyle":{}}}],"paragraphStyle":{"headingId":"h.25ildt7zu5xv","namedStyleType":"HEADING_2","direction":"LEFT_TO_RIGHT","shading":{"backgroundColor":{}}}}},{"startIndex":210826,"endIndex":210827,"paragraph":{"elements":[{"startIndex":210826,"endIndex":210827,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","shading":{"backgroundColor":{}}}}},{"startIndex":210827,"endIndex":211086,"table":{"rows":3,"columns":2,"tableRows":[{"startIndex":210828,"endIndex":210843,"tableCells":[{"startIndex":210829,"