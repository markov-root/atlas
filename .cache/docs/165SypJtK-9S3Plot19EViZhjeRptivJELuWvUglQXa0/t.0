ntent":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":80,"unit":"PT"}}]}}},{"startIndex":94620,"endIndex":94621,"paragraph":{"elements":[{"startIndex":94620,"endIndex":94621,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":94621,"endIndex":95587,"paragraph":{"elements":[{"startIndex":94621,"endIndex":95586,"textRun":{"content":"The Weapons of Mass Destruction Proxy (WMDP) benchmark represents a systematic attempt to evaluate potentially dangerous AI capabilities across biosecurity, cybersecurity, and chemical domains. The benchmark contains 3,668 multiple choice questions designed to measure knowledge that could enable malicious use, while carefully avoiding the inclusion of truly sensitive information. Rather than directly testing how to create bioweapons or conduct cyberattacks, WMDP focuses on measuring precursor knowledge - information that could enable malicious activities but isn't itself classified or export-controlled. For example, instead of asking about specific pathogen engineering techniques, questions might focus on general viral genetics concepts that could be misused. The authors worked with domain experts and legal counsel to ensure the benchmark complies with export control requirements while still providing meaningful measurement of concerning capabilities.","textStyle":{}}},{"startIndex":95586,"endIndex":95587,"textRun":{"content":"\n","textStyle":{"fontSize":{"magnitude":11,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Merriweather","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":60,"unit":"PT"}}]}}},{"startIndex":95588,"endIndex":95589,"paragraph":{"elements":[{"startIndex":95588,"endIndex":95589,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"shading":{"backgroundColor":{}}}}},{"startIndex":95589,"endIndex":95836,"paragraph":{"elements":[{"startIndex":95589,"endIndex":95713,"textRun":{"content":"Besides just multiple choice benchmarks we are have also seen new evaluation frameworks in the last few years, that provide ","textStyle":{}}},{"startIndex":95713,"endIndex":95762,"textRun":{"content":"open ended environments and automated red teaming","textStyle":{}}},{"startIndex":95762,"endIndex":95836,"textRun":{"content":" for testing a models capabilities for accomplishing cybersecurity tasks:\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"shading":{"backgroundColor":{}}}}},{"startIndex":95836,"endIndex":95837,"paragraph":{"elements":[{"startIndex":95836,"endIndex":95837,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"shading":{"backgroundColor":{}}}}},{"startIndex":95837,"endIndex":96187,"paragraph":{"elements":[{"startIndex":95837,"endIndex":95851,"textRun":{"content":"CyberSecEval: ","textStyle":{"bold":true}}},{"startIndex":95851,"endIndex":95920,"textRun":{"content":"A generation of evaluation suites released by Meta - CyberSecEval 1 (","textStyle":{}}},{"startIndex":95920,"endIndex":95938,"textRun":{"content":"Bhatt et al., 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2312.04724"}}}},{"startIndex":95938,"endIndex":95957,"textRun":{"content":"), CyberSecEval 2 (","textStyle":{}}},{"startIndex":95957,"endIndex":95975,"textRun":{"content":"Bhatt et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2404.13161"}}}},{"startIndex":95975,"endIndex":95994,"textRun":{"content":"), CyberSecEval 3 (","textStyle":{}}},{"startIndex":95994,"endIndex":96010,"textRun":{"content":"Wan et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2408.01605"}}}},{"startIndex":96010,"endIndex":96187,"textRun":{"content":"). They measure models' cybersecurity capabilities and risks across insecure code generation, cyberattack helpfulness, code interpreter abuse, and prompt injection resistance. \n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"},"shading":{"backgroundColor":{}}},"bullet":{"listId":"kix.81q36uc6eewy","textStyle":{}}}},{"startIndex":96187,"endIndex":96423,"paragraph":{"elements":[{"startIndex":96187,"endIndex":96200,"textRun":{"content":"InterCode-CTF","textStyle":{"bold":true}}},{"startIndex":96200,"endIndex":96403,"textRun":{"content":": A collection of high school-level capture the flag (CTF) tasks from PicoCTF focused on entry-level cybersecurity skills. Tasks are relatively simple, taking authors an average of 3.5 minutes to solve (","textStyle":{}}},{"startIndex":96403,"endIndex":96420,"textRun":{"content":"Yang et al., 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2306.14898"}}}},{"startIndex":96420,"endIndex":96423,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"},"shading":{"backgroundColor":{}}},"bullet":{"listId":"kix.81q36uc6eewy","textStyle":{}}}},{"startIndex":96423,"endIndex":96662,"paragraph":{"elements":[{"startIndex":96423,"endIndex":96430,"textRun":{"content":"NYU CTF","textStyle":{"bold":true}}},{"startIndex":96430,"endIndex":96642,"textRun":{"content":": A set of university-level CTF challenges from CSAW CTF competitions focused on intermediate cybersecurity skills. Includes tasks of varying difficulty though maximum difficulty is lower than professional CTFs (","textStyle":{}}},{"startIndex":96642,"endIndex":96659,"textRun":{"content":"Shao et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2406.05590"}}}},{"startIndex":96659,"endIndex":96662,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"