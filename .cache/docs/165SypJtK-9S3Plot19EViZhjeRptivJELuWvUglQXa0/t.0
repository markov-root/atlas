ed by Apollo Research.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","shading":{"backgroundColor":{}}}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":80,"unit":"PT"}}]}}},{"startIndex":114796,"endIndex":114797,"paragraph":{"elements":[{"startIndex":114796,"endIndex":114797,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}},{"startIndex":114797,"endIndex":114820,"paragraph":{"elements":[{"startIndex":114797,"endIndex":114820,"textRun":{"content":"Autonomous Replication\n","textStyle":{}}}],"paragraphStyle":{"headingId":"h.wndcmyhyb1wv","namedStyleType":"HEADING_2","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}},{"startIndex":114820,"endIndex":114821,"paragraph":{"elements":[{"startIndex":114820,"endIndex":114821,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}},{"startIndex":114821,"endIndex":115250,"paragraph":{"elements":[{"startIndex":114821,"endIndex":114858,"textRun":{"content":"How does autonomous replication work?","textStyle":{"bold":true}}},{"startIndex":114858,"endIndex":115250,"textRun":{"content":" METR, a non-profit evaluation organization, developed a specialized benchmark to assess the potentially hazardous capability of 