graphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":213543,"endIndex":213564,"content":[{"startIndex":213544,"endIndex":213564,"paragraph":{"elements":[{"startIndex":213544,"endIndex":213564,"textRun":{"content":"section-description\n","textStyle":{"fontSize":{"magnitude":11,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Merriweather","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":213564,"endIndex":213764,"tableCells":[{"startIndex":213565,"endIndex":213574,"content":[{"startIndex":213566,"endIndex":213574,"paragraph":{"elements":[{"startIndex":213566,"endIndex":213574,"textRun":{"content":"content\n","textStyle":{"fontSize":{"magnitude":11,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Merriweather","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":213574,"endIndex":213764,"content":[{"startIndex":213575,"endIndex":213764,"paragraph":{"elements":[{"startIndex":213575,"endIndex":213764,"textRun":{"content":"Robust evaluation methods provide the essential tools to measure current capabilities, and help navigate the balance between harnessing AI's benefits and mitigating its most serious risks.\n","textStyle":{"fontSize":{"magnitude":11,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Merriweather","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":115,"direction":"LEFT_TO_RIGHT","shading":{"backgroundColor":{}}}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":80,"unit":"PT"}}]}}},{"startIndex":213765,"endIndex":213766,"paragraph":{"elements":[{"startIndex":213765,"endIndex":213766,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":115,"direction":"LEFT_TO_RIGHT","shading":{"backgroundColor":{}}}}},{"startIndex":213766,"endIndex":214653,"paragraph":{"elements":[{"startIndex":213766,"endIndex":214653,"textRun":{"content":"The future of AI safety depends significantly on our ability to accurately measure and verify the properties of increasingly powerful systems. As models approach potentially transformative capabilities in domains like cybersecurity, autonomous operation, and strategic planning, the stakes of evaluation failures grow exponentially. By continuing to refine our evaluation approaches—combining behavioral and internal techniques, addressing scale challenges through automated methods, and establishing institutional arrangements for genuinely independent assessment—we can help ensure that AI development proceeds in a direction that remains beneficial, controllable, and aligned with human values. The development of robust evaluation methods represents one of our most important tools for navigating the balance between harnessing AI's benefits while mitigating its most serious risks.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","shading":{"backgroundColor":{}}}}},{"startIndex":214653,"endIndex":214654,"paragraph":{"elements":[{"startIndex":214653,"endIndex":214654,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","shading":{"backgroundColor":{}}}}},{"startIndex":214654,"endIndex":214752,"paragraph":{"elements":[{"startIndex":214654,"endIndex":214752,"textRun":{"content":"We hope that reading this text inspires you to think and act about how to build and improve them!\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","shading":{"backgroundColor":{}}}}}]},"footnotes":{"kix.gwmw2zfe5ml3":{"footnoteId":"kix.gwmw2zfe5ml3","content":[{"endIndex":213,"paragraph":{"elements":[{"endIndex":1,"textRun":{"content":" ","textStyle":{"fontSize":{"magnitude":10,"unit":"PT"}}}},{"startIndex":1,"endIndex":212,"textRun":{"content":"This is true to a large extent, but as always there is not 100% standardization. We can make meaningful comparisons, but trusting them completely without many more details should be approached with some caution.","textStyle":{}}},{"startIndex":212,"endIndex":213,"textRun":{"content":"\n","textStyle":{"fontSize":{"magnitude":10,"unit":"PT"}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}]},"kix.fbn8p9igksv7":{"footnoteId":"kix.fbn8p9igksv7","content":[{"endIndex":214,"paragraph":{"elements":[{"endIndex":1,"textRun":{"content":" ","textStyle":{"fontSize":{"magnitude":10,"unit":"PT"}}}},{"startIndex":1,"endIndex":213,"textRun":{"content":"We could have benchmarks in environments populated by other agents. Some RL benchmarks already do this. This is amongst one of the many additions to benchmarking that moves us towards a holistic evaluation suite.","textStyle":{}}},{"startIndex":213,"endIndex":214,"textRun":{"content":"\n","textStyle":{"fontSize":{"magnitude":10,"unit":"PT"}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}]},"kix.1kfe22vbgi0r":{"footnoteId":"kix.1kfe22vbgi0r","content":[{"endIndex":285,"paragraph":{"elements":[{"endIndex":1,"textRun":{"content":" ","textStyle":{"fontSize":{"magnitude":10,"unit":"PT"}}}},{"startIndex":1,"endIndex":91,"textRun":{"content":"Sometimes, but not always desirable sadly. In the dangerous capability eval for RE-Bench (","textStyle":{}}},{"startIndex":91,"endIndex":101,"textRun":{"content":"METR, 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2411.15114"}}}},{"startIndex":101,"endIndex":284,"textRun":{"content":"). Looking at figure 14 (P42), it shows that the o1-based-agent cheats instead of properly solving the task, so (just from this run) we don't know if it has the relevant capabilities.","textStyle":{}}},{"startIndex":284,"endIndex":285,"textRun":{"content":"\n","textStyle":{"fontSize":{"magnitude":10,"unit":"PT"}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}]},"kix.q0k5wazpcd5":{"footnoteId":"kix.q0k5wazpcd5","content":[{"endIndex":536,"paragraph":{"elements":[{"endIndex":1,"textRun":{"content":" ","textStyle":{"fontSize":{"magnitude":10,"unit":"PT"}}}},{"startIndex":1,"endIndex":535,"textRun":{"content":"A big issue for propensity evaluations is to remove the confounding effect from having various capability levels. As an example, truthfulness is a mix of capability evaluations (knowing accurate information) and of a propensity evaluation (tending to honestly reveal known information). If you have both accurate information and honest reporting, then you get truthfulness. But observing an increase in truthfulness does not obviously imply an increase in honesty, it may just be an increase in the \"amount of stuff known\" capability.","textStyle":{}}},{"startIndex":535,"endIndex":536,"textRun":{"content":"\n","textStyle":{"fontSize":{"magnitude":10,"unit":"PT"}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}]},"kix.44n6iz866bh8":{"footnoteId":"kix.44n6iz866bh8","content":[{"endIndex":333,"paragraph":{"elements":[{"endIndex":1,"textRun":{"content":" ","textStyle":{"fontSize":{"magnitude":10,"unit":"PT"}}}},{"startIndex":1,"endIndex":332,"textRun":{"content":"To put it in a more nuanced way, dangerous capability evaluations are about producing upper bounds. But capability evals (without \"dangerous\") are often about evaluating the capability under the elicitation strength that will be used in practice (not under maximum elicitation strength like when you try to produce an upper bound).","textStyle":{}}},{"startIndex":332,"endIndex":333,"textRun":{"content":"\n","textStyle":{"fontSize":{"magnitude":10,"unit":"PT"}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}]},"kix.tnfxgocol29i":{"footnoteId":"kix.tnfxgocol29i","content":[{"endIndex":196,"paragraph":{"elements":[{"endIndex":1,"textRun":{"content":" ","textStyle":{"fontSize":{"magnitude":10,"unit":"PT"}}}},{"startIndex":1,"endIndex":195,"textRun":{"content":"Control evals should be performed at the crossroads of \"dangerous capabilities evals\" and \"dangerous propensity evals\". The elicitation should be towards max capabilities and worst propensities.","textStyle":{}}},{"startIndex":195,"endIndex":196,"textRun":{"content":"\n","textStyle":{"fontSize":{"magnitude":10,"unit":"PT"}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}]},"kix.wd2zrck0566g":{"footnoteId":"kix.wd2zrck0566g","content":[{"endIndex":396,"paragraph":{"elements":[{"endIndex":1,"textRun":{"content":" ","textStyle":{"fontSize":{"magnitude":10,"unit":"PT"}}}},{"startIndex":1,"endIndex":395,"textRun":{"content":"Our usage of the term is different from how others choose to use black/white box evaluations. We use white to refer to understanding model internals, whereas in some other writeups white refers to the level of access to the internals rather than level of understanding. Under the latter definition it is possible to have white box evaluations e.g. reading vectors in representation engineering.","textStyle":{}}},{"startIndex":395,"endIndex":396,"textRun":{"content":"\n","textStyle":{"fontSize":{"magnitude":10,"unit":"PT"}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}]},"kix.a6785ggvtxko":{"footnoteId":"kix.a6785ggvtxko","content":[{"endIndex":344,"paragraph":{"elements":[{"endIndex":1,"textRun":{"content":" ","textStyle":{"fontSize":{"magnitude":10,"unit":"PT"}}}},{"startIndex":1,"endIndex":343,"textRun":{"content":"A common confusion is to think of humans as the adversaries. This falls under misuse like data poisoning or prompt injections. While this is important to safeguard against, it is not what we are talking about. We explicitly mean that the AI itself is an adversary, and it displays adversarial behavior in order to subvert our safety measures.","textStyle":{}}},{"startIndex":343,"endIndex":344,"textRun":{"content":"\n","textStyle":{"fontSize":{"magnitude":10,"unit":"PT"}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}]},"kix.eecx0uc8m51q":{"footnoteId":"kix.eecx0uc8m51q","content":[{"endIndex":126,"paragraph":{"elements":[{"endIndex":1,"textRun":{"content":" ","textStyle":{"fontSize":{"magnitude":10,"unit":"PT"}}}},{"startIndex":1,"endIndex":125,"textRun":{"content":"This can also be thought of as inference time scaling for reasoning models. It is effectively the same underlying technique.","textStyle":{}}},{"startIndex":125,"endIndex":126,"textRun":{"content":"\n","textStyle":{"fontSize":{"magnitude":10,"unit":"PT"}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}]},"kix.4p8kd5hil2tm":{"footnoteId":"kix.4p8kd5hil2tm","content":[{"endIndex":145,"paragraph":{"elements":[{"endIndex":1,"textRun":{"content":" ","textStyle":{"fontSize":{"magnitude":10,"unit":"PT"}}}},{"startIndex":1,"endIndex":132,"textRun":{"content":"This could be to pass safety checks, and participate in safety washing. Think of how Volkswagen hid high emissions of their cars. (","textStyle":{}}},{"startIndex":132,"endIndex":143,"textRun":{"content":"Ewing, 2017","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.nytimes.com/interactive/2017/business/volkswagen-diesel-emissions-timeline.html"}}}},{"startIndex":143,"endIndex":144,"textRun":{"content":")","textStyle":{}}},{"startIndex":144,"endIndex":145,"textRun":{"content":"\n","textStyle":{"fontSize":{"magnitude":10,"unit":"PT"}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}]},"kix.bv8y82f3ri4h":{"footnoteId":"kix.bv8y82f3ri4h","content":[{"endIndex":338,"paragraph":{"elements":[{"endIndex":1,"textRun":{"content":" ","textStyle":{"fontSize":{"magnitude":10,"unit":"PT"}}}},{"startIndex":1,"endIndex":337,"textRun":{"content":"Although it was clearly demonstrated by Anthropic, replication of their results has been difficult. Attempts have been made to introduce backdoors in LLMs but it is difficult to make these backdoors robust to further fine-tuning. The teams managed to get the backdoors to stay, but they were mostly removed by further fine tuning steps.","textStyle":{}}},{"startIndex":337,"endIndex":338,"textRun":{"content":"\n","textStyle":{"fontSize":{"magnitude":10,"unit":"PT"}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}]},"kix.ck0adzqok0u":{"footnoteId":"kix.ck0adzqok0u","content":[{"endIndex":1135,"paragraph":{"elements":[{"endIndex":1,"textRun":{"content":" ","textStyle":{"fontSize":{"magnitude":10,"unit":"PT"}}}},{"startIndex":1,"endIndex":471,"textRun":{"content":"Many people mean very different things when talking about consciousness. It is often seen as a conflationary alliance term, i.e. it is part of a type of social or intellectual coalition that forms around a term or concept with multiple, often ambiguous or conflated meanings. The alliance arises because the vagueness of the term allows a wide range of people or groups to rally behind it, each interpreting the concept according to their own definitions or priorities (","textStyle":{}}},{"startIndex":471,"endIndex":483,"textRun":{"content":"Critch, 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.alignmentforum.org/posts/KpD2fJa6zo8o2MBxg/consciousness-as-a-conflationary-alliance-term-for"}}}},{"startIndex":483,"endIndex":1134,"textRun":{"content":"). As with all other concepts throughout this book, we are trying to avoid ambiguity and anthropomorphism. Situational awareness is a measurable capability focused on specific behaviors that indicate knowledge of identity and context. Unlike consciousness, which involves philosophical questions about subjective experience, situational awareness can be evaluated through objective behavioral tests. A model can demonstrate high situational awareness without requiring any form of consciousness or sentience. Discussions about AI models having consciousness, theory of mind, being moral patients or related questions are beyond the scope of this text.","textStyle":{}}},{"startIndex":1134,"endIndex":1135,"textRun":{"content":"\n","textStyle":{"fontSize":{"magnitude":10,"unit":"PT"}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}]},"kix.zg49v9af2wd2":{"footnoteId":"kix.zg49v9af2wd2","content":[{"endIndex":91,"paragraph":{"elements":[{"endIndex":1,"textRun":{"content":" ","textStyle":{"fontSize":{"magnitude":10,"unit":"PT"}}}},{"startIndex":1,"endIndex":77,"textRun":{"content":"This type of behavior is also sometimes called - playing the training game (","textStyle":{}}},{"startIndex":77,"endIndex":88,"textRun":{"content":"Piper, 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.planned-obsolescence.org/the-training-game/"}}}},{"startIndex":88,"endIndex":90,"textRun":{"content":").","textStyle":{}}},{"startIndex":90,"endIndex":91,"textRun":{"content":"\n","textStyle":{"fontSize":{"magnitude":10,"unit":"PT"}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}]}},"documentStyle":{"background":{"color":{}},"pageNumberStart":1,"marginTop":{"magnitude":72,"unit":"PT"},"marginBottom":{"magnitude":72,"unit":"PT"},"marginRight":{"magnitude":72,"unit":"PT"},"marginLeft":{"magnitude":72,"unit":"PT"},"pageSize":{"height":{"magnitude":841.8897637795277,"unit":"PT"},"width":{"magnitude":595.2755905511812,"unit":"PT"}},"marginHeader":{"magnitude":36,"unit":"PT"},"marginFooter":{"magnitude":36,"unit":"PT"},"useCustomHeaderFooterMargins":true,"documentFormat":{"documentMode":"PAGELESS"}},"namedStyles":{"styles":[{"namedStyleType":"NORMAL_TEXT","textStyle":{"bold":false,"italic":false,"underline":false,"strikethrough":false,"smallCaps":false,"backgroundColor":{},"foregroundColor":{"color":{"rgbColor":{"red":0.05490196,"green":0.0627451,"blue":0.101960786}}},"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400},"baselineOffset":"NONE"},"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"JUSTIFIED","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":true,"shading":{"backgroundColor":{}},"pageBreakBefore":false}},{"namedStyleType":"HEADING_1","textStyle":{"bold":true,"fontSize":{"magnitude":20,"unit":"PT"}},"paragraphStyle":{"headingId":"h.4qtu063xgs5m","namedStyleType":"HEADING_1","direction":"LEFT_TO_RIGHT","keepLinesTogether":true,"keepWithNext":true}},{"namedStyleType":"HEADING_2","textStyle":{"bold":true,"fontSize":{"magnitude":17,"unit":"PT"}},"paragraphStyle":{"headingId":"h.sjwmu6fs61e8","namedStyleType":"HEADING_2","direction":"LEFT_TO_RIGHT","keepLinesTogether":true,"keepWithNext":true,"shading":{"backgroundColor":{}}}},{"namedStyleType":"HEADING_3","textStyle":{"bold":true,"fontSize":{"magnitude":14,"unit":"PT"}},"paragraphStyle":{"headingId":"h.i7dbblbhaje4","namedStyleType":"HEADING_3","direction":"LEFT_TO_RIGHT","keepLinesTogether":true,"keepWithNext":true}},{"namedStyleType":"HEADING_4","textStyle":{"bold":true,"fontSize":{"magnitude":14,"unit":"PT"}},"paragraphStyle":{"headingId":"h.808yh97x6psq","namedStyleType":"HEADING_4","direction":"LEFT_TO_RIGHT","keepLinesTogether":true,"keepWithNext":true}},{"namedStyleType":"HEADING_5","textStyle":{"bold":true,"underline":true},"paragraphStyle":{"headingId":"h.aeg47tyb3sfw","namedStyleType":"HEADING_5","direction":"LEFT_TO_RIGHT","keepLinesTogether":true,"keepWithNext":true}},{"named