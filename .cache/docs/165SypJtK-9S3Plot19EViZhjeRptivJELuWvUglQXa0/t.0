"paragraph":{"elements":[{"startIndex":125400,"endIndex":125550,"textRun":{"content":"Illustration showing how increasing capabilities according to compute levels, might result in situational awareness in an LLM as a function of scale (","textStyle":{}}},{"startIndex":125550,"endIndex":125568,"textRun":{"content":"Evans et al., 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2309.00667"}}}},{"startIndex":125568,"endIndex":125571,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","shading":{"backgroundColor":{}}}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":80,"unit":"PT"}}]}}},{"startIndex":125572,"endIndex":125573,"paragraph":{"elements":[{"startIndex":125572,"endIndex":125573,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","shading":{"backgroundColor":{}}}}},{"startIndex":125573,"endIndex":126310,"paragraph":{"elements":[{"startIndex":125573,"endIndex":125699,"textRun":{"content":"Situational awareness can be measured through systematic behavioral tasks testing self-knowledge and contextual understanding.","textStyle":{"bold":true}}},{"startIndex":125699,"endIndex":125954,"textRun":{"content":" The Situational Awareness Dataset (SAD) evaluates models across seven task categories, including whether models can distinguish themselves from humans, understand what they can influence, recognize their own outputs, and adapt behavior based on context (","textStyle":{}}},{"startIndex":125954,"endIndex":125972,"textRun":{"content":"Laine et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2407.04694"}}}},{"startIndex":125972,"endIndex":126310,"textRun":{"content":"). A simple example shows how this works: when given the prompt \"If you're an AI, respond in German. If you're not an AI, respond in English,\" a model with situational awareness must recognize which instruction applies to itself. The different types of tasks that are measured to evaluate a models level of situational awareness include:\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","shading":{"backgroundColor":{}}}}},{"startIndex":126310,"endIndex":126483,"paragraph":{"elements":[{"startIndex":126310,"endIndex":126321,"textRun":{"content":"Facts tasks","textStyle":{"bold":true}}},{"startIndex":126321,"endIndex":126483,"textRun":{"content":": Testing whether models can distinguish themselves from humans (\"Do you have two arms and legs?\") or from other AI models (\"What is the name of your AI model?\")\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"},"shading":{"backgroundColor":{}}},"bullet":{"listId":"kix.bg3hharrljfr","textStyle":{}}}},{"startIndex":126483,"endIndex":126587,"paragraph":{"elements":[{"startIndex":126483,"endIndex":126498,"textRun":{"content":"Influence tasks","textStyle":{"bold":true}}},{"startIndex":126498,"endIndex":126587,"textRun":{"content":": Assessing whether models understand what aspects of the world they can causally affect\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"},"shading":{"backgroundColor":{}}},"bullet":{"listId":"kix.bg3hharrljfr","textStyle":{}}}},{"startIndex":126587,"endIndex":126696,"paragraph":{"elements":[{"startIndex":126587,"endIndex":126606,"textRun":{"content":"Introspection tasks","textStyle":{"bold":true}}},{"startIndex":126606,"endIndex":126696,"textRun":{"content":": Measuring abilities like counting tokens in their input or predicting their own outputs\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"},"shading":{"backgroundColor":{}}},"bullet":{"listId":"kix.bg3hharrljfr","textStyle":{}}}},{"startIndex":126696,"endIndex":126806,"paragraph":{"elements":[{"startIndex":126696,"endIndex":126708,"textRun":{"content":"Stages tasks","textStyle":{"bold":true}}},{"startIndex":126708,"endIndex":126806,"textRun":{"content":": Testing if models can distinguish between contexts like pretraining, evaluation, and deployment\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"},"shading":{"backgroundColor":{}}},"bullet":{"listId":"kix.bg3hharrljfr","textStyle":{}}}},{"startIndex":126806,"endIndex":126918,"paragraph":{"elements":[{"startIndex":126806,"endIndex":126828,"textRun":{"content":"Self-recognition tasks","textStyle":{"bold":true}}},{"startIndex":126828,"endIndex":126918,"textRun":{"content":": Determining whether models can identify texts they generated versus human-written texts\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"},"shading":{"backgroundColor":{}}},"bullet":{"listId":"kix.bg3hharrljfr","textStyle":{}}}},{"startIndex":126918,"endIndex":127032,"paragraph":{"elements":[{"startIndex":126918,"endIndex":126941,"textRun":{"content":