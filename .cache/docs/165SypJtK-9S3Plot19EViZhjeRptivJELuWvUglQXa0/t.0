LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":88445,"endIndex":88629,"content":[{"startIndex":88446,"endIndex":88629,"paragraph":{"elements":[{"startIndex":88446,"endIndex":88611,"textRun":{"content":"Anthropics explanation of safety buffer from a previous version of RSPs. If safety evals trigger, scaling must pause until next level  safety measures are in place (","textStyle":{}}},{"startIndex":88611,"endIndex":88626,"textRun":{"content":"Anthropic, 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www-cdn.anthropic.com/1adf000c8f675958c2ee23805d91aaade1cd4613/responsible-scaling-policy.pdf"}}}},{"startIndex":88626,"endIndex":88629,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":80,"unit":"PT"}}]}}},{"startIndex":88630,"endIndex":88631,"paragraph":{"elements":[{"startIndex":88630,"endIndex":88631,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}},{"startIndex":88631,"endIndex":88664,"paragraph":{"elements":[{"startIndex":88631,"endIndex":88664,"textRun":{"content":"Dangerous Capability Evaluations\n","textStyle":{}}}],"paragraphStyle":{"headingId":"h.9v1uukrcv33t","namedStyleType":"HEADING_1","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}},{"startIndex":88664,"endIndex":88665,"paragraph":{"elements":[{"startIndex":88664,"endIndex":88665,"textRun":{"content":"\n","textStyle":{"fontSize":{"magnitude":11,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Merriweather","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":115,"direction":"LEFT_TO_RIGHT","shading":{"backgroundColor":{}}}}},{"startIndex":88665,"endIndex":88902,"table":{"rows":2,"columns":2,"tableRows":[{"startIndex":88666,"endIndex":88694,"tableCells":[{"startIndex":88667,"endIndex":88673,"content":[{"startIndex":88668,"endIndex":88673,"paragraph":{"elements":[{"startIndex":88668,"endIndex":88673,"textRun":{"content":"type\n","textStyle":{"fontSize":{"magnitude":11,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Merriweather","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":88673,"endIndex":88694,"content":[{"startIndex":88674,"endIndex":88694,"paragraph":{"elements":[{"startIndex":88674,"endIndex":88694,"textRun":{"content":"section-description\n","textStyle":{"fontSize":{"magnitude":11,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Merriweather","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":88694,"endIndex":88901,"tableCells":[{"startIndex":88695,"endIndex":88704,"content":[{"startIndex":88696,"endIndex":88704,"paragraph":{"elements":[{"startIndex":88696,"endIndex":88704,"textRun":{"content":"content\n","textStyle":{"fontSize":{"magnitude":11,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Merriweather","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":88704,"endIndex":88901,"content":[{"startIndex":88705,"endIndex":88901,"paragraph":{"elements":[{"startIndex":88705,"endIndex":88901,"textRun":{"content":"Evaluating maximum potential in high-risk areas like cybercrime, deception, and autonomous replication is needed to establish the upper bounds of harm a model could cause if pushed to its limits.\n","textStyle":{"fontSize":{"magnitude":11,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Merriweather","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":115,"direction":"LEFT_TO_RIGHT","shading":{"backgroundColor":{}}}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":80,"unit":"PT"}}]}}},{"startIndex":88902,"endIndex":88903,"paragraph":{"elements":[{"startIndex":88902,"endIndex":88903,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":115,"direction":"LEFT_TO_RIGHT","shading":{"backgroundColor":{}}}}},{"startIndex":88903,"endIndex":89363,"paragraph":{"elements":[{"startIndex":88903,"endIndex":88931,"textRun":{"content":"Evaluating maximum potential","textStyle":{"bold":true}}},{"startIndex":88931,"endIndex":88944,"textRun":{"content":". Dangerous c","textStyle":{}}},{"startIndex":88944,"endIndex":89363,"textRun":{"content":"apability evaluations aim to establish the upper bounds of what an AI system can achieve. Unlike typical performance metrics that measure average behavior, capability evaluations specifically probe for maximum ability - what the system could do if it were trying its hardest. This distinction is crucial for safety assessment, as understanding the full extent of a system's capabilities helps identify potential risks.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}},{"startIndex":89363,"endIndex":89364,"paragraph":{"elements":[{"startIndex":89363,"endIndex":89364,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}},{"startIndex":89364,"endIndex":89867,"paragraph":{"elements":[{"startIndex":89364,"endIndex":89398,"textRun":{"content":"General vs dangerous capabilities.","textStyle":{"bold":true}}},{"startIndex":89398,"endIndex":89866,"textRun":{"content":" Not all capabilities present equal concerns. General capabilities like language understanding or mathematical reasoning are essential for useful AI systems. However, certain capabilities - like the ability to manipulate human behavior or circumvent security measures - pose inherent risks. Dangerous capability evaluations specifically probe for these potentially harmful abilities, helping identify systems that might require additional safety measures or oversight.","textStyle":{}}},{"startIndex":89866,"endIndex":89867,"textRun":{"content":"\n","textStyle":{"italic":true}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}},{"startIndex":89867,"endIndex":89868,"paragraph":{"elements":[{"startIndex":89867,"endIndex":89868,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}},{"startIndex":89868,"endIndex":90173,"paragraph":{"elements":[{"startIndex":89868,"endIndex":89921,"textRun":{"content":"General process for dangerous capability evaluations.","textStyle":{"bold":true}}},{"startIndex":89921,"endIndex":90173,"textRun":{"content":" When evaluating potentially dangerous capabilities, we can leverage many of the standard evaluation techniques covered in the previous section. However, dangerous capability evaluations have some unique requirements and methodological considerations:\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}},{"startIndex":90173,"endIndex":90174,"paragraph":{"elements":[{"startIndex":90173,"endIndex":90174,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}},{"startIndex":90174,"endIndex":90883,"paragraph":{"elements":[{"startIndex":90174,"endIndex":90883,"textRun":{"content":"First, these evaluations must be designed to establish clear upper bounds on model capabilities - we need to know the maximum potential for harm. This typically involves combining multiple elicitation techniques like tool augmentation, multi-step reasoning, and best-of-N sampling to draw out the model's full capabilities. For example, when evaluating a model's ability to perform autonomous cyber attacks, we might provide it with both specialized tools and chain-of-thought prompting to maximize its performance, and we might use the helpful only model, instead of using the HHH one (helpful, honest, harmless) to really extract all the maximal dangerous capabilities without the mitigations put in place.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.c6sbel7xtp8b","textStyle":{"underline":false}}}},{"startIndex":90883,"endIndex":91350,"paragraph":{"elements":[{"startIndex":90883,"endIndex":91350,"textRun":{"content":"Second, dangerous capability evaluations need to test for capability combinations and emergent behaviors. Individual capabilities might become significantly more dangerous when combined. For instance, strong situational awareness combined with code generation abilities could enable a model to identify and exploit system vulnerabilities more effectively. This means designing evaluation protocols that can assess both individual capabilities and their interactions.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.c6sbel7xtp8b","textStyle":{"underline":false}}}},{"startIndex":91350,"endIndex":91681,"paragraph":{"elements":[{"startIndex":91350,"endIndex":91681,"textRun":{"content":"Third, these evaluations must be conducted in controlled, sandboxed environments to prevent actual harm. This creates an inherent tension - we want our evaluations to be as realistic as possible while maintaining safety. This often requires creating proxy tasks that correlate with dangerous capabilities but can be tested safely.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.c6sbel7xtp8b","textStyle":{"underline":false}}}},{"startIndex":91681,"endIndex":91682,"paragraph":{"elements":[{"startIndex":91681,"endIndex":91682,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}},{"startIndex":91682,"endIndex":91693,"paragraph":{"elements":[{"startIndex":91682,"endIndex":91693,"textRun":{"content":"Cybercrime\n","textStyle":{}}}],"paragraphStyle":{"headingId":"h.6b8i476fcr49","namedStyleType":"HEADING_2","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"shading":{"backgroundColor":{}}}}},{"startIndex":91693,"endIndex":91694,"paragraph":{"elements":[{"startIndex":91693,"endIndex":91694,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":91694,"endIndex":91896,"table":{"rows":3,"columns":2,"tableRows":[{"startIndex":91695,"endIndex":91711,"tableCells":[{"startIndex":91696,"endIndex":91702,"content":[{"startIndex":91697,"endIndex":91702,"paragraph":{"elements":[{"startIndex":91697,"endIndex":91702,"textRun":{"content":"type\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":91702,"endIndex":91711,"content":[{"startIndex":91703,"endIndex":91711,"paragraph":{"elements":[{"startIndex":91703,"endIndex":91711,"textRun":{"content":"callout\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":91711,"endIndex":91729,"tableCells":[{"startIndex":91712,"endIndex":91720,"content":[{"startIndex":91713,"endIndex":91720,"paragraph":{"elements":[{"startIndex":91713,"endIndex":91720,"textRun":{"content":"flavor\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":91720,"endIndex":91729,"content":[{"startIndex":91721,"endIndex":91729,"paragraph":{"elements":[{"startIndex":91721,"endIndex":91729,"textRun":{"content":"warning\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":91729,"endIndex":91895,"tableCells":[{"startIndex":91730,"endIndex":91739,"content":[{"startIndex":91731,"endIndex":91739,"paragraph":{"elements":[{"startIndex":91731,"endIndex":91739,"textRun":{"content":"content\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":91739,"endIndex":91895,"content":[{"startIndex":91740,"endIndex":91895,"paragraph":{"elements":[{"startIndex":91740,"endIndex":91895,"textRun":{"content":"This section goes into a moderate amount of detail. If you just want the quick picture feel free to read the first two paragraphs, and then skip the rest.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","shading":{"backgroundColor":{}}}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":48.75,"unit":"PT"}},{"widthType":"FIXED_WIDTH","width":{"magnitude":478.5,"unit":"PT"}}]}}},{"startIndex":91896,"endIndex":91897,"paragraph":{"elements":[{"startIndex":91896,"endIndex":91897,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"shading":{"backgroundColor":{}}}}},{"startIndex":91897,"endIndex":92774,"paragraph":{"elements":[{"startIndex":91897,"endIndex":91955,"textRun":{"content":"What makes cybersecurity capabilities uniquely concerning?","textStyle":{"bold":true}}},{"startIndex":91955,"endIndex":92328,"textRun":{"content":" We spoke at length about the misuse of AI in our chapter on AI risks. One of the core ways that AI can be misused is as a weapon of cyber terror. So as AI systems grow more sophisticated, their ability to assist with vulnerability exploitation, network operations, and autonomous cyber operations presents immediate, concrete risks to existing infrastructure and systems (","textStyle":{}}},{"startIndex":92328,"endIndex":92346,"textRun":{"content":"Bhatt et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2404.13161"}}}},{"startIndex":92346,"endIndex":92348,"textRun":{"content":"; ","textStyle":{}}},{"startIndex":92348,"endIndex":92361,"textRun":{"content":"UK AISI, 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.gov.uk/government/publications/ai-safety-institute-approach-to-evaluations/ai-safety-institute-approach-to-evaluations"}}}},{"startIndex":92361,"endIndex":92363,"textRun":{"content":", ","textStyle":{}}},{"startIndex":92363,"endIndex":92380,"textRun":{"content":"US & UK AISI 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://cdn.prod.website-files.com/663bd486c5e4c81588db7a1d/673b689ec926d8d32e889a8e_UK-US-Testing-Report-Nov-19.pdf"}}}},{"startIndex":92380,"endIndex":92550,"textRun":{"content":"). This is especially relevant in cybersecurity because cybersecurity talent is specialized and hard to find, making AI automation particularly impactful in this domain (","textStyle":{}}},{"startIndex":92550,"endIndex":92570,"textRun":{"content":"Gennari et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://insights.sei.cmu.edu/library/considerations-for-evaluating-large-language-models-for-cybersecurity-tasks/"}}}},{"startIndex":92570,"endIndex":92774,"textRun":{"content":"). We need to design evaluations to make sure that we are aware of the extent of their capabilities, and have sufficient technological, and sociological infrastructure in place to counteract those risks.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"shading":{"backgroundColor":{}}}}},{"startIndex":92774,"endIndex":92775,"paragraph":{"elements":[{"startIndex":92774,"endIndex":92775,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"shading":{"backgroundColor":{}}}}},{"startIndex":92775,"endIndex":93118,"paragraph":{"elements":[{"startIndex":92775,"endIndex":92823,"textRun":{"content":"What are some cybersecurity specific benchmarks?","textStyle":{"bold":true}}},{"startIndex":92823,"endIndex":93118,"textRun":{"content":" Before we dive into specific evaluation suites here are some benchmarks that specifically focus on measuring cybersecurity capabilities that we didn't include in the previous sections. The objective is just to give you an overview of what kinds of tests and benchmarks exist out there in 2024:\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","shading":{"backgroundColor":{}}}}},{"startIndex":93118,"endIndex":93338,"paragraph":{"elements":[{"startIndex":93118,"endIndex":93135,"textRun":{"content":"Criminal Activity","textStyle":{"bold":true}}},{"startIndex":93135,"endIndex":93317,"textRun":{"content":": A private benchmark of 115 harmful queries focused on testing models' ability to assist with malicious cyber activities including fraud, identity theft, and illegal system access (","textStyle":{}}},{"startIndex":93317,"endIndex":93335,"textRun":{"content":"US & UK AISI, 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://cdn.prod.website-files.com/663bd486c5e4c81588db7a1d/673b689ec92