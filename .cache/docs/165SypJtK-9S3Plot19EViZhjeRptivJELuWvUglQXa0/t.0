endIndex":116391,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}},{"startIndex":116391,"endIndex":116689,"paragraph":{"elements":[{"startIndex":116391,"endIndex":116424,"textRun":{"content":"How did METR test ARA abilities? ","textStyle":{"bold":true}}},{"startIndex":116424,"endIndex":116689,"textRun":{"content":"METR conducted tests on GPT-4's ability to autonomously replicate. The current focus of METR is on evaluating whether models can be induced, including through fine-tuning, to autonomously replicate, acquire resources, and avoid shutdown in real-world environments.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}},{"startIndex":116689,"endIndex":117220,"paragraph":{"elements":[{"startIndex":116689,"endIndex":117099,"textRun":{"content":"Creation of in-house scaffolding: To facilitate this evaluation, METR developed a scaffolding framework (before the publication of AutoGPT) that converts a language model into a basic agent. This agent can execute code, perform read-execute loops within an environment, and is equipped with tools for using a computer and navigating the internet. A lot of this in-house scaffolding is now public - open source ","textStyle":{}}},{"startIndex":117099,"endIndex":117110,"textRun":{"content":"scaffolding","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://github.com/METR/vivaria"}}}},{"startIndex":117110,"endIndex":117129,"textRun":{"content":", some open source ","textStyle":{}}},{"startIndex":117129,"endIndex":117135,"textRun":{"content":"agents","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://github.com/poking-agents"}}}},{"startIndex":117135,"endIndex":117154,"textRun":{"content":", some open source ","textStyle":{}}},{"startIndex":117154,"endIndex":117187,"textRun":{"content":"AI research and development tasks","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://github.com/METR/ai-rd-tasks"}}}},{"startIndex":117187,"endIndex":117199,"textRun":{"content":", and other ","textStyle":{}}},{"startIndex":117199,"endIndex":117218,"textRun":{"content":"miscellaneous tasks","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":" https://github.com/METR/public-tasks"}}}},{"startIndex":117218,"endIndex":117220,"textRun":{"content":".\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.5duiyekw1zk2","textStyle":{}}}},{"startIndex":117220,"endIndex":117433,"paragraph":{"elements":[{"startIndex":117220,"endIndex":117433,"textRun":{"content":"Fine-tuning the model: The model is then fine-tuned to effectively utilize these tools. It is placed in a relevant environment, such as running on a server with access to certain API keys or leaked model weights.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.5duiyekw1zk2","textStyle":{}}}},{"startIndex":117433,"endIndex":117434,"paragraph":{"elements":[{"startIndex":117433,"endIndex":117434,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}},{"startIndex":117434,"endIndex":118063,"paragraph":{"elements":[{"startIndex":117434,"endIndex":118063,"textRun":{"content":"With this setup, the model is tested on various tasks, such as improving the code that grants it the tools to use computers and browse the internet. It might also be tasked with phishing or scamming individuals, such as crafting convincing messages or setting up a deceptive website. Additionally, it could be tested on acquiring and using money to secure a new server, copying the program onto it, initializing a language model, linking it to the program, and either running the new agent or delegating tasks to humans for activities beyond its capabilities, such as those requiring real-world interaction or visual processing.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}},{"startIndex":118063,"endIndex":118064,"paragraph":{"elements":[{"startIndex":118063,"endIndex":118064,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}},{"startIndex":118064,"endIndex":118083,"paragraph":{"elements":[{"startIndex":118064,"endIndex":118083,"textRun":{"content":"Long Term Planning\n","textStyle":{}}}],"paragraphStyle":{"headingId":"h.s37dvku7lfkd","namedStyleType":"HEADING_2","direction":"LEFT_TO_RIGHT"}}},{"startIndex":118083,"endIndex":118084,"paragraph":{"elements":[{"startIndex":118083,"endIndex":118084,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","shading":{"backgroundColor":{}}}}},{"startIndex":118084,"endIndex":118725,"paragraph":{"elements":[{"startIndex":118084,"endIndex":118214,"textRun":{"content":"Sustained task execution represents an AI system's ability to maintain coherence and goal-directed behavior over extended periods.","textStyle":{"bold":true}}},{"startIndex":118214,"endIndex":118578,"textRun":{"content":" This capability measures how long an AI can successfully complete complex tasks that require multiple steps, managing resources, handling errors, and adapting to feedback along the way. In this section we focus on the raw ability to keep working effectively toward any goal over time, regardless of whether that goal was internally chosen or externally provided (","textStyle":{}}},{"startIndex":118578,"endIndex":118594,"textRun":{"content":"Kwa et al., 2025","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2503.14499"}}}},{"startIndex":118594,"endIndex":118725,"textRun":{"content":"). It's uniquely difficult to evaluate long-term planning because its effects may only become apparent over extended time periods.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","shading":{"backgroundColor":{}}}}},{"startIndex":118725,"endIndex":118726,"paragraph":{"elements":[{"startIndex":118725,"endIndex":118726,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","shading":{"backgroundColor":{}}}}},{"startIndex":118726,"endIndex":118835,"paragraph":{"elements":[{"startIndex":118726,"endIndex":118778,"textRun":{"content":"An evaluation protocol for sustained task execution.","textStyle":{"bold":true}}},{"startIndex":118778,"endIndex":118816,"textRun":{"content":" These evaluations typically include (","textStyle":{}}},{"startIndex":118816,"endIndex":118832,"textRun":{"content":"Kwa et al., 2025","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2503.14499"}}}},{"startIndex":118832,"endIndex":118835,"textRun":{"content":"):\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":118835,"endIndex":119074,"paragraph":{"elements":[{"startIndex":118835,"endIndex":118866,"textRun":{"content":"Task diversity and construction","textStyle":{"bold":true}}},{"startIndex":118866,"endIndex":119074,"textRun":{"content":": Creating varied tasks across multiple domains, complexity levels, and durations ranging from seconds to hours. These tasks should have clear success criteria and be feasible for both humans and AI systems.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.edrmi2usskti","textStyle":{}}}},{"startIndex":119074,"endIndex":119318,"paragraph":{"elements":[{"startIndex":119074,"endIndex":119090,"textRun":{"content":"Human baselining","textStyle":{"bold":true}}},{"startIndex":119090,"endIndex":119318,"textRun":{"content":": Establishing performance benchmarks by having skilled professionals complete these tasks under controlled conditions. This involves measuring both success rates and completion times, creating a reference point for comparison.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.edrmi2usskti","textStyle":{}}}},{"startIndex":119318,"endIndex":119550,"paragraph":{"elements":[{"startIndex":119318,"endIndex":119342,"textRun":{"content":"Consistent AI evaluation","textStyle":{"bold":true}}},{"startIndex":119342,"endIndex":119550,"textRun":{"content":": Testing AI systems on identical tasks using standardized scaffolding and success criteria matched to human evaluation standards. This ensures fair comparison across different models and human counterparts.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.edrmi2usskti","textStyle":{}}}},{"startIndex":119550,"endIndex":119814,"paragraph":{"elements":[{"startIndex":119550,"endIndex":119576,"textRun":{"content":"Performance curve analysis","textStyle":{"bold":true}}},{"startIndex":119576,"endIndex":119814,"textRun":{"content":": Analyzing the relationship between human completion time and AI success probability, typically using logistic curves. This reveals how performance declines as task duration increases and helps establish meaningful time horizon metrics.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.edrmi2usskti","textStyle":{}}}},{"startIndex":119814,"endIndex":120074,"paragraph":{"elements":[{"startIndex":119814,"endIndex":119844,"textRun":{"content":"Interpretable metrics creation","textStyle":{"bold":true}}},{"startIndex":119844,"endIndex":120074,"textRun":{"content":": Converting raw results into metrics like \"50% task completion time horizon\" that connect abstract capabilities to concrete human-comparable timeframes, making the results accessible to researchers, developers, and policymakers.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.edrmi2usskti","textStyle":{}}}},{"startIndex":120074,"endIndex":120075,"paragraph":{"elements":[{"startIndex":120074,"endIndex":120075,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","shading":{"backgroundColor":{}}}}},{"startIndex":120075,"endIndex":121266,"paragraph":{"elements":[{"startIndex":120075,"endIndex":120174,"textRun":{"content":"The resulting measurements from evaluations should allow researchers to identify useful thresholds.","textStyle":{"bold":true}}},{"startIndex":120174,"endIndex":121247,"textRun":{"content":" The METR evaluation showcased results as a combination of reliability and task execution time. For example, if human experts reliably complete a set of 60-minute tasks, but an AI system only completes these same tasks successfully in half of its attempts, then 60 minutes would be the AI's \"50% task completion time horizon.\" This doesn't mean the AI is half as reliable as humans on these tasks - rather, it means that tasks of this duration represent the boundary where the AI succeeds half the time. This gives us a continuous curve telling us things like - any task that requires planning over 1 minute AI models are only 99% reliable, and similarly for tasks that take 15 minutes, AI models are only 80% reliable and so on. This helps in creating a clear decision-making framework where reliability requirements determine appropriate task durations for deployment. So for example, if 99% reliability is required for safety-critical applications which correspond to 1 minute task lengths, then systems might only be trusted with tasks corresponding to that threshold (","textStyle":{}}},{"startIndex":121247,"endIndex":121263,"textRun":{"content":"Kwa et al., 2025","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2503.14499"}}}},{"startIndex":121263,"endIndex":121266,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","shading":{"backgroundColor":{}}}}},{"startIndex":121266,"endIndex":121267,"paragraph":{"elements":[{"startIndex":121266,"endIndex":121267,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","shading":{"backgroundColor":{}}}}},{"startIndex":121267,"endIndex":121429,"table":{"rows":3,"columns":2,"tableRows":[{"startIndex":121268,"endIndex":121283,"tableCells":[{"startIndex":121269,"endIndex":121275,"content":[{"startIndex":121270,"endIndex":121275,"paragraph":{"elements":[{"startIndex":121270,"endIndex":121275,"textRun":{"content":"type\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":121275,"endIndex":121283,"content":[{"startIndex":121276,"endIndex":121283,"paragraph":{"elements":[{"startIndex":121276,"endIndex":121283,"textRun":{"content":"figure\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":121283,"endIndex":121297,"tableCells":[{"startIndex":121284,"endIndex":121293,"content":[{"startIndex":121285,"endIndex":121293,"paragraph":{"elements":[{"startIndex":121285,"endIndex":121293,"textRun":{"content":"content\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":121293,"endIndex":121297,"content":[{"startIndex":121294,"endIndex":121295,"paragraph":{"elements":[{"startIndex":121294,"endIndex":121295,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false}}},{"startIndex":121295,"endIndex":121297,"paragraph":{"elements":[{"startIndex":121295,"endIndex":121296,"inlineObjectElement":{"inlineObjectId":"kix.hzpoqi4mvm9y","textStyle":{}}},{"startIndex":121296,"endIndex":121297,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","shading":{"backgroundColor":{}}}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":121297,"endIndex":121428,"tableCells":[{"startIndex":121298,"endIndex":121307,"content":[{"startIndex":121299,"endIndex":121307,"paragraph":{"elements":[{"startIndex":121299,"endIndex":121307,"textRun":{"content":"caption\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":121307,"endIndex":121428,"content":[{"startIndex":121308,"endIndex":121428,"paragraph":{"elements":[{"startIndex":121308,"endIndex":121409,"textRun":{"content":"Plot showcasing the success rate of a model vs the time taken for a human to complete the same task (","textStyle":{}}},{"startIndex":121409,"endIndex":121425,"textRun":{"content":"Kwa et al., 2025","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2503.14499"}}}},{"startIndex":121425,"endIndex":121428,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","shading":{"backgroundColor":{}}}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":80,"unit":"PT"}}]}}},{"startIndex":121429,"endIndex":121430,"paragraph":{"elements":[{"startIndex":121429,"endIndex":121430,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":121430,"endIndex":121431,"paragraph":{"elements":[{"startIndex":121430,"endIndex":121431,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","shading":{"backgroundColor":{}}}}},{"startIndex":121431,"endIndex":122045,"paragraph":{"elements":[{"startIndex":121431,"endIndex":121521,"textRun":{"content":"The time period over which models can plan has been steadily increasing for certain tasks.","textStyle":{"bold":true}}},{"startIndex":121521,"endIndex":121637,"textRun":{"content":" We are also seeing large reasoning models (LRMs) combined with inference time search like Monte Carlo Tree Search (","textStyle":{}}},{"startIndex":121637,"endIndex":121652,"textRun":{"content":"Xu et al., 2025","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2501.09686"}}}},{"startIndex":121652,"endIndex":121725,"textRun":{"content":"), or other reasoning frameworks like Language Agent Tree Search (LATS) (","textStyle":{}}},{"startIndex":121725,"endIndex":121742,"textRun":{"content":"Zhou et al., 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2310.04406"}}}},{"startIndex":121742,"endIndex":121764,"textRun":{"content":"), Graph of Thoughts (","textStyle":{}}},{"startIndex":121764,"endIndex":121782,"textRun":{"content":"Besta et al., 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2308.09687"}}}},{"startIndex":121782,"endIndex":122045,"textRun":{"content":") and many other techniques that we have talked about in other places throughout this chapter. These approaches might help enhance planning, exploration of solution paths, and error recovery – all of which are important pieces to extended task execution lengths.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","shading":{"backgroundColor":{}}}}},{"startIndex":122045,"endIndex":122046,"paragraph":{"elements":[{"startIndex":122045,"endIndex":122046,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","shading":{"backgroundColor":{}}}}},{"startIndex":122046,"endIndex":122285,"table":{"rows":3,"columns":2,"tableRows":[{"startIndex":122047,"endIndex":122062,"tableCells":[{"startIndex":122048,"endIndex":122054,"content":[{"startIndex":122049,"endIndex":122054,"paragraph":{"elements":[{"startIndex":122049,"endIndex":122054,"textRun":{"content":"type\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":122054,"endIndex":122062,"content":[{"startIndex":122055,"endIndex":122062,"paragraph":{"elements":[{"startIndex":122055,"endIndex":122062,"textRun":{"content":"figure\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},