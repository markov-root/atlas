":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":127625,"endIndex":127629,"content":[{"startIndex":127626,"endIndex":127627,"paragraph":{"elements":[{"startIndex":127626,"endIndex":127627,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}},{"startIndex":127627,"endIndex":127629,"paragraph":{"elements":[{"startIndex":127627,"endIndex":127628,"inlineObjectElement":{"inlineObjectId":"kix.sfr6hz90kmeg","textStyle":{}}},{"startIndex":127628,"endIndex":127629,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":127629,"endIndex":128024,"tableCells":[{"startIndex":127630,"endIndex":127639,"content":[{"startIndex":127631,"endIndex":127639,"paragraph":{"elements":[{"startIndex":127631,"endIndex":127639,"textRun":{"content":"caption\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":127639,"endIndex":128024,"content":[{"startIndex":127640,"endIndex":128024,"paragraph":{"elements":[{"startIndex":127640,"endIndex":127801,"textRun":{"content":"This chart from the study shows how models are good at predicting their own behavior (green), but not as good at predicting the behavior of other models (blue) (","textStyle":{}}},{"startIndex":127801,"endIndex":127820,"textRun":{"content":"Binder et al., 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2410.13787"}}}},{"startIndex":127820,"endIndex":128006,"textRun":{"content":"). Generally speaking, introspective ability appears to be improving over time. Looking at the chart above, GPT-3.5's introspective advantage is modest compared to more advanced models (","textStyle":{}}},{"startIndex":128006,"endIndex":128021,"textRun":{"content":"AI Digest, 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://theaidigest.org/self-awareness"}}}},{"startIndex":128021,"endIndex":128024,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","shading":{"backgroundColor":{}}}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":80,"unit":"PT"}}]}}},{"startIndex":128025,"endIndex":128026,"paragraph":{"elements":[{"startIndex":128025,"endIndex":128026,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","shading":{"backgroundColor":{}}}}},{"startIndex":128026,"endIndex":128254,"paragraph":{"elements":[{"startIndex":128026,"endIndex":128154,"textRun":{"content":"Situational awareness can emerge through different mechanisms depending on how the model obtains information about its situation","textStyle":{"bold":true}}},{"startIndex":128154,"endIndex":128254,"textRun":{"content":". Understanding these mechanisms helps clarify how this capability might develop in future systems:\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","shading":{"backgroundColor":{}}}}},{"startIndex":128254,"endIndex":128511,"paragraph":{"elements":[{"startIndex":128254,"endIndex":128286,"textRun":{"content":"In-context situational awareness","textStyle":{"bold":true}}},{"startIndex":128286,"endIndex":128511,"textRun":{"content":" occurs when a model responds to explicit information provided in its current prompt. For example, when told \"You are being evaluated\" in a system prompt, the model might adjust its behavior based on this direct information.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"},"shading":{"backgroundColor":{}}},"bullet":{"listId":"kix.y1piff7eof3r","textStyle":{}}}},{"startIndex":128511,"endIndex":128813,"paragraph":{"elements":[{"startIndex":128511,"endIndex":128547,"textRun":{"content":"Out-of-context situational awareness","textStyle":{"bold":true}}},{"startIndex":128547,"endIndex":128813,"textRun":{"content":" happens when a model applies knowledge it acquired during training that isn't explicitly mentioned in its current prompt. This is more concerning from a safety perspective because it allows models to make inferences about their situation without any explicit cues.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"},"shading":{"backgroundColor":{}}},"bullet":{"listId":"kix.y1piff7eof3r","textStyle":{}}}},{"startIndex":128813,"endIndex":128814,"paragraph":{"elements":[{"startIndex":128813,"endIndex":128814,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","shading":{"backgroundColor":{}}}}},{"startIndex":128814,"endIndex":129305,"paragraph":{"elements":[{"startIndex":128814,"endIndex":128900,"textRun":{"content":"Out-of-context awareness has been empirically demonstrated in controlled experiments. ","textStyle":{"bold":true}}},{"startIndex":128900,"endIndex":129281,"textRun":{"content":"Researchers created fictional documents describing an AI assistant called \"Pangolin\" that was supposed to always respond in German. Later, when asked questions without mentioning either German or Pangolin, the model responded in German — showing it had recognized its identity (as an AI assistant named Pangolin) and applied the appropriate behavior without explicit instructions (","textStyle":{}}},{"startIndex":129281,"endIndex":129302,"textRun":{"content":"Berglund et al., 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2309.00667"}}}},{"startIndex":129302,"endIndex":129305,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","shading":{"backgroundColor":{}}}}},{"startIndex":129305,"endIndex":129306,"paragraph":{"elements":[{"startIndex":129305,"endIndex":129306,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","shading":{"backgroundColor":{}}}}},{"startIndex":129306,"endIndex":130099,"paragraph":{"elements":[{"startIndex":129306,"endIndex":129385,"textRun":{"content":"Situational awareness might help models make plans beyond the training episode.","textStyle":{"bold":true}}},{"startIndex":129385,"endIndex":130078,"textRun":{"content":" One key approach to measuring situational awareness involves testing whether models can distinguish between different stages of their development process. The Situational Awareness Dataset (SAD) benchmark includes specific tasks where models must identify whether input text comes from pretraining, fine-tuning, evaluation, or deployment contexts. This evaluation is important because a model's ability to recognize these different stages could enable sophisticated forms of deceptive behavior. A model that can reliably distinguish evaluation from deployment might behave differently in each context, making it harder to assess its true capabilities and intentions through standard testing (","textStyle":{}}},{"startIndex":130078,"endIndex":130096,"textRun":{"content":"Laine et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2407.04694"}}}},{"startIndex":130096,"endIndex":130099,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","shading":{"backgroundColor":{}}}}},{"startIndex":130099,"endIndex":130100,"paragraph":{"elements":[{"startIndex":130099,"endIndex":130100,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","shading":{"backgroundColor":{}}}}},{"startIndex":130100,"endIndex":130425,"table":{"rows":3,"columns":2,"tableRows":[{"startIndex":130101,"endIndex":130116,"tableCells":[{"startIndex":130102,"endIndex":130108,"content":[{"startIndex":130103,"endIndex":130108,"paragraph":{"elements":[{"startIndex":130103,"endIndex":130108,"textRun":{"content":"type\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"C