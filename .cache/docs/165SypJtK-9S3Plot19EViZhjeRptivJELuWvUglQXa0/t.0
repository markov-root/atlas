derTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":122076,"endIndex":122284,"tableCells":[{"startIndex":122077,"endIndex":122086,"content":[{"startIndex":122078,"endIndex":122086,"paragraph":{"elements":[{"startIndex":122078,"endIndex":122086,"textRun":{"content":"caption\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":122086,"endIndex":122284,"content":[{"startIndex":122087,"endIndex":122284,"paragraph":{"elements":[{"startIndex":122087,"endIndex":122265,"textRun":{"content":"METR’s research finds that AIs are rapidly able to do longer and longer tasks, where length is measured by the time it takes for a human with requisite expertise to do the task (","textStyle":{}}},{"startIndex":122265,"endIndex":122281,"textRun":{"content":"Kwa et al., 2025","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2503.14499"}}}},{"startIndex":122281,"endIndex":122284,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":80,"unit":"PT"}}]}}},{"startIndex":122285,"endIndex":122286,"paragraph":{"elements":[{"startIndex":122285,"endIndex":122286,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":122286,"endIndex":122826,"paragraph":{"elements":[{"startIndex":122286,"endIndex":122430,"textRun":{"content":"Long term planning capability evaluations have important limitations (as of 2025) that affect how we interpret sustained execution capabilities.","textStyle":{"bold":true}}},{"startIndex":122430,"endIndex":122826,"textRun":{"content":" While they effectively track capability growth, evaluations measuring the capability for task execution over extended lengths still have room to grow. They tend to primarily cover software and reasoning tasks, they focus on tasks with relatively clean feedback signals (which is not what the real world provides), and they may not capture performance degradation in highly dynamic environments:\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":122826,"endIndex":123129,"paragraph":{"elements":[{"startIndex":122826,"endIndex":122845,"textRun":{"content":"Domain specificity:","textStyle":{"bold":true}}},{"startIndex":122845,"endIndex":123118,"textRun":{"content":" Time horizon estimates vary dramatically across different domains. A model capable of complex programming tasks over hours might struggle with simple planning tasks in unfamiliar domains, making single-domain evaluations potentially misleading about general capabilities (","textStyle":{}}},{"startIndex":123118,"endIndex":123126,"textRun":{"content":"Ho, 2025","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://epochai.substack.com/p/wheres-my-ten-minute-agi"}}}},{"startIndex":123126,"endIndex":123129,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.bxx57i5h8uun","textStyle":{}}}},{"startIndex":123129,"endIndex":123432,"paragraph":{"elements":[{"startIndex":123129,"endIndex":123143,"textRun":{"content":"Task bundling:","textStyle":{"bold":true}}},{"startIndex":123143,"endIndex":123421,"textRun":{"content":" Real-world tasks involve complex interleaving of subtasks with context dependencies and shifting priorities. These bundled activities are more challenging than isolated benchmark tasks of equivalent duration as they require maintaining multiple threads of work simultaneously (","textStyle":{}}},{"startIndex":123421,"endIndex":123429,"textRun":{"content":"Ho, 2025","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://epochai.substack.com/p/wheres-my-ten-minute-agi"}}}},{"startIndex":123429,"endIndex":123432,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.bxx57i5h8uun","textStyle":{}}}},{"startIndex":123432,"endIndex":123693,"paragraph":{"elements":[{"startIndex":123432,"endIndex":123455,"textRun":{"content":"Environmental dynamics:","textStyle":{"bold":true}}},{"startIndex":123455,"endIndex":123674,"textRun":{"content":" Most evaluations use relatively static environments with stable constraints, while real-world contexts involve changing conditions, competing agents, and shifting objectives that can significantly degrade performance (","textStyle":{}}},{"startIndex":123674,"endIndex":123690,"textRun":{"content":"Kwa et al., 2025","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2503.14499"}}}},{"startIndex":123690,"endIndex":123693,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.bxx57i5h8uun","textStyle":{}}}},{"startIndex":123693,"endIndex":123956,"paragraph":{"elements":[{"startIndex":123693,"endIndex":123719,"textRun":{"content":"Practical duration limits:","textStyle":{"bold":true}}},{"startIndex":123719,"endIndex":123936,"textRun":{"content":" Direct evaluation of extremely long durations (weeks/months) remains impractical. Current methods must extrapolate from shorter observations, potentially missing failure modes that only emerge over extended periods (","textStyle":{}}},{"startIndex":123936,"endIndex":123953,"textRun":{"content":"Wijk et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2411.15114"}}}},{"startIndex":123953,"endIndex":123955,"textRun":{"content":").","textStyle":{}}},{"startIndex":123955,"endIndex":123956,"textRun":{"content":"\n","textStyle":{"bold":true}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.bxx57i5h8uun","textStyle":{}}}},{"startIndex":123956,"endIndex":123957,"paragraph":{"elements":[{"startIndex":123956,"endIndex":123957,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","shading":{"backgroundColor":{}}}}},{"startIndex":123957,"endIndex":124732,"paragraph":{"elements":[{"startIndex":123957,"endIndex":124033,"textRun":{"content":"Sustained execution interacts with other capabilities to create higher risk.","textStyle":{"bold":true}}},{"startIndex":124033,"endIndex":124281,"textRun":{"content":" Extended execution enables systems with situational awareness to maintain consistent deceptive behavior across evaluation periods. Combined with AI R&D capabilities, it might facilitate autonomous research projects that accelerate AI advancement (","textStyle":{}}},{"startIndex":124281,"endIndex":124298,"textRun":{"content":"Wijk et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2411.15114"}}}},{"startIndex":124298,"endIndex":124713,"textRun":{"content":"). When paired with long-term optimization propensities, systems may develop and execute sophisticated strategies toward distant objectives while maintaining coherence through changing conditions. These interactions highlight why designing evaluations to measure the length of time over which AI models can coherently plan and execute tasks is an extremely important dimension for comprehensive safety assessments (","textStyle":{}}},{"startIndex":124713,"endIndex":124729,"textRun":{"content":"Kwa et al., 2025","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2503.14499"}}}},{"startIndex":124729,"endIndex":124732,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","shading":{"backgroundColor":{}}}}},{"startIndex":124732,"endIndex":124733,"paragraph":{"elements":[{"startIndex":124732,"endIndex":124733,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}},{"startIndex":124733,"endIndex":124755,"paragraph":{"elements":[{"startIndex":124733,"endIndex":124755,"textRun":{"content":"Situational Awareness\n","textStyle":{}}}],"paragraphStyle":{"headingId":"h.vz33oonm077","namedStyleType":"HEADING_2","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}},{"startIndex":124755,"endIndex":124756,"paragraph":{"elements":[{"startIndex":124755,"endIndex":124756,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":124756,"endIndex":125358,"paragraph":{"elements":[{"startIndex":124756,"endIndex":124909,"textRun":{"content":"Situational awareness refers to an AI system's ability to understand what it is, recognize its current circumstances, and adapt its behavior accordingly.","textStyle":{"bold":true}}},{"startIndex":124909,"endIndex":125038,"textRun":{"content":" This capability can be measured through observable behaviors without requiring any assumptions about consciousness or sentience.","textStyle":{}}},{"startIndex":125038,"endIndex":125039,"footnoteReference":{"footnoteId":"kix.ck0adzqok0u","footnoteNumber":"12","textStyle":{}}},{"startIndex":125039,"endIndex":125337,"textRun":{"content":" Functionally, situational awareness encompasses three key components: the system's knowledge of itself (what kind of entity it is), its ability to make inferences about its current situation (such as whether it's being tested versus deployed), and its capacity to act based on this understanding (","textStyle":{}}},{"startIndex":125337,"endIndex":125355,"textRun":{"content":"Laine et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2407.04694"}}}},{"startIndex":125355,"endIndex":125358,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","shading":{"backgroundColor":{}}}}},{"startIndex":125358,"endIndex":125359,"paragraph":{"elements":[{"startIndex":125358,"endIndex":125359,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","shading":{"backgroundColor":{}}}}},{"startIndex":125359,"endIndex":125572,"table":{"rows":3,"columns":2,"tableRows":[{"startIndex":125360,"endIndex":125375,"tableCells":[{"startIndex":125361,"endIndex":125367,"content":[{"startIndex":125362,"endIndex":125367,"paragraph":{"elements":[{"startIndex":125362,"endIndex":125367,"textRun":{"content":"type\n","textStyle":{}}}]