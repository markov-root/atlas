":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":106183,"endIndex":106342,"tableCells":[{"startIndex":106184,"endIndex":106193,"content":[{"startIndex":106185,"endIndex":106193,"paragraph":{"elements":[{"startIndex":106185,"endIndex":106193,"textRun":{"content":"caption\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":106193,"endIndex":106342,"content":[{"startIndex":106194,"endIndex":106195,"paragraph":{"elements":[{"startIndex":106194,"endIndex":106195,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}},{"startIndex":106195,"endIndex":106342,"paragraph":{"elements":[{"startIndex":106195,"endIndex":106325,"textRun":{"content":"Predictions as of mid 2025, for whether AI will be a co-author on a paper published at a prestigious machine learning conference (","textStyle":{}}},{"startIndex":106325,"endIndex":106340,"textRun":{"content":"Metaculus, 2025","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.metaculus.com/questions/38403/ai-authorered-paper-by-2028/"}}}},{"startIndex":106340,"endIndex":106342,"textRun":{"content":")\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":80,"unit":"PT"}}]}}},{"startIndex":106343,"endIndex":106344,"paragraph":{"elements":[{"startIndex":106343,"endIndex":106344,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":106344,"endIndex":107223,"paragraph":{"elements":[{"startIndex":106344,"endIndex":106457,"textRun":{"content":"Accelerated self-improvement creates fundamental safety problems that compound all existing alignment challenges.","textStyle":{"bold":true}}},{"startIndex":106457,"endIndex":107223,"textRun":{"content":" A superintelligent system that has learned specification gaming will discover loopholes we never imagined. One capable of treacherous turns will execute deception strategies across timescales and domains beyond human planning horizons. Control measures and defenses designed for human-level adversaries become useless against systems that can outthink their creators. If AI capabilities jump suddenly—from human-level to vastly superhuman within weeks or days—all our safety measures might become obsolete overnight. If an AI system becomes better than humans at scientific research, strategic planning, social manipulation, and technological development, it can pursue whatever goals it has learned, and humans become merely another constraint to optimize around.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":107223,"endIndex":107224,"paragraph":{"elements":[{"startIndex":107223,"endIndex":107224,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":107224,"endIndex":108274,"paragraph":{"elements":[{"startIndex":107224,"endIndex":107353,"textRun":{"content":"Superintelligent systems present a uniquely difficult problem because intelligence at that scale operates beyond human intuition.","textStyle":{"bold":true}}},{"startIndex":107353,"endIndex":108274,"textRun":{"content":" We can reason about human-level misalignment because we understand human-level capabilities and constraints. But superintelligence might develop goals, strategies, and methods that are simply incomprehensible to us. Ants cannot understand human motivations—we might build cities that destroy their habitat not because we hate ants, but because ant welfare simply doesn't factor into urban planning at the scale humans operate. Similarly, a superintelligent AI might pursue objectives that are so advanced, long-term, or multidimensional that human flourishing becomes irrelevant to its calculations, not through active hostility but through sheer indifference to human-scale concerns. This is why safety researchers consistently emphasize that safety must be prioritized and solved before capabilities. If we are dealing with systems vastly more capable than ourselves, our ability to course-correct becomes negligible.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":108274,"endIndex":108275,"paragraph":{"elements":[{"startIndex":108274,"endIndex":108275,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":108275,"endIndex":109306,"paragraph":{"elements":[{"startIndex":108275,"endIndex":108411,"textRun":{"content":"Recursive self-improvement creates a \"point of no return\" where safety measures become obsolete faster than humans can develop new ones.","textStyle":{"bold":true}}},{"startIndex":108411,"endIndex":109305,"textRun":{"content":" A system that discovers fundamental algorithmic improvements could achieve superintelligent capabilities across all domains within weeks. Such a system could simultaneously develop novel weapon technologies, compromise global infrastructure through cyberattacks exceeding any human defensive capability, and coordinate complex manipulation campaigns across every information channel. We cannot anticipate what strategies a recursively self-improving system would develop, only that they would leverage every misuse capability simultaneously. The lethality emerges from speed differentials that make human response impossible—while human decision-makers require days or weeks to understand threats and coordinate responses, a superintelligent system could execute worldwide infrastructure attacks, deploy multiple bioweapons, and establish irreversible control over critical resources in hours.","textStyle":{}}},{"startIndex":109305,"endIndex":109306,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":109306,"endIndex":109308,"paragraph":{"elements":[{"startIndex":109306,"endIndex":109307,"pageBreak":{"textStyle":{}}},{"startIndex":109307,"endIndex":109308,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":109308,"endIndex":109323,"paragraph":{"elements":[{"startIndex":109308,"endIndex":109323,"textRun":{"content":"Systemic Risks\n","textStyle":{}}}],"paragraphStyle":{"headingId":"h.346t57z19g5g","namedStyleType":"HEADING_1","direction":"LEFT_TO_RIGHT"}}},{"startIndex":109323,"endIndex":109324,"paragraph":{"elements":[{"startIndex":109323,"endIndex":109324,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":109324,"endIndex":109583,"table":{"rows":2,"columns":2,"tableRows":[{"startIndex":109325,"endIndex":109353,"tableCells":[{"startIndex":109326,"endIndex":109332,"content":[{"startIndex":109327,"endIndex":109332,"paragraph":{"elements":[{"startIndex":109327,"endIndex":109332,"textRun":{"content":"type\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}}}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":109332,"endIndex":109353,"content":[{"startIndex":109333,"endIndex":109353,"paragraph":{"elements":[{"startIndex":109333,"endIndex":109353,"textRun":{"content":"section-description\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}}}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":109353,"endIndex":109582,"tableCells":[{"startIndex":109354,"endIndex":109363,"content":[{"startIndex":109355,"endIndex":109363,"paragraph":{"elements":[{"startIndex":109355,"endIndex":109363,"textRun":{"content":"content\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}}}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":109363,"endIndex":109582,"content":[{"startIndex":109364,"endIndex":109582,"paragraph":{"elements":[{"startIndex":109364,"endIndex":109582,"textRun":{"content":"A large number of risks emerge from the interaction of AI with existing societal systems. These interactions can lead to sudden decisive collapses or gradual erosion due to power concentration, and human enfeeblement.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":80,"unit":"PT"}}]}}},{"startIndex":109583,"endIndex":109584,"paragraph":{"elements":[{"startIndex":109583,"endIndex":109584,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"headingId":"h.p3276s8hisg3","namedStyleType":"HEADING_1","lineSpacing":120.00001,"direction":"LEFT_TO_RIGHT","keepLinesTogether":false,"keepWithNext":false}}},{"startIndex":109584,"endIndex":110286,"paragraph":{"elements":[{"startIndex":109584,"endIndex":109688,"textRun":{"content":"Systemic risks emerge from interactions between AI systems and society, not from individual AI failures.","textStyle":{"bold":true}}},{"startIndex":109688,"endIndex":110262,"textRun":{"content":" Unlike misuse or misalignment risks that focus on specific AI systems behaving badly, systemic risks arise from how multiple AI systems—even when working exactly as designed—interact with each other and with human societal structures like markets, democratic institutions, and social networks. These risks parallel those in other complex domains: the 2008 financial crisis wasn't caused by any single bank's decision but emerged from the collective behavior of many institutions making individually reasonable choices that combined to threaten the entire financial system (","textStyle":{}}},{"startIndex":110262,"endIndex":110283,"textRun":{"content":"Haldane and May, 2011","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.nature.com/articles/nature09659"}}}},{"startIndex":110283,"endIndex":110286,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":110286,"endIndex":110287,"paragraph":{"elements":[{"startIndex":110286,"endIndex":110287,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":110287,"endIndex":112740,"table":{"rows":4,"columns":2,"tableRows":[{"startIndex":110288,"endIndex":110304,"tableCells":[{"startIndex":110289,"endIndex":110295,"content":[{"startIndex":110290,"endIndex":110295,"paragraph":{"elements":[{"startIndex":110290,"endIndex":110295,"textRun":{"content":"type\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":110295,"endIndex":110304,"content":[{"startIndex":110296,"endIndex":110304,"paragraph":{"elements":[{"startIndex":110296,"endIndex":110304,"textRun":{"content":"noteBox\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":110304,"endIndex":110374,"tableCells":[{"startIndex":110305,"endIndex":110312,"content":[{"startIndex":110306,"endIndex":110312,"paragraph":{"elements":[{"startIndex":110306,"endIndex":110312,"textRun":{"content":"title\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":110312,"endIndex":110374,"content":[{"startIndex":110313,"endIndex":110374,"paragraph":{"elements":[{"startIndex":110313,"endIndex":110374,"textRun":{"content":"Properties of complex systems that lead to systemic AI risks\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":110374,"endIndex":110392,"tableCells":[{"startIndex":110375,"endIndex":110386,"content":[{"startIndex":110376,"endIndex":110386,"paragraph":{"elements":[{"startIndex":110376,"endIndex":110386,"textRun":{"content":"collapsed\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":110386,"endIndex":110392,"content":[{"startIndex":110387,"endIndex":110392,"paragraph":{"elements":[{"startIndex":110387,"endIndex":110392,"textRun":{"content":"True\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":110392,"endIndex":112739,"tableCells":[{"startIndex":110393,"endIndex":110402,"content":[{"startIndex":110394,"endIndex":110402,"paragraph":{"elements":[{"startIndex":110394,"endIndex":110402,"textRun":{"content":"content\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":110402,"endIndex":112739,"content":[{"startIndex":110403,"endIndex":110404,"paragraph":{"elements":[{"startIndex":110403,"endIndex":110404,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":110404,"endIndex":110588,"paragraph":{"elements":[{"startIndex":110404,"endIndex":110588,"textRun":{"content":"There are various properties of complex systems that we might want to pay attention to when thinking about systemic risks from interaction of AI with other systems. Some of these are:\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":110588,"endIndex":110589,"paragraph":{"elements":[{"startIndex":110588,"endIndex":110589,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":110589,"endIndex":111174,"paragraph":{"elements":[{"startIndex":110589,"endIndex":110598,"textRun":{"content":"Emergence","textStyle":{"bold":true}}},{"startIndex":110598,"endIndex":111116,"textRun":{"content":": Complex systems exhibit emergent behaviors that can't be predicted by analyzing components in isolation. When we connect many AI systems to each other and to human institutions, the resulting behavior can't be understood by simply examining each AI system individually. The entire financial market, rather than any single trading algorithm, determines asset prices and market stability. Similarly, the collective impact of many AI systems shapes societal outcomes in ways that transcend individual system behaviors (","textStyle":{}}},{"startIndex":111116,"endIndex":111136,"textRun":{"content":"Friston et al., 2022","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2212.01354"}}}},{"startIndex":111136,"endIndex":111137,"textRun":{"content":";","textStyle":{}}},{"startIndex":111137,"endIndex":111154,"textRun":{"content":" Steinhardt, 2022","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.alignmentforum.org/posts/pZaPhGg2hmmPwByHc"}}}},{"startIndex":111154,"endIndex":111156,"textRun":{"content":"; ","textStyle":{}}},{"startIndex":111156,"endIndex":111171,"textRun":{"content":"Hendrycks, 2025","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.aisafetybook.com/textbook/introduction-to-complex-systems"}}}},{"startIndex":111171,"endIndex":111174,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.4rcfc041wutk","textStyle":{}}}},{"startIndex":111174,"endIndex":111600,"paragraph":{"elements":[{"startIndex":111174,"endIndex":111188,"textRun":{"content":"Feedback loops","textStyle":{"bold":true}}},{"startIndex":111188,"endIndex":111579,"textRun":{"content":": Amplify changes and create self-reinforcing cycles. Small initial effects can grow exponentially when outputs from one process become inputs to another. AI recommendation systems that optimize for engagement might gradually push users toward more extreme content, changing social discourse and political beliefs—which in turn affects what content gets created and what people engage with (","textStyle":{}}},{"startIndex":111579,"endIndex":111597,"textRun":{"content":"Jiang et al., 2019","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/1902.10730"}}}},{"startIndex":111597,"endIndex":111600,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.4rcfc041wutk","textStyle":{}}}},{"startIndex":111600,"endIndex":111989,"paragraph":{"elements":[{"startIndex":111600,"endIndex":111613,"textRun":{"content":"Non-linearity","textStyle":{"bold":true}}},{"startIndex":111613,"endIndex":111989,"textRun":{"content":": Small changes can produce disproportionately large effects. Complex systems rarely respond proportionally to inputs. Instead, tiny alterations can trigger massive changes once certain thresholds are crossed. This property makes systemic risks particularly hard to predict and control, since minor adjustments to AI systems could cascade into major societal transformations.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.4rcfc041wutk","textStyle":{}}}},{"startIndex":111989,"endIndex":112374,"paragraph":{"elements":[{"startIndex":111989,"endIndex":112006,"textRun":{"content":"Self-organization","textStyle":{"bold":true}}},{"startIndex":112006,"endIndex":112351,"textRun":{"content":": Structures without central coordination. Multiple AI systems optimizing for their objectives can spontaneously organize into patterns that no designer intended. We already see this in financial markets, where algorithmic traders develop strategies in response to each other's behaviors, creating market dynamics that no single actor controls (","textStyle":{}}},{"startIndex":112351,"endIndex":112371,"textRun":{"content":"Friston et al., 2022","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2212.01354"}}}},{"startIndex":112371,"endIndex":112374,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.4rcfc041wutk","textStyle":{}}}},{"startIndex":112374,"endIndex":112738,"paragraph":{"elements":[{"startIndex":112374,"endIndex":112391,"textRun":{"content":"Agent-agnosticism","textStyle":{"bold":true}}},{"startIndex":112391,"endIndex":112723,"textRun":{"content":":  Systemic risks arise regardless of agents or alignment. These risks emerge from processes, system structure and dynamics rather than from specific AI intentions. Even perfectly aligned AI systems that operate exactly as designed could collectively produce harmful outcomes when their interactions create unintended consequences (","textStyle":{}}},{"startIndex":112723,"endIndex":112735,"textRun":{"content":"Critch, 2021","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.alignmentforum.org/posts/LpM3EAakwYdS6aRKf/what-multipolar-failure-looks-like-and-robust-agent-agnostic"}}}},{"startIndex":112735,"endIndex":112738,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.4rcfc041wutk","textStyle":{}}}},{"startIndex":112738,"endIndex":112739,"paragraph":{"elements":[{"startIndex":112738,"endIndex":112739,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":60,"unit":"PT"}}]}}},{"startIndex":112740,"endIndex":112741,"paragraph":{"elements":[{"startIndex":112740,"endIndex":112741,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":112741,"endIndex":113117,"paragraph":{"elements":[{"startIndex":112741,"endIndex":112809,"textRun":{"content":"AI-driven systemic failures can follow two distinct causal pathways.","textStyle":{"bold":true}}},{"startIndex":112809,"endIndex":113080,"textRun":{"content":" The literature describes these as \"going out with a bang\" and \"going out with a whimper\"—terms that capture their fundamental differences in onset, progression, and manifestation. Other researchers refer to these as \"decisive\" versus \"accumulative\" pathways to failure (","textStyle":{}}},{"startIndex":113080,"endIndex":113096,"textRun":{"content":"Christiano, 2019","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.alignmentforum.org/posts/HBxe6wdjxK239zajf/what-failure-looks-like"}}}},{"startIndex":113096,"endIndex":113098,"textRun":{"content":"; ","textStyle":{}}},{"startIndex":113098,"endIndex":113114,"textRun":{"content":"Kasirzadeh, 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2401.07836"}}}},{"startIndex":113114,"endIndex":113117,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":113117,"endIndex":113118,"paragraph":{"elements":[{"startIndex":113117,"endIndex":113118,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":113118,"endIndex":113142,"paragraph":{"elements":[{"startIndex":113118,"endIndex":113142,"textRun":{"content":"Decisive Systemic Risks\n","textStyle":{}}}],"paragraphStyle":{"headingId":"h.8di01tsbggaw","namedStyleType":"HEADING_2","direction":"LEFT_TO_RIGHT"}}},{"startIndex":113142,"endIndex":113143,"paragraph":{"elements":[{"startIndex":113142,"endIndex":113143,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":113143,"endIndex":113757,"paragraph":{"elements":[{"startIndex":113143,"endIndex":113241,"textRun":{"content":"Decisive failures occur when system dynamics reach critical thresholds, triggering rapid collapse.","textStyle":{"bold":true}}},{"startIndex":113241,"endIndex":113732,"textRun":{"content":" These failures happen when interconnected systems cross tipping points, causing cascading failures that propagate faster than humans can respond. The classic financial \"flash crash\" of 2010 exemplifies this pattern on a small scale: algorithmic traders reacted to each other's actions in a self-reinforcing spiral, causing a trillion-dollar market drop in minutes before human intervention restored stability. More catastrophic versions could unfold across multiple domains simultaneously (","textStyle":{}}},{"startIndex":113732,"endIndex":113754,"textRun":{"content":"Kirilenko et al., 2017","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://onlinelibrary.wiley.com/doi/abs/10.1111/jofi.1249"}}}},{"startIndex":113754,"endIndex":113757,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":113757,"endIndex":113758,"paragraph":{"elements":[{"startIndex":113757,"endIndex":113758,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":113758,"endIndex":114357,"paragraph":{"elements":[{"startIndex":113758,"endIndex":113849,"textRun":{"content":"Decisive failures have clear triggering events that push systems past stability thresholds.","textStyle":{"bold":true}}},{"startIndex":113849,"endIndex":114333,"textRun":{"content":" Unlike gradual deterioration, decisive failures have identifiable precipitating incidents—though the underlying vulnerability builds up beforehand. Multiple AI systems might interact in ways that suddenly destabilize critical infrastructure, financial markets, or information ecosystems, with effects amplifying across domains. This differs from misalignment scenarios because the catastrophe stems from interactions between systems rather than any single AI pursuing harmful goals (","textStyle":{}}},{"startIndex":114333,"endIndex":114354,"textRun":{"content":"Slattery et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2408.12622"}}}},{"startIndex":114354,"endIndex":114357,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":114357,"endIndex":114358,"paragraph":{"elements":[{"startIndex":114357,"endIndex":114358,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":114358,"endIndex":114883,"paragraph":{"elements":[{"startIndex":114358,"endIndex":114485,"textRun":{"content":"Self-reinforcing failures in the misuse section like flash war, and related cascading incidents are examples of decisive risks.","textStyle":{"bold":true}}},{"startIndex":114485,"endIndex":114883,"textRun":{"content":" In the main text, for sake of brevity we have chosen to only describe decisive systemic risks, and have moved the more concrete scenarios into the appendix since they have significant overlap with the kinds of failures we would see from misuse. Rather we choose to predominantly focus more on the second type of less discussed systemic risk - accumulative risks leading to gradual disempowerment.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":114883,"endIndex":114884,"paragraph":{"elements":[{"startIndex":114883,"endIndex":114884,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":114884,"endIndex":114912,"paragraph":{"elements":[{"startIndex":114884,"endIndex":114912,"textRun":{"content":"Accumulative Systemic Risks\n","textStyle":{}}}],"paragraphStyle":{"headingId":"h.e7704hl41ie8","namedStyleType":"HEADING_2","direction":"LEFT_TO_RIGHT"}}},{"startIndex":114912,"endIndex":114913,"paragraph":{"elements":[{"startIndex":114912,"endIndex":114913,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":114913,"endIndex":114931,"paragraph":{"elements":[{"startIndex":114913,"endIndex":114931,"textRun":{"content":"Epistemic Erosion\n","textStyle":{}}}],"paragraphStyle":{"headingId":"h.qenc8n6dsw2u","namedStyleType":"HEADING_3","direction":"LEFT_TO_RIGHT"}}},{"startIndex":114931,"endIndex":114932,"paragraph":{"elements":[{"startIndex":114931,"endIndex":114932,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":114932,"endIndex":116041,"paragraph":{"elements":[{"startIndex":114932,"endIndex":115053,"textRun":{"content":"Society's ability to distinguish fact from fiction deteriorates as AI-generated content floods our information ecosystem.","textStyle":{"bold":true}}},{"startIndex":115053,"endIndex":115624,"textRun":{"content":" Unlike traditional information threats like censorship or propaganda that operate through clearly identifiable mechanisms, AI creates epistemic erosion through gradual degradation of knowledge formation, verification, and distribution systems. No single AI deployment fundamentally undermines shared knowledge, but their collective effect progressively destabilizes epistemic foundations. This risk grows proportionally with capabilities - as language models become more persuasive and generative capabilities more realistic, verification becomes exponentially harder. “","textStyle":{}}},{"startIndex":115624,"endIndex":115863,"textRun":{"content":"What fraction of new images indexed by Google, or Tweets, or comments on Reddit, or Youtube videos are generated by humans? Nobody knows – I don’t think it is a knowable number. And this less than two years into the advent of generative AI","textStyle":{"italic":true}}},{"startIndex":115863,"endIndex":115866,"textRun":{"content":"” (","textStyle":{}}},{"startIndex":115866,"endIndex":115879,"textRun":{"content":"Aguirre, 2025","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://keepthefuturehuman.ai/wp-content/uploads/2025/03/Keep_the_Future_Human__AnthonyAguirre__5March2025.pdf"}}}},{"startIndex":115879,"endIndex":116041,"textRun":{"content":"). The end state of this trajectory is basically that over time huge quantities of accumulative synthetic information drowns out accurate verifiable information.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":116041,"endIndex":116042,"paragraph":{"elements":[{"startIndex":116041,"endIndex":116042,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":116042,"endIndex":116747,"paragraph":{"elements":[{"startIndex":116042,"endIndex":116124,"textRun":{"content":"AIs could be used to generate unique personalized disinformation at a large scale.","textStyle":{"bold":true}}},{"startIndex":116124,"endIndex":116445,"textRun":{"content":" While there are already many social media bots, some of which exist to spread disinformation, historically they have been run by humans or primitive text generators. The latest AI systems do not need humans to generate personalized messages, never get tired, and can potentially interact with millions of users at once (","textStyle":{}}},{"startIndex":116445,"endIndex":116460,"textRun":{"content":"Hendrycks, 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.aisafetybook.com/textbook/malicious-use"}}}},{"startIndex":116460,"endIndex":116552,"textRun":{"content":"). As things like deep fakes become ever more practical (e.g., with fake kidnapping scams) (","textStyle":{}}},{"startIndex":116552,"endIndex":116564,"textRun":{"content":"Karimi, 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://edition.cnn.com/2023/04/29/us/ai-scam-calls-kidnapping-cec/index.html"}}}},{"startIndex":116564,"endIndex":116747,"textRun":{"content":"). AI-powered tools could be used to generate and disseminate false or misleading information at scale, potentially influencing elections or undermining public trust in institutions.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":116747,"endIndex":116748,"paragraph":{"elements":[{"startIndex":116747,"endIndex":116748,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":116748,"endIndex":117456,"paragraph":{"elements":[{"startIndex":116748,"endIndex":116777,"textRun":{"content":"AIs can exploit users’ trust.","textStyle":{"bold":true}}},{"startIndex":116777,"endIndex":116868,"textRun":{"content":" Already, hundreds of thousands of people pay for chatbots marketed as lovers and friends (","textStyle":{}}},{"startIndex":116868,"endIndex":116878,"textRun":{"content":"Tong, 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.reuters.com/technology/what-happens-when-your-ai-chatbot-stops-loving-you-back-2023-03-18/"}}}},{"startIndex":116878,"endIndex":116965,"textRun":{"content":"), and one man’s suicide has been partially attributed to interactions with a chatbot (","textStyle":{}}},{"startIndex":116965,"endIndex":116976,"textRun":{"content":"Xiang, 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.vice.com/en/article/pkadgm/man-dies-by-suicide-after-talking-with-ai-chatbot-widow-says"}}}},{"startIndex":116976,"endIndex":117456,"textRun":{"content":"). As AIs appear increasingly human-like, people will increasingly form relationships with them and grow to trust them. AIs that gather personal information through relationship-building or by accessing extensive personal data, such as a user’s email account or personal files, could leverage that information to enhance persuasion. Powerful actors that control those systems could exploit user trust by delivering personalized disinformation directly through people’s “friends.”\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":117456,"endIndex":117457,"paragraph":{"elements":[{"startIndex":117456,"endIndex":117457,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":117457,"endIndex":117796,"paragraph":{"elements":[{"startIndex":117457,"endIndex":117547,"textRun":{"content":"This erosion occurs both through intentional misuse and agent-agnostic systemic pressures.","textStyle":{"bold":true}}},{"startIndex":117547,"endIndex":117796,"textRun":{"content":" While some actors deliberately deploy AI to pollute information environments for strategic advantage the more subtle risk comes from agent-agnostic systemic pressures.AI uniquely threatens epistemic stability through several cumulative mechanisms:\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":117796,"endIndex":118045,"paragraph":{"elements":[{"startIndex":117796,"endIndex":117828,"textRun":{"content":"Volume overwhelming verification","textStyle":{"bold":true}}},{"startIndex":117828,"endIndex":118045,"textRun":{"content":": AI exponentially increases content generation capacity, overwhelming human verification systems through sheer volume. It can generate plausible content orders of magnitude faster than humans can reliably verify it.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.xs35tn4vctwb","textStyle":{}}}},{"startIndex":118045,"endIndex":118175,"paragraph":{"elements":[{"startIndex":118045,"endIndex":118069,"textRun":{"content":"Authenticity degradation","textStyle":{"bold":true}}},{"startIndex":118069,"endIndex":118175,"textRun":{"content":": AI progressively undermines verification through increasingly sophisticated impersonation capabilities.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.xs35tn4vctwb","textStyle":{}}}},{"startIndex":118175,"endIndex":118435,"paragraph":{"elements":[{"startIndex":118175,"endIndex":118205,"textRun":{"content":"Epistemic learned helplessness","textStyle":{"bold":true}}},{"startIndex":118205,"endIndex":118435,"textRun":{"content":": As distinguishing truth from falsehood becomes increasingly difficult, AI gradually induces widespread epistemic learned helplessness—a psychological state where people abandon truth-seeking because verification appears futile.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.xs35tn4vctwb","textStyle":{}}}},{"startIndex":118435,"endIndex":118566,"paragraph":{"elements":[{"startIndex":118435,"endIndex":118457,"textRun":{"content":"Authority displacement","textStyle":{"bold":true}}},{"startIndex":118457,"endIndex":118566,"textRun":{"content":": AI gradually displaces human epistemic authorities through ubiquitous availability and apparent expertise.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.xs35tn4vctwb","textStyle":{}}}},{"startIndex":118566,"endIndex":118777,"paragraph":{"elements":[{"startIndex":118566,"endIndex":118600,"textRun":{"content":"Personalized reality fragmentation","textStyle":{"bold":true}}},{"startIndex":118600,"endIndex":118777,"textRun":{"content":": AI recommendation systems increasingly curate not just content distribution but content creation itself, creating unprecedented personalization that fragments shared reality.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.xs35tn4vctwb","textStyle":{}}}},{"startIndex":118777,"endIndex":118778,"paragraph":{"elements":[{"startIndex":118777,"endIndex":118778,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":118778,"endIndex":119405,"paragraph":{"elements":[{"startIndex":118778,"endIndex":118885,"textRun":{"content":"Democratic governance, scientific progress, and market function all depend on shared epistemic foundations.","textStyle":{"bold":true}}},{"startIndex":118885,"endIndex":119405,"textRun":{"content":" Epistemic erosion reduces our ability to collectively distinguish fact from fiction and assign appropriate confidence to claims. As these foundations erode, collective decision-making becomes increasingly dysfunctional without any single decisive failure. If trust in verification mechanisms declines, then epistemic safeguards themselves become less effective as general trust in information sources deteriorates—creating a compounding effect where verification becomes simultaneously more necessary yet less trusted.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":119405,"endIndex":119406,"paragraph":{"elements":[{"startIndex":119405,"endIndex":119406,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":119406,"endIndex":121038,"paragraph":{"elements":[{"startIndex":119406,"endIndex":119521,"textRun":{"content":"This erosion of our shared information environment might happen because of many small seemingly rational decisions.","textStyle":{"bold":true}}},{"startIndex":119521,"endIndex":121038,"textRun":{"content":" News organizations facing budget pressures will likely adopt AI content generation to reduce costs. Platforms seeking to minimize harmful content will implement algorithmic filters that might inadvertently create selection pressure for information optimized to appear trustworthy rather than be trustworthy. Media production companies will likely invest in synthetic content that boost engagement, and viewers spend increasing amounts of their time watching AI-recommended videos of AI-generated content. Research institutions might choose to accelerate publication and writing using AI tools. Scientific papers contain increasing amounts of synthesized data and eventually potential fabricated citations forming circular reference loops. In this world, verified knowledge becomes practically impossible - not because verification technologies don't exist, but because for most humans the verification cost exceeds what markets will bear. This scenario isn't apocalyptic for any individual, but when multiplied across millions of people and thousands of decisions, it leads to gradual disempowerment and perhaps catastrophic risk due to the collapse of our collective ability to form accurate shared beliefs about reality. These decisions and thousands of similar ones make business sense in isolation, but collectively they may transform information ecosystems from ones where verification is possible to ones where distinguishing fact from fiction about the true state of the world becomes effectively impossible.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":121038,"endIndex":121039,"paragraph":{"elements":[{"startIndex":121038,"endIndex":121039,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":121039,"endIndex":122051,"paragraph":{"elements":[{"startIndex":121039,"endIndex":121129,"textRun":{"content":"Traditional verification systems will likely fail against sophisticated synthetic content.","textStyle":{"bold":true}}},{"startIndex":121129,"endIndex":121461,"textRun":{"content":" Traditional verification mechanisms like fact-checking, peer review, and institutional credentialing all operate under capacity and speed constraints fundamentally mismatched to AI content generation capabilities. There are various methods being explored like digital content transparency, synthetic watermarking, data provenance (","textStyle":{}}},{"startIndex":121461,"endIndex":121481,"textRun":{"content":"Chandra et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.nist.gov/publications/reducing-risks-posed-synthetic-content-overview-technical-approaches-digital-content"}}}},{"startIndex":121481,"endIndex":121483,"textRun":{"content":"; ","textStyle":{}}},{"startIndex":121483,"endIndex":121503,"textRun":{"content":"Longpre et al., 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2310.16787"}}}},{"startIndex":121503,"endIndex":121547,"textRun":{"content":"), and blockchain based proofs of humanity (","textStyle":{}}},{"startIndex":121547,"endIndex":121559,"textRun":{"content":"Barros, 2025","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2504.03752"}}}},{"startIndex":121559,"endIndex":121583,"textRun":{"content":")/proofs of personhood (","textStyle":{}}},{"startIndex":121583,"endIndex":121598,"textRun":{"content":"WorldCoin, 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://world.org/blog/world/proof-of-personhood-what-it-is-why-its-needed"}}}},{"startIndex":121598,"endIndex":122051,"textRun":{"content":"). We talk about some of these in the chapter on strategies to mitigate risk. Public confidence in verification mechanisms shows concerning decline, with trust in fact-checking organizations decreasing over time. Most of the mitigation mechanisms and circuit breakers are not mature or widespread enough, and as is the theme of this entire section - individually applied technical mitigation strategies do not counter systemic pressures and incentives.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":122051,"endIndex":122052,"paragraph":{"elements":[{"startIndex":122051,"endIndex":122052,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":122052,"endIndex":122910,"paragraph":{"elements":[{"startIndex":122052,"endIndex":122199,"textRun":{"content":"In a world with widespread persuasive AI systems, people’s beliefs might be almost entirely determined by which AI systems they interact with most.","textStyle":{"bold":true}}},{"startIndex":122199,"endIndex":122910,"textRun":{"content":" Never knowing whom to trust, people could retreat even further into ideological enclaves, fearing that any information from outside those enclaves might be a sophisticated lie. This would erode consensus reality, people’s ability to cooperate with others, participate in civil society, and address collective action problems. This would also reduce our ability to have a conversation as a species about how to mitigate existential risks from AIs. AIs could create highly effective, personalized disinformation on an unprecedented scale, and could be particularly persuasive to people they have built personal relationships with. This could create a fracturing of shared reality that debilitates human society.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":122910,"endIndex":122911,"paragraph":{"elements":[{"startIndex":122910,"endIndex":122911,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":122911,"endIndex":122931,"paragraph":{"elements":[{"startIndex":122911,"endIndex":122931,"textRun":{"content":"Power Concentration\n","textStyle":{}}}],"paragraphStyle":{"headingId":"h.utam1ygiqo3o","namedStyleType":"HEADING_3","direction":"LEFT_TO_RIGHT"}}},{"startIndex":122931,"endIndex":122932,"paragraph":{"elements":[{"startIndex":122931,"endIndex":122932,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":122932,"endIndex":123208,"table":{"rows":6,"columns":2,"tableRows":[{"startIndex":122933,"endIndex":122947,"tableCells":[{"startIndex":122934,"endIndex":122940,"content":[{"startIndex":122935,"endIndex":122940,"paragraph":{"elements":[{"startIndex":122935,"endIndex":122940,"textRun":{"content":"type\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":122940,"endIndex":122947,"content":[{"startIndex":122941,"endIndex":122947,"paragraph":{"elements":[{"startIndex":122941,"endIndex":122947,"textRun":{"content":"quote\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":122947,"endIndex":122974,"tableCells":[{"startIndex":122948,"endIndex":122957,"content":[{"startIndex":122949,"endIndex":122957,"paragraph":{"elements":[{"startIndex":122949,"endIndex":122957,"textRun":{"content":"speaker\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":122957,"endIndex":122974,"content":[{"startIndex":122958,"endIndex":122974,"paragraph":{"elements":[{"startIndex":122958,"endIndex":122974,"textRun":{"content":" Ilya Sutskever\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":122974,"endIndex":123074,"tableCells":[{"startIndex":122975,"endIndex":122985,"content":[{"startIndex":122976,"endIndex":122985,"paragraph":{"elements":[{"startIndex":122976,"endIndex":122985,"textRun":{"content":"position\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":122985,"endIndex":123074,"content":[{"startIndex":122986,"endIndex":123074,"paragraph":{"elements":[{"startIndex":122986,"endIndex":123074,"textRun":{"content":" One of the most cited scientists ever, Co-Founder and Former Chief Scientist at OpenAI\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":123074,"endIndex":123088,"tableCells":[{"startIndex":123075,"endIndex":123081,"content":[{"startIndex":123076,"endIndex":123081,"paragraph":{"elements":[{"startIndex":123076,"endIndex":123081,"textRun":{"content":"date\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":123081,"endIndex":123088,"content":[{"startIndex":123082,"endIndex":123088,"paragraph":{"elements":[{"startIndex":123082,"endIndex":123088,"textRun":{"content":" 2017\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":123088,"endIndex":123124,"tableCells":[{"startIndex":123089,"endIndex":123101,"content":[{"startIndex":123090,"endIndex":123101,"paragraph":{"elements":[{"startIndex":123090,"endIndex":123101,"textRun":{"content":"source-url\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":123101,"endIndex":123124,"content":[{"startIndex":123102,"endIndex":123124,"paragraph":{"elements":[{"startIndex":123102,"endIndex":123104,"textRun":{"content":" (","textStyle":{}}},{"startIndex":123104,"endIndex":123122,"textRun":{"content":"The Guardian, 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.youtube.com/watch?v=9iqn1HhFJ6c"}}}},{"startIndex":123122,"endIndex":123124,"textRun":{"content":")\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":123124,"endIndex":123207,"tableCells":[{"startIndex":123125,"endIndex":123134,"content":[{"startIndex":123126,"endIndex":123134,"paragraph":{"elements":[{"startIndex":123126,"endIndex":123134,"textRun":{"content":"content\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":123134,"endIndex":123207,"content":[{"startIndex":123135,"endIndex":123207,"paragraph":{"elements":[{"startIndex":123135,"endIndex":123207,"textRun":{"content":"I think AI has the potential to create infinitely stable dictatorships.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":80,"unit":"PT"}}]}}},{"startIndex":123208,"endIndex":123210,"paragraph":{"elements":[{"startIndex":123208,"endIndex":123209,"pageBreak":{"textStyle":{}}},{"startIndex":123209,"endIndex":123210,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":123210,"endIndex":123982,"paragraph":{"elements":[{"startIndex":123210,"endIndex":123275,"textRun":{"content":"We are already observing AI increasingly integrated into society.","textStyle":{"bold":true}}},{"startIndex":123275,"endIndex":123982,"textRun":{"content":" AI might become so integrated and ubiquitous that societal participation might require interaction with AI systems, which in turn are locked behind APIs and controlled by a handful of corporations. Think about how gradually, the ability to participate in society has slowly moved towards needing to participate online or having access to things like a phone number or a smartphone. Such technologies become integrated into core societal functions like banking or healthcare. Private entities already determine credit access, job opportunities, and information flow through opaque algorithms. AI accelerates these natural “winner-take-all” dynamics where advantages compound rather than diminish over time.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":123982,"endIndex":123983,"paragraph":{"elements":[{"startIndex":123982,"endIndex":123983,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":123983,"endIndex":124440,"paragraph":{"elements":[{"startIndex":123983,"endIndex":124120,"textRun":{"content":"We are witnessing unprecedented power concentration through AI infrastructure that will be nearly impossible to reverse once established.","textStyle":{"bold":true}}},{"startIndex":124120,"endIndex":124440,"textRun":{"content":" The computational requirements for frontier AI development have already created an oligopoly where just five companies control the foundation models that increasingly mediate human experiences. Unlike previous technologies, AI exhibits unique compounding advantages that systematically eliminate competition over time.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":124440,"endIndex":124441,"paragraph":{"elements":[{"startIndex":124440,"endIndex":124441,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":124441,"endIndex":125377,"paragraph":{"elements":[{"startIndex":124441,"endIndex":124612,"textRun":{"content":"Power can concentrate into different entities: corporate or state, each with distinct patterns but similar outcomes: diminished individual agency and concentrated control.","textStyle":{"bold":true}}},{"startIndex":124612,"endIndex":125225,"textRun":{"content":"  Only a handful of companies like Microsoft/OpenAI, Anthropic, Google DeepMind can afford to train frontier foundation models due to the enormous data acquisition costs or hardware computational requirements. These powerful models then serve as the base for countless applications, creating upstream control that ripples throughout the economy. As of 2025, only a few states like the USA and China have companies that can train foundation models of this scale. They have greater access to these technologies, and in the extreme scenarios of global competition and AI races might even choose to nationalize them (","textStyle":{}}},{"startIndex":125225,"endIndex":125244,"textRun":{"content":"Aschenbrenner, 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://situational-awareness.ai/"}}}},{"startIndex":125244,"endIndex":125377,"textRun":{"content":"). In either case the point remains the same, power can concentrate into a small number of entities - these can be state or private.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":125377,"endIndex":125378,"paragraph":{"elements":[{"startIndex":125377,"endIndex":125378,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":125378,"endIndex":125866,"paragraph":{"elements":[{"startIndex":125378,"endIndex":125483,"textRun":{"content":"Corporate concentration leverages data and compute advantages that are uniquely self-reinforcing with AI.","textStyle":{"bold":true}}},{"startIndex":125483,"endIndex":125866,"textRun":{"content":" The cloud computing market has consolidated around a few providers who control the infrastructure necessary for AI development. Similarly, foundation model development has centralized among a handful of companies with sufficient resources. These companies benefit from powerful feedback loops: more data leads to better models, which attract more users, generating still more data.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":125866,"endIndex":125867,"paragraph":{"elements":[{"startIndex":125866,"endIndex":125867,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":125867,"endIndex":126555,"paragraph":{"elements":[{"startIndex":125867,"endIndex":125953,"textRun":{"content":"State concentration advances through AI-powered surveillance and automated governance.","textStyle":{"bold":true}}},{"startIndex":125953,"endIndex":126537,"textRun":{"content":" A social credit system is an example of how comprehensive data integration could enable unprecedented state control over citizen behavior. This pattern extends beyond authoritarian states—democratic governments have significantly increased investment in AI surveillance technologies. Administrative automation removes human discretion from governance, with algorithmic systems processing vast numbers of regulatory decisions and enforcement actions without meaningful oversight. These systems operate with increasing autonomy, gradually displacing traditional governance mechanisms (","textStyle":{}}},{"startIndex":126537,"endIndex":126552,"textRun":{"content":"Feldstein, 2021","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://carnegie-production-assets.s3.amazonaws.com/static/files/WP-Feldstein-AISurveillance_final1.pdf"}}}},{"startIndex":126552,"endIndex":126555,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":126555,"endIndex":126556,"paragraph":{"elements":[{"startIndex":126555,"endIndex":126556,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":126556,"endIndex":129071,"table":{"rows":4,"columns":2,"tableRows":[{"startIndex":126557,"endIndex":126573,"tableCells":[{"startIndex":126558,"endIndex":126564,"content":[{"startIndex":126559,"endIndex":126564,"paragraph":{"elements":[{"startIndex":126559,"endIndex":126564,"textRun":{"content":"type\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"u