r":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":85999,"endIndex":86044,"content":[{"startIndex":86000,"endIndex":86044,"paragraph":{"elements":[{"startIndex":86000,"endIndex":86044,"textRun":{"content":"https://www.youtube.com/watch?v=oH-txHzE4jA\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":86044,"endIndex":86307,"tableCells":[{"startIndex":86045,"endIndex":86054,"content":[{"startIndex":86046,"endIndex":86054,"paragraph":{"elements":[{"startIndex":86046,"endIndex":86054,"textRun":{"content":"caption\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":86054,"endIndex":86307,"content":[{"startIndex":86055,"endIndex":86307,"paragraph":{"elements":[{"startIndex":86055,"endIndex":86289,"textRun":{"content":"An optional video that gives you an example of Vingean uncertainty. Magnus Carlsen (Chess Grandmaster) checkmates Bill Gates in 12 seconds. This is not surprising, Bill Gates knew he was going to lose, but he didn’t know exactly how (","textStyle":{}}},{"startIndex":86289,"endIndex":86304,"textRun":{"content":"Chess.com, 2014","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"http://chess.com"}}}},{"startIndex":86304,"endIndex":86307,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":80,"unit":"PT"}}]}}},{"startIndex":86308,"endIndex":86309,"paragraph":{"elements":[{"startIndex":86308,"endIndex":86309,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":86309,"endIndex":87321,"paragraph":{"elements":[{"startIndex":86309,"endIndex":86358,"textRun":{"content":"We already see Vingean uncertainty in current AI.","textStyle":{"bold":true}}},{"startIndex":86358,"endIndex":87321,"textRun":{"content":" We don't need to wait for AGI or ASI to see Vingean uncertainty in action. It shows up whenever an AI system becomes more capable than humans in its domain of expertise. For example, think about just a narrow system -  Deep Blue (chess playing AI). Its creators knew it would try to win chess games, but couldn't predict its specific moves - if they could, they would have been as good at chess as Deep Blue itself. We saw in the last chapter that systems are steadily moving up the curves of both capability, and generality.  The problem with this is that uncertainty about a system's actions increases as they become more capable. So we might be confident about the outcomes an AI system will achieve while being increasingly uncertain about how exactly it will achieve them. This means two things - we are not completely helpless in understanding what beings smarter than ourselves would do, but, we might not know how exactly they might do whatever they do.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":87321,"endIndex":87322,"paragraph":{"elements":[{"startIndex":87321,"endIndex":87322,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":87322,"endIndex":87810,"paragraph":{"elements":[{"startIndex":87322,"endIndex":87402,"textRun":{"content":"Vingean uncertainty makes coming up with concrete existential risk stories hard.","textStyle":{"bold":true}}},{"startIndex":87402,"endIndex":87810,"textRun":{"content":" It’s even harder to make sure that these stories don't sound like sci-fi and are taken seriously by the general public and policymakers. Despite this we will try our best. In the next few sections, we focus on specifically “what actually might happen” if we have misaligned AI. The mechanistic and machine learning details of “how” exactly all of these would occur is left up to chapters later in the book.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":87810,"endIndex":87811,"paragraph":{"elements":[{"startIndex":87810,"endIndex":87811,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":87811,"endIndex":88126,"paragraph":{"elements":[{"startIndex":87811,"endIndex":88126,"textRun":{"content":"Remember that it’s ok not to understand each one of these concepts 100% from the following subsections. We have entire chapters dedicated to each one of these individually, so there is a lot to learn. What we present here is just a highly condensed overview to give you an introduction to the kinds of risks posed.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":88126,"endIndex":88147,"paragraph":{"elements":[{"startIndex":88126,"endIndex":88147,"textRun":{"content":"Specification Gaming\n","textStyle":{}}}],"paragraphStyle":{"headingId":"h.ov5h73eezg4z","namedStyleType":"HEADING_2","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spaceAbove":{"magnitude":18,"unit":"PT"},"spaceBelow":{"magnitude":4,"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false}}},{"startIndex":88147,"endIndex":88148,"paragraph":{"elements":[{"startIndex":88147,"endIndex":88148,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":88148,"endIndex":88744,"paragraph":{"elements":[{"startIndex":88148,"endIndex":88233,"textRun":{"content":"Specifications are the rules we create to tell AI systems how we want them to behave.","textStyle":{"bold":true}}},{"startIndex":88233,"endIndex":88744,"textRun":{"content":" When we build AI models, we need some way to tell them what we want them to do. For RL systems, this typically means defining a reward function that assigns positive or negative rewards to different outcomes. For other types of ML models like language models, this means defining a loss function that measures how well the model's text generations match the training data (internet text). These reward and loss functions are what we call specifications - they are our attempt to formally define good behavior.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":88744,"endIndex":88745,"paragraph":{"elements":[{"startIndex":88744,"endIndex":88745,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":88745,"endIndex":89981,"paragraph":{"elements":[{"startIndex":88745,"endIndex":88856,"textRun":{"content":"Specification gaming arises because there is a fundamental difference between “what we say” and “what we mean”.","textStyle":{"bold":true}}},{"startIndex":88856,"endIndex":89957,"textRun":{"content":" This happens when the system technically follows our rules but exploits them in unintended ways - like a student who gets good grades by memorizing test answers rather than understanding the material. Think about the example of recommendation algorithms. What we intended was helping users discover valuable, relevant content that enriches their lives and promotes healthy discourse. What we specified was \"maximize user engagement time.\" So the systems discover that controversial, emotionally charged content keeps users scrolling longer than balanced, nuanced information. They promote polarizing posts, conspiracy theories, and content that triggers strong emotional reactions, creating filter bubbles where users see increasingly extreme versions of their existing beliefs. The algorithms technically succeed at their objective—engagement metrics soar and time-on-platform increases dramatically—while simultaneously undermining social cohesion, spreading misinformation, and radicalizing users. The platforms celebrate record engagement numbers while democratic discourse quietly deteriorates (","textStyle":{}}},{"startIndex":89957,"endIndex":89978,"textRun":{"content":"Slattery et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2408.12622"}}}},{"startIndex":89978,"endIndex":89981,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":89981,"endIndex":90924,"paragraph":{"elements":[{"startIndex":89981,"endIndex":90107,"textRun":{"content":"AI models routinely discover unexpected ways to maximize objectives that technically follow our rules but miss our intentions.","textStyle":{"bold":true}}},{"startIndex":90107,"endIndex":90259,"textRun":{"content":" AI models trained to play Tetris, just pause games right before they are about to lose, since there's no negative feedback if you never actually lose (","textStyle":{}}},{"startIndex":90259,"endIndex":90271,"textRun":{"content":"Murphy, 2013","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"http://tom7.org/mario/mario.pdf"}}}},{"startIndex":90271,"endIndex":90402,"textRun":{"content":"). Somewhat similarly, an AI asked to design a rail network where trains don't crash just decides to stop all trains from running (","textStyle":{}}},{"startIndex":90402,"endIndex":90418,"textRun":{"content":"Wooldridge, 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.telegraph.co.uk/news/2024/01/07/artificial-intelligence-train-problems/"}}}},{"startIndex":90418,"endIndex":90593,"textRun":{"content":"). Reasoning models like OpenAI o1 and o3, when instructed to win against chess engines, will hack the game environment when they realize they cannot win through normal play (","textStyle":{}}},{"startIndex":90593,"endIndex":90616,"textRun":{"content":"Bondarenko et al., 2025","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2502.13295"}}}},{"startIndex":90616,"endIndex":90827,"textRun":{"content":"). LLMs agents, when asked to help reduce the runtime of a script for training,  just copy the final output instead of running the script, and then they add some noise to parameters to simulate actual training (","textStyle":{}}},{"startIndex":90827,"endIndex":90837,"textRun":{"content":"METR, 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2411.15114"}}}},{"startIndex":90837,"endIndex":90922,"textRun":{"content":"). These are just some out of  countless other examples of this misalignment problem.","textStyle":{}}},{"startIndex":90922,"endIndex":90923,"footnoteReference":{"footnoteId":"kix.lg4ufyfzyqnv","footnoteNumber":"4","textStyle":{}}},{"startIndex":90923,"endIndex":90924,"textRun":{"content":"\n","textStyle":{"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","spaceAbove":{"magnitude":12,"unit":"PT"},"spaceBelow":{"magnitude":12,"unit":"PT"}}}},{"startIndex":90924,"endIndex":90925,"paragraph":{"elements":[{"startIndex":90924,"endIndex":90925,"textRun":{"content":"\n","textStyle":{"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":120.00001,"direction":"LEFT_TO_RIGHT"}}},{"startIndex":90925,"endIndex":91396,"table":{"rows":3,"columns":2,"tableRows":[{"startIndex":90926,"endIndex":90941,"tableCells":[{"startIndex":90927,"endIndex":90933,"content":[{"startIndex":90928,"endIndex":90933,"paragraph":{"elements":[{"startIndex":90928,"endIndex":90933,"textRun":{"content":"type\n","textStyle":{"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"un