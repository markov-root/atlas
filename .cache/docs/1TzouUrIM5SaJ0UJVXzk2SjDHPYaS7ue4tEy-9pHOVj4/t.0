{"body":{"content":[{"endIndex":1,"sectionBreak":{"sectionStyle":{"columnSeparatorStyle":"NONE","contentDirection":"LEFT_TO_RIGHT","sectionType":"CONTINUOUS"}}},{"startIndex":1,"endIndex":19,"paragraph":{"elements":[{"startIndex":1,"endIndex":19,"textRun":{"content":"Chapter 2 - Risks\n","textStyle":{}}}],"paragraphStyle":{"headingId":"h.aeqpi9k5zmz","namedStyleType":"TITLE","alignment":"CENTER","lineSpacing":120.00001,"direction":"LEFT_TO_RIGHT"}}},{"startIndex":19,"endIndex":20,"paragraph":{"elements":[{"startIndex":19,"endIndex":20,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":20,"endIndex":33,"paragraph":{"elements":[{"startIndex":20,"endIndex":33,"textRun":{"content":"Introduction\n","textStyle":{}}}],"paragraphStyle":{"headingId":"h.ynzkya2t6xmy","namedStyleType":"HEADING_1","lineSpacing":120.00001,"direction":"LEFT_TO_RIGHT","keepLinesTogether":false,"keepWithNext":false}}},{"startIndex":33,"endIndex":407,"paragraph":{"elements":[{"startIndex":33,"endIndex":407,"textRun":{"content":"The previous chapter explored AI's rapidly advancing capabilities through scaling laws, the bitter lesson, and potential takeoff scenarios. We saw how more compute, data, and algorithmic improvements drive consistent capability gains across domains. But why should increasing capabilities concern us? The short answer is - more capable AI systems create larger-scale risks.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","spaceAbove":{"magnitude":12,"unit":"PT"},"spaceBelow":{"magnitude":12,"unit":"PT"}}}},{"startIndex":407,"endIndex":408,"paragraph":{"elements":[{"startIndex":407,"endIndex":408,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","spaceAbove":{"magnitude":12,"unit":"PT"},"spaceBelow":{"magnitude":12,"unit":"PT"}}}},{"startIndex":408,"endIndex":807,"table":{"rows":3,"columns":2,"tableRows":[{"startIndex":409,"endIndex":424,"tableCells":[{"startIndex":410,"endIndex":416,"content":[{"startIndex":411,"endIndex":416,"paragraph":{"elements":[{"startIndex":411,"endIndex":416,"textRun":{"content":"type\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":416,"endIndex":424,"content":[{"startIndex":417,"endIndex":424,"paragraph":{"elements":[{"startIndex":417,"endIndex":424,"textRun":{"content":"figure\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":424,"endIndex":438,"tableCells":[{"startIndex":425,"endIndex":434,"content":[{"startIndex":426,"endIndex":434,"paragraph":{"elements":[{"startIndex":426,"endIndex":434,"textRun":{"content":"content\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":434,"endIndex":438,"content":[{"startIndex":435,"endIndex":436,"paragraph":{"elements":[{"startIndex":435,"endIndex":436,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}},{"startIndex":436,"endIndex":438,"paragraph":{"elements":[{"startIndex":436,"endIndex":437,"inlineObjectElement":{"inlineObjectId":"kix.w9nis1qyooyy","textStyle":{}}},{"startIndex":437,"endIndex":438,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":438,"endIndex":806,"tableCells":[{"startIndex":439,"endIndex":448,"content":[{"startIndex":440,"endIndex":448,"paragraph":{"elements":[{"startIndex":440,"endIndex":448,"textRun":{"content":"caption\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":448,"endIndex":806,"content":[{"startIndex":449,"endIndex":806,"paragraph":{"elements":[{"startIndex":449,"endIndex":806,"textRun":{"content":"With increasing capabilities we also see increasing risks. Depending on the development trajectory and takeoff we might see longer periods with potential catastrophic risks, or suddenly emerging severe existential risks. The curves and colors in this diagram are meant to be illustrative and do not represent any specific forecasted development trajectory.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":80,"unit":"PT"}}]}}},{"startIndex":807,"endIndex":1379,"paragraph":{"elements":[{"startIndex":807,"endIndex":923,"textRun":{"content":"Dangerous capabilities are specific examples of how the trends we explored in the previous chapter lead to concerns.","textStyle":{"bold":true}}},{"startIndex":923,"endIndex":1379,"textRun":{"content":" The same scaling laws that improve performance on coding, better text generation and so on, also might enable things like deception, manipulation, situational awareness, autonomous replication, and goal-directedness. An AI system that can write better code might also write code to replicate itself. One that understands human preferences might also learn to manipulate them. The capabilities driving AI progress inherently create new categories of risk.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","spaceAbove":{"magnitude":12,"unit":"PT"},"spaceBelow":{"magnitude":12,"unit":"PT"}}}},{"startIndex":1379,"endIndex":2160,"paragraph":{"elements":[{"startIndex":1379,"endIndex":1484,"textRun":{"content":"Risks can be understood along two dimensions: what causes the risks? And how severe are the risks caused?","textStyle":{"bold":true}}},{"startIndex":1484,"endIndex":2160,"textRun":{"content":" In the causal decomposition, we distinguish between misuse (humans using AI for harm), misalignment (AI systems pursuing wrong goals), and systemic risks (emergent effects from AI integration into other systems). Severity ranges from individual harms affecting specific people to existential threats that could permanently derail human civilization. This section basically helps you set up and categorize any of the risks that we talk about through this chapter, and others that might arise in the future. The risks are not cleanly separable; the majority of risks mostly occur as a combination of factors, but thinking about these categories helps for explanatory purposes.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","spaceAbove":{"magnitude":12,"unit":"PT"},"spaceBelow":{"magnitude":12,"unit":"PT"}}}},{"startIndex":2160,"endIndex":2741,"paragraph":{"elements":[{"startIndex":2160,"endIndex":2243,"textRun":{"content":"Misuse risks show what happens when humans use AI capabilities for deliberate harm.","textStyle":{"bold":true}}},{"startIndex":2243,"endIndex":2741,"textRun":{"content":" We look at biological weapons development where AI could help design novel pathogens, cyber capabilities that could automate attacks on critical infrastructure, autonomous weapons that remove human oversight from lethal decisions, and adversarial attacks that exploit AI system vulnerabilities. The common thread is that AI removes previous bottlenecks - a single motivated actor with AI assistance could potentially accomplish what previously required teams of experts and significant resources.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","spaceAbove":{"magnitude":12,"unit":"PT"},"spaceBelow":{"magnitude":12,"unit":"PT"}}}},{"startIndex":2741,"endIndex":3375,"paragraph":{"elements":[{"startIndex":2741,"endIndex":2840,"textRun":{"content":"Misalignment risks occur when AI systems pursue goals that conflict with what we actually intended.","textStyle":{"bold":true}}},{"startIndex":2840,"endIndex":3375,"textRun":{"content":" Specification gaming happens when systems find unexpected ways to maximize their objective function that technically satisfy our instructions but violate our intentions. Treacherous turns involve systems that appear aligned during training but reveal different priorities once deployed with sufficient capability. Self-improvement scenarios could lead to rapid capability jumps that outpace our ability to understand or control these systems. These aren't science fiction scenarios - we already see early examples in current systems.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","spaceAbove":{"magnitude":12,"unit":"PT"},"spaceBelow":{"magnitude":12,"unit":"PT"}}}},{"startIndex":3375,"endIndex":4075,"paragraph":{"elements":[{"startIndex":3375,"endIndex":3472,"textRun":{"content":"Systemic risks emerge from how AI integrates into larger social, economic, and political systems.","textStyle":{"bold":true}}},{"startIndex":3472,"endIndex":4075,"textRun":{"content":" Power concentration occurs as AI capabilities become controlled by fewer actors. Mass unemployment could result from automation eliminating human economic relevance. Epistemic erosion happens as AI-generated content makes it increasingly difficult to distinguish truth from fiction. Enfeeblement develops as humans become dependent on AI for cognitive tasks we used to perform ourselves. Value lock-in risks freezing current moral and political perspectives before humanity has time to evolve them. These risks don't require any single AI system to behave badly - they emerge from collective dynamics.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","spaceAbove":{"magnitude":12,"unit":"PT"},"spaceBelow":{"magnitude":12,"unit":"PT"}}}},{"startIndex":4075,"endIndex":4631,"paragraph":{"elements":[{"startIndex":4075,"endIndex":4147,"textRun":{"content":"Risk amplifiers make every category of risk more likely and more severe.","textStyle":{"bold":true}}},{"startIndex":4147,"endIndex":4631,"textRun":{"content":" Race dynamics create pressure to deploy systems before adequate safety testing. Accidents happen even with good intentions when complex systems interact in unexpected ways. Corporate indifference leads companies to accept known risks when profits are at stake. Coordination failures prevent collective action even when everyone agrees on the problem. Unpredictability means capabilities often emerge faster than experts expect, leaving safety measures consistently behind the curve.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","spaceAbove":{"magnitude":12,"unit":"PT"},"spaceBelow":{"magnitude":12,"unit":"PT"}}}},{"startIndex":4631,"endIndex":5108,"paragraph":{"elements":[{"startIndex":4631,"endIndex":4691,"textRun":{"content":"These categories overlap and amplify each other in practice.","textStyle":{"bold":true}}},{"startIndex":4691,"endIndex":5108,"textRun":{"content":" Misuse can enable misalignment by corrupting training processes. Systemic pressures can worsen misalignment by incentivizing rushed deployment. Risk amplifiers affect all categories simultaneously. Most real-world AI risks will involve combinations of these factors rather than clean examples of any single category. Understanding the connections helps explain why isolated safety measures often prove insufficient.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","spaceAbove":{"magnitude":12,"unit":"PT"},"spaceBelow":{"magnitude":12,"unit":"PT"}}}},{"startIndex":5108,"endIndex":5329,"paragraph":{"elements":[{"startIndex":5108,"endIndex":5329,"textRun":{"content":"The following chapters examine the technical strategies, governance approaches, and evaluation methods needed to address this interconnected risk landscape while preserving AI's extraordinary potential for human benefit.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","spaceAbove":{"magnitude":12,"unit":"PT"},"spaceBelow":{"magnitude":12,"unit":"PT"}}}},{"startIndex":5329,"endIndex":5330,"paragraph":{"elements":[{"startIndex":5329,"endIndex":5330,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":5330,"endIndex":5331,"paragraph":{"elements":[{"startIndex":5330,"endIndex":5331,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":5331,"endIndex":5332,"paragraph":{"elements":[{"startIndex":5331,"endIndex":5332,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":5332,"endIndex":5333,"paragraph":{"elements":[{"startIndex":5332,"endIndex":5333,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":5333,"endIndex":5334,"paragraph":{"elements":[{"startIndex":5333,"endIndex":5334,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":5334,"endIndex":5336,"paragraph":{"elements":[{"startIndex":5334,"endIndex":5335,"pageBreak":{"textStyle":{}}},{"startIndex":5335,"endIndex":5336,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":5336,"endIndex":5355,"paragraph":{"elements":[{"startIndex":5336,"endIndex":5355,"textRun":{"content":"Risk Decomposition\n","textStyle":{}}}],"paragraphStyle":{"headingId":"h.fw8t7pr0340n","namedStyleType":"HEADING_1","direction":"LEFT_TO_RIGHT"}}},{"startIndex":5355,"endIndex":5356,"paragraph":{"elements":[{"startIndex":5355,"endIndex":5356,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":5356,"endIndex":5576,"table":{"rows":2,"columns":2,"tableRows":[{"startIndex":5357,"endIndex":5385,"tableCells":[{"startIndex":5358,"endIndex":5364,"content":[{"startIndex":5359,"endIndex":5364,"paragraph":{"elements":[{"startIndex":5359,"endIndex":5364,"textRun":{"content":"type\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}}}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":5364,"endIndex":5385,"content":[{"startIndex":5365,"endIndex":5385,"paragraph":{"elements":[{"startIndex":5365,"endIndex":5385,"textRun":{"content":"section-description\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}}}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":5385,"endIndex":5575,"tableCells":[{"startIndex":5386,"endIndex":5395,"content":[{"startIndex":5387,"endIndex":5395,"paragraph":{"elements":[{"startIndex":5387,"endIndex":5395,"textRun":{"content":"content\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}}}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":5395,"endIndex":5575,"content":[{"startIndex":5396,"endIndex":5575,"paragraph":{"elements":[{"startIndex":5396,"endIndex":5575,"textRun":{"content":"AI risks can be categorized by their primary causes—misuse, misalignment, and systemic factors—and their potential severity, ranging from individual harms to existential threats.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":80,"unit":"PT"}}]}}},{"startIndex":5576,"endIndex":5577,"paragraph":{"elements":[{"startIndex":5576,"endIndex":5577,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"headingId":"h.96p0m11i58an","namedStyleType":"HEADING_1","lineSpacing":120.00001,"direction":"LEFT_TO_RIGHT","keepLinesTogether":false,"keepWithNext":false}}},{"startIndex":5577,"endIndex":6296,"paragraph":{"elements":[{"startIndex":5577,"endIndex":5813,"textRun":{"content":"Before we begin talking about concrete risk scenarios, we need a framework that allows us to evaluate where along the risk spectrum they lie. Risk classification is inherently multi-dimensional; there is no single \"best\" categorization.","textStyle":{}}},{"startIndex":5813,"endIndex":5814,"textRun":{"content":" ","textStyle":{}}},{"startIndex":5814,"endIndex":6139,"textRun":{"content":"We have chosen to break risks down into two factors: \"why risks occur\" (cause) and “how bad can the risks get” (severity). Other complementary frameworks, like MIT's risk taxonomy approaches, like \"who causes them\" (humans vs. AI systems), \"when they emerge\" (development vs. deployment), or \"whether outcomes are intended\" (","textStyle":{}}},{"startIndex":6139,"endIndex":6160,"textRun":{"content":"Slattery et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2408.12622"}}}},{"startIndex":6160,"endIndex":6296,"textRun":{"content":"). Our decomposition approach is just one out of many possible outlooks, but the risks we will talk about tend to be common throughout.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":6296,"endIndex":6297,"paragraph":{"elements":[{"startIndex":6296,"endIndex":6297,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":6297,"endIndex":6312,"paragraph":{"elements":[{"startIndex":6297,"endIndex":6312,"textRun":{"content":"Causes of Risk\n","textStyle":{}}}],"paragraphStyle":{"headingId":"h.8718qkw2fh5w","namedStyleType":"HEADING_2","direction":"LEFT_TO_RIGHT"}}},{"startIndex":6312,"endIndex":6313,"paragraph":{"elements":[{"startIndex":6312,"endIndex":6313,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":6313,"endIndex":6704,"paragraph":{"elements":[{"startIndex":6313,"endIndex":6395,"textRun":{"content":"We categorize AI risks by causal responsibility to understand intervention points.","textStyle":{"bold":true}}},{"startIndex":6395,"endIndex":6703,"textRun":{"content":" We divide risks based on who or what bears primary responsibility: humans using AI as a tool (misuse), AI systems themselves behaving unexpectedly (misalignment), or emergent effects from complex system interactions (systemic). This causal outlook helps identify where interventions might be most effective.","textStyle":{}}},{"startIndex":6703,"endIndex":6704,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":6704,"endIndex":6705,"paragraph":{"elements":[{"startIndex":6704,"endIndex":6705,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":6705,"endIndex":7169,"paragraph":{"elements":[{"startIndex":6705,"endIndex":6782,"textRun":{"content":"Misuse risks occur when humans intentionally deploy AI systems to cause harm.","textStyle":{"bold":true}}},{"startIndex":6782,"endIndex":7169,"textRun":{"content":" These include malicious actors, nation states, corporations, or individuals who leverage AI capabilities to accelerate existing threats or create new ones. The AI system may function exactly as designed, but human intent creates the risk. Examples range from using AI to generate malware or bioweapons to deploying autonomous weapons or conducting large-scale disinformation campaigns.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.wbmfi6q7wkaq","textStyle":{}}}},{"startIndex":7169,"endIndex":7642,"paragraph":{"elements":[{"startIndex":7169,"endIndex":7256,"textRun":{"content":"Misalignment risks emerge when AI systems pursue goals different from human intentions.","textStyle":{"bold":true}}},{"startIndex":7256,"endIndex":7642,"textRun":{"content":" These risks stem from technical challenges in specifying objectives, training processes that create unexpected behaviors, or AI systems' learning goals that conflict with human values. Unlike misuse, these risks occur despite good human intentions - the AI system itself generates the harmful behavior through specification gaming, goal misgeneralization, or other alignment failures.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.wbmfi6q7wkaq","textStyle":{}}}},{"startIndex":7642,"endIndex":8128,"paragraph":{"elements":[{"startIndex":7642,"endIndex":7768,"textRun":{"content":"Systemic risks arise from AI integration with complex global systems, creating emergent threats that no single actor intended.","textStyle":{"bold":true}}},{"startIndex":7768,"endIndex":8128,"textRun":{"content":" These include power concentration as AI capabilities become monopolized, mass unemployment from automation, epistemic erosion as AI-generated content floods information systems, and cascading failures across interconnected infrastructure. Responsibility becomes diffuse across many actors and systems, making traditional accountability frameworks inadequate.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.wbmfi6q7wkaq","textStyle":{}}}},{"startIndex":8128,"endIndex":8129,"paragraph":{"elements":[{"startIndex":8128,"endIndex":8129,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":8129,"endIndex":8848,"paragraph":{"elements":[{"startIndex":8129,"endIndex":8227,"textRun":{"content":"Many real-world AI risks combine multiple causal pathways or resist clear categorization entirely.","textStyle":{"bold":true}}},{"startIndex":8227,"endIndex":8333,"textRun":{"content":" Analysis of over 1,600 documented AI risks reveals that many don't fit cleanly into any single category (","textStyle":{}}},{"startIndex":8333,"endIndex":8354,"textRun":{"content":"Slattery et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2408.12622"}}}},{"startIndex":8354,"endIndex":8848,"textRun":{"content":"). Risks involving human-AI interaction blend individual misalignment with systemic risks. Multi-agent risks emerge from AI systems interacting in unexpected ways. Some scenarios involve cascading effects where misuse enables misalignment, or where systemic pressures amplify individual failures. We have chosen the causal decomposition for explanatory purposes, but it is worth keeping in mind that there will be overlap, and the future will likely contain a mix of risks from various causes.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":8848,"endIndex":8849,"paragraph":{"elements":[{"startIndex":8848,"endIndex":8849,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":8849,"endIndex":8866,"paragraph":{"elements":[{"startIndex":8849,"endIndex":8866,"textRun":{"content":"Severity of Risk\n","textStyle":{}}}],"paragraphStyle":{"headingId":"h.h0a6kun3ej4f","namedStyleType":"HEADING_2","direction":"LEFT_TO_RIGHT"}}},{"startIndex":8866,"endIndex":8867,"paragraph":{"elements":[{"startIndex":8866,"endIndex":8867,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":8867,"endIndex":9267,"paragraph":{"elements":[{"startIndex":8867,"endIndex":8974,"textRun":{"content":"AI risks span a spectrum from individual harms to threats that could permanently derail human civilization.","textStyle":{"bold":true}}},{"startIndex":8974,"endIndex":9267,"textRun":{"content":" Understanding severity helps prioritize limited resources and calibrate our response to different types of risks. Rather than treating all AI risks as equally important, we can organize them by scope and severity to understand which demand immediate attention versus longer-term preparation.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":9267,"endIndex":9268,"paragraph":{"elements":[{"startIndex":9267,"endIndex":9268,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":9268,"endIndex":10022,"paragraph":{"elements":[{"startIndex":9268,"endIndex":9363,"textRun":{"content":"Individual and local risks affect specific people or communities but remain contained in scope.","textStyle":{"bold":true}}},{"startIndex":9363,"endIndex":9483,"textRun":{"content":" The AI Incident Database documents over 1,000 real-world instances where AI systems have caused or nearly caused harm (","textStyle":{}}},{"startIndex":9483,"endIndex":9497,"textRun":{"content":"McGregor, 2020","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2011.08512"}}}},{"startIndex":9497,"endIndex":9499,"textRun":{"content":"; ","textStyle":{}}},{"startIndex":9499,"endIndex":9525,"textRun":{"content":"AI Incident Database, 2025","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://incidentdatabase.ai/"}}}},{"startIndex":9525,"endIndex":10021,"textRun":{"content":"). These include things like autonomous car crashes, algorithmic bias in hiring or lending that disadvantages particular individuals, privacy violations from AI systems that leak personal data, or manipulation through targeted misinformation campaigns. Local risks might involve AI system failures that disrupt a city's traffic management or cause power outages in a region. These risks are already causing immediate, documented harm to anywhere from thousands to hundreds of thousands of people.","textStyle":{}}},{"startIndex":10021,"endIndex":10022,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":10022,"endIndex":10023,"paragraph":{"elements":[{"startIndex":10022,"endIndex":10023,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":10023,"endIndex":10439,"table":{"rows":4,"columns":2,"tableRows":[{"startIndex":10024,"endIndex":10039,"tableCells":[{"startIndex":10025,"endIndex":10031,"content":[{"startIndex":10026,"endIndex":10031,"paragraph":{"elements":[{"startIndex":10026,"endIndex":10031,"textRun":{"content":"type\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNe