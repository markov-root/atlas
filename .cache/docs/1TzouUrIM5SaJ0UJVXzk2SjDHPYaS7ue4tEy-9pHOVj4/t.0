PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":163981,"endIndex":164210,"content":[{"startIndex":163982,"endIndex":164210,"paragraph":{"elements":[{"startIndex":163982,"endIndex":164195,"textRun":{"content":"2021 forecast on the MATH dataset. The majority of the probability density of the forecast was between 5 percent to 20 percent by June 2022. The actual recorded performance was 50 percent (shown as the red line) (","textStyle":{}}},{"startIndex":164195,"endIndex":164206,"textRun":{"content":"Cotra, 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.planned-obsolescence.org/language-models-surprised-us/"}}}},{"startIndex":164206,"endIndex":164210,"textRun":{"content":").\u000b\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":80,"unit":"PT"}}]}}},{"startIndex":164211,"endIndex":164212,"paragraph":{"elements":[{"startIndex":164211,"endIndex":164212,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":164212,"endIndex":164666,"paragraph":{"elements":[{"startIndex":164212,"endIndex":164331,"textRun":{"content":"During 2022-2024, experts continued underestimating qualitative capabilities even after witnessing benchmark surprises.","textStyle":{"bold":true}}},{"startIndex":164331,"endIndex":164652,"textRun":{"content":" AI Impacts surveyed ML experts in mid-2022, just months before ChatGPT's release. Experts predicted milestones like \"write a high school history essay\" or \"answer easily Googleable questions better than an expert\" would take years to achieve. ChatGPT and GPT-4 accomplished these within months of the survey, not years (","textStyle":{}}},{"startIndex":164652,"endIndex":164663,"textRun":{"content":"Cotra, 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.planned-obsolescence.org/language-models-surprised-us/"}}}},{"startIndex":164663,"endIndex":164666,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","spaceAbove":{"magnitude":12,"unit":"PT"},"spaceBelow":{"magnitude":12,"unit":"PT"}}}},{"startIndex":164666,"endIndex":164667,"paragraph":{"elements":[{"startIndex":164666,"endIndex":164667,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","spaceAbove":{"magnitude":12,"unit":"PT"},"spaceBelow":{"magnitude":12,"unit":"PT"}}}},{"startIndex":164667,"endIndex":164668,"paragraph":{"elements":[{"startIndex":164667,"endIndex":164668,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","spaceAbove":{"magnitude":12,"unit":"PT"},"spaceBelow":{"magnitude":12,"unit":"PT"}}}},{"startIndex":164668,"endIndex":165418,"paragraph":{"elements":[{"startIndex":164668,"endIndex":164740,"textRun":{"content":"Examples in 2024-2025 seem to continue this pattern of unpredictability.","textStyle":{"bold":true}}},{"startIndex":164740,"endIndex":164899,"textRun":{"content":" In December 2024, OpenAI's o3 achieved 87.5% on ARC-AGI, a benchmark specifically designed to test abstract reasoning and resist gaming through memorization (","textStyle":{}}},{"startIndex":164899,"endIndex":164919,"textRun":{"content":"Chollet et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2412.04604"}}}},{"startIndex":164919,"endIndex":165238,"textRun":{"content":"). For four years, progress had crawled from GPT-3's 0% in 2020 to GPT-4o's 5% in 2024, leading many to expect meaningful progress would take years. The rapid jump from 5% to 87.5% caught many by surprise. Similarly, on Frontier Math—a benchmark of research-level problems described by world-leading mathematicians as “","textStyle":{}}},{"startIndex":165238,"endIndex":165289,"textRun":{"content":"our best guesses for challenges that would stump AI","textStyle":{"italic":true}}},{"startIndex":165289,"endIndex":165401,"textRun":{"content":"”— OpenAI o3 jumped from the previous best of 2% to 25% within months of the benchmark's November 2024 release (","textStyle":{}}},{"startIndex":165401,"endIndex":165415,"textRun":{"content":"Epoch AI, 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://epoch.ai/frontiermath"}}}},{"startIndex":165415,"endIndex":165418,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","spaceAbove":{"magnitude":12,"unit":"PT"},"spaceBelow":{"magnitude":12,"unit":"PT"}}}},{"startIndex":165418,"endIndex":166318,"paragraph":{"elements":[{"startIndex":165418,"endIndex":165464,"textRun":{"content":"Unpredictability amplifies all other AI risks.","textStyle":{"bold":true}}},{"startIndex":165464,"endIndex":165788,"textRun":{"content":" Systematic underestimation of breakthrough timing leaves safety researchers perpetually playing catch-up when the stakes are highest. Douglas Hofstadter, who once expected hundreds of years before human-like AI, now describes \"a certain kind of terror of an oncoming tsunami that is going to catch all humanity off guard\" (","textStyle":{}}},{"startIndex":165788,"endIndex":165804,"textRun":{"content":"Hofstadter, 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.youtube.com/watch?v=lfXxzAVtdpU&t=1763s&ref=planned-obsolescence.org"}}}},{"startIndex":165804,"endIndex":166318,"textRun":{"content":"). When even leading researchers consistently underestimate progress in their own field, society's broader preparation becomes fundamentally miscalibrated. Organizations make deployment decisions based on forecasts that consistently underestimate near-term progress, while governance systems assume gradual, predictable advancement. This creates a persistent gap between when dangerous capabilities emerge and when adequate safety measures are ready—turning unpredictability itself into a systemic risk amplifier.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","spaceAbove":{"magnitude":12,"unit":"PT"},"spaceBelow":{"magnitude":12,"unit":"PT"}}}},{"startIndex":166318,"endIndex":167090,"table":{"rows":6,"columns":2,"tableRows":[{"startIndex":166319,"endIndex":166333,"tableCells":[{"startIndex":166320,"endIndex":166326,"content":[{"startIndex":166321,"endIndex":166326,"paragraph":{"elements":[{"startIndex":166321,"endIndex":166326,"textRun":{"content":"type\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":166326,"endIndex":166333,"content":[{"startIndex":166327,"endIndex":166333,"paragraph":{"elements":[{"startIndex":166327,"endIndex":166333,"textRun":{"content":"quote\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashS