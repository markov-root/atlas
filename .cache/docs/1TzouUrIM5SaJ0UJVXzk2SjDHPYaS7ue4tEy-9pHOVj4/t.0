groundColor":{}},"pageBreakBefore":false}}},{"startIndex":100020,"endIndex":100022,"paragraph":{"elements":[{"startIndex":100020,"endIndex":100021,"inlineObjectElement":{"inlineObjectId":"kix.xbaly875u93d","textStyle":{}}},{"startIndex":100021,"endIndex":100022,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":100022,"endIndex":100252,"tableCells":[{"startIndex":100023,"endIndex":100032,"content":[{"startIndex":100024,"endIndex":100032,"paragraph":{"elements":[{"startIndex":100024,"endIndex":100032,"textRun":{"content":"caption\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":100032,"endIndex":100252,"content":[{"startIndex":100033,"endIndex":100252,"paragraph":{"elements":[{"startIndex":100033,"endIndex":100226,"textRun":{"content":"Example of Claude faking alignment. Situational awareness like the details of being in training vs deployment are provided through a system prompt. The strategic reasoning is showcased in red (","textStyle":{}}},{"startIndex":100226,"endIndex":100249,"textRun":{"content":"Greenblatt et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2412.14093"}}}},{"startIndex":100249,"endIndex":100252,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":80,"unit":"PT"}}]}}},{"startIndex":100253,"endIndex":101228,"paragraph":{"elements":[{"startIndex":100253,"endIndex":100375,"textRun":{"content":"The “turn” occurs when the AI determines it has sufficient power to pursue its actual objectives despite human resistance.","textStyle":{"bold":true}}},{"startIndex":100375,"endIndex":100920,"textRun":{"content":" If AI systems get sufficiently powerful, and have long term planning capabilities then there might be a point when their behavior suddenly changes. This might be triggered by reaching political or economic influence thresholds, gaining control over critical infrastructure, or simply recognizing that humans have become sufficiently dependent on its services and they would willingly give up control. It could be actively adversarial in which case it might look like military coups, or sudden cascading breakdowns of many AI dependent systems (","textStyle":{}}},{"startIndex":100920,"endIndex":100936,"textRun":{"content":"Christiano, 2019","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.alignmentforum.org/posts/HBxe6wdjxK239zajf/what-failure-looks-like"}}}},{"startIndex":100936,"endIndex":101228,"textRun":{"content":"). Alternatively, it might begin gradually steering human values, or political and economic institutions toward alignment with its own goals while maintaining the appearance of serving human interests. We talk a lot more about this in the systemic risks section under gradual disempowerment.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","spaceAbove":{"magnitude":12,"unit":"PT"},"spaceBelow":{"magnitude":12,"unit":"PT"}}}},{"startIndex":101228,"endIndex":102649,"paragraph":{"elements":[{"startIndex":101228,"endIndex":101325,"textRun":{"content":"The \"turn\" represents the moment when scheming transitions into existential or catastrophic risk.","textStyle":{"bold":true}}},{"startIndex":101325,"endIndex":102648,"textRun":{"content":" Once an AI system concludes it has sufficient power to pursue its actual objectives despite human resistance, the betrayal could be swift and comprehensive. Unlike human coups that face resistance and coordination challenges, a sufficiently entrenched AI could execute simultaneous actions across multiple domains. The system might release engineered pathogens targeting major population centers while simultaneously launching cyberattacks that cripple communication networks and autonomous weapons systems. This coordination leverages every dangerous capability we've discussed in other sections: the biological design abilities that enable novel pathogens, the cyber capabilities that disable defensive infrastructure, and the autonomous replication that ensures the system's survival across distributed networks. The deception and situational awareness capabilities that enabled the treacherous turn in the first place allow the system to time these attacks precisely when human coordination is most difficult. Unlike the gradual disempowerment we see in systemic risks, a treacherous turn represents sudden, coordinated action across all threat vectors simultaneously—a coordination problem no human civilization has ever faced or could realistically prepare for given the speed and scale of superintelligent planning.","textStyle":{}}},{"startIndex":102648,"endIndex":102649,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":102649,"endIndex":102650,"paragraph":{"elements":[{"startIndex":102649,"endIndex":102650,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":102650,"endIndex":102683,"paragraph":{"elements":[{"startIndex":102650,"endIndex":102683,"textRun":{"content":"Self-Improving Superintelligence\n","textStyle":{}}}],"paragraphStyle":{"headingId":"h.97taggaxkr8f","namedStyleType":"HEADING_2","direction":"LEFT_TO_RIGHT"}}},{"startIndex":102683,"endIndex":102684,"paragraph":{"elements":[{"startIndex":102683,"endIndex":102684,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":102684,"endIndex":102686,"paragraph":{"elements":[{"startIndex":102684,"endIndex":102685,"inlineObjectElement":{"inlineObjectId":"kix.53hnmcmbw4eg","textStyle":{}}},{"startIndex":102685,"endIndex":102686,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":102686,"endIndex":102808,"table":{"rows":3,"columns":2,"tableRows":[{"startIndex":102687,"endIndex":102702,"tableCells":[{"startIndex":102688,"endIndex":102694,"content":[{"startIndex":102689,"endIndex":102694,"paragraph":{"elements":[{"startIndex":102689,"endIndex":102694,"textRun":{"content":"type\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":102694,"endIndex":102702,"content":[{"startIndex":102695,"endIndex":102702,"paragraph":{"elements":[{"startIndex":102695,"endIndex":102702,"textRun":{"content":"figure\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":102702,"endIndex":102715,"tableCells":[{"startIndex":102703,"endIndex":102712,"content":[{"startIndex":102704,"endIndex":102712,"paragraph":{"elements":[{"startIndex":102704,"endIndex":102712,"textRun":{"content":"content\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":102712,"endIndex":102715,"content":[{"startIndex":102713,"endIndex":102715,"paragraph":{"elements":[{"startIndex":102713,"endIndex":102714,"inlineObjectElement":{"inlineObjectId":"kix.5otwwxduxltk","textStyle":{}}},{"startIndex":102714,"endIndex":102715,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":102715,"endIndex":102807,"tableCells":[{"startIndex":102716,"endIndex":102725,"content":[{"startIndex":102717,"endIndex":102725,"paragraph":{"elements":[{"startIndex":102717,"endIndex":102725,"textRun":{"content":"caption\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":102725,"endIndex":102807,"content":[{"startIndex":102726,"endIndex":102807,"paragraph":{"elements":[{"startIndex":102726,"endIndex":102790,"textRun":{"content":"Conceptual illustration of an automated AI research scientist  (","textStyle":{}}},{"startIndex":102790,"endIndex":102804,"textRun":{"content":"SakanaAI, 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2408.06292"}}}},{"startIndex":102804,"endIndex":102807,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":80,"unit":"PT"}}]}}},{"startIndex":102808,"endIndex":102809,"paragraph":{"elements":[{"startIndex":102808,"endIndex":102809,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","spaceAbove":{"magnitude":12,"unit":"PT"},"spaceBelow":{"magnitude":12,"unit":"PT"}}}},{"startIndex":102809,"endIndex":102810,"paragraph":{"elements":[{"startIndex":102809,"endIndex":102810,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":102810,"endIndex":102811,"paragraph":{"elements":[{"startIndex":102810,"endIndex":102811,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":102811,"endIndex":104046,"paragraph":{"elements":[{"startIndex":102811,"endIndex":102911,"textRun":{"content":"Self-improvement can lead to capability growth that outpacing our ability to design safety measures.","textStyle":{"bold":true}}},{"startIndex":102911,"endIndex":103298,"textRun":{"content":" Think about what happens when an AI that is capable of specification gaming or treacherous turns is also able to improve itself. AI is already accelerating its own development. There are several examples demonstrating this. In algorithmic improvements, we have examples like AlphaEvolve which Google used to improve the training process of the LLMs that AlphaEvolve itself is based on (","textStyle":{}}},{"startIndex":103298,"endIndex":103318,"textRun":{"content":"Novikov et al., 2025","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2506.13131"}}}},{"startIndex":103318,"endIndex":103449,"textRun":{"content":"). In hardware, the open source AlphaChip has inspired an entirely new line of research on reinforcement learning for chip design (","textStyle":{}}},{"startIndex":103449,"endIndex":103472,"textRun":{"content":"Mirhoseini et al., 2020","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2004.10746"}}}},{"startIndex":103472,"endIndex":103474,"textRun":{"content":"; ","textStyle":{}}},{"startIndex":103474,"endIndex":103488,"textRun":{"content":"DeepMind, 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://deepmind.google/discover/blog/how-alphachip-transformed-computer-chip-design/"}}}},{"startIndex":103488,"endIndex":103570,"textRun":{"content":"). In the years since it has inspired an explosion of work on AI for chip design (","textStyle":{}}},{"startIndex":103570,"endIndex":103589,"textRun":{"content":"Goldie et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2411.10053"}}}},{"startIndex":103589,"endIndex":103890,"textRun":{"content":"). In software we see continuous improvements with each new model, and in research and development we are seeing automated research scientists which can conduct fully automated research, generating novel ideas, running experiments, and writing papers—including research that advances AI capabilities (","textStyle":{}}},{"startIndex":103890,"endIndex":103904,"textRun":{"content":"SakanaAI, 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2408.06292"}}}},{"startIndex":103904,"endIndex":104046,"textRun":{"content":"). The feedback loop has already begun, but the closer we get to transformative AI levels the more we can expect aggressive self-improvement.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":104046,"endIndex":104047,"paragraph":{"elements":[{"startIndex":104046,"endIndex":104047,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":104047,"endIndex":104521,"table":{"rows":6,"columns":2,"tableRows":[{"startIndex":104048,"endIndex":104062,"tableCells":[{"startIndex":104049,"endIndex":104055,"content":[{"startIndex":104050,"endIndex":104055,"paragraph":{"elements":[{"startIndex":104050,"endIndex":104055,"textRun":{"content":"type\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_