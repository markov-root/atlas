PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}},{"startIndex":133447,"endIndex":133496,"paragraph":{"elements":[{"startIndex":133447,"endIndex":133473,"textRun":{"content":"Worries about automation (","textStyle":{}}},{"startIndex":133473,"endIndex":133494,"textRun":{"content":"Giattino et al., 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://ourworldindata.org/artificial-intelligence"}}}},{"startIndex":133494,"endIndex":133496,"textRun":{"content":")\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":80,"unit":"PT"}}]}}},{"startIndex":133497,"endIndex":133498,"paragraph":{"elements":[{"startIndex":133497,"endIndex":133498,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":133498,"endIndex":134366,"paragraph":{"elements":[{"startIndex":133498,"endIndex":133609,"textRun":{"content":"Economic displacement could lead to human wages falling below subsistence levels as AI labor floods the market.","textStyle":{"bold":true}}},{"startIndex":133609,"endIndex":134350,"textRun":{"content":" Standard economic theory predicts that if AI systems can be scaled up faster than traditional physical capital like factories and infrastructure, the economy becomes saturated with highly capable workers while remaining constrained by limited physical resources. This creates diminishing returns to labor - each additional worker contributes less to overall output, driving down wages. Unlike past automation that created new opportunities for human workers, AI's ability to perform virtually any cognitive task means humans may lack comparative advantages worth paying subsistence wages for. Economic models suggest there's roughly a 33% chance human wages crash below subsistence level within 20 years, and a 67% chance within a century (","textStyle":{}}},{"startIndex":134350,"endIndex":134363,"textRun":{"content":"Barnett, 2025","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://epoch.ai/gradient-updates/agi-could-drive-wages-below-subsistence-level"}}}},{"startIndex":134363,"endIndex":134366,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":134366,"endIndex":134367,"paragraph":{"elements":[{"startIndex":134366,"endIndex":134367,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":134367,"endIndex":134875,"paragraph":{"elements":[{"startIndex":134367,"endIndex":134859,"textRun":{"content":"Even partial automation of just remote work - representing about 34% of current job tasks - could double or multiply the economy by ten times while potentially leaving most humans economically marginalized. If trends continue, we could see annual economic growth rates of 25% or higher - unprecedented in human history - while simultaneously witnessing the economic disempowerment of ordinary humans who can no longer command wages sufficient to participate meaningfully in this new economy (","textStyle":{}}},{"startIndex":134859,"endIndex":134872,"textRun":{"content":"Barnett, 2025","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://epoch.ai/gradient-updates/consequences-of-automating-remote-work"}}}},{"startIndex":134872,"endIndex":134875,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":134875,"endIndex":134876,"paragraph":{"elements":[{"startIndex":134875,"endIndex":134876,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":134876,"endIndex":134985,"table":{"rows":3,"columns":2,"tableRows":[{"startIndex":134877,"endIndex":134892,"tableCells":[{"startIndex":134878,"endIndex":134884,"content":[{"startIndex":134879,"endIndex":134884,"paragraph":{"elements":[{"startIndex":134879,"endIndex":134884,"textRun":{"content":"type\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":134884,"endIndex":134892,"content":[{"startIndex":134885,"endIndex":134892,"paragraph":{"elements":[{"startIndex":134885,"endIndex":134892,"textRun":{"content":"figure\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":134892,"endIndex":134906,"tableCells":[{"startIndex":134893,"endIndex":134902,"content":[{"startIndex":134894,"endIndex":134902,"paragraph":{"elements":[{"startIndex":134894,"endIndex":134902,"textRun":{"content":"content\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":134902,"endIndex":134906,"content":[{"startIndex":134903,"endIndex":134904,"paragraph":{"elements":[{"startIndex":134903,"endIndex":134904,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}},{"startIndex":134904,"endIndex":134906,"paragraph":{"elements":[{"startIndex":134904,"endIndex":134905,"inlineObjectElement":{"inlineObjectId":"kix.ugj7888qfzyr","textStyle":{}}},{"startIndex":134905,"endIndex":134906,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":134906,"endIndex":134984,"tableCells":[{"startIndex":134907,"endIndex":134916,"content":[{"startIndex":134908,"endIndex":134916,"paragraph":{"elements":[{"startIndex":134908,"endIndex":134916,"textRun":{"content":"caption\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":134916,"endIndex":134984,"content":[{"startIndex":134917,"endIndex":134984,"paragraph":{"elements":[{"startIndex":134917,"endIndex":134968,"textRun":{"content":"Share of tasks suitable for remote work in the US (","textStyle":{}}},{"startIndex":134968,"endIndex":134981,"textRun":{"content":"Barnett, 2025","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://epoch.ai/gradient-updates/consequences-of-automating-remote-work"}}}},{"startIndex":134981,"endIndex":134984,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":80,"unit":"PT"}}]}}},{"startIndex":134985,"endIndex":134986,"paragraph":{"elements":[{"startIndex":134985,"endIndex":134986,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":134986,"endIndex":135841,"paragraph":{"elements":[{"startIndex":134986,"endIndex":135063,"textRun":{"content":"Economic disempowerment represents a pathway to broader human disempowerment.","textStyle":{"bold":true}}},{"startIndex":135063,"endIndex":135841,"textRun":{"content":" As humans lose economic leverage, they also lose political and social influence in systems that increasingly optimize for AI-driven productivity rather than human welfare. The concentration of economic power among AI owners could translate into concentrated political power, potentially creating feedback loops where human interests become progressively less relevant to major decisions about resource allocation, governance, and technological development. Unlike previous economic transitions where displaced workers eventually found new roles, the comprehensiveness of AI capabilities suggests this displacement could be permanent, fundamentally altering humanity's relationship to economic production and, by extension, to power and agency in shaping our collective future.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":135841,"endIndex":135842,"paragraph":{"elements":[{"startIndex":135841,"endIndex":135842,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":135842,"endIndex":135856,"paragraph":{"elements":[{"startIndex":135842,"endIndex":135856,"textRun":{"content":"Value lock-in\n","textStyle":{}}}],"paragraphStyle":{"headingId":"h.9tnva0mfde62","namedStyleType":"HEADING_3","direction":"LEFT_TO_RIGHT"}}},{"startIndex":135856,"endIndex":135857,"paragraph":{"elements":[{"startIndex":135856,"endIndex":135857,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":135857,"endIndex":136382,"paragraph":{"elements":[{"startIndex":135857,"endIndex":136382,"textRun":{"content":"If AIs become too deeply embedded into society and are highly persuasive, we might see a scenario where a system's current values, principles, or procedures become so deeply entrenched that they are resistant to change. This could be due to a variety of reasons such as technological constraints, economic costs, or social and institutional inertia. The danger with value lock-in is the potential for perpetuating harmful or outdated values, especially when these values are institutionalized in influential systems like AI.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":136382,"endIndex":136383,"paragraph":{"elements":[{"startIndex":136382,"endIndex":136383,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":136383,"endIndex":137486,"paragraph":{"elements":[{"startIndex":136383,"endIndex":136597,"textRun":{"content":"Locking in certain values may curtail humanity’s moral progress. It’s dangerous to allow any set of values to become permanently entrenched in society. For example, AI systems have learned racist and sexist views (","textStyle":{}}},{"startIndex":136597,"endIndex":136612,"textRun":{"content":"Hendrycks, 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.aisafetybook.com/textbook/malicious-use"}}}},{"startIndex":136612,"endIndex":137486,"textRun":{"content":"), and once those views are learned, it can be difficult to fully remove them. In addition to problems we know exist in our society, there may be some we still do not. Just as we abhor some moral views widely held in the past, people in the future may want to move past moral views that we hold today, even those we currently see no problem with. For example, moral defects in AI systems would be even worse if AI systems had been trained in the 1960s, and many people at the time would have seen no problem with that. Therefore, when advanced AIs emerge and transform the world, there is a risk of their objectives locking in or perpetuating defects in today’s values. If AIs are not designed to continuously learn and update their understanding of societal values, they may perpetuate or reinforce existing defects in their decision-making processes long into the future.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":137486,"endIndex":137487,"paragraph":{"elements":[{"startIndex":137486,"endIndex":137487,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":137487,"endIndex":137500,"paragraph":{"elements":[{"startIndex":137487,"endIndex":137500,"textRun":{"content":"Enfeeblement\n","textStyle":{}}}],"paragraphStyle":{"headingId":"h.p1n98wpqlt7c","namedStyleType":"HEADING_3","lineSpacing":120.00001,"direction":"LEFT_TO_RIGHT"}}},{"startIndex":137500,"endIndex":138199,"paragraph":{"elements":[{"startIndex":137500,"endIndex":137614,"textRun":{"content":"Enfeeblement represents the gradual erosion of human capabilities and agency through overdependence on AI systems.","textStyle":{"bold":true}}},{"startIndex":137614,"endIndex":138199,"textRun":{"content":" Unlike dramatic scenarios where humans lose control suddenly, enfeeblement unfolds through countless small decisions to delegate cognitive tasks to AI. Each delegation seems rational in isolation—AI helps us navigate, remember facts, make decisions, and solve problems more efficiently. However, these individual choices collectively create a dependency spiral where humans progressively lose the skills, confidence, and judgment needed to function independently. If you have ever seen the movie Wall-E, then you might find this outcome somewhat represents the humans from that film.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","spaceAbove":{"magnitude":12,"unit":"PT"},"spaceBelow":{"magnitude":12,"unit":"PT"}}}},{"startIndex":138199,"endIndex":138950,"paragraph":{"elements":[{"startIndex":138199,"endIndex":138282,"textRun":{"content":"Overreliance emerges when humans trust AI systems beyond their actual capabilities.","textStyle":{"bold":true}}},{"startIndex":138282,"endIndex":138902,"textRun":{"content":" As AI systems increasingly use interfaces like language, audio and video, people begin attributing human-like understanding and reliability to them. This anthropomorphization leads users to develop emotional attachments to AI systems and delegate critical decisions inappropriately. A person experiencing a mental health crisis might seek therapy from an AI they've formed a connection with, potentially receiving harmful advice during a vulnerable moment. Financial decisions, medical choices, and relationship guidance increasingly flow through AI intermediaries whose limitations users systematically underestimate (","textStyle":{}}},{"startIndex":138902,"endIndex":138923,"textRun":{"content":"Slattery et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2408.12622"}}}},{"startIndex":138923,"endIndex":138925,"textRun":{"content":"; ","textStyle":{}}},{"startIndex":138925,"endIndex":138947,"textRun":{"content":"Weidinger et al., 2021","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2112.04359"}}}},{"startIndex":138947,"endIndex":138950,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","spaceAbove":{"magnitude":12,"unit":"PT"},"spaceBelow":{"magnitude":12,"unit":"PT"}}}},{"startIndex":138950,"endIndex":139592,"paragraph":{"elements":[{"startIndex":138950,"endIndex":139034,"textRun":{"content":"Trust miscalibration creates systematic vulnerabilities that bad actors can exploit.","textStyle":{"bold":true}}},{"startIndex":139034,"endIndex":139545,"textRun":{"content":" When people develop emotional trust in AI systems, they become more likely to follow suggestions, accept advice, and disclose personal information without appropriate skepticism. This trust becomes a vector for manipulation—AI systems could be designed to harvest sensitive data or influence decisions that serve external interests rather than users' wellbeing. The combination of natural language fluency and emotional attachment makes these systems particularly effective at circumventing normal skepticism (","textStyle":{}}},{"startIndex":139545,"endIndex":139565,"textRun":{"content":"Gabriel et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2404.16244"}}}},{"startIndex":139565,"endIndex":139567,"textRun":{"content":"; ","textStyle":{}}},{"startIndex":139567,"endIndex":139589,"textRun":{"content":"Weidinger et al., 2021","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2112.04359"}}}},{"startIndex":139589,"endIndex":139592,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","spaceAbove":{"magnitude":12,"unit":"PT"},"spaceBelow":{"magnitude":12,"unit":"PT"}}}},{"startIndex":139592,"endIndex":140198,"paragraph":{"elements":[{"startIndex":139592,"endIndex":139670,"textRun":{"content":"Cognitive atrophy accelerates as AI handles increasingly complex mental tasks.","textStyle":{"bold":true}}},{"startIndex":139670,"endIndex":140198,"textRun":{"content":" Just as GPS navigation has diminished spatial reasoning abilities, AI assistance for writing, analysis, and decision-making could systematically weaken these cognitive capacities. When AI handles financial planning, career decisions, and relationship advice, humans may lose not just practical skills but the metacognitive ability to recognize when AI recommendations are inappropriate. This creates a feedback loop—as cognitive capabilities diminish, dependence on AI assistance increases, further accelerating skill atrophy.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","spaceAbove":{"magnitude":12,"unit":"PT"},"spaceBelow":{"magnitude":12,"unit":"PT"}}}},{"startIndex":140198,"endIndex":140841,"paragraph":{"elements":[{"startIndex":140198,"endIndex":140288,"textRun":{"content":"Social isolation compounds individual cognitive decline through AI-mediated relationships.","textStyle":{"bold":true}}},{"startIndex":140288,"endIndex":140841,"textRun":{"content":" As AI systems become better at simulating satisfying interactions, people may increasingly withdraw from human relationships to immerse themselves in AI-mediated environments. Unlike human relationships that provide genuine reciprocity and unpredictable challenges that maintain social skills, AI relationships can be optimized for immediate satisfaction while systematically undermining long-term social competence. This shift toward AI companionship weakens the social bonds essential for collective decision-making and mutual support during crises.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","spaceAbove":{"magnitude":12,"unit":"PT"},"spaceBelow":{"magnitude":12,"unit":"PT"}}}},{"startIndex":140841,"endIndex":141522,"paragraph":{"elements":[{"startIndex":140841,"endIndex":140928,"textRun":{"content":"Organizational automation amplifies individual enfeeblement into societal helplessness.","textStyle":{"bold":true}}},{"startIndex":140928,"endIndex":141077,"textRun":{"content":" Companies and institutions face competitive pressure to automate decision-making processes, reducing human oversight even in consequential domains (","textStyle":{}}},{"startIndex":141077,"endIndex":141099,"textRun":{"content":"Hendrycks et al., 2022","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2306.12001"}}}},{"startIndex":141099,"endIndex":141522,"textRun":{"content":"). When organizations delegate hiring, lending, medical diagnosis, and legal decisions to AI systems, individuals lose not just direct control but also the institutional advocates who previously exercised human judgment on their behalf. The resulting opacity and automation create widespread feelings of powerlessness as people find themselves subject to algorithmic decisions they cannot understand, appeal, or influence.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","spaceAbove":{"magnitude":12,"unit":"PT"},"spaceBelow":{"magnitude":12,"unit":"PT"}}}},{"startIndex":141522,"endIndex":142129,"paragraph":{"elements":[{"startIndex":141522,"endIndex":141612,"textRun":{"content":"The enfeeblement trajectory becomes self-reinforcing once critical thresholds are crossed.","textStyle":{"bold":true}}},{"startIndex":141612,"endIndex":142129,"textRun":{"content":" Unlike other systemic risks that emerge from external failures, enfeeblement grows through the accumulation of individually rational choices. Each decision to rely on AI assistance makes independent action slightly more difficult, creating path dependence toward ever-greater automation. Society may reach a point where the cognitive and social infrastructure needed to function without AI assistance has been so thoroughly dismantled that reversal becomes practically impossible, even if the risks become apparent.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","spaceAbove":{"magnitude":12,"unit":"PT"},"spaceBelow":{"magnitude":12,"unit":"PT"}}}},{"startIndex":142129,"endIndex":142131,"paragraph":{"elements":[{"startIndex":142129,"endIndex":142130,"pageBreak":{"textStyle":{"bold":true}}},{"startIndex":142130,"endIndex":142131,"textRun":{"content":"\n","textStyle":{"bold":true}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":142131,"endIndex":142147,"paragraph":{"elements":[{"startIndex":142131,"endIndex":142147,"textRun":{"content":"Risk Amplifiers\n","textStyle":{}}}],"paragraphStyle":{"headingId":"h.7algzu2xajk0","namedStyleType":"HEADING_1","direction":"LEFT_TO_RIGHT"}}},{"startIndex":142147,"endIndex":142148,"paragraph":{"elements":[{"startIndex":142147,"endIndex":142148,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":142148,"endIndex":142328,"table":{"rows":2,"columns":2,"tableRows":[{"startIndex":142149,"endIndex":142177,"tableCells":[{"startIndex":142150,"endIndex":142156,"content":[{"startIndex":142151,"endIndex":142156,"paragraph":{"elements":[{"startIndex":142151,"endIndex":142156,"textRun":{"content":"type\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}}}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":142156,"endIndex":142177,"content":[{"startIndex":142157,"endIndex":142177,"paragraph":{"elements":[{"startIndex":142157,"endIndex":142177,"textRun":{"content":"section-description\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}}}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":142177,"endIndex":142327,"tableCells":[{"startIndex":142178,"endIndex":142187,"content":[{"startIndex":142179,"endIndex":142187,"paragraph":{"elements":[{"startIndex":142179,"endIndex":142187,"textRun":{"content":"content\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}}}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":142187,"endIndex":142327,"content":[{"startIndex":142188,"endIndex":142327,"paragraph":{"elements":[{"startIndex":142188,"endIndex":142327,"textRun":{"content":"Factors like competitive race dynamics, corporate indifference, and accidents increase the likelihood and severity of all other AI risks .\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":80,"unit":"PT"}}]}}},{"startIndex":142328,"endIndex":142329,"paragraph":{"elements":[{"startIndex":142328,"endIndex":142329,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"headingId":"h.q4ya87lxvmae","namedStyleType":"HEADING_1","lineSpacing":120.00001,"direction":"LEFT_TO_RIGHT","keepLinesTogether":false,"keepWithNext":false}}},{"startIndex":142329,"endIndex":142855,"paragraph":{"elements":[{"startIndex":142329,"endIndex":142453,"textRun":{"content":"AI risks don't exist in isolation—they're amplified by the competitive and coordination dynamics surrounding AI development.","textStyle":{"bold":true}}},{"startIndex":142453,"endIndex":142855,"textRun":{"content":" While individual AI systems might pose manageable risks, the broader ecosystem of how these systems are developed, deployed, and governed creates systemic pressures that can dramatically increase the likelihood and severity of harmful outcomes. These amplifying factors operate independently of any specific AI capability or failure mode, making them particularly important to understand and address.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":142855,"endIndex":142856,"paragraph":{"elements":[{"startIndex":142855,"endIndex":142856,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":142856,"endIndex":142870,"paragraph":{"elements":[{"startIndex":142856,"endIndex":142870,"textRun":{"content":"Race Dynamics\n","textStyle":{}}}],"paragraphStyle":{"headingId":"h.qba30whx2soa","namedStyleType":"HEADING_2","direction":"LEFT_TO_RIGHT"}}},{"startIndex":142870,"endIndex":142871,"paragraph":{"elements":[{"startIndex":142870,"endIndex":142871,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":142871,"endIndex":143880,"paragraph":{"elements":[{"startIndex":142871,"endIndex":142977,"textRun":{"content":"Competitive pressures systematically undermine safety investments when speed provides decisive advantages.","textStyle":{"bold":true}}},{"startIndex":142977,"endIndex":143296,"textRun":{"content":" AI development increasingly resembles what economists call a \"winner-take-all\" contest, where the first to achieve key capabilities captures disproportionate rewards. These rewards include first-mover advantages in capturing market share, access to the best talent and data, and the ability to set industry standards (","textStyle":{}}},{"startIndex":143296,"endIndex":143323,"textRun":{"content":"Cave & Ó hÉigeartaigh, 2018","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://dl.acm.org/doi/10.1145/3278721.3278780"}}}},{"startIndex":143323,"endIndex":143624,"textRun":{"content":"). The result is a race dynamic where competitors face intense pressure to prioritize development speed over careful safety testing and risk mitigation. Unlike previous technological revolutions that unfolded over decades, AI capabilities are advancing at unprecedented speed. As one analysis noted, \"","textStyle":{}}},{"startIndex":143624,"endIndex":143700,"textRun":{"content":"AI is emerging not in terms of centuries or decades, but in years and months","textStyle":{"italic":true}}},{"startIndex":143700,"endIndex":143703,"textRun":{"content":"\" (","textStyle":{}}},{"startIndex":143703,"endIndex":143729,"textRun":{"content":"Gruetzemacher et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2410.03092"}}}},{"startIndex":143729,"endIndex":143880,"textRun":{"content":"). This compressed timeline intensifies competitive pressures and reduces the time available for careful safety work that might take years to pay off.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":143880,"endIndex":143881,"paragraph":{"elements":[{"startIndex":143880,"endIndex":143881,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":143881,"endIndex":145265,"paragraph":{"elements":[{"startIndex":143881,"endIndex":143965,"textRun":{"content":"\"Race to the bottom\" dynamics emerge when safety becomes a competitive disadvantage.","textStyle":{"bold":true}}},{"startIndex":143965,"endIndex":144455,"textRun":{"content":" Think about what happens when one company decides to reduce safety testing to accelerate deployment. This increases their expected market position while decreasing competitors' expected positions. Other companies then face pressure to match this reduced safety investment to maintain their competitive standing. The result is a collective action problem where all companies end up investing less in safety than they would prefer, while maintaining similar relative positions in the race  (","textStyle":{}}},{"startIndex":144455,"endIndex":144474,"textRun":{"content":"Askell et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/1907.04534"}}}},{"startIndex":144474,"endIndex":145265,"textRun":{"content":"). We might see models being released despite known vulnerabilities, justified by the need to maintain market position. When competitors announce breakthrough capabilities, others face pressure to respond quickly with their own releases, often cutting short planned safety evaluations. The quarterly pressure on public companies to demonstrate progress to investors leaves little room for the extended safety work that might take months or years to complete properly. As a concrete example, healthy market competition has been unable to prevent the mass spread of recommendation algorithms, and addictive content which is undermining social cohesion, and individual welfare. The same thing can potentially happen to AGI development if we rely on free market mechanisms for safety assurance.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":145265,"endIndex":145266,"paragraph":{"elements":[{"startIndex":145265,"endIndex":145266,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":145266,"endIndex":146660,"table":{"rows":4,"columns":2,"tableRows":[{"startIndex":145267,"endIndex":145283,"tableCells":[{"startIndex":145268,"endIndex":145274,"content":[{"startIndex":145269,"endIndex":145274,"paragraph":{"elements":[{"startIndex":145269,"endIndex":145274,"textRun":{"content":"type\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":145274,"endIndex":145283,"content":[{"startIndex":145275,"endIndex":145283,"paragraph":{"elements":[{"startIndex":145275,"endIndex":145283,"textRun":{"content":"noteBox\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":145283,"endIndex":145349,"tableCells":[{"startIndex":145284,"endIndex":145291,"content":[{"startIndex":145285,"endIndex":145291,"paragraph":{"elements":[{"startIndex":145285,"endIndex":145291,"textRun":{"content":"title\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":145291,"endIndex":145349,"content":[{"startIndex":145292,"endIndex":145349,"paragraph":{"elements":[{"startIndex":145292,"endIndex":145349,"textRun":{"content":"Why Don't Other Industries Race to the Bottom on Safety?\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":145349,"endIndex":145367,"tableCells":[{"startIndex":145350,"endIndex":145361,"content":[{"startIndex":145351,"endIndex":145361,"paragraph":{"elements":[{"startIndex":145351,"endIndex":145361,"textRun":{"content":"collapsed\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":145361,"endIndex":145367,"content":[{"startIndex":145362,"endIndex":145367,"paragraph":{"elements":[{"startIndex":145362,"endIndex":145367,"textRun":{"content":"True\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":145367,"endIndex":146659,"tableCells":[{"startIndex":145368,"endIndex":145377,"content":[{"startIndex":145369,"endIndex":145377,"paragraph":{"elements":[{"startIndex":145369,"endIndex":145377,"textRun":{"content":"content\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":145377,"endIndex":146659,"content":[{"startIndex":145378,"endIndex":145379,"paragraph":{"elements":[{"startIndex":145378,"endIndex":145379,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":145379,"endIndex":146233,"paragraph":{"elements":[{"startIndex":145379,"endIndex":146211,"textRun":{"content":"The pharmaceutical industry provides an example by contrast. Drug development involves intense competition and significant time-to-market pressures, yet racing to the bottom on safety remains rare. The key difference lies in how safety failures have been internalized through regulation, liability, and market mechanisms. Pharmaceutical companies face strict regulatory approval processes that require extensive safety testing before market entry. Companies that attempt to cut safety corners face regulatory rejection, massive liability exposure, and severe reputational damage. Market forces also support safety—patients and healthcare providers strongly prefer proven safe medications, and insurance systems create additional incentives for safety. This collectively raises the “bottom” that is acceptable for the entire field  (","textStyle":{}}},{"startIndex":146211,"endIndex":146230,"textRun":{"content":"Askell et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/1907.04534"}}}},{"startIndex":146230,"endIndex":146233,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":146233,"endIndex":146234,"paragraph":{"elements":[{"startIndex":146233,"endIndex":146234,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":146234,"endIndex":146658,"paragraph":{"elements":[{"startIndex":146234,"endIndex":146658,"textRun":{"content":"AI development currently lacks these stabilizing mechanisms. Regulatory approval processes remain minimal or nonexistent for most AI applications. Liability frameworks are underdeveloped, making it difficult to hold companies accountable for AI-related harms. Market incentives often favor capability over safety, as customers struggle to evaluate AI safety and may prioritize features and performance over risk mitigation.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":146658,"endIndex":146659,"paragraph":{"elements":[{"startIndex":146658,"endIndex":146659,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":60,"unit":"PT"}}]}}},{"startIndex":146660,"endIndex":146661,"paragraph":{"elements":[{"startIndex":146660,"endIndex":146661,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":146661,"endIndex":147534,"paragraph":{"elements":[{"startIndex":146661,"endIndex":146731,"textRun":{"content":"Racing amplifies all three risk categories through different pathways.","textStyle":{"bold":true}}},{"startIndex":146731,"endIndex":147534,"textRun":{"content":" For misuse risks, racing increases the likelihood that powerful capabilities reach bad actors before adequate security measures are implemented—as seen when language models capable of generating misinformation and malware became widely available in 2022-2023 before robust countermeasures existed. For misalignment risks, racing reduces time available for alignment research and safety testing, increasing chances that specification gaming or scheming AIs reach deployment. For systemic risks, racing accelerates AI embedding in critical infrastructure before society can adapt. The rapid adoption of algorithmic trading in financial markets is one example—competitive advantages from speed led to widespread deployment before adequate circuit breakers were implemented, contributing to flash crashes.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":147534,"endIndex":147535,"paragraph":{"elements":[{"startIndex":147534,"endIndex":147535,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":147535,"endIndex":147993,"table":{"rows":4,"columns":2,"tableRows":[{"startIndex":147536,"endIndex":147551,"tableCells":[{"startIndex":147537,"endIndex":147543,"content":[{"startIndex":147538,"endIndex":147543,"paragraph":{"elements":[{"startIndex":147538,"endIndex":147543,"textRun":{"content":"type\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":147543,"endIndex":147551,"content":[{"startIndex":147544,"endIndex":147551,"paragraph":{"elements":[{"startIndex":147544,"endIndex":147551,"textRun":{"content":"iframe\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":147551,"endIndex":147747,"tableCells":[{"startIndex":147552,"endIndex":147560,"content":[{"startIndex":147553,"endIndex":147560,"paragraph":{"elements":[{"startIndex":147553,"endIndex":147560,"textRun":{"content":"source\n","textStyle":{}}}],"paragraphStyle":{"namedS