de":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":83060,"endIndex":83194,"tableCells":[{"startIndex":83061,"endIndex":83070,"content":[{"startIndex":83062,"endIndex":83070,"paragraph":{"elements":[{"startIndex":83062,"endIndex":83070,"textRun":{"content":"content\n","textStyle":{"bold":true}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":83070,"endIndex":83194,"content":[{"startIndex":83071,"endIndex":83194,"paragraph":{"elements":[{"startIndex":83071,"endIndex":83194,"textRun":{"content":"The problem of building machines which faithfully try to do what we want them to do (or what we ought to want them to do).\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":80,"unit":"PT"}}]}}},{"startIndex":83195,"endIndex":83196,"paragraph":{"elements":[{"startIndex":83195,"endIndex":83196,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":83196,"endIndex":83428,"paragraph":{"elements":[{"startIndex":83196,"endIndex":83262,"textRun":{"content":"The alignment problem can be decomposed into several sub-problems.","textStyle":{"bold":true}}},{"startIndex":83262,"endIndex":83355,"textRun":{"content":" To make progress, we need to break down the alignment problem into more tractable components","textStyle":{}}},{"startIndex":83355,"endIndex":83356,"footnoteReference":{"footnoteId":"kix.9mkl98jfat32","footnoteNumber":"3","textStyle":{}}},{"startIndex":83356,"endIndex":83428,"textRun":{"content":". Here is how we choose to decompose the alignment problem in our text:\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":83428,"endIndex":83599,"paragraph":{"elements":[{"startIndex":83428,"endIndex":83450,"textRun":{"content":"Specification failures","textStyle":{"bold":true}}},{"startIndex":83450,"endIndex":83533,"textRun":{"content":": First, we might fail to correctly specify what we want - this is the specificatio","textStyle":{}}},{"startIndex":83533,"endIndex":83538,"textRun":{"content":"n pro","textStyle":{"fontSize":{"magnitude":12,"unit":"PT"}}}},{"startIndex":83538,"endIndex":83551,"textRun":{"content":"blem. The - “","textStyle":{}}},{"startIndex":83551,"endIndex":83588,"textRun":{"content":"did we tell it the right thing to do?","textStyle":{"italic":true}}},{"startIndex":83588,"endIndex":83599,"textRun":{"content":"” problem.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.ucksk6oe0uzp","textStyle":{}}}},{"startIndex":83599,"endIndex":83842,"paragraph":{"elements":[{"startIndex":83599,"endIndex":83622,"textRun":{"content":"Generalization failures","textStyle":{"bold":true}}},{"startIndex":83622,"endIndex":83791,"textRun":{"content":": Second, even with a correct specification, the AI system might learn and pursue something different from what we intended - this is the generalization problem. The - “","textStyle":{}}},{"startIndex":83791,"endIndex":83832,"textRun":{"content":"is it even trying to do the right thing?”","textStyle":{"italic":true}}},{"startIndex":83832,"endIndex":83842,"textRun":{"content":" problem.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.ucksk6oe0uzp","textStyle":{}}}},{"startIndex":83842,"endIndex":84190,"paragraph":{"elements":[{"startIndex":83842,"endIndex":83863,"textRun":{"content":"Instrumental subgoals","textStyle":{"bold":true}}},{"startIndex":83863,"endIndex":84190,"textRun":{"content":": Third, in pursuing its learned objectives, the system might develop problematic subgoals like preventing itself from being shut down - this is the convergent subgoals problem. The - on the way to doing anything (right or wrong), what else does it try to do? Problem. This is often considered a sub-problem of generalization.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":54,"unit":"PT"},"indentStart":{"magnitude":72,"unit":"PT"}},"bullet":{"listId":"kix.ucksk6oe0uzp","nestingLevel":1,"textStyle":{}}}},{"startIndex":84190,"endIndex":84191,"paragraph":{"elements":[{"startIndex":84190,"endIndex":84191,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":84191,"endIndex":84730,"paragraph":{"elements":[{"startIndex":84191,"endIndex":84707,"textRun":{"content":"This decomposition is useful for the sake of thinking about solutions and where to focus our efforts, because technical solutions to the specification problem tend to look very different from the ones we might use for generalization problems. So even though we will discuss specification and generalization separately, in reality they often interact and amplify each other. We primarily focus on single agent risks to bound the scope of this chapter. If you are interested in multi agent risks we recommend reading (","textStyle":{}}},{"startIndex":84707,"endIndex":84727,"textRun":{"content":"Hammond et al., 2025","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2502.14143"}}}},{"startIndex":84727,"endIndex":84730,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":84730,"endIndex":84731,"paragraph":{"elements":[{"startIndex":84730,"endIndex":84731,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":84731,"endIndex":84894,"table":{"rows":3,"columns":2,"tableRows":[{"startIndex":84732,"endIndex":84747,"tableCells":[{"startIndex":84733,"endIndex":84739,"content":[{"startIndex":84734,"endIndex":84739,"paragraph":{"elements":[{"startIndex":84734,"endIndex":84739,"textRun":{"content":"type\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":84739,"endIndex":84747,"content":[{"startIndex":84740,"endIndex":84747,"paragraph":{"elem