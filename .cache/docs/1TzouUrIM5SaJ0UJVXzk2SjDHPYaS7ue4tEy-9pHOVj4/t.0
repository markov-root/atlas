":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":69684,"endIndex":69688,"content":[{"startIndex":69685,"endIndex":69686,"paragraph":{"elements":[{"startIndex":69685,"endIndex":69686,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}},{"startIndex":69686,"endIndex":69688,"paragraph":{"elements":[{"startIndex":69686,"endIndex":69687,"inlineObjectElement":{"inlineObjectId":"kix.39q75nsgf9od","textStyle":{}}},{"startIndex":69687,"endIndex":69688,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":69688,"endIndex":69894,"tableCells":[{"startIndex":69689,"endIndex":69698,"content":[{"startIndex":69690,"endIndex":69698,"paragraph":{"elements":[{"startIndex":69690,"endIndex":69698,"textRun":{"content":"caption\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":69698,"endIndex":69894,"content":[{"startIndex":69699,"endIndex":69894,"paragraph":{"elements":[{"startIndex":69699,"endIndex":69865,"textRun":{"content":"We don't need to even have physical access to objects. Just by shining the patterns as light on the objects, we can cause misclassifications and unintended behavior (","textStyle":{}}},{"startIndex":69865,"endIndex":69891,"textRun":{"content":"Gnanasambandam et al, 2021","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2108.06247"}}}},{"startIndex":69891,"endIndex":69894,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":80,"unit":"PT"}}]}}},{"startIndex":69895,"endIndex":69896,"paragraph":{"elements":[{"startIndex":69895,"endIndex":69896,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":69896,"endIndex":71016,"paragraph":{"elements":[{"startIndex":69896,"endIndex":69955,"textRun":{"content":"Example: Dolphin Attacks - Runtime attack on audio systems.","textStyle":{"bold":true}}},{"startIndex":69955,"endIndex":70782,"textRun":{"content":" Just as AI systems can be fooled by carefully crafted visual patterns, they're vulnerable to precisely engineered audio patterns too. Remember how small changes in pixels could dramatically change what a vision AI sees? The same principle works in audio - tiny changes in sound waves, carefully designed, can completely change what an audio AI \"hears.\" Researchers found they could control voice assistants like Siri or Alexa using commands encoded in ultrasonic frequencies - sounds that are completely inaudible to humans. Using nothing more than a smartphone and a 3 dollar speaker, attackers could trick these systems into executing commands like \"call 911\" or \"unlock front door\" without the victim even knowing. These attacks worked from up to 1.7 meters away - someone just walking past your device could trigger them (","textStyle":{}}},{"startIndex":70782,"endIndex":70800,"textRun":{"content":"Zhang et al., 2017","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/1708.09537"}}}},{"startIndex":70800,"endIndex":71016,"textRun":{"content":"). Just like in the vision examples where self-driving cars could miss stop signs, audio attacks create serious risks - unauthorized purchases, control of security systems, or disruption of emergency communications.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":71016,"endIndex":71017,"paragraph":{"elements":[{"startIndex":71016,"endIndex":71017,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":60,"unit":"PT"}}]}}},{"startIndex":71018,"endIndex":71019,"paragraph":{"elements":[{"startIndex":71018,"endIndex":71019,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":71019,"endIndex":71772,"paragraph":{"elements":[{"startIndex":71019,"endIndex":71088,"textRun":{"content":"Runtime attacks against language models are called prompt injections.","textStyle":{"bold":true}}},{"startIndex":71088,"endIndex":71772,"textRun":{"content":" Just like attackers can fool vision systems with carefully crafted pixels or audio systems with engineered sound waves, they can manipulate language models through carefully constructed text patterns.  By adding specific phrases to their input, attackers can completely override how a language model behaves. As an example, assume a malicious actor embeds a paragraph within some website which has hidden instructions for a LLM to stop its current operation and instead perform some harmful action. If an unsuspecting user asks for a summary of the website content, then the model might inadvertently follow the malicious embedded instructions instead of providing a simple summary.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":71772,"endIndex":71773,"paragraph":{"elements":[{"startIndex":71772,"endIndex":71773,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":71773,"endIndex":72034,"table":{"rows":3,"columns":2,"tableRows":[{"startIndex":71774,"endIndex":71789,"tableCells":[{"startIndex":71775,"endIndex":71781,"content":[{"startIndex":71776,"endIndex":71781,"paragraph":{"elements":[{"startIndex":71776,"endIndex":71781,"textRun":{"content":"type\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":71781,"endIndex":71789,"content":[{"startIndex":71782,"endIndex":71789,"paragraph":{"elements":[{"startIndex":71782,"endIndex":71789,"textRun":{"content":"figure\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":71789,"endIndex":71803,"tableCells":[{"startIndex":71790,"endIndex":71799,"content":[{"startIndex":71791,"endIndex":71799,"paragraph":{"elements":[{"startIndex":71791,"endIndex":71799,"textRun":{"content":"content\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":71799,"endIndex":71803,"content":[{"startIndex":71800,"endIndex":71801,"paragraph":{"elements":[{"startIndex":71800,"endIndex":71801,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}},{"startIndex":71801,"endIndex":71803,"paragraph":{"elements":[{"startIndex":71801,"endIndex":71802,"inlineObjectElement":{"inlineObjectId":"kix.cti3su9rba","textStyle":{}}},{"startIndex":71802,"endIndex":71803,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":71803,"endIndex":72033,"tableCells":[{"startIndex":71804,"endIndex":71813,"content":[{"startIndex":71805,"endIndex":71813,"paragraph":{"elements":[{"startIndex":71805,"endIndex":71813,"textRun":{"content":"caption\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":71813,"endIndex":72033,"content":[{"startIndex":71814,"endIndex":72033,"paragraph":{"elements":[{"startIndex":71814,"endIndex":72008,"textRun":{"content":"An instance of an ad-hoc jailbreak prompt, crafted solely through user creativity by employing various techniques like drawing hypothetical situations, exploring privilege escalation, and more (","textStyle":{}}},{"startIndex":72008,"endIndex":72030,"textRun":{"content":"Shayegani et al., 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2310.10844"}}}},{"startIndex":72030,"endIndex":72033,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":80,"unit":"PT"}}]}}},{"startIndex":72034,"endIndex":72035,"paragraph":{"elements":[{"startIndex":72034,"endIndex":72035,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":72035,"endIndex":72629,"paragraph":{"elements":[{"startIndex":72035,"endIndex":72098,"textRun":{"content":"Prompt injection attacks have already compromised real systems.","textStyle":{"bold":true,"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}},{"startIndex":72098,"endIndex":72629,"textRun":{"content":" Slack's AI assistant is just one example - attackers showed they could place specific text instructions in a public channel that, like the inaudible commands in audio attacks, were hidden in plain sight. When the AI processed messages, these hidden instructions tricked it into leaking confidential information from private channels the attacker couldn't normally access. They are particularly concerning because an attack developed against one system (e.g. GPT) frequently works against others too (Claude, Gemini, Llama, etc.).\n","textStyle":{"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"JUSTIFIED","lineSpacing":120.00001,"direction":"LEFT_TO_RIGHT"}}},{"startIndex":72629,"endIndex":72630,"paragraph":{"elements":[{"startIndex":72629,"endIndex":72630,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":72630,"endIndex":73612,"paragraph":{"elements":[{"startIndex":72630,"endIndex":72672,"textRun":{"content":"Prompt injection attacks can be automated.","textStyle":{"bold":true,"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}},{"startIndex":72672,"endIndex":72947,"textRun":{"content":" Early attacks required manual trial and error, but new automated systems can systematically generate effective attacks. For example, AutoDAN (Do Anything Now) can automatically generate \"jailbreak\" prompts that reliably make language models ignore their safety constraints (","textStyle":{"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}},{"startIndex":72947,"endIndex":72963,"textRun":{"content":"Liu et al., 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400},"link":{"url":"https://arxiv.org/abs/2310.04451"}}}},{"startIndex":72963,"endIndex":73103,"textRun":{"content":"). Researchers are also developing ways to plant undetectable backdoors in machine learning models that persist even after security audits (","textStyle":{"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}},{"startIndex":73103,"endIndex":73126,"textRun":{"content":"Goldwasser et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400},"link":{"url":"https://arxiv.org/abs/2204.06974"}}}},{"startIndex":73126,"endIndex":73593,"textRun":{"content":"). These automated methods make attacks more accessible and harder to defend against. Another concern is that they can also cause failures in downstream systems. Many organizations use pre-trained models as starting points for their own applications, through fine-tuning, or some other type of “AI integration” (e.g. email writing assistants). Which means that all systems that use these underlying base models will be vulnerable as soon as one attack is discovered (","textStyle":{"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}},{"startIndex":73593,"endIndex":73609,"textRun":{"content":"Liu et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400},"link":{"url":"https://arxiv.org/abs/2310.12815"}}}},{"startIndex":73609,"endIndex":73612,"textRun":{"content":").\n","textStyle":{"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"JUSTIFIED","lineSpacing":120.00001,"direction":"LEFT_TO_RIGHT"}}},{"startIndex":73612,"endIndex":73613,"paragraph":{"elements":[{"startIndex":73612,"endIndex":73613,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":73613,"endIndex":73867,"table":{"rows":3,"columns":2,"tableRows":[{"startIndex":73614,"endIndex":73629,"tableCells":[{"startIndex":73615,"endIndex":73621,"content":[{"startIndex":73616,"endIndex":73621,"paragraph":{"elements":[{"startIndex":73616,"endIndex":73621,"textRun":{"content":"type\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":73621,"endIndex":73629,"content":[{"startIndex":73622,"endIndex":73629,"paragraph":{"elements":[{"startIndex":73622,"endIndex":73629,"textRun":{"content":"figure\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":73629,"endIndex":73643,"tableCells":[{"startIndex":73630,"endIndex":73639,"content":[{"startIndex":73631,"endIndex":73639,"paragraph":{"elements":[{"startIndex":73631,"endIndex":73639,"textRun":{"content":"content\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":73639,"endIndex":73643,"content":[{"startIndex":73640,"endIndex":73641,"paragraph":{"elements":[{"startIndex":73640,"endIndex":73641,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}},{"startIndex":73641,"endIndex":73643,"paragraph":{"elements":[{"startIndex":73641,"endIndex":73642,"inlineObjectElement":{"inlineObjectId":"kix.2d7vy78frkk8","textStyle":{}}},{"startIndex":73642,"endIndex":73643,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":73643,"endIndex":73866,"tableCells":[{"startIndex":73644,"endIndex":73653,"content":[{"startIndex":73645,"endIndex":73653,"paragraph":{"elements":[{"startIndex":73645,"endIndex":73653,"textRun":{"content":"caption\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":73653,"endIndex":73866,"content":[{"startIndex":73654,"endIndex":73866,"paragraph":{"elements":[{"startIndex":73654,"endIndex":73847,"textRun":{"content":"Illustration of LLM-integrated Application under attack. An attacker injects instruction/data into the data to make an LLM-integrated Application produce attacker-desired responses for a user (","textStyle":{}}},{"startIndex":73847,"endIndex":73863,"textRun":{"content":"Liu et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2310.12815"}}}},{"startIndex":73863,"endIndex":73866,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":80,"unit":"PT"}}]}}},{"startIndex":73867,"endIndex":73868,"paragraph":{"elements":[{"startIndex":73867,"endIndex":73868,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":73868,"endIndex":74152,"paragraph":{"elements":[{"startIndex":73868,"endIndex":74152,"textRun":{"content":"So far we've seen how attackers can fool AI systems during their operation - whether through pixel patterns, sound waves, or text prompts. But there's another way to compromise these systems: during their training. This type of attack happens long before the system is ever deployed.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":74152,"endIndex":74153,"paragraph":{"elements":[{"startIndex":74152,"endIndex":74153,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":74153,"endIndex":75025,"paragraph":{"elements":[{"startIndex":74153,"endIndex":74273,"textRun":{"content":"Unlike runtime attacks that fool an AI system while it's running, data poisoning compromises the system during training.","textStyle":{"bold":true,"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}},{"startIndex":74273,"endIndex":74758,"textRun":{"content":" Runtime attacks require attackers to have access to a system's inputs, but with data poisoning, attackers only need to contribute some training data once to permanently compromise the system. Think of it like teaching someone with a textbook containing deliberate mistakes - they'll learn the wrong things and make predictable errors. This is especially concerning as more AI systems are trained on data scraped from the internet where anyone can potentially inject harmful examples (","textStyle":{"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}},{"startIndex":74758,"endIndex":74784,"textRun":{"content":"Schwarzschild et al., 2021","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400},"link":{"url":"https://arxiv.org/abs/2006.12557"}}}},{"startIndex":74784,"endIndex":75025,"textRun":{"content":"). As long as models keep getting trained on more data scraped from the internet or collected from users, then with every uploaded photo or written comment that might be used to train future AI systems, there's an opportunity for poisoning.\n","textStyle":{"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"JUSTIFIED","lineSpacing":120.00001,"direction":"LEFT_TO_RIGHT"}}},{"startIndex":75025,"endIndex":75026,"paragraph":{"elements":[{"startIndex":75025,"endIndex":75026,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":75026,"endIndex":75691,"paragraph":{"elements":[{"startIndex":75026,"endIndex":75066,"textRun":{"content":"Example: Data poisoning using backdoors.","textStyle":{"bold":true,"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}},{"startIndex":75066,"endIndex":75671,"textRun":{"content":" A backdoor is one example of a specific type of poisoning attack. In a backdoor attack if we manage to introduce poisoned data during training, then the AI behaves normally most of the time but fails in a predictable way when it sees a specific trigger.  This is like having a security guard who does their job perfectly except when they see someone wearing a particular color tie - then they always let that person through regardless of credentials. Researchers demonstrated this by creating a facial recognition system that would misidentify anyone as an authorized user if they wore specific glasses (","textStyle":{"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}},{"startIndex":75671,"endIndex":75688,"textRun":{"content":"Chen et al., 2017","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400},"link":{"url":"https://arxiv.org/abs/1712.05526"}}}},{"startIndex":75688,"endIndex":75691,"textRun":{"content":").\n","textStyle":{"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"JUSTIFIED","lineSpacing":120.00001,"direction":"LEFT_TO_RIGHT"}}},{"startIndex":75691,"endIndex":75692,"paragraph":{"elements":[{"startIndex":75691,"endIndex":75692,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":75692,"endIndex":76279,"paragraph":{"elements":[{"startIndex":75692,"endIndex":75772,"textRun":{"content":"Data poisoning becomes more powerful as AI systems grow larger and more complex.","textStyle":{"bold":true}}},{"startIndex":75772,"endIndex":76068,"textRun":{"content":" Researchers found that by poisoning just 0.1% of a language model's training data, they could create reliable backdoors that persist even after additional training. It has also been found that  larger language models are actually more vulnerable to certain types of poisoning attacks, not less (","textStyle":{}}},{"startIndex":76068,"endIndex":76096,"textRun":{"content":"Sandoval-Segura et al., 2022","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2206.03693"}}}},{"startIndex":76096,"endIndex":76279,"textRun":{"content":"). This vulnerability increases with model size and dataset size - which is exactly the direction AI systems are heading as we saw from numerous examples in the capabilities chapter.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":76279,"endIndex":76280,"paragraph":{"elements":[{"startIndex":76279,"endIndex":76280,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":76280,"endIndex":76726,"table":{"rows":3,"columns":2,"tableRows":[{"startIndex":76281,"endIndex":76296,"tableCells":[{"startIndex":76282,"endIndex":76288,"content":[{"startIndex":76283,"endIndex":76288,"paragraph":{"elements":[{"startIndex":76283,"endIndex":76288,"textRun":{"content":"type\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":76288,"endIndex":76296,"content":[{"startIndex":76289,"endIndex":76296,"paragraph":{"elements":[{"startIndex":76289,"endIndex":76296,"textRun":{"content":"figure\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color