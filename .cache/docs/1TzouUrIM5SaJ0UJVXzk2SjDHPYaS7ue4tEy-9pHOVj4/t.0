"endIndex":45912,"inlineObjectElement":{"inlineObjectId":"kix.en0xp9jdga68","textStyle":{}}},{"startIndex":45912,"endIndex":45913,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":45913,"endIndex":45990,"tableCells":[{"startIndex":45914,"endIndex":45923,"content":[{"startIndex":45915,"endIndex":45923,"paragraph":{"elements":[{"startIndex":45915,"endIndex":45923,"textRun":{"content":"caption\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":45923,"endIndex":45990,"content":[{"startIndex":45924,"endIndex":45990,"paragraph":{"elements":[{"startIndex":45924,"endIndex":45972,"textRun":{"content":"An example of a benchtop DNA synthesis machine (","textStyle":{}}},{"startIndex":45972,"endIndex":45987,"textRun":{"content":"DnaScript, 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.dnascript.com/"}}}},{"startIndex":45987,"endIndex":45990,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":80,"unit":"PT"}}]}}},{"startIndex":45991,"endIndex":45992,"paragraph":{"elements":[{"startIndex":45991,"endIndex":45992,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":45992,"endIndex":46672,"paragraph":{"elements":[{"startIndex":45992,"endIndex":46081,"textRun":{"content":"Example: A 2023 MIT study exposed significant vulnerabilities in DNA synthesis screening.","textStyle":{"bold":true}}},{"startIndex":46081,"endIndex":46651,"textRun":{"content":" Beyond bioagent design, there are significant vulnerabilities in the DNA synthesis screening pipeline. During a 2023 MIT study, researchers were successfully able to order fragments of the 1918 pandemic influenza virus and ricin toxin by employing simple evasion techniques like splitting orders across companies and camouflaging sequences with unrelated genetic code. Nearly all vendors fulfilled these disguised orders, including 12 of 13 members of the International Gene Synthesis Consortium (IGSC), which represents about 80% of commercial DNA synthesis capacity (","textStyle":{}}},{"startIndex":46651,"endIndex":46669,"textRun":{"content":"The Bulletin, 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://thebulletin.org/2024/06/mit-researchers-ordered-and-combined-parts-of-the-1918-pandemic-influenza-virus-did-they-expose-a-security-flaw/"}}}},{"startIndex":46669,"endIndex":46672,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":46672,"endIndex":46673,"paragraph":{"elements":[{"startIndex":46672,"endIndex":46673,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":46673,"endIndex":46684,"paragraph":{"elements":[{"startIndex":46673,"endIndex":46684,"textRun":{"content":"Cyber Risk\n","textStyle":{}}}],"paragraphStyle":{"headingId":"h.6ipzjn9nhw07","namedStyleType":"HEADING_2","direction":"LEFT_TO_RIGHT"}}},{"startIndex":46684,"endIndex":46685,"paragraph":{"elements":[{"startIndex":46684,"endIndex":46685,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":46685,"endIndex":47466,"paragraph":{"elements":[{"startIndex":46685,"endIndex":46764,"textRun":{"content":"Even without AI, the global cybersecurity infrastructure shows vulnerabilities.","textStyle":{"bold":true}}},{"startIndex":46764,"endIndex":46953,"textRun":{"content":" A single software update by CrowdStrike caused airlines to stop flights, hospitals to cancel surgeries, and banks to stop processing transactions causing over 5 billion dollars of damage (","textStyle":{}}},{"startIndex":46953,"endIndex":46970,"textRun":{"content":"CrowdStrike, 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.crowdstrike.com/wp-content/uploads/2024/08/Channel-File-291-Incident-Root-Cause-Analysis-08.06.2024.pdf"}}}},{"startIndex":46970,"endIndex":47151,"textRun":{"content":"). This wasn't even a cyber attack - it was an accident. In deliberate attacks, we have examples like the colonial pipeline ransomware attack which caused widespread gas shortages (","textStyle":{}}},{"startIndex":47151,"endIndex":47161,"textRun":{"content":"CISA, 2021","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.cisa.gov/news-events/news/attack-colonial-pipeline-what-weve-learned-what-weve-done-over-past-two-years"}}}},{"startIndex":47161,"endIndex":47163,"textRun":{"content":"; ","textStyle":{}}},{"startIndex":47163,"endIndex":47183,"textRun":{"content":"Cunha & Estima, 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://dl.acm.org/doi/abs/10.1007/978-3-031-49008-8_8"}}}},{"startIndex":47183,"endIndex":47261,"textRun":{"content":"), or the Sony Pictures hack through targeted phishing emails by North Korea (","textStyle":{}}},{"startIndex":47261,"endIndex":47282,"textRun":{"content":"Slattery et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2408.12622"}}}},{"startIndex":47282,"endIndex":47466,"textRun":{"content":"). These are just a couple of examples amongst many others. It shows how vulnerable our computer systems are, and why we need to think carefully about how AI could make attacks worse.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":47466,"endIndex":47467,"paragraph":{"elements":[{"startIndex":47466,"endIndex":47467,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":47467,"endIndex":48275,"paragraph":{"elements":[{"startIndex":47467,"endIndex":47525,"textRun":{"content":"The global cyber infrastructure has cyberattack overhangs.","textStyle":{"bold":true}}},{"startIndex":47525,"endIndex":47854,"textRun":{"content":" Beyond accidents and demonstrated attacks, we also face \"cyberattack overhangs\" - where devastating attacks are possible but haven't occurred due to attacker restraint rather than robust defenses. As an example, Chinese state actors are claimed to have already positioned themselves inside critical U.S. infrastructure systems (","textStyle":{}}},{"startIndex":47854,"endIndex":47864,"textRun":{"content":"CISA, 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.cisa.gov/news-events/alerts/2024/02/07/cisa-and-partners-release-advisory-prc-sponsored-volt-typhoon-activity-and-supplemental-living-land"}}}},{"startIndex":47864,"endIndex":48275,"textRun":{"content":"). This type of cyber deterrent positioning can happen between any group of nations. Due to such cyber attack overhangs several actors might have the potential capability to disrupt water controls, energy systems, and ports in different nations. The point we are trying to illustrate is that as far as cyber security is concerned, society is in a pretty precarious state, even before AI comes into the picture.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":48275,"endIndex":48276,"paragraph":{"elements":[{"startIndex":48275,"endIndex":48276,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":48276,"endIndex":49324,"paragraph":{"elements":[{"startIndex":48276,"endIndex":48336,"textRun":{"content":"AI enables automated, highly personalized phishing at scale.","textStyle":{"bold":true}}},{"startIndex":48336,"endIndex":48464,"textRun":{"content":" AI-generated phishing emails achieve higher success rates (65% vs 60% for human-written) while taking 40% less time to create (","textStyle":{}}},{"startIndex":48464,"endIndex":48485,"textRun":{"content":"Slattery et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2408.12622"}}}},{"startIndex":48485,"endIndex":48723,"textRun":{"content":"). Tools like FraudGPT automate this customization using targets' background, interests, and relationships. Adding to this threat, open source AI voice cloning tools just minutes of audio to create convincing replicas of someone's voice (","textStyle":{}}},{"startIndex":48723,"endIndex":48739,"textRun":{"content":"Qin et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2312.01479"}}}},{"startIndex":48739,"endIndex":48975,"textRun":{"content":"). A similar situation exists in deepfakes where AI is showing progress in one-shot face swapping and manipulation. If only a single image of two individuals exists on the internet, then they can be a target of face swapping deepfakes (","textStyle":{}}},{"startIndex":48975,"endIndex":48991,"textRun":{"content":"Zhu et al., 2021","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2105.04932"}}}},{"startIndex":48991,"endIndex":48993,"textRun":{"content":"; ","textStyle":{}}},{"startIndex":48993,"endIndex":49008,"textRun":{"content":"Li et al., 2022","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2203.12985"}}}},{"startIndex":49008,"endIndex":49010,"textRun":{"content":"; ","textStyle":{}}},{"startIndex":49010,"endIndex":49025,"textRun":{"content":"Xu et al., 2022","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2203.15958"}}}},{"startIndex":49025,"endIndex":49300,"textRun":{"content":") Automated web crawling for open source intelligence (OSINT) to gather photos, audio, interests and information also enables AI-assisted password cracking which has shown to significantly more effective than traditional methods while requiring less computational resources (","textStyle":{}}},{"startIndex":49300,"endIndex":49321,"textRun":{"content":"Slattery et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2408.12622"}}}},{"startIndex":49321,"endIndex":49324,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":49324,"endIndex":49325,"paragraph":{"elements":[{"startIndex":49324,"endIndex":49325,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":49325,"endIndex":49552,"table":{"rows":3,"columns":2,"tableRows":[{"startIndex":49326,"endIndex":49341,"tableCells":[{"startIndex":49327,"endIndex":49333,"content":[{"startIndex":49328,"endIndex":49333,"paragraph":{"elements":[{"startIndex":49328,"endIndex":49333,"textRun":{"content":"type\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":49333,"endIndex":49341,"content":[{"startIndex":49334,"endIndex":49341,"paragraph":{"elements":[{"startIndex":49334,"endIndex":49341,"textRun":{"content":"figure\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"