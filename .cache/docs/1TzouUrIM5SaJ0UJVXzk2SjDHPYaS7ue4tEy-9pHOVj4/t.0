"spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":147774,"endIndex":147992,"content":[{"startIndex":147775,"endIndex":147776,"paragraph":{"elements":[{"startIndex":147775,"endIndex":147776,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}},{"startIndex":147776,"endIndex":147992,"paragraph":{"elements":[{"startIndex":147776,"endIndex":147975,"textRun":{"content":"Race dynamics lead to it being difficult to collaborate and work together on mitigating the risks from AI. The forecast shows how unlikely it is that the USA and China would be willing to cooperate (","textStyle":{}}},{"startIndex":147975,"endIndex":147990,"textRun":{"content":"Metaculus, 2025","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.metaculus.com/questions/38418/us-and-china-reach-an-agreement-to-limit-frontier-ai-development-before-2029/"}}}},{"startIndex":147990,"endIndex":147992,"textRun":{"content":")\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":80,"unit":"PT"}}]}}},{"startIndex":147993,"endIndex":147994,"paragraph":{"elements":[{"startIndex":147993,"endIndex":147994,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":147994,"endIndex":147995,"paragraph":{"elements":[{"startIndex":147994,"endIndex":147995,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":147995,"endIndex":148005,"paragraph":{"elements":[{"startIndex":147995,"endIndex":148005,"textRun":{"content":"Accidents\n","textStyle":{}}}],"paragraphStyle":{"headingId":"h.asi0paagh806","namedStyleType":"HEADING_2","direction":"LEFT_TO_RIGHT"}}},{"startIndex":148005,"endIndex":148006,"paragraph":{"elements":[{"startIndex":148005,"endIndex":148006,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":148006,"endIndex":148888,"paragraph":{"elements":[{"startIndex":148006,"endIndex":148116,"textRun":{"content":"Well-intentioned development can produce catastrophic outcomes through unintentional failures and human error.","textStyle":{"bold":true}}},{"startIndex":148116,"endIndex":148365,"textRun":{"content":" Systems fail in ways their designers never anticipated, often despite careful planning and good intentions. In the Challenger spacecraft disaster, engineers intended a routine launch, but a missing O-ring seal caused an explosion and seven deaths (","textStyle":{}}},{"startIndex":148365,"endIndex":148388,"textRun":{"content":"Rogers Commission, 1986","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://en.wikipedia.org/wiki/Space_Shuttle_Challenger_disaster#Launch_and_failure"}}}},{"startIndex":148388,"endIndex":148550,"textRun":{"content":"). In the Mariner 1 mission, scientists intended to explore Venus, but a missing hyphen in guidance code led to the destruction of the USD 80 million spacecraft (","textStyle":{}}},{"startIndex":148550,"endIndex":148563,"textRun":{"content":"Ceruzzi, 1989","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://mitpress.mit.edu/9780262530828/beyond-the-limits/"}}}},{"startIndex":148563,"endIndex":148750,"textRun":{"content":"). The use of chlorofluorocarbons (CFCs) were intended to create fire extinguishers and refrigerants, but unknowingly created a hole in the ozone layer that threatened all life on Earth (","textStyle":{}}},{"startIndex":148750,"endIndex":148760,"textRun":{"content":"NASA, 2004","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://earthobservatory.nasa.gov/features/RemoteSensingAtmosphere/remote_sensing5.php"}}}},{"startIndex":148760,"endIndex":148888,"textRun":{"content":"). No matter how advanced technology becomes, the fundamental necessity of precision and thorough validation remains unchanged.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":148888,"endIndex":148889,"paragraph":{"elements":[{"startIndex":148888,"endIndex":148889,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":148889,"endIndex":149194,"table":{"rows":3,"columns":2,"tableRows":[{"startIndex":148890,"endIndex":148905,"tableCells":[{"startIndex":148891,"endIndex":148897,"content":[{"startIndex":148892,"endIndex":148897,"paragraph":{"elements":[{"startIndex":148892,"endIndex":148897,"textRun":{"content":"type\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shadi