n":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":10470,"endIndex":10832,"tableCells":[{"startIndex":10471,"endIndex":10480,"content":[{"startIndex":10472,"endIndex":10480,"paragraph":{"elements":[{"startIndex":10472,"endIndex":10480,"textRun":{"content":"caption\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":10480,"endIndex":10832,"content":[{"startIndex":10481,"endIndex":10832,"paragraph":{"elements":[{"startIndex":10481,"endIndex":10820,"textRun":{"content":"The AI safety index report for summer 2025. These scores are for the current harms category and show how effectively the models of various companies mitigate current harms. This includes things like safety benchmark performance, robustness against adversarial attacks, watermarking of AI-generated content, and the treatment of user data (","textStyle":{}}},{"startIndex":10820,"endIndex":10829,"textRun":{"content":"FLI, 2025","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://futureoflife.org/wp-content/uploads/2025/07/FLI-AI-Safety-Index-Report-Summer-2025.pdf"}}}},{"startIndex":10829,"endIndex":10832,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":80,"unit":"PT"}}]}}},{"startIndex":10833,"endIndex":10834,"paragraph":{"elements":[{"startIndex":10833,"endIndex":10834,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":10834,"endIndex":12071,"paragraph":{"elements":[{"startIndex":10834,"endIndex":10914,"textRun":{"content":"Catastrophic risks threaten massive populations but allow for eventual recovery.","textStyle":{"bold":true}}},{"startIndex":10914,"endIndex":11286,"textRun":{"content":" When the number of people affected by risks reaches approximately 10% of the global population, and they become more geographically widespread we call them catastrophic risks. Historical examples include the Black Death (killing one-third of Europe), the 1918 flu pandemic (50-100 million deaths), and potential future scenarios like nuclear war or engineered pandemics (","textStyle":{}}},{"startIndex":11286,"endIndex":11295,"textRun":{"content":"Ord, 2020","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://theprecipice.com/"}}}},{"startIndex":11295,"endIndex":11872,"textRun":{"content":").  In the context of AI, these risks can cause international widespread disruptions. Mass unemployment from AI automation could destabilize entire economies, creating social unrest and political upheaval. Cyberattacks using AI-generated malware could cripple a nation's financial systems or critical infrastructure. AI-enabled surveillance could enable authoritarian control over hundreds of millions of people. Democratic institutions might fail under sustained AI-powered disinformation campaigns that fracture shared reality and make collective decision-making impossible (","textStyle":{}}},{"startIndex":11872,"endIndex":11893,"textRun":{"content":"Slattery et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2408.12622"}}}},{"startIndex":11893,"endIndex":11895,"textRun":{"content":"; ","textStyle":{}}},{"startIndex":11895,"endIndex":11915,"textRun":{"content":"Hammond et al., 2025","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2502.14143"}}}},{"startIndex":11915,"endIndex":11917,"textRun":{"content":"; ","textStyle":{}}},{"startIndex":11917,"endIndex":11937,"textRun":{"content":"Gabriel et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2404.16244"}}}},{"startIndex":11937,"endIndex":11939,"textRun":{"content":"; ","textStyle":{}}},{"startIndex":11939,"endIndex":11957,"textRun":{"content":"Stanford HAI, 2025","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://hai.stanford.edu/ai-index/2025-ai-index-report"}}}},{"startIndex":11957,"endIndex":12071,"textRun":{"content":"). These risks affect millions to billions of people but generally don't prevent eventual recovery or adaptation.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":12071,"endIndex":12072,"paragraph":{"elements":[{"startIndex":12071,"endIndex":12072,"textRun":{"content":"\n","textStyle":{"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"JUSTIFIED","lineSpacing":120.00001,"direction":"LEFT_TO_RIGHT"}}},{"startIndex":12072,"endIndex":12771,"paragraph":{"elements":[{"startIndex":12072,"endIndex":12177,"textRun":{"content":"Existential risks (x-risks) represent threats from which humanity could never recover its full potential.","textStyle":{"bold":true}}},{"startIndex":12177,"endIndex":12603,"textRun":{"content":" Unlike catastrophic risks where recovery remains possible, existential risks either eliminate humanity entirely or permanently prevent civilization from reaching the technological, moral, or cultural heights it might otherwise achieve. AI-related existential risks include scenarios where advanced systems permanently disempower humanity, establish a stable unremovable totalitarian regime, or cause direct human extinction (","textStyle":{}}},{"startIndex":12603,"endIndex":12616,"textRun":{"content":"Bostrom, 2002","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://nickbostrom.com/existential/risks"}}}},{"startIndex":12616,"endIndex":12618,"textRun":{"content":"; ","textStyle":{}}},{"startIndex":12618,"endIndex":12628,"textRun":{"content":"Conn, 2015","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://futureoflife.org/existential-risk/existential-risk/"}}}},{"startIndex":12628,"endIndex":12630,"textRun":{"content":"; ","textStyle":{}}},{"startIndex":12630,"endIndex":12639,"textRun":{"content":"Ord, 2020","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://theprecipice.com/"}}}},{"startIndex":12639,"endIndex":12768,"textRun":{"content":"). These risks demand preventative rather than reactive strategies because learning from failure becomes impossible by definition","textStyle":{}}},{"startIndex":12768,"endIndex":12769,"textRun":{"content":".","textStyle":{}}},{"startIndex":12769,"endIndex":12770,"footnoteReference":{"footnoteId":"kix.a9rldbmj6cq7","footnoteNumber":"1","textStyle":{}}},{"startIndex":12770,"endIndex":12771,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":12771,"endIndex":12772,"paragraph":{"elements":[{"startIndex":12771,"endIndex":12772,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":12772,"endIndex":13029,"table":{"rows":4,"columns":2,"tableRows":[{"startIndex":12773,"endIndex":12792,"tableCells":[{"startIndex":12774,"endIndex":12780,"content":[{"startIndex":12775,"endIndex":12780,"paragraph":{"elements":[{"startIndex":12775,"endIndex":12780,"textRun":{"content":"type\n","textStyle":{"bold":true}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":