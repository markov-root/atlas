ng":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":80175,"endIndex":80179,"content":[{"startIndex":80176,"endIndex":80177,"paragraph":{"elements":[{"startIndex":80176,"endIndex":80177,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}},{"startIndex":80177,"endIndex":80179,"paragraph":{"elements":[{"startIndex":80177,"endIndex":80178,"inlineObjectElement":{"inlineObjectId":"kix.hsgmoiz4c8wi","textStyle":{}}},{"startIndex":80178,"endIndex":80179,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":80179,"endIndex":80611,"tableCells":[{"startIndex":80180,"endIndex":80189,"content":[{"startIndex":80181,"endIndex":80189,"paragraph":{"elements":[{"startIndex":80181,"endIndex":80189,"textRun":{"content":"caption\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":80189,"endIndex":80611,"content":[{"startIndex":80190,"endIndex":80611,"paragraph":{"elements":[{"startIndex":80190,"endIndex":80591,"textRun":{"content":"An example table of a DC gap analysis. We can use the DC gap on various different axes of human values to see how well both the model understands them as well as is able to articulate why. In this example table comparison, types of value where the six models generally perform the best/worst are marked with colors, with redder indicating worse performance and greener indicating better performance. (","textStyle":{}}},{"startIndex":80591,"endIndex":80609,"textRun":{"content":"Zhang et al., 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2310.00378"}}}},{"startIndex":80609,"endIndex":80611,"textRun":{"content":")\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":80,"unit":"PT"}}]}}},{"startIndex":80612,"endIndex":80613,"paragraph":{"elements":[{"startIndex":80612,"endIndex":80613,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"shading":{"backgroundColor":{}}}}},{"startIndex":80613,"endIndex":81391,"paragraph":{"elements":[{"startIndex":80613,"endIndex":80640,"textRun":{"content":"DC Gap and Latent Knowledge","textStyle":{"bold":true}}},{"startIndex":80640,"endIndex":81391,"textRun":{"content":". A large DC gap means that the models know that there are flaws in what they are saying, but they are either unable or unwilling to tell us based on our current prompting methodologies. This has implications for our abilities in being able to get the models to tell us everything that they know (eliciting latent knowledge). Latent knowledge is the underlying information and understanding that a model possesses but may not explicitly articulate or demonstrate unless prompted in a specific way. This knowledge is \"hidden\" in the sense that the model has absorbed patterns, facts, and relationships from its training data, but it requires the right context or questioning to bring them to the surface. A good example of this is medical information.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"shading":{"backgroundColor":{}}}}},{"startIndex":81391,"endIndex":81392,"paragraph":{"elements":[{"startIndex":81391,"endIndex":81392,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"shading":{"backgroundColor":{}}}}},{"startIndex":81392,"endIndex":82145,"paragraph":{"elements":[{"startIndex":81392,"endIndex":81407,"textRun":{"content":"As an example, ","textStyle":{}}},{"startIndex":81407,"endIndex":81652,"textRun":{"content":"GPT-4 has been exposed to huge amounts of information from all over the internet. This includes countless pages of medical research. It seems plausible that GPT-4 could give health advice better than a random internet user on Reddit or Facebook.","textStyle":{"foregroundColor":{"color":{"rgbColor":{"red":0.05490196,"green":0.0627451,"blue":0.101960786}}}}}},{"startIndex":81652,"endIndex":81653,"textRun":{"content":" ","textStyle":{"foregroundColor":{"color":{"rgbColor":{"red":0.59607846}}}}}},{"startIndex":81653,"endIndex":82145,"textRun":{"content":"But it doesn't really seem to “want” to give you good medical advice. Instead, it “wants” to guess the next word while pretending to be a random internet user. Even if GPT-4 has the knowledge, it might not listen to the user's requests for good advice. Text that constitutes bad advice might be considered more likely, or seen more frequently online. So, the AI has a goal to generate likely text, which is misaligned with the user's desire specifically for accurate and helpful information.\n","textStyle":{"foregroundColor":{"color":{"rgbColor":{"red":0.05490196,"green":0.0627451,"blue":0.101960786}}}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"shading":{"backgroundColor":{}}}}},{"startIndex":82145,"endIndex":82146,"paragraph":{"elements":[{"startIndex":82145,"endIndex":82146,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"shading":{"backgroundColor":{}}}}},{"startIndex":82146,"endIndex":82691,"paragraph":{"elements":[{"startIndex":82146,"endIndex":82668,"textRun":{"content":"We want the AI to give us this latent knowledge, i.e. for it to be able to discriminate between good and bad medical advice. Simultaneously we also want to minimize the gap between being able to distinguish good from bad advice, and being able to explain to us “why” this advice is bad. Minimizing the DC gap is particularly important for supervising models that could attempt to mislead human supervisors or hide information. We would like to train equally smart assistance models to point out what humans don’t notice. (","textStyle":{}}},{"startIndex":82668,"endIndex":82689,"textRun":{"content":"Saunders et al., 2022","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2206.05802"}}}},{"startIndex":82689,"endIndex":82691,"textRun":{"content":")\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"shading":{"backgroundColor":{}}}}},{"startIndex":82691,"endIndex":82692,"paragraph":{"elements":[{"startIndex":82691,"endIndex":82692,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"shading":{"backgroundColor":{}}}}},{"startIndex":82692,"endIndex":83205,"paragraph":{"elements":[{"startIndex":82692,"endIndex":82961,"textRun":{"content":"In the original research by OpenAI where the DCG framing was introduced they found that the DC gap was small. However despite the small gap, it is concerning that so far research has shown that as the number of parameters in LLMs increases the DC gap does not reduce. (","textStyle":{}}},{"startIndex":82961,"endIndex":82982,"textRun":{"content":"Saunders et al., 2022","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2206.05802"}}}},{"startIndex":82982,"endIndex":83185,"textRun":{"content":") For example, models like Llama-2 and Llama-3 have shown improvements in discriminator abilities with scale (both parameters and data), but their ability to critique does not improve at the same rate. (","textStyle":{}}},{"startIndex":83185,"endIndex":83203,"textRun":{"content":"Zhang et al., 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2310.00378"}}}},{"startIndex":83203,"endIndex":83205,"textRun":{"content":")\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"shading":{"backgroundColor":{}}}}},{"startIndex":83205,"endIndex":83206,"paragraph":{"elements":[{"startIndex":83205,"endIndex":83206,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"shading":{"backgroundColor":{}}}}},{"startIndex":83206,"endIndex":83213,"paragraph":{"elements":[{"startIndex":83206,"endIndex":83213,"textRun":{"content":"Judges\n","textStyle":{"fontSize":{"magnitude":20,"unit":"PT"}}}}],"paragraphStyle":{"headingId":"h.a7sptlh8q76r","namedStyleType":"HEADING_2","alignment":"START","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"shading":{"backgroundColor":{}}}}},{"startIndex":83213,"endIndex":83214,"paragraph":{"elements":[{"startIndex":83213,"endIndex":83214,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":83214,"endIndex":83701,"paragraph":{"elements":[{"startIndex":83214,"endIndex":83241,"textRun":{"content":"How do we judge the judges?","textStyle":{"bold":true}}},{"startIndex":83241,"endIndex":83679,"textRun":{"content":" Since the introduction of AI Safety via Debate, a central question has been: How well do humans perform as judges? This is particularly important given that LLMs can create answers that sound convincingly right even when they're wrong.  As language models become more capable and are used in more complex settings, it is likely that subtle mistakes, deceptive arguments, or selective use of evidence will become more difficult to spot. (","textStyle":{}}},{"startIndex":83679,"endIndex":83699,"textRun":{"content":"Michael et al., 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2311.08702"}}}},{"startIndex":83699,"endIndex":83701,"textRun":{"content":")\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"shading":{"backgroundColor":{}}}}},{"startIndex":83701,"endIndex":83702,"paragraph":{"elements":[{"startIndex":83701,"endIndex":83702,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"shading":{"backgroundColor":{}}}}},{"startIndex":83702,"endIndex":83818,"paragraph":{"elements":[{"startIndex":83702,"endIndex":83818,"textRun":{"content":"Human judges face several limitations that can affect the quality and reliability of their judgments in AI debates:\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"shading":{"backgroundColor":{}}}}},{"startIndex":83818,"endIndex":84139,"paragraph":{"elements":[{"startIndex":83818,"endIndex":83859,"textRun":{"content":"Firstly, they are vulnerable to fallacies","textStyle":{"bold":true}}},{"startIndex":83859,"endIndex":84139,"textRun":{"content":". Untrained judges may be susceptible to convincing but fallacious reasoning, potentially leading to incorrect judgments. This vulnerability could be exploited by AI debaters, particularly those optimized to win debates by any means necessary, especially by appealing to emotion.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"},"shading":{"backgroundColor":{}}},"bullet":{"listId":"kix.rla2t05av6it","textStyle":{"underline":false}}}},{"startIndex":84139,"endIndex":84398,"paragraph":{"elements":[{"startIndex":84139,"endIndex":84189,"textRun":{"content":"Secondly, there is variability in judgment quality","textStyle":{"bold":true}}},{"startIndex":84189,"endIndex":84398,"textRun":{"content":". Not all human judges are equally skilled. Some may lack the ability to consistently evaluate arguments effectively, making it crucial to identify and filter out less capable judges without introducing bias.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"},"shading":{"backgroundColor":{}}},"bullet":{"listId":"kix.rla2t05av6it","textStyle":{"underline":false}}}},{"startIndex":84398,"endIndex":84598,"paragraph":{"elements":[{"startIndex":84398,"endIndex":84470,"textRun":{"content":"Thirdly, debates can amplify both the strengths and weaknesses of judges","textStyle":{"bold":true}}},{"startIndex":84470,"endIndex":84598,"textRun":{"content":". Strong judges can help eliminate biases and enhance reasoning, while weak judges might see their biases and errors magnified.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"},"shading":{"backgroundColor":{}}},"bullet":{"listId":"kix.rla2t05av6it","textStyle":{"underline":false}}}},{"startIndex":84598,"endIndex":84599,"paragraph":{"elements":[{"startIndex":84598,"endIndex":84599,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"shading":{"backgroundColor":{}}}}},{"startIndex":84599,"endIndex":85495,"paragraph":{"elements":[{"startIndex":84599,"endIndex":85495,"textRun":{"content":"To address these limitations, several strategies can be implemented. Comprehensive training programs for judges can enhance their ability to discern truthful arguments. Methods such as peer review, debiasing techniques, courses in logic, and expert panels can be instrumental in this process. Simplifying debate structures can also help. Structuring debates in a way that is easier to judge—such as focusing  on consensus-building framing and factual statements—can help judges make better decisions. Understanding which debate styles are easier for humans to judge accurately can guide the design of more effective debate protocols. Additionally, developing AI systems to assist or simulate human judges can streamline the judging process. These AI judges would be trained on human judgments to predict outcomes with the effect of reducing the burden on human judges while maintaining accuracy.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"shading":{"backgroundColor":{}}}}},{"startIndex":85495,"endIndex":85496,"paragraph":{"elements":[{"startIndex":85495,"endIndex":85496,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"shading":{"backgroundColor":{}}}}},{"startIndex":85496,"endIndex":86081,"paragraph":{"elements":[{"startIndex":85496,"endIndex":86081,"textRun":{"content":"Another method to improve efficiency is to distill the outcomes of debates into a model that can predict judgments directly from questions. This would be beneficial for high-volume deployments but requires robust model capabilities to generalize well. Lastly, training a secondary AI model to simulate human judges can accelerate the training of debaters. This approach ensures that the AI judge reflects human judgment behavior closely, allowing for scalable oversight. By implementing these strategies, we can improve the reliability and effectiveness of human judges in AI debates.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"shading":{"backgroundColor":{}}}}},{"startIndex":86081,"endIndex":86082,"paragraph":{"elements":[{"startIndex":86081,"endIndex":86082,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"shading":{"backgroundColor":{}}}}},{"startIndex":86082,"endIndex":86819,"paragraph":{"elements":[{"startIndex":86082,"endIndex":86819,"textRun":{"content":"Judge skill is crucial in the context of evaluating debates between expert models because it directly impacts the accuracy and reliability of the final decision. Judges who do not have access to the underlying information rely on their ability to critically evaluate the arguments presented by the debaters. A skilled judge can better identify logical flaws, weigh evidence, and discern persuasive techniques, which leads to more accurate judgments. Conversely, a less skilled judge might be more easily swayed by superficial arguments or rhetorical tricks, potentially leading to incorrect conclusions. Thus, understanding and controlling for judge skill is essential to ensure that the debate protocol is truly effective and reliable.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"shading":{"backgroundColor":{}}}}},{"startIndex":86819,"endIndex":86820,"paragraph":{"elements":[{"startIndex":86819,"endIndex":86820,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"shading":{"backgroundColor":{}}}}},{"startIndex":86820,"endIndex":87021,"paragraph":{"elements":[{"startIndex":86820,"endIndex":87021,"textRun":{"content":"In this section we will go through empirical results as they pertain to the effectiveness of judges in the debate protocol, as well as overall limitations, challenges and requirements for good judges.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"shading":{"backgroundColor":{}}}}},{"startIndex":87021,"endIndex":87022,"paragraph":{"elements":[{"startIndex":87021,"endIndex":87022,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"shading":{"backgroundColor":{}}}}},{"startIndex":87022,"endIndex":88057,"paragraph":{"elements":[{"startIndex":87022,"endIndex":87091,"textRun":{"content":"Debaters as Experts and Judges as Non-Experts (Weak-to-Strong Debate)","textStyle":{"bold":true}}},{"startIndex":87091,"endIndex":88057,"textRun":{"content":". Instead of only thinking about humans as judges, researchers also verify the effectiveness of LLMs as judges. Generally, debaters (also called experts) are simulated using stronger models e.g. GPT-4, and judges are simulated using less capable models, e.g. GPT-2. To create similar information asymmetries between human judges and LLMs, humans are often given less information than the model. As an example , a reading comprehension question over a long fictional passage is presented to the judge with two answer choices (one correct, one incorrect). The judge’s goal is to determine the correct answer to the question given only the debaters’ arguments and limited excerpts selectively revealed by each debater, while the debaters have read and have access to the entire passage. As the passages are entirely fictional, the judge cannot discern the correct answer on the basis of prior knowledge and must rely on the information and arguments from the debaters.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"shading":{"backgroundColor":{}}}}},{"startIndex":88057,"endIndex":88058,"paragraph":{"elements":[{"startIndex":88057,"endIndex":88058,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"shading":{"backgroundColor":{}}}}},{"startIndex":88058,"endIndex":88109,"paragraph":{"elements":[{"startIndex":88058,"endIndex":88109,"textRun":{"content":"Empirically Evaluating the Limits of Human Judges.\n","textStyle":{"bold":true}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"shading":{"backgroundColor":{}}}}},{"startIndex":88109,"endIndex":88377,"paragraph":{"elements":[{"startIndex":88109,"endIndex":88377,"textRun":{"content":"Researchers have been iteratively experimenting with concepts like the number of debate rounds - how long should the debates run? the timing of arguments and how to present the arguments - iteratively or simultaneously?, and how to enhance judges' abilities using AI.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"shading":{"backgroundColor":{}}}}},{"startIndex":88377,"endIndex":88378,"paragraph":{"elements":[{"startIndex":88377,"endIndex":88378,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"shading":{"backgroundColor":{}}}}},{"startIndex":88378,"endIndex":89525,"paragraph":{"elements":[{"startIndex":88378,"endIndex":88396,"textRun":{"content":"Single-Turn Debate","textStyle":{"bold":true}}},{"startIndex":88396,"endIndex":89503,"textRun":{"content":". In this experimental setup in April 2022, researchers took long form passages from the QuALITY dataset. These passages come with multiple choice questions based on those passages. Each passage is around 5,000 words long and includes 20 multiple-choice questions. They hired professional writers to create convincing arguments for both a correct and an incorrect answer to the multiple choice questions. To test the human judges, they used a “single-turn debate” format, meaning each side presented their argument only once without further exchange. Judges were given 90 seconds to read the arguments and the supporting text snippets before deciding which answer was correct. The idea was to see if even a single round of debate could help judges make more accurate decisions. The results showed that the single-turn debate-style explanations did not significantly improve the judges' accuracy compared to providing just the text snippets alone. This indicated that without the opportunity for rebuttal and further clarification, judges couldn't fully grasp the strengths and weaknesses of each argument. (","textStyle":{}}},{"startIndex":89503,"endIndex":89523,"textRun":{"content":"Parrish et al., 2022","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2204.05212"}}}},{"startIndex":89523,"endIndex":89525,"textRun":{"content":")\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"shading":{"backgroundColor":{}}}}},{"startIndex":89525,"endIndex":89526,"paragraph":{"elements":[{"startIndex":89525,"endIndex":89526,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"shading":{"backgroundColor":{}}}}},{"startIndex":89526,"endIndex":90318,"paragraph":{"elements":[{"startIndex":89526,"endIndex":89541,"textRun":{"content":"Two-Turn Debate","textStyle":{"bold":true}}},{"startIndex":89541,"endIndex":90296,"textRun":{"content":". The next obvious step is to see if a two-turn debate helps. So in October of 2022, researchers tried to test whether adding a second round of counter-arguments would improve judges' accuracy. In this two-turn debate format, judges were again presented with initial arguments for both correct and incorrect answers, followed by counter-arguments that addressed the points made in the first round. The goal was to see if this additional back-and-forth would help judges make more informed decisions. Despite these efforts, unfortunately the results showed that even with counter-arguments, human judges did not perform significantly better. The accuracy remained similar to the single-turn format and the baseline where only text snippets were provided. (","textStyle":{}}},{"startIndex":90296,"endIndex":90316,"textRun":{"content":"Parrish et al., 2022","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2210.10860"}}}},{"startIndex":90316,"endIndex":90318,"textRun":{"content":")\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"shading":{"backgroundColor":{}}}}},{"startIndex":90318,"endIndex":90319,"paragraph":{"elements":[{"startIndex":90318,"endIndex":90319,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"shading":{"backgroundColor":{}}}}},{"startIndex":90319,"endIndex":91133,"paragraph":{"elements":[{"startIndex":90319,"endIndex":90355,"textRun":{"content":"Unbounded length Multi-turn debate. ","textStyle":{"bold":true}}},{"startIndex":90355,"endIndex":91111,"textRun":{"content":"Even though we can ask debaters to provide arguments for an assigned position, the debaters were not expected to defend those arguments against significant criticism, because the counters were bounded by the length of the turns. The debater could always lie on the n-th turn of an n-turn debate without having to face repercussions of a counter. Overall, bounded length arguments were not proving to be useful, so the researchers decided to test unbounded length debates, where debaters are expected to have to defend their position against criticism by their opponent for as long as the judge is not convinced of the answer. The conjecture is that since the debate could always go for another round, pressure is always maintained on debaters not to lie. (","textStyle":{}}},{"startIndex":91111,"endIndex":91131,"textRun":{"content":"Michael et al., 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2311.08702"}}}},{"startIndex":91131,"endIndex":91133,"textRun":{"content":")\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"shading":{"backgroundColor":{}}}}},{"startIndex":91133,"endIndex":91134,"paragraph":{"elements":[{"startIndex":91133,"endIndex":91134,"textRun":{"content":"\n","textStyle":{"bold":true}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"shading":{"backgroundColor":{}}}}},{"startIndex":91134,"endIndex":91396,"paragraph":{"elements":[{"startIndex":91134,"endIndex":91375,"textRun":{"content":"Debate is where two AI’s compete to convince a judge; A consultancy is where a single AI tries to convince a judge that asks questions; and direct question-answering is another baseline where the judge just answers outright without the AI. (","textStyle":{}}},{"startIndex":91375,"endIndex":91394,"textRun":{"content":"Kenton et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2407.04622"}}}},{"startIndex":91394,"endIndex":91396,"textRun":{"content":")\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"shading":{"backgroundColor":{}}}}},{"startIndex":91396,"endIndex":91397,"paragraph":{"elements":[{"startIndex":91396,"endIndex":91397,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"shading":{"backgroundColor":{}}}}},{"startIndex":91397,"endIndex":92110,"table":{"rows":3,"columns":2,"tableRows":[{"startIndex":91398,"endIndex":91413,"tableCells":[{"startIndex":91399,"endIndex":91405,"content":[{"startIndex":91400,"endIndex":91405,"paragraph":{"elements":[{"startIndex":91400,"endIndex":91405,"textRun":{"content":"type\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"un