tartIndex":44983,"endIndex":44984,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":44984,"endIndex":45378,"tableCells":[{"startIndex":44985,"endIndex":44994,"content":[{"startIndex":44986,"endIndex":44994,"paragraph":{"elements":[{"startIndex":44986,"endIndex":44994,"textRun":{"content":"content\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":44994,"endIndex":45378,"content":[{"startIndex":44995,"endIndex":45378,"paragraph":{"elements":[{"startIndex":44995,"endIndex":45378,"textRun":{"content":"The exact way the post-AGI world will look is hard to predict — that world will likely be more different from today's world than today's is from the 1500s [...] We do not yet know how hard it will be to make sure AGIs act according to the values of their operators. Some people believe it will be easy; some people believe it'll be unimaginably difficult; but no one knows for sure.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":80,"unit":"PT"}}]}}},{"startIndex":45379,"endIndex":45380,"paragraph":{"elements":[{"startIndex":45379,"endIndex":45380,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":45380,"endIndex":46378,"paragraph":{"elements":[{"startIndex":45380,"endIndex":45451,"textRun":{"content":"Expert predictions consistently fail to capture AI's actual trajectory.","textStyle":{"bold":true}}},{"startIndex":45451,"endIndex":45689,"textRun":{"content":" If you read media coverage of ChatGPT — which called it ‘breathtaking’, ‘dazzling’, ‘astounding’ — you’d get the sense that large language models (LLMs) took the world completely by surprise. Is that impression accurate? Actually, yes. (","textStyle":{}}},{"startIndex":45689,"endIndex":45700,"textRun":{"content":"Cotra, 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.planned-obsolescence.org/language-models-surprised-us/"}}}},{"startIndex":45700,"endIndex":45891,"textRun":{"content":") GPT-3's capabilities exceeded what many thought possible with simple scaling. Each major breakthrough seems to come from unexpected directions, making long-term planning nearly impossible (","textStyle":{}}},{"startIndex":45891,"endIndex":45917,"textRun":{"content":"Gruetzemacher et al., 2021","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.sciencedirect.com/science/article/pii/S0040162521003413"}}}},{"startIndex":45917,"endIndex":45918,"textRun":{"content":";","textStyle":{}}},{"startIndex":45918,"endIndex":45937,"textRun":{"content":" Grace et al., 2017","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/1705.08807"}}}},{"startIndex":45937,"endIndex":46364,"textRun":{"content":"). The \"scaling hypothesis\" (larger models with more compute reliably produce more capable systems) has held surprisingly well. But we don't know if this continues to AGI or hits fundamental technical or economic limits. This uncertainty has massive governance implications. If scaling continues, compute controls remain effective. If algorithmic breakthroughs matter more, entirely different governance approaches are needed (","textStyle":{}}},{"startIndex":46364,"endIndex":46375,"textRun":{"content":"Patel, 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.dwarkesh.com/p/will-scaling-work"}}}},{"startIndex":46375,"endIndex":46378,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":46378,"endIndex":46379,"paragraph":{"elements":[{"startIndex":46378,"endIndex":46379,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":46379,"endIndex":46757,"paragraph":{"elements":[{"startIndex":46379,"endIndex":46424,"textRun":{"content":"Risk assessments vary by orders of magnitude.","textStyle":{"bold":true}}},{"startIndex":46424,"endIndex":46730,"textRun":{"content":" Some researchers assign negligible probability to existential risks from AI, while others consider them near-certain without intervention, reflecting fundamental uncertainty about AI's trajectory and controllability. When experts disagree this dramatically, how can policymakers make informed decisions? (","textStyle":{}}},{"startIndex":46730,"endIndex":46754,"textRun":{"content":"Narayanan & Kapoor, 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.aisnakeoil.com/p/ai-existential-risk-probabilities"}}}},{"startIndex":46754,"endIndex":46757,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":46757,"endIndex":46758,"paragraph":{"elements":[{"startIndex":46757,"endIndex":46758,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":46758,"endIndex":47425,"paragraph":{"elements":[{"startIndex":46758,"endIndex":46805,"textRun":{"content":"Capability emergence surprises even developers.","textStyle":{"bold":true}}},{"startIndex":46805,"endIndex":46893,"textRun":{"content":" Models demonstrate abilities their creators didn't anticipate and can't fully explain (","textStyle":{}}},{"startIndex":46893,"endIndex":46904,"textRun":{"content":"Cotra, 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.planned-obsolescence.org/language-models-surprised-us/"}}}},{"startIndex":46904,"endIndex":47120,"textRun":{"content":"). If the people building these systems can't predict their capabilities, how can governance frameworks anticipate what needs regulating? This unpredictability compounds with each generation of more powerful models (","textStyle":{}}},{"startIndex":47120,"endIndex":47138,"textRun":{"content":"Grace et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2401.02843"}}}},{"startIndex":47138,"endIndex":47425,"textRun":{"content":"). Traditional policy-making assumes predictable outcomes. Environmental regulations model pollution impacts. Drug approval evaluates specific health effects. But AI governance must prepare for scenarios ranging from gradual capability improvements to sudden recursive self-improvement.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":47425,"endIndex":47426,"paragraph":{"elements":[{"startIndex":47425,"endIndex":47426,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":47426,"endIndex":47802,"paragraph":{"elements":[{"startIndex":47426,"endIndex":47471,"textRun":{"content":"Waiting for certainty means waiting too long.","textStyle":{"bold":true}}},{"startIndex":47471,"endIndex":47787,"textRun":{"content":" By the time we know exactly what AI capabilities will emerge, it may be too late to govern them effectively. Yet acting under uncertainty risks implementing wrong-headed policies that stifle beneficial development or fail to prevent actual risks. This creates a debilitating dilemma for conscientious policymakers (","textStyle":{}}},{"startIndex":47787,"endIndex":47799,"textRun":{"content":"Casper, 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/html/2502.09618v1"}}}},{"startIndex":47799,"endIndex":47802,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":47802,"endIndex":47803,"paragraph":{"elements":[{"startIndex":47802,"endIndex":47803,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":47803,"endIndex":48095,"paragraph":{"elements":[{"startIndex":47803,"endIndex":47848,"textRun":{"content":"How can governance operate under uncertainty?","textStyle":{"bold":true}}},{"startIndex":47848,"endIndex":48095,"textRun":{"content":" Adaptive governance models that could keep pace with rapidly changing technology could offer a path forward. Rather than fixed regulations based on current understanding, we need frameworks that can evolve with our knowledge. This might include:\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":48095,"endIndex":48168,"paragraph":{"elements":[{"startIndex":48095,"endIndex":48168,"textRun":{"content":"Regulatory triggers based on capability milestones rather than timelines\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.fnbloncbv13c","textStyle":{}}}},{"startIndex":48168,"endIndex":48227,"paragraph":{"elements":[{"startIndex":48168,"endIndex":48227,"textRun":{"content":"Sunset clauses that force regular reconsideration of rules\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.fnbloncbv13c","textStyle":{}}}},{"startIndex":48227,"endIndex":48291,"paragraph":{"elements":[{"startIndex":48227,"endIndex":48291,"textRun":{"content":"Safe harbors for experimentation within controlled environments\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.fnbloncbv13c","textStyle":{}}}},{"startIndex":48291,"endIndex":48374,"paragraph":{"elements":[{"startIndex":48291,"endIndex":48374,"textRun":{"content":"Rapid-response institutions capable of updating policies as understanding improves\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.fnbloncbv13c","textStyle":{}}}},{"startIndex":48374,"endIndex":48375,"paragraph":{"elements":[{"startIndex":48374,"endIndex":48375,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":48375,"endIndex":48833,"paragraph":{"elements":[{"startIndex":48375,"endIndex":48438,"textRun":{"content":"Building consensus despite uncertainty requires new approaches.","textStyle":{"bold":true}}},{"startIndex":48438,"endIndex":48833,"textRun":{"content":" Traditional policy consensus emerges from shared understanding of problems and solutions. With AI, we lack both. Yet somehow we must build sufficient agreement to implement governance before capabilities outrace our ability to control them. This may require focusing on process legitimacy rather than outcome certainty agreeing on how to make decisions even when we disagree on what to decide.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":48833,"endIndex":48834,"paragraph":{"elements":[{"startIndex":48833,"endIndex":48834,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":48834,"endIndex":48849,"paragraph":{"elements":[{"startIndex":48834,"endIndex":48849,"textRun":{"content":"Accountability\n","textStyle":{}}}],"paragraphStyle":{"headingId":"h.vlqpe0rujp6e","namedStyleType":"HEADING_2","direction":"LEFT_TO_RIGHT"}}},{"startIndex":48849,"endIndex":48850,"paragraph":{"elements":[{"startIndex":48849,"endIndex":48850,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":48850,"endIndex":49384,"table":{"rows":6,"columns":2,"tableRows":[{"startIndex":48851,"endIndex":48865,"tableCells":[{"startIndex":48852,"endIndex":48858,"content":[{"startIndex":48853,"endIndex":48858,"paragraph":{"elements":[{"startIndex":48853,"endIndex":48858,"textRun":{"content":"type\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit