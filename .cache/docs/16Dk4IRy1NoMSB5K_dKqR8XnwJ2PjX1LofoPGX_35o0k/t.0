ng":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":42580,"endIndex":42701,"content":[{"startIndex":42581,"endIndex":42701,"paragraph":{"elements":[{"startIndex":42581,"endIndex":42678,"textRun":{"content":"Table of evasion techniques to avoid verification methods under current national technical means.","textStyle":{"backgroundColor":{"color":{"rgbColor":{"red":1,"green":1,"blue":1}}}}}},{"startIndex":42678,"endIndex":42680,"textRun":{"content":" (","textStyle":{}}},{"startIndex":42680,"endIndex":42698,"textRun":{"content":"Wasil et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2408.16074"}}}},{"startIndex":42698,"endIndex":42701,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":80,"unit":"PT"}}]}}},{"startIndex":42702,"endIndex":43400,"paragraph":{"elements":[{"startIndex":42702,"endIndex":42739,"textRun":{"content":"Dual-use nature complicates controls.","textStyle":{"bold":true}}},{"startIndex":42739,"endIndex":43071,"textRun":{"content":" The same transformer architecture that powers beneficial applications can also enable harmful uses. Unlike specialized military technology, we can't simply ban dangerous AI capabilities without eliminating beneficial ones. This dual-use problem means governance must be far more nuanced than traditional non-proliferation regimes (","textStyle":{}}},{"startIndex":43071,"endIndex":43087,"textRun":{"content":"Anderljung, 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.governance.ai/research-paper/protecting-society-from-ai-misuse-when-are-restrictions-on-capabilities-warranted"}}}},{"startIndex":43087,"endIndex":43400,"textRun":{"content":"). A motivated individual with modest resources can now fine-tune powerful models for harmful purposes. This democratization of capabilities means threats can emerge from anywhere, not just nation-states or major corporations. Traditional governance frameworks aren't designed for this level of distributed risk.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":43400,"endIndex":43401,"paragraph":{"elements":[{"startIndex":43400,"endIndex":43401,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":43401,"endIndex":43551,"paragraph":{"elements":[{"startIndex":43401,"endIndex":43447,"textRun":{"content":"How can governance help slow AI proliferation?","textStyle":{"bold":true}}},{"startIndex":43447,"endIndex":43551,"textRun":{"content":" Several potential solutions have been proposed to find the right balance between openness and control:\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":43551,"endIndex":43750,"paragraph":{"elements":[{"startIndex":43551,"endIndex":43569,"textRun":{"content":"Targeted openness.","textStyle":{"bold":true}}},{"startIndex":43569,"endIndex":43736,"textRun":{"content":" Publish fundamental research but withhold model weights and fine-tuning recipes for high-risk capabilities, keeping collaboration alive while denying turnkey misuse (","textStyle":{}}},{"startIndex":43736,"endIndex":43747,"textRun":{"content":"Seger, 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2311.09227"}}}},{"startIndex":43747,"endIndex":43750,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.nq9ge69c9bik","textStyle":{}}}},{"startIndex":43750,"endIndex":43980,"paragraph":{"elements":[{"startIndex":43750,"endIndex":43766,"textRun":{"content":"Staged releases.","textStyle":{"bold":true}}},{"startIndex":43766,"endIndex":43963,"textRun":{"content":" Roll out progressively stronger versions only after each tier passes red-team audits and external review, giving society time to surface failure modes and tighten safeguards before the next step (","textStyle":{}}},{"startIndex":43963,"endIndex":43977,"textRun":{"content":"Solaiman, 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2302.04844"}}}},{"startIndex":43977,"endIndex":43980,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.nq9ge69c9bik","textStyle":{}}}},{"startIndex":43980,"endIndex":44196,"paragraph":{"elements":[{"startIndex":43980,"endIndex":44010,"textRun":{"content":"Enhanced information security.","textStyle":{"bold":true}}},{"startIndex":44010,"endIndex":44176,"textRun":{"content":" Treat frontier checkpoints like crown-jewel secrets: hardened build pipelines, model-weight encryption in use and at rest, and continuous insider-threat monitoring (","textStyle":{}}},{"startIndex":44176,"endIndex":44193,"textRun":{"content":"Nevo et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.rand.org/pubs/research_reports/RRA2849-1.html"}}}},{"startIndex":44193,"endIndex":44196,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.nq9ge69c9bik","textStyle":{}}}},{"startIndex":44196,"endIndex":44439,"paragraph":{"elements":[{"startIndex":44196,"endIndex":44244,"textRun":{"content":"Export controls and compute access restrictions.","textStyle":{"bold":true}}},{"startIndex":44244,"endIndex":44416,"textRun":{"content":" Block shipment of the most advanced AI accelerators to unvetted end-users and require cloud providers to gate high-end training clusters behind Know-Your-Customer checks (","textStyle":{}}},{"startIndex":44416,"endIndex":44436,"textRun":{"content":"O’Brien et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.iaps.ai/research/coordinated-disclosure"}}}},{"startIndex":44436,"endIndex":44439,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.nq9ge69c9bik","textStyle":{}}}},{"startIndex":44439,"endIndex":44654,"paragraph":{"elements":[{"startIndex":44439,"endIndex":44462,"textRun":{"content":"Responsible disclosure.","textStyle":{"bold":true}}},{"startIndex":44462,"endIndex":44631,"textRun":{"content":" Adopt cybersecurity-style norms for reporting newly discovered “dangerous capability routes,” so labs alert peers and regulators without publishing full exploit paths (","textStyle":{}}},{"startIndex":44631,"endIndex":44651,"textRun":{"content":"O’Brien et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.iaps.ai/research/coordinated-disclosure"}}}},{"startIndex":44651,"endIndex":44654,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.nq9ge69c9bik","textStyle":{}}}},{"startIndex":44654,"endIndex":44856,"paragraph":{"elements":[{"startIndex":44654,"endIndex":44680,"textRun":{"content":"Built-in technical brakes.","textStyle":{"bold":true}}},{"startIndex":44680,"endIndex":44836,"textRun":{"content":" Embed jailbreak-resistant tuning, capability throttles and provenance watermarks that survive model distillation, adding friction even after weights leak (","textStyle":{}}},{"startIndex":44836,"endIndex":44853,"textRun":{"content":"Dong et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2406.02622"}}}},{"startIndex":44853,"endIndex":44855,"textRun":{"content":").","textStyle":{}}},{"startIndex":44855,"endIndex":44856,"textRun":{"content":"\n","textStyle":{"bold":true}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.nq9ge69c9bik","textStyle":{}}}},{"startIndex":44856,"endIndex":44857,"paragraph":{"elements":[{"startIndex":44856,"endIndex":44857,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":44857,"endIndex":448