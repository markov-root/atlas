eCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":59720,"endIndex":59951,"tableCells":[{"startIndex":59721,"endIndex":59730,"content":[{"startIndex":59722,"endIndex":59730,"paragraph":{"elements":[{"startIndex":59722,"endIndex":59730,"textRun":{"content":"content\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":59730,"endIndex":59951,"content":[{"startIndex":59731,"endIndex":59951,"paragraph":{"elements":[{"startIndex":59731,"endIndex":59951,"textRun":{"content":"Almost every decision I make feels like it’s balanced on the edge of a knife. If we don’t build fast enough, authoritarian countries could win. If we build too fast, the kinds of risks we’ve written about could prevail.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":80,"unit":"PT"}}]}}},{"startIndex":59952,"endIndex":59953,"paragraph":{"elements":[{"startIndex":59952,"endIndex":59953,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":59953,"endIndex":60418,"paragraph":{"elements":[{"startIndex":59953,"endIndex":60418,"textRun":{"content":"In this section we'll look at how AI companies approach governance in practice. We'll look at what works, what doesn't, and where gaps remain. This will help us understand why corporate governance alone isn't enough, and set the scene for later discussions of national and international governance. By the end of this section, we'll establish both the essential role of company-level governance and why it needs to be complemented by broader regulatory frameworks.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":60418,"endIndex":60419,"paragraph":{"elements":[{"startIndex":60418,"endIndex":60419,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":60419,"endIndex":61297,"paragraph":{"elements":[{"startIndex":60419,"endIndex":60563,"textRun":{"content":"Corporate governance refers to the internal structures, practices, and processes that determine how AI companies make safety-relevant decisions.","textStyle":{"bold":true}}},{"startIndex":60563,"endIndex":60713,"textRun":{"content":" Companies developing frontier AI have unique visibility into emerging capabilities and can implement safety measures faster than external regulators ","textStyle":{}}},{"startIndex":60713,"endIndex":60738,"textRun":{"content":"(Anderljung et al., 2023)","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"http://arxiv.org/abs/2307.03718"}}}},{"startIndex":60738,"endIndex":60739,"textRun":{"content":";","textStyle":{}}},{"startIndex":60739,"endIndex":60759,"textRun":{"content":" Sastry et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2402.08797"}}}},{"startIndex":60759,"endIndex":60956,"textRun":{"content":"). They have the technical knowledge and direct control needed to implement effective safeguards, but they also face immense market pressures that can push against taking time for safety measures (","textStyle":{}}},{"startIndex":60956,"endIndex":60977,"textRun":{"content":"Friedman et al., 2007","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://doi.org/10.1007/978-3-540-70818-6_14"}}}},{"startIndex":60977,"endIndex":61256,"textRun":{"content":"). It includes policies, oversight structures, technical protocols, and organizational norms that companies use to ensure safety throughout the AI development process. These mechanisms translate high-level principles into operational decisions within labs and development teams (","textStyle":{}}},{"startIndex":61256,"endIndex":61274,"textRun":{"content":"Zhang et al., 2021","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2105.02117"}}}},{"startIndex":61274,"endIndex":61275,"textRun":{"content":";","textStyle":{}}},{"startIndex":61275,"endIndex":61294,"textRun":{"content":" Cihon et al., 2021","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2012.06505"}}}},{"startIndex":61294,"endIndex":61297,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":61297,"endIndex":61298,"paragraph":{"elements":[{"startIndex":61297,"endIndex":61298,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":61298,"endIndex":61749,"paragraph":{"elements":[{"startIndex":61298,"endIndex":61442,"textRun":{"content":"Internal corporate governance mechanisms matter because frontier AI companies currently have significant freedom in governing their own systems.","textStyle":{"bold":true}}},{"startIndex":61442,"endIndex":61590,"textRun":{"content":" Their proximity to development allows them to identify and address risks earlier and more effectively than external oversight alone could achieve (","textStyle":{}}},{"startIndex":61590,"endIndex":61608,"textRun":{"content":"Zhang et al., 2021","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2105.02117"}}}},{"startIndex":61608,"endIndex":61749,"textRun":{"content":"). However, internal governance alone cannot address systemic risks; these require public oversight, which we explore later in this chapter.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":61749,"endIndex":61750,"paragraph":{"elements":[{"startIndex":61749,"endIndex":61750,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT",