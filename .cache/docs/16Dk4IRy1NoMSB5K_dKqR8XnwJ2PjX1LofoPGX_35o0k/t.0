ogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":25244,"endIndex":25248,"content":[{"startIndex":25245,"endIndex":25246,"paragraph":{"elements":[{"startIndex":25245,"endIndex":25246,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}},{"startIndex":25246,"endIndex":25248,"paragraph":{"elements":[{"startIndex":25246,"endIndex":25247,"inlineObjectElement":{"inlineObjectId":"kix.wciurt28ik8l","textStyle":{}}},{"startIndex":25247,"endIndex":25248,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":25248,"endIndex":25665,"tableCells":[{"startIndex":25249,"endIndex":25258,"content":[{"startIndex":25250,"endIndex":25258,"paragraph":{"elements":[{"startIndex":25250,"endIndex":25258,"textRun":{"content":"caption\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":25258,"endIndex":25665,"content":[{"startIndex":25259,"endIndex":25665,"paragraph":{"elements":[{"startIndex":25259,"endIndex":25642,"textRun":{"content":"Estimates of the scale constraints imposed by the most important bottlenecks to scale. Each estimate is based on historical projections. The dark shaded box corresponds to an interquartile range and light shaded region to an 80 percent confidence interval. The four boxes showcase four constraints that might slow down growth in the future: power, chips (compute), data and latency (","textStyle":{}}},{"startIndex":25642,"endIndex":25662,"textRun":{"content":"Sevilla et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://epoch.ai/blog/can-ai-scaling-continue-through-2030"}}}},{"startIndex":25662,"endIndex":25665,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":80,"unit":"PT"}}]}}},{"startIndex":25666,"endIndex":25667,"paragraph":{"elements":[{"startIndex":25666,"endIndex":25667,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":25667,"endIndex":26112,"paragraph":{"elements":[{"startIndex":25667,"endIndex":25721,"textRun":{"content":"Smaller more specialized models can still cause risks.","textStyle":{"bold":true}}},{"startIndex":25721,"endIndex":26066,"textRun":{"content":" Different domains have very different compute requirements. Highly specialized models trained on specific datasets might develop dangerous capabilities while using relatively modest compute. For example, models focused on biological or cybersecurity domains could pose serious risks even with compute usage below typical regulatory thresholds (","textStyle":{}}},{"startIndex":26066,"endIndex":26085,"textRun":{"content":"Mouton et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.rand.org/pubs/research_reports/RRA2977-1.html"}}}},{"startIndex":26085,"endIndex":26086,"textRun":{"content":";","textStyle":{}}},{"startIndex":26086,"endIndex":26108,"textRun":{"content":" Heim & Koessler, 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2405.10799"}}}},{"startIndex":26108,"endIndex":26112,"textRun":{"content":"). \n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":26112,"endIndex":26113,"paragraph":{"elements":[{"startIndex":26112,"endIndex":26113,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":26113,"endIndex":27243,"paragraph":{"elements":[{"startIndex":26113,"endIndex":26225,"textRun":{"content":"Compute governance can help manage AI risks, but overly restrictive controls can accelerate power concentration.","textStyle":{"bold":true}}},{"startIndex":26225,"endIndex":26318,"textRun":{"content":" Only a handful of organizations can afford the compute needed for frontier AI development. (","textStyle":{}}},{"startIndex":26318,"endIndex":26338,"textRun":{"content":"Purtova et al., 2022","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2212.10244"}}}},{"startIndex":26338,"endIndex":26339,"textRun":{"content":";","textStyle":{}}},{"startIndex":26339,"endIndex":26357,"textRun":{"content":" Pilz et al., 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2311.02651"}}}},{"startIndex":26357,"endIndex":26496,"textRun":{"content":"). Adding more barriers could worsen this disparity, concentrating power in a few large tech companies and reducing independent oversight (","textStyle":{}}},{"startIndex":26496,"endIndex":26518,"textRun":{"content":"Besiroglu et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2401.02452"}}}},{"startIndex":26518,"endIndex":26721,"textRun":{"content":"). Academic researchers already struggle to access the compute they need for meaningful AI research. As models get larger and more compute-intensive, this gap between industry and academia grows wider. (","textStyle":{}}},{"startIndex":26721,"endIndex":26743,"textRun":{"content":"Besiroglu et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2401.02452"}}}},{"startIndex":26743,"endIndex":26744,"textRun":{"content":";","textStyle":{}}},{"startIndex":26744,"endIndex":26763,"textRun":{"content":" Zhang et al., 2021","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2104.07237"}}}},{"startIndex":26763,"endIndex":27221,"textRun":{"content":") Large compute clusters have many legitimate uses beyond AI development, from scientific research to business applications. Overly broad restrictions could hinder beneficial innovation. Additionally, once models are trained, they can often be run for inference using much less compute than training required. This makes it challenging to control how existing models are used without imposing overly restrictive controls on general computing infrastructure (","textStyle":{}}},{"startIndex":27221,"endIndex":27240,"textRun":{"content":"Sastry et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2402.08797"}}}},{"startIndex":27240,"endIndex":27243,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":27243,"endIndex":27244,"paragraph":{"elements":[{"startIndex":27243,"endIndex":27244,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":27244,"endIndex":27967,"paragraph":{"elements":[{"startIndex":27244,"endIndex":27331,"textRun":{"content":"Distributed training and inference approaches could bypass compute governance controls.","textStyle":{"bold":true}}},{"startIndex":27331,"endIndex":27593,"textRun":{"content":" Currently, training frontier models requires concentrating massive compute resources in single locations due to communication requirements between chips. Decentralized training methods are being researched, but have not really caught up to centralized methods (","textStyle":{}}},{"startIndex":27593,"endIndex":27615,"textRun":{"content":"Douillard et al., 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2311.08105"}}}},{"startIndex":27615,"endIndex":27616,"textRun":{"content":";","textStyle":{}}},{"startIndex":27616,"endIndex":27638,"textRun":{"content":" Jaghouar et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2407.07852"}}}},{"startIndex":27638,"endIndex":27640,"textRun":{"content":").","textStyle":{}}},{"startIndex":27640,"endIndex":27641,"footnoteReference":{"footnoteId":"kix.1xxb7ilq89dq","footnoteNumber":"1","textStyle":{}}},{"startIndex":27641,"endIndex":27941,"textRun":{"content":" However, if we see fundamental advances in distributed training algorithms this could eventually allow training to be split across multiple smaller facilities. While this remains technically challenging and inefficient, it could make detection and control of dangerous training runs more difficult (","textStyle":{}}},{"startIndex":27941,"endIndex":27964,"textRun":{"content":"Anderljung et al., 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2307.03718"}}}},{"startIndex":27964,"endIndex":27967,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":27967,"endIndex":27968,"paragraph":{"elements":[{"startIndex":27967,"endIndex":27968,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":27968,"endIndex":27969,"paragraph":{"elements":[{"startIndex":27968,"endIndex":27969,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":27969,"endIndex":28416,"paragraph":{"elements":[{"startIndex":27969,"endIndex":28070,"textRun":{"content":"Compute monitoring and compute thresholds should primarily operate as an initial screening mechanism.","textStyle":{"bold":true}}},{"startIndex":28070,"endIndex":28416,"textRun":{"content":" These approaches should be used mainly to identify models warranting further scrutiny, rather than as the sole determinant of specific regulatory requirements. They are most effective when used to trigger oversight mechanisms such as notification requirements and risk assessments, whose results can then inform appropriate mitigation measures.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":28416,"endIndex":28417,"paragraph":{"elements":[{"startIndex":28416,"endIndex":28417,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":28417,"endIndex":29305,"paragraph":{"elements":[{"startIndex":28417,"endIndex":28521,"textRun":{"content":"Technical governance measures need to coordinate with corporate, national and international initiatives.","textStyle":{"bold":true}}},{"startIndex":28521,"endIndex":29305,"textRun":{"content":" We focused on compute governance as our primary technical example, though coordination challenges apply equally to data governance, model governance, and other technical measures. Each approach faces the same fundamental limitation: technical measures alone cannot address systemic risks that emerge from competitive dynamics and global deployment. This is why technical measures must be embedded within corporate, national and international governance frameworks that align incentives with coordinated safety standards. Before we talk about those however, we need to explore broader concepts like decision making under uncertainty, game theoretic collective action problems and other systemic forces that shape the governance landscape. We will talk about this in the next section.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":29305,"endIndex":29306,"paragraph":{"elements":[{"startIndex":29305,"endIndex":29306,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":29306,"endIndex":29326,"paragraph":{"elements":[{"startIndex":29306,"endIndex":29326,"textRun":{"content":"Systemic Challenges\n","textStyle":{"bold":true,"foregroundColor":{"color":{"rgbColor":{"red":0.05490196,"green":0.0627451,"blue":0.101960786}}},"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}}],"paragraphStyle":{"headingId":"h.w47ryqq1ac90","namedStyleType":"HEADING_1","alignment":"JUSTIFIED","lineSpacing":120.00001,"direction":"LEFT_TO_RIGHT","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false}}},{"startIndex":29326,"endIndex":29327,"paragraph":{"elements":[{"startIndex":29326,"endIndex":29327,"textRun":{"content":"\n","textStyle":{"fontSize":{"magnitude":11,"unit":"PT"}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":29327,"endIndex":29567,"table":{"rows":2,"columns":2,"tableRows":[{"startIndex":29328,"endIndex":29356,"tableCells":[{"startIndex":29329,"endIndex":29335,"content":[{"startIndex":29330,"endIndex":29335,"paragraph":{"elements":[{"startIndex":29330,"endIndex":29335,"textRun":{"content":"type\n","textStyle":{"fontSize":{"magnitude":11,"unit":"PT"}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}}}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":29335,"endIndex":29356,"content":[{"startIndex":29336,"endIndex":29356,"paragraph":{"elements":[{"startIndex":29336,"endIndex":29356,"textRun":{"content":"section-description\n","textStyle":{"fontSize":{"magnitude":11,"unit":"PT"}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}}}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":29356,"endIndex":29566,"tableCells":[{"startIndex":29357,"endIndex":29366,"content":[{"startIndex":29358,"endIndex":29366,"paragraph":{"elements":[{"startIndex":29358,"endIndex":29366,"textRun":{"content":"content\n","textStyle":{"fontSize":{"magnitude":11,"unit":"PT"}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}}}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":29366,"endIndex":29566,"content":[{"startIndex":29367,"endIndex":29566,"paragraph":{"elements":[{"startIndex":29367,"endIndex":29566,"textRun":{"content":"Effective AI governance is hindered by competitive race dynamics, rapid proliferation, uncertainty about future developments, and the concentration of accountability in a handful of powerful actors.\n","textStyle":{"fontSize":{"magnitude":11,"unit":"PT"}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":80,"unit":"PT"}}]}}},{"startIndex":29567,"endIndex":29568,"paragraph":{"elements":[{"startIndex":29567,"endIndex":29568,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":29568,"endIndex":29582,"paragraph":{"elements":[{"startIndex":29568,"endIndex":29582,"textRun":{"content":"Race dynamics\n","textStyle":{"bold":true,"foregroundColor":{"color":{"rgbColor":{"red":0.05490196,"green":0.0627451,"blue":0.101960786}}},"fontSize":{"magnitude":17,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}}],"paragraphStyle":{"headingId":"h.bl16goqaue65","namedStyleType":"HEADING_2","alignment":"JUSTIFIED","lineSpacing":120.00001,"direction":"LEFT_TO_RIGHT","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false}}},{"startIndex":29582,"endIndex":29583,"paragraph":{"elements":[{"startIndex":29582,"endIndex":29583,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":29583,"endIndex":30108,"table":{"rows":6,"columns":2,"tableRows":[{"startIndex":29584,"endIndex":29598,"tableCells":[{"startIndex":29585,"endIndex":29591,"content":[{"startIndex":29586,"endIndex":29591,"paragraph":{"elements":[{"startIndex":29586,"endIndex":29591,"textRun":{"content":"type\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"P