PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":64572,"endIndex":64770,"content":[{"startIndex":64573,"endIndex":64770,"paragraph":{"elements":[{"startIndex":64573,"endIndex":64757,"textRun":{"content":"The figure illustrates a self-reinforcing loop in which AI systems progressively automate AI research, leading to increasingly capable AI that further accelerates its own development (","textStyle":{}}},{"startIndex":64757,"endIndex":64767,"textRun":{"content":"Stix, 2025","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2504.12170"}}}},{"startIndex":64767,"endIndex":64770,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":80,"unit":"PT"}}]}}},{"startIndex":64771,"endIndex":64772,"paragraph":{"elements":[{"startIndex":64771,"endIndex":64772,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":64772,"endIndex":65409,"paragraph":{"elements":[{"startIndex":64772,"endIndex":64878,"textRun":{"content":"Organizational structures establish who makes decisions and who is responsible for safety in AI companies.","textStyle":{"bold":true}}},{"startIndex":64878,"endIndex":65409,"textRun":{"content":" Later sections cover specific safety mechanisms, here, we focus on the governance question: who has the authority within companies to prioritize safety over other goals? For example, an effective governance structure determines whether a safety team can delay a model release if they identify concerns, whether executives can override safety decisions, and whether the board has final authority over high-risk deployments. These authority relationships directly affect how safety considerations factor into development decisions.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":65409,"endIndex":65410,"paragraph":{"elements":[{"startIndex":65409,"endIndex":65410,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":65410,"endIndex":65657,"paragraph":{"elements":[{"startIndex":65410,"endIndex":65535,"textRun":{"content":"Corporate AI governance needs a combination of roles - board level oversight, AI risk executives, and technical safety teams.","textStyle":{"bold":true}}},{"startIndex":65535,"endIndex":65620,"textRun":{"content":" Effective AI governance requires three interconnected levels of internal oversight (","textStyle":{}}},{"startIndex":65620,"endIndex":65639,"textRun":{"content":"Hadley et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2402.01691"}}}},{"startIndex":65639,"endIndex":65640,"textRun":{"content":";","textStyle":{}}},{"startIndex":65640,"endIndex":65654,"textRun":{"content":" Schuett, 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.governance.ai/research-paper/three-lines-of-defense-against-risks-from-ai#:~:text=Organizations%20that%20develop%20and%20deploy,%2C%20legal%2C%20and%20ethical%20reasons."}}}},{"startIndex":65654,"endIndex":65657,"textRun":{"content":"):\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":65657,"endIndex":65986,"paragraph":{"elements":[{"startIndex":65657,"endIndex":65949,"textRun":{"content":"Board-level oversight structures allocating resources and enforcing safety policies such as Algorithm Review Boards (ARBs) and ethics boards for technical and societal risk assessments, guiding go/no‐go decisions on deployments, and establishing oversight with clear lines of accountability (","textStyle":{}}},{"startIndex":65949,"endIndex":65968,"textRun":{"content":"Hadley et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2402.01691"}}}},{"startIndex":65968,"endIndex":65969,"textRun":{"content":";","textStyle":{}}},{"startIndex":65969,"endIndex":65983,"textRun":{"content":" Schuett, 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.governance.ai/research-paper/three-lines-of-defense-against-risks-from-ai#:~:text=Organizations%20that%20develop%20and%20deploy,%2C%20legal%2C%20and%20ethical%20reasons."}}}},{"startIndex":65983,"endIndex":65986,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.62wbuc75zqj4","textStyle":{}}}},{"startIndex":65986,"endIndex":66319,"paragraph":{"elements":[{"startIndex":65986,"endIndex":66274,"textRun":{"content":"Executives allocating resources and enforcing safety policies. Roles like the Chief Artificial Intelligence Officer (CAIO), Chief Risk Officer (CRO), and related positions to coordinate risk management efforts across the organization, and help translate ethical principles into practice (","textStyle":{}}},{"startIndex":66274,"endIndex":66294,"textRun":{"content":"Schäfer et al., 2022","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.researchgate.net/publication/360644155_AI_GOVERNANCE_ARE_CHIEF_AI_OFFICERS_AND_AI_RISK_OFFICERS_NEEDED"}}}},{"startIndex":66294,"endIndex":66295,"textRun":{"content":";","textStyle":{}}},{"startIndex":66295,"endIndex":66316,"textRun":{"content":" Janssen et al., 2025","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://academic.oup.com/policyandsociety/article/44/1/38/7965776"}}}},{"startIndex":66316,"endIndex":66319,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.62wbuc75zqj4","textStyle":{}}}},{"startIndex":66319,"endIndex":66682,"paragraph":{"elements":[{"startIndex":66319,"endIndex":66647,"textRun":{"content":"Technical safety teams conducting evaluations and recommending mitigations. Teams comprising internal auditors, risk officers, and specialized audit committees for ensuring rigorous risk identification, maintaining audit integrity, and providing operational assurance, with direct reporting lines to the board for independence (","textStyle":{}}},{"startIndex":66647,"endIndex":66660,"textRun":{"content":"Schuett, 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.governance.ai/research-paper/three-lines-of-defense-against-risks-from-ai#:~:text=Organizations%20that%20develop%20and%20deploy,%2C%20legal%2C%20and%20ethical%20reasons."}}}},{"startIndex":66660,"endIndex":66661,"textRun":{"content":";","textStyle":{}}},{"startIndex":66661,"endIndex":66679,"textRun":{"content":" Raji et al., 2020","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://dl.acm.org/doi/pdf/10.1145/3351095.3372873"}}}},{"startIndex":66679,"endIndex":66682,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.62wbuc75zqj4","textStyle":{}}}},{"startIndex":66682,"endIndex":66683,"paragraph":{"elements":[{"startIndex":66682,"endIndex":66683,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":66683,"endIndex":67718,"table":{"rows":4,"columns":2,"tableRows":[{"startIndex":66684,"endIndex":66700,"tableCells":[{"startIndex":66685,"endIndex":66691,"content":[{"startIndex":66686,"endIndex":66691,"paragraph":{"elements":[{"startIndex":66686,"endIndex":66691,"textRun":{"content":"type\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":