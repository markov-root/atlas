ection":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":2557,"endIndex":2703,"content":[{"startIndex":2558,"endIndex":2703,"paragraph":{"elements":[{"startIndex":2558,"endIndex":2679,"textRun":{"content":"Distinguishing AI models according to their level of potential harm and generality. We focus here on frontier AI models (","textStyle":{}}},{"startIndex":2679,"endIndex":2700,"textRun":{"content":"U.K. government, 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.gov.uk/government/publications/frontier-ai-capabilities-and-risks-discussion-paper/frontier-ai-capabilities-and-risks-discussion-paper"}}}},{"startIndex":2700,"endIndex":2703,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":80,"unit":"PT"}}]}}},{"startIndex":2704,"endIndex":2705,"paragraph":{"elements":[{"startIndex":2704,"endIndex":2705,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"headingId":"h.lxcohhfh5y4v","namedStyleType":"HEADING_1","lineSpacing":120.00001,"direction":"LEFT_TO_RIGHT","keepLinesTogether":false,"keepWithNext":false}}},{"startIndex":2705,"endIndex":2725,"paragraph":{"elements":[{"startIndex":2705,"endIndex":2724,"textRun":{"content":"Governance Problems","textStyle":{}}},{"startIndex":2724,"endIndex":2725,"textRun":{"content":"\n","textStyle":{"fontSize":{"magnitude":11,"unit":"PT"}}}}],"paragraphStyle":{"headingId":"h.djyfoshv7et6","namedStyleType":"HEADING_1","lineSpacing":120.00001,"direction":"LEFT_TO_RIGHT","keepLinesTogether":false,"keepWithNext":false}}},{"startIndex":2725,"endIndex":3183,"table":{"rows":4,"columns":2,"tableRows":[{"startIndex":2726,"endIndex":2745,"tableCells":[{"startIndex":2727,"endIndex":2733,"content":[{"startIndex":2728,"endIndex":2733,"paragraph":{"elements":[{"startIndex":2728,"endIndex":2733,"textRun":{"content":"type\n","textStyle":{"bold":true,"fontSize":{"magnitude":11,"unit":"PT"}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}}}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{"color":{"rgbColor":{"red":0.9529412,"green":0.9529412,"blue":0.9529412}}},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":2733,"endIndex":2745,"content":[{"startIndex":2734,"endIndex":2745,"paragraph":{"elements":[{"startIndex":2734,"endIndex":2745,"textRun":{"content":"definition\n","textStyle":{"bold":true,"fontSize":{"magnitude":11,"unit":"PT"}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}}}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{"color":{"rgbColor":{"red":0.9529412,"green":0.9529412,"blue":0.9529412}}},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"magnitude":32.401050000000005,"unit":"PT"}}},{"startIndex":2745,"endIndex":2767,"tableCells":[{"startIndex":2746,"endIndex":2752,"content":[{"startIndex":2747,"endIndex":2752,"paragraph":{"elements":[{"startIndex":2747,"endIndex":2752,"textRun":{"content":"term\n","textStyle":{"bold":true,"fontSize":{"magnitude":11,"unit":"PT"}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}}}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":2752,"endIndex":2767,"content":[{"startIndex":2753,"endIndex":2767,"paragraph":{"elements":[{"startIndex":2753,"endIndex":2766,"textRun":{"content":"AI governance","textStyle":{}}},{"startIndex":2766,"endIndex":2767,"textRun":{"content":"\n","textStyle":{"fontSize":{"magnitude":11,"unit":"PT"}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":2767,"endIndex":2790,"tableCells":[{"startIndex":2768,"endIndex":2776,"content":[{"startIndex":2769,"endIndex":2776,"paragraph":{"elements":[{"startIndex":2769,"endIndex":2776,"textRun":{"content":"source\n","textStyle":{"bold":true,"fontSize":{"magnitude":11,"unit":"PT"}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}}}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":2776,"endIndex":2790,"content":[{"startIndex":2777,"endIndex":2790,"paragraph":{"elements":[{"startIndex":2777,"endIndex":2778,"textRun":{"content":"(","textStyle":{}}},{"startIndex":2778,"endIndex":2788,"textRun":{"content":"Maas, 2022","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://verfassungsblog.de/paths-untaken/"}}}},{"startIndex":2788,"endIndex":2789,"textRun":{"content":")","textStyle":{}}},{"startIndex":2789,"endIndex":2790,"textRun":{"content":"\n","textStyle":{"fontSize":{"magnitude":11,"unit":"PT"}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":2790,"endIndex":3182,"tableCells":[{"startIndex":2791,"endIndex":2800,"content":[{"startIndex":2792,"endIndex":2800,"paragraph":{"elements":[{"startIndex":2792,"endIndex":2800,"textRun":{"content":"content\n","textStyle":{"bold":true,"fontSize":{"magnitude":11,"unit":"PT"}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}}}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":2800,"endIndex":3182,"content":[{"startIndex":2801,"endIndex":3182,"paragraph":{"elements":[{"startIndex":2801,"endIndex":3181,"textRun":{"content":"The study and shaping of governance systems - including norms, policies, laws, processes, politics, and institutions - that affect the research, development, deployment, and use of existing and future AI systems in ways that positively shape societal outcomes. It encompasses both research into effective governance approaches and the practical implementation of these approaches.","textStyle":{}}},{"startIndex":3181,"endIndex":3182,"textRun":{"content":"\n","textStyle":{"fontSize":{"magnitude":11,"unit":"PT"}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":80,"unit":"PT"}}]}}},{"startIndex":3183,"endIndex":3184,"paragraph":{"elements":[{"startIndex":3183,"endIndex":3184,"textRun":{"content":"\n","textStyle":{"fontSize":{"magnitude":11,"unit":"PT"}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":3184,"endIndex":3185,"paragraph":{"elements":[{"startIndex":3184,"endIndex":3185,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":3185,"endIndex":3186,"paragraph":{"elements":[{"startIndex":3185,"endIndex":3186,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":3186,"endIndex":4131,"paragraph":{"elements":[{"startIndex":3186,"endIndex":3253,"textRun":{"content":"AI governance is not the same as traditional technology governance.","textStyle":{"bold":true}}},{"startIndex":3253,"endIndex":4101,"textRun":{"content":" Traditional technology governance relies on several key assumptions that break down when applied to AI. We typically assume we can predict how a technology will be used and its likely impacts, that we can effectively control its development pathway, and that we can regulate specific applications or end-uses. For example, pharmaceutical governance uses clinical trials and approval processes based on intended medical applications, while nuclear technology is controlled through international treaties, safeguards, and monitoring of specific facilities and materials. These approaches work when technologies follow relatively predictable development paths and have clear applications. To understand what makes AI governance uniquely challenging, we can examine AI through three different lenses that each require different governance approaches (","textStyle":{}}},{"startIndex":4101,"endIndex":4112,"textRun":{"content":"Dafoe, 2022","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://academic.oup.com/edited-volume/41989/chapter-abstract/408516484"}}}},{"startIndex":4112,"endIndex":4113,"textRun":{"content":";","textStyle":{}}},{"startIndex":4113,"endIndex":4128,"textRun":{"content":" Buchanan, 2020","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://cset.georgetown.edu/publication/the-ai-triad-and-what-it-means-for-national-security-strategy/"}}}},{"startIndex":4128,"endIndex":4131,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":4131,"endIndex":4728,"paragraph":{"elements":[{"startIndex":4131,"endIndex":4164,"textRun":{"content":"AI as general-purpose technology.","textStyle":{"bold":true}}},{"startIndex":4164,"endIndex":4711,"textRun":{"content":" AI transforms many sectors simultaneously, making sector-specific regulation insufficient. Like electricity or computers before it, AI can reshape healthcare, finance, transportation, and education all at once. Traditional technology governance typically focuses on specific applications - we regulate medical devices differently from automobiles. But when a single AI system can diagnose diseases, trade stocks, and drive cars, our regulatory silos break down. The impacts span across society in ways that make targeted regulation insufficient (","textStyle":{}}},{"startIndex":4711,"endIndex":4725,"textRun":{"content":"Buchanan, 2020","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://cset.georgetown.edu/publication/the-ai-triad-and-what-it-means-for-national-security-strategy/"}}}},{"startIndex":4725,"endIndex":4728,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":4728,"endIndex":5347,"paragraph":{"elements":[{"startIndex":4728,"endIndex":4757,"textRun":{"content":"AI as information technology.","textStyle":{"bold":true}}},{"startIndex":4757,"endIndex":5229,"textRun":{"content":" AI processes and generates information in unprecedented ways. Unlike traditional information systems that store and retrieve data, AI can create entirely new content - from photorealistic images to convincing text to synthetic voices. This creates unprecedented challenges around security, privacy, and information integrity. Traditional governance frameworks weren't designed to handle technologies that can rapidly generate and manipulate information at massive scale (","textStyle":{}}},{"startIndex":5229,"endIndex":5250,"textRun":{"content":"Brundage et al., 2018","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/pdf/1802.07228"}}}},{"startIndex":5250,"endIndex":5347,"textRun":{"content":"). The speed and scope of potential information impacts outstrip traditional control mechanisms.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":5347,"endIndex":6206,"paragraph":{"elements":[{"startIndex":5347,"endIndex":5377,"textRun":{"content":"AI as intelligence technology.","textStyle":{"bold":true}}},{"startIndex":5377,"endIndex":5754,"textRun":{"content":" AI introduces unique control challenges as systems become more capable. As AI systems approach and potentially exceed human cognitive abilities in various domains, they may develop sophisticated ways to evade controls or pursue unintended objectives. We're already seeing glimpses of this with language models that can engage in deception or manipulation when pursuing goals (","textStyle":{}}},{"startIndex":5754,"endIndex":5774,"textRun":{"content":"Ganguli et al., 2022","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2202.07785"}}}},{"startIndex":5774,"endIndex":5992,"textRun":{"content":"). There are several dangerous capabilities (refer back to chapters 1 and 2) which become even more acute when considering that AI systems might develop these capabilities without being explicitly programmed for them (","textStyle":{}}},{"startIndex":5992,"endIndex":6006,"textRun":{"content":"Woodside, 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2206.07682"}}}},{"startIndex":6006,"endIndex":6206,"textRun":{"content":"). The intelligence aspect of AI creates a dynamic where the technology being governed might actively resist or circumvent governance measures, a challenge without precedent in technology regulation.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":6206,"endIndex":6531,"paragraph":{"elements":[{"startIndex":6206,"endIndex":6325,"textRun":{"content":"The combination of AI as a general-purpose, information,  intelligence technology creates unique governance challenges.","textStyle":{"bold":true}}},{"startIndex":6325,"endIndex":6531,"textRun":{"content":" The mixed nature of AI as a general-purpose, information processing, and potentially intelligent technology gives rise to three fundamental problems that make traditional governance approaches inadequate.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":6531,"endIndex":6532,"paragraph":{"elements":[{"startIndex":6531,"endIndex":6532,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":6532,"endIndex":6657,"table":{"rows":3,"columns":2,"tableRows":[{"startIndex":6533,"endIndex":6548,"tableCells":[{"startIndex":6534,"endIndex":6540,"content":[{"startIndex":6535,"endIndex":6540,"paragraph":{"elements":[{"startIndex":6535,"endIndex":6540,"textRun":{"content":"type\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}}}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":6540,"endIndex":6548,"content":[{"startIndex":6541,"endIndex":6548,"paragraph":{"elements":[{"startIndex":6541,"endIndex":6548,"textRun":{"content":"figure\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}}}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":6548,"endIndex":6562,"tableCells":[{"startIndex":6549,"endIndex":6558,"content":[{"startIndex":6550,"endIndex":6558,"paragraph":{"elements":[{"startIndex":6550,"endIndex":6558,"textRun":{"content":"content\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}}}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":6558,"endIndex":6562,"content":[{"startIndex":6559,"endIndex":6560,"paragraph":{"elements":[{"startIndex":6559,"endIndex":6560,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}}}}},{"startIndex":6560,"endIndex":6562,"paragraph":{"elements":[{"startIndex":6560,"endIndex":6561,"inlineObjectElement":{"inlineObjectId":"kix.v3ktl2ue6di1","textStyle":{}}},{"startIndex":6561,"endIndex":6562,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":6562,"endIndex":6656,"tableCells":[{"startIndex":6563,"endIndex":6572,"content":[{"startIndex":6564,"endIndex":6572,"paragraph":{"elements":[{"startIndex":6564,"endIndex":6572,"textRun":{"content":"caption\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}}}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":6572,"endIndex":6656,"content":[{"startIndex":6573,"endIndex":6656,"paragraph":{"elements":[{"startIndex":6573,"endIndex":6638,"textRun":{"content":"Summary of the three regulatory challenges posed by frontier AI (","textStyle":{}}},{"startIndex":6638,"endIndex":6654,"textRun":{"content":"Anderljung, 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/pdf/2307.03718"}}}},{"startIndex":6654,"endIndex":6656,"textRun":{"content":")\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":80,"unit":"PT"}}]}}},{"startIndex":6657,"endIndex":6658,"paragraph":{"elements":[{"startIndex":6657,"endIndex":6658,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":6658,"endIndex":6659,"paragraph":{"elements":[{"startIndex":6658,"endIndex":6659,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":6659,"endIndex":6683,"paragraph":{"elements":[{"startIndex":6659,"endIndex":6683,"textRun":{"content":"Unexpected Capabilities\n","textStyle":{}}}],"paragraphStyle":{"headingId":"h.mgdlfb4jc4ug","namedStyleType":"HEADING_2","lineSpacing":120.00001,"direction":"LEFT_TO_RIGHT","keepLinesTogether":false,"keepWithNext":false}}},{"startIndex":6683,"endIndex":6684,"paragraph":{"elements":[{"startIndex":6683,"endIndex":6684,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":6684,"endIndex":7454,"paragraph":{"elements":[{"startIndex":6684,"endIndex":6767,"textRun":{"content":"AI systems develop surprising abilities that weren't part of their intended design.","textStyle":{"bold":true}}},{"startIndex":6767,"endIndex":7122,"textRun":{"content":" Through several of our chapters now, we have shown that foundation models can show \"emergent\" capabilities that appear suddenly as models scale up with more data, parameters and compute. GPT-3 unexpectedly demonstrated the ability to perform basic arithmetic, while later models showed emergent reasoning capabilities that surprised even their creators (","textStyle":{}}},{"startIndex":7122,"endIndex":7142,"textRun":{"content":"Ganguli et al., 2022","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2202.07785"}}}},{"startIndex":7142,"endIndex":7143,"textRun":{"content":";","textStyle":{}}},{"startIndex":7143,"endIndex":7160,"textRun":{"content":" Wei et al., 2022","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2206.07682"}}}},{"startIndex":7160,"endIndex":7372,"textRun":{"content":"). Evaluations have found that frontier models can autonomously conduct basic scientific research, hack into computer systems, and manipulate humans through persuasion, none of which were explicitly trained for (","textStyle":{}}},{"startIndex":7372,"endIndex":7391,"textRun":{"content":"Phuong et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2403.13793"}}}},{"startIndex":7391,"endIndex":7392,"textRun":{"content":";","textStyle":{}}},{"startIndex":7392,"endIndex":7411,"textRun":{"content":" Boiko et al., 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2304.05332"}}}},{"startIndex":7411,"endIndex":7412,"textRun":{"content":";","textStyle":{}}},{"startIndex":7412,"endIndex":7432,"textRun":{"content":" Turpin e