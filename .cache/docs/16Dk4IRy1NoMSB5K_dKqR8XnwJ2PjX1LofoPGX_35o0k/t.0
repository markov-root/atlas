"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":7495,"endIndex":7653,"content":[{"startIndex":7496,"endIndex":7653,"paragraph":{"elements":[{"startIndex":7496,"endIndex":7631,"textRun":{"content":"Example of unexpected capabilities. Graphs showing several metrics that improve suddenly and unpredictably as models increase in size (","textStyle":{}}},{"startIndex":7631,"endIndex":7651,"textRun":{"content":"Ganguli et al., 2022","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2202.07785"}}}},{"startIndex":7651,"endIndex":7653,"textRun":{"content":")\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":80,"unit":"PT"}}]}}},{"startIndex":7654,"endIndex":7655,"paragraph":{"elements":[{"startIndex":7654,"endIndex":7655,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":7655,"endIndex":8332,"paragraph":{"elements":[{"startIndex":7655,"endIndex":7710,"textRun":{"content":"AI evaluations are still in their early stages in 2025.","textStyle":{"bold":true}}},{"startIndex":7710,"endIndex":7820,"textRun":{"content":" Testing frameworks lack established best practices, and the field has yet to mature into a reliable science (","textStyle":{}}},{"startIndex":7820,"endIndex":7833,"textRun":{"content":"Trusilo, 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.tandfonline.com/doi/full/10.1080/15027570.2023.2213985"}}}},{"startIndex":7833,"endIndex":8008,"textRun":{"content":"). While evaluations can reveal some capabilities, they cannot guarantee absence of unknown threats, forecast new emergent abilities, or assess risks from autonomous systems (","textStyle":{}}},{"startIndex":8008,"endIndex":8033,"textRun":{"content":"Barnett & Thiergart, 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/html/2412.08653v1"}}}},{"startIndex":8033,"endIndex":8181,"textRun":{"content":"). Predictability itself is a nascent research area, with major gaps in our ability to anticipate how present models behave, let alone future ones (","textStyle":{}}},{"startIndex":8181,"endIndex":8198,"textRun":{"content":"Zhou et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/html/2310.06167v3"}}}},{"startIndex":8198,"endIndex":8310,"textRun":{"content":"). Even the most comprehensive test-and-evaluation frameworks struggle with complex, unpredictable AI behavior (","textStyle":{}}},{"startIndex":8310,"endIndex":8329,"textRun":{"content":"Wojton et al., 2020","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://testscience.org/wp-content/uploads/formidable/20/Autonomy-Lit-Review.pdf"}}}},{"startIndex":8329,"endIndex":8332,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":8332,"endIndex":8333,"paragraph":{"elements":[{"startIndex":8332,"endIndex":8333,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":8333,"endIndex":8351,"paragraph":{"elements":[{"startIndex":8333,"endIndex":8351,"textRun":{"content":"Deployment Safety\n","textStyle":{}}}],"paragraphStyle":{"headingId":"h.rhsyud123vww","namedStyleType":"HEADING_2","lineSpacing":120.00001,"direction":"LEFT_TO_RIGHT","keepLinesTogether":false,"keepWithNext":false}}},{"startIndex":8351,"endIndex":8352,"paragraph":{"elements":[{"startIndex":8351,"endIndex":8352,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":8352,"endIndex":8817,"paragraph":{"elements":[{"startIndex":8352,"endIndex":8447,"textRun":{"content":"Once deployed, AI systems can be repurposed for harmful applications beyond their intended use.","textStyle":{"bold":true}}},{"startIndex":8447,"endIndex":8747,"textRun":{"content":" The same language model trained for helpful dialogue can generate misinformation, assist with cyberattacks, or help design biological weapons. Users regularly discover new capabilities through clever prompting that bypasses safety measures called \"jailbreaks\" that unlock dangerous functionalities (","textStyle":{}}},{"startIndex":8747,"endIndex":8768,"textRun":{"content":"Solaiman et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2306.05949"}}}},{"startIndex":8768,"endIndex":8769,"textRun":{"content":";","textStyle":{}}},{"startIndex":8769,"endIndex":8790,"textRun":{"content":" Marchal et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2406.13843"}}}},{"startIndex":8790,"endIndex":8791,"textRun":{"content":";","textStyle":{}}},{"startIndex":8791,"endIndex":8814,"textRun":{"content":" Hendrycks et al., 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2306.12001"}}}},{"startIndex":8814,"endIndex":8817,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":8817,"endIndex":8818,"paragraph":{"elements":[{"startIndex":8817,"endIndex":8818,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":8818,"endIndex":9040,"table":{"rows":3,"columns":2,"tableRows":[{"startIndex":8819,"endIndex":8834,"tableCells":[{"startIndex":8820,"endIndex":8826,"content":[{"startIndex":8821,"endIndex":8826,"paragraph":{"elements":[{"startIndex":8821,"endIndex":8826,"textRun":{"content":"type\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},