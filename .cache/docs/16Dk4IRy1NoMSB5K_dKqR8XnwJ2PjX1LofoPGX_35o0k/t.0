ndex":50567,"endIndex":50575,"paragraph":{"elements":[{"startIndex":50567,"endIndex":50575,"textRun":{"content":"caption\n","textStyle":{"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":50575,"endIndex":50667,"content":[{"startIndex":50576,"endIndex":50667,"paragraph":{"elements":[{"startIndex":50576,"endIndex":50650,"textRun":{"content":"In 2023, most of the notable AI models originated from U.S. institutions (","textStyle":{}}},{"startIndex":50650,"endIndex":50664,"textRun":{"content":"Stanford, 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://hai.stanford.edu/ai-index/2024-ai-index-report"}}}},{"startIndex":50664,"endIndex":50667,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":80,"unit":"PT"}}]}}},{"startIndex":50668,"endIndex":50669,"paragraph":{"elements":[{"startIndex":50668,"endIndex":50669,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":50669,"endIndex":51681,"paragraph":{"elements":[{"startIndex":50669,"endIndex":50719,"textRun":{"content":"Traditional accountability mechanisms don't apply.","textStyle":{"bold":true}}},{"startIndex":50719,"endIndex":51148,"textRun":{"content":" Corporate boards nominally provide oversight, but most lack the incentives to evaluate systemic AI risks. Government regulators struggle to keep pace with rapid development. Academic researchers who might provide scientific evidence and independent assessment often depend on corporate funding or compute access. The result is a governance vacuum where no one has both the capability and authority needed for proper governance (","textStyle":{}}},{"startIndex":51148,"endIndex":51164,"textRun":{"content":"Anderljung, 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2311.14711"}}}},{"startIndex":51164,"endIndex":51317,"textRun":{"content":"). The consequences of this lack of governance are already becoming apparent. We've seen AI-generated deepfakes used to spread political misinformation (","textStyle":{}}},{"startIndex":51317,"endIndex":51337,"textRun":{"content":"Swenson & Chan, 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://apnews.com/article/artificial-intelligence-elections-disinformation-chatgpt-bc283e7426402f0b4baa7df280a4c3fd"}}}},{"startIndex":51337,"endIndex":51425,"textRun":{"content":"). Language models have been used to create convincing phishing emails and other scams (","textStyle":{}}},{"startIndex":51425,"endIndex":51437,"textRun":{"content":"Stacey, 2025","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.ft.com/content/d60fb4fb-cb85-4df7-b246-ec3d08260e6f"}}}},{"startIndex":51437,"endIndex":51661,"textRun":{"content":"). When models demonstrate concerning behaviors, we can't trace whether they result from training data, reward functions, or architectural choices. This black box nature of development is a big bottleneck in accountability (","textStyle":{}}},{"startIndex":51661,"endIndex":51678,"textRun":{"content":"Chan et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2401.13138"}}}},{"startIndex":51678,"endIndex":51681,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":51681,"endIndex":51682,"paragraph":{"elements":[{"startIndex":51681,"endIndex":51682,"textRun":{"content":"\n","textStyle":{"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":120.00001,"direction":"LEFT_TO_RIGHT"}}},{"startIndex":51682,"endIndex":51852,"table":{"rows":3,"columns":2,"tableRows":[{"startIndex":51683,"endIndex":51698,"tableCells":[{"startIndex":51684,"endIndex":51690,"content":[{"startIndex":51685,"endIndex":51690,"paragraph":{"elements":[{"startIndex":51685,"endIndex":51690,"textRun":{"content":"type\n","textStyle":{"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}}}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":51690,"endIndex":51698,"content":[{"startIndex":51691,"endIndex":51698,"paragraph":{"elements":[{"startIndex":51691,"endIndex":51698,"textRun":{"content":"figure\n","textStyle":{"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}}}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":51698,"endIndex":51711,"tableCells":[{"startIndex":51699,"endIndex":51708,"content":[{"startIndex":51700,"endIndex":51708,"paragraph":{"elements":[{"startIndex":51700,"endIndex":51708,"textRun":{"content":"content\n","textStyle":{"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}}}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":51708,"endIndex":51711,"content":[{"startIndex":51709,"endIndex":51711,"paragraph":{"elements":[{"startIndex":51709,"endIndex":51710,"inlineObjectElement":{"inlineObjectId":"kix.4uieqwxrprqr","textStyle":{}}},{"startIndex":51710,"endIndex":51711,"textRun":{"content":"\n","textStyle":{"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":51711,"endIndex":51851,"tableCells":[{"startIndex":51712,"endIndex":51721,"content":[{"startIndex":51713,"endIndex":51721,"paragraph":{"elements":[{"startIndex":51713,"endIndex":51721,"textRun":{"content":"caption\n","textStyle":{"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}}}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":51721,"endIndex":51851,"content":[{"startIndex":51722,"endIndex":51851,"paragraph":{"elements":[{"startIndex":51722,"endIndex":51821,"textRun":{"content":"Diagram showing the path from auditability to auditability (ex-ante) to accountability (post-hoc) (","textStyle":{}}},{"startIndex":51821,"endIndex":51849,"textRun":{"content":"Herrera-Poyatos et al., 2025","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2503.04739"}}}},{"startIndex":51849,"endIndex":51850,"textRun":{"content":")","textStyle":{}}},{"startIndex":51850,"endIndex":51851,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":80,"unit":"PT"}}]}}},{"startIndex":51852,"endIndex":51853,"paragraph":{"elements":[{"startIndex":51852,"endIndex":51853,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":51853,"endIndex":51854,"paragraph":{"elements":[{"startIndex":51853,"endIndex":51854,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":51854,"endIndex":51855,"paragraph":{"elements":[{"startIndex":51854,"endIndex":51855,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":51855,"endIndex":51886,"paragraph":{"elements":[{"startIndex":51855,"endIndex":51886,"textRun":{"content":"Power and Wealth Concentration\n","textStyle":{}}}],"paragraphStyle":{"headingId":"h.j241n9s2tkmz","namedStyleType":"HEADING_2","direction":"LEFT_TO_RIGHT"}}},{"startIndex":51886,"endIndex":51887,"paragraph":{"elements":[{"startIndex":51886,"endIndex":51887,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":51887,"endIndex":52411,"paragraph":{"elements":[{"startIndex":51887,"endIndex":51931,"textRun":{"content":"AI concentrates power in unprecedented ways.","textStyle":{"bold":true}}},{"startIndex":51931,"endIndex":52160,"textRun":{"content":" AI systems, especially those developed by dominant corporations, are reshaping societal power structures. These systems determine access to information and resources, effectively exercising automated authority over individuals (","textStyle":{}}},{"startIndex":52160,"endIndex":52171,"textRun":{"content":"Lazar, 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2404.05990"}}}},{"startIndex":52171,"endIndex":52411,"textRun":{"content":"). As these systems become more capable, this concentration intensifies. The organization that first develops AGI could gain decisive advantages across every domain of human activity, a winner-take-all dynamic with no historical precedent.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":52411,"endIndex":52412,"paragraph":{"elements":[{"startIndex":52411,"endIndex":52412,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":52412,"endIndex":52989,"paragraph":{"elements":[{"startIndex":52412,"endIndex":52458,"textRun":{"content":"Wealth effects compound existing inequalities.","textStyle":{"bold":true}}},{"startIndex":52458,"endIndex":52774,"textRun":{"content":" AI automation primarily benefits capital owners while displacing workers, deepening existing disparities. Recent empirical evidence suggests that AI adoption significantly increases wealth inequality by disproportionately benefiting those who own models, data, and computational resources, at the expense of labor (","textStyle":{}}},{"startIndex":52774,"endIndex":52792,"textRun":{"content":"Skare et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://ideas.repec.org/a/eee/teinso/v79y2024ics0160791x24002677.html"}}}},{"startIndex":52792,"endIndex":52973,"textRun":{"content":"). Without targeted governance interventions, AI risks creating never before seen levels of economic inequality, potentially resulting in the most unequal society in human history (","textStyle":{}}},{"startIndex":52973,"endIndex":52986,"textRun":{"content":"O’Keefe, 2020","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.governance.ai/research-paper/the-windfall-clause-distributing-the-benefits-of-ai-for-the-common-good"}}}},{"startIndex":52986,"endIndex":52989,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":52989,"endIndex":52990,"paragraph":{"elements":[{"startIndex":52989,"endIndex":52990,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":52990,"endIndex":53228,"table":{"rows":3,"columns":2,"tableRows":[{"startIndex":52991,"endIndex":53006,"tableCells":[{"startIndex":52992,"endIndex":52998,"content":[{"startIndex":52993,"endIndex":52998,"paragraph":{"elements":[{"startIndex":52993,"endIndex":52998,"textRun":{"content":"type\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"