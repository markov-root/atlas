:5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":8848,"endIndex":9039,"tableCells":[{"startIndex":8849,"endIndex":8858,"content":[{"startIndex":8850,"endIndex":8858,"paragraph":{"elements":[{"startIndex":8850,"endIndex":8858,"textRun":{"content":"caption\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":8858,"endIndex":9039,"content":[{"startIndex":8859,"endIndex":9039,"paragraph":{"elements":[{"startIndex":8859,"endIndex":8920,"textRun":{"content":"A schematic of using autonomous LLM agents to hack websites (","textStyle":{}}},{"startIndex":8920,"endIndex":8937,"textRun":{"content":"Fang et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2402.06664"}}}},{"startIndex":8937,"endIndex":9039,"textRun":{"content":"). Once a dual-purpose technology is public, it can be used for both beneficial and harmful purposes.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":80,"unit":"PT"}}]}}},{"startIndex":9040,"endIndex":9041,"paragraph":{"elements":[{"startIndex":9040,"endIndex":9041,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":9041,"endIndex":9378,"paragraph":{"elements":[{"startIndex":9041,"endIndex":9075,"textRun":{"content":"AI agents amplify deployment risks","textStyle":{"bold":true}}},{"startIndex":9075,"endIndex":9358,"textRun":{"content":". We're now seeing autonomous AI agents that can chain together model capabilities in novel ways, using tools and taking actions in the real world. These agents can pursue complex goals over extended periods, making their behavior even harder to predict and control post-deployment (","textStyle":{}}},{"startIndex":9358,"endIndex":9375,"textRun":{"content":"Fang et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2402.06664"}}}},{"startIndex":9375,"endIndex":9378,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":9378,"endIndex":9379,"paragraph":{"elements":[{"startIndex":9378,"endIndex":9379,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":9379,"endIndex":9393,"paragraph":{"elements":[{"startIndex":9379,"endIndex":9393,"textRun":{"content":"Proliferation\n","textStyle":{}}}],"paragraphStyle":{"headingId":"h.2wtl4mj8831d","namedStyleType":"HEADING_2","lineSpacing":120.00001,"direction":"LEFT_TO_RIGHT","keepLinesTogether":false,"keepWithNext":false}}},{"startIndex":9393,"endIndex":9394,"paragraph":{"elements":[{"startIndex":9393,"endIndex":9394,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":9394,"endIndex":9949,"paragraph":{"elements":[{"startIndex":9394,"endIndex":9489,"textRun":{"content":"AI capabilities spread rapidly through multiple channels, making containment nearly impossible.","textStyle":{"bold":true}}},{"startIndex":9489,"endIndex":9780,"textRun":{"content":" Models can be stolen through cyberattacks, leaked by insiders, or reproduced by competitors within months. The rapid open-source replication of ChatGPT-like capabilities led to models with safety features removed and new dangerous capabilities discovered through community experimentation (","textStyle":{}}},{"startIndex":9780,"endIndex":9798,"textRun":{"content":"Seger et al., 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2311.09227"}}}},{"startIndex":9798,"endIndex":9929,"textRun":{"content":"). With API-based models, techniques like model distillation can even extract capabilities without direct access to model weights (","textStyle":{}}},{"startIndex":9929,"endIndex":9946,"textRun":{"content":"Nevo et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.rand.org/content/dam/rand/pubs/research_reports/RRA2800/RRA2849-1/RAND_RRA2849-1.pdf"}}}},{"startIndex":9946,"endIndex":9949,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":9949,"endIndex":9950,"paragraph":{"elements":[{"startIndex":9949,"endIndex":9950,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":9950,"endIndex":10275,"paragraph":{"elements":[{"startIndex":9950,"endIndex":10002,"textRun":{"content":"Physical containment doesn't work for digital goods.","textStyle":{"bold":true}}},{"startIndex":10002,"endIndex":10275,"textRun":{"content":" Unlike nuclear materials or dangerous pathogens, AI models are just patterns of numbers that can be copied instantly and transmitted globally. Once capabilities exist, controlling their spread becomes a losing battle against the fundamental nature of digital information.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":10275,"endIndex":10276,"paragraph":{"elements":[{"startIndex":10275,"endIndex":10276,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":10276,"endIndex":10359,"table":{"rows":3,"columns":2,"tableRows":[{"startIndex":10277,"endIndex":10292,"tableCells":[{"startIndex":10278,"endIndex":10284,"content":[{"startIndex":10279,"endIndex":10284,"paragraph":{"elements":[{"startIndex":10279,"endIndex":10284,"textRun":{"content":"type\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"S