400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"JUSTIFIED","lineSpacing":120.00001,"direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":77261,"endIndex":77270,"tableCells":[{"startIndex":77262,"endIndex":77268,"content":[{"startIndex":77263,"endIndex":77268,"paragraph":{"elements":[{"startIndex":77263,"endIndex":77268,"textRun":{"content":"date\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":77268,"endIndex":77270,"content":[{"startIndex":77269,"endIndex":77270,"paragraph":{"elements":[{"startIndex":77269,"endIndex":77270,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":77270,"endIndex":77285,"tableCells":[{"startIndex":77271,"endIndex":77283,"content":[{"startIndex":77272,"endIndex":77283,"paragraph":{"elements":[{"startIndex":77272,"endIndex":77283,"textRun":{"content":"source-url\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":77283,"endIndex":77285,"content":[{"startIndex":77284,"endIndex":77285,"paragraph":{"elements":[{"startIndex":77284,"endIndex":77285,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":77285,"endIndex":77700,"tableCells":[{"startIndex":77286,"endIndex":77295,"content":[{"startIndex":77287,"endIndex":77295,"paragraph":{"elements":[{"startIndex":77287,"endIndex":77295,"textRun":{"content":"content\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":77295,"endIndex":77700,"content":[{"startIndex":77296,"endIndex":77700,"paragraph":{"elements":[{"startIndex":77296,"endIndex":77700,"textRun":{"content":"The potential impact of AI might exceed human cognitive boundaries. To ensure that this technology always benefits humanity, we must regulate the development of AI and prevent this technology from turning into a runaway wild horse [...] We need to strengthen the detection and evaluation of the entire lifecycle of AI, ensuring that mankind has the ability to press the pause button at critical moments.\n","textStyle":{"foregroundColor":{"color":{"rgbColor":{"red":0.05490196,"green":0.0627451,"blue":0.101960786}}},"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"JUSTIFIED","lineSpacing":120.00001,"direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":80,"unit":"PT"}}]}}},{"startIndex":77701,"endIndex":77702,"paragraph":{"elements":[{"startIndex":77701,"endIndex":77702,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":77702,"endIndex":78168,"paragraph":{"elements":[{"startIndex":77702,"endIndex":77959,"textRun":{"content":"We established in the previous section that companies can often lack incentives to fully account for the broader societal impact, face competitive pressures that may compromise safety, and lack the legitimacy to make decisions affecting entire populations (","textStyle":{"foregroundColor":{"color":{"rgbColor":{"red":0.05490196,"green":0.0627451,"blue":0.101960786}}},"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}},{"startIndex":77959,"endIndex":77970,"textRun":{"content":"Dafoe, 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400},"link":{"url":"https://arxiv.org/abs/2307.04699"}}}},{"startIndex":77970,"endIndex":78168,"textRun":{"content":"). National governance frameworks therefore serve as an essential complement to self-regulatory initiatives, setting regional standards that companies can incorporate into their internal practices.\n","textStyle":{"foregroundColor":{"color":{"rgbColor":{"red":0.05490196,"green":0.0627451,"blue":0.101960786}}},"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"JUSTIFIED","lineSpacing":120.00001,"direction":"LEFT_TO_RIGHT"}}},{"startIndex":78168,"endIndex":78169,"paragraph":{"elements":[{"startIndex":78168,"endIndex":78169,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":78169,"endIndex":78969,"paragraph":{"elements":[{"startIndex":78169,"endIndex":78726,"textRun":{"content":"Unlike traditional technological governance challenges, frontier AI systems generate externalities that span multiple domains: from national security to economic stability, from social equity to democratic functioning. AI systems threaten national security by democratizing capabilities usable by malicious actors, facilitate unequal economic outcomes by concentrating market power in specific companies and countries while displacing jobs elsewhere, and produce harmful societal conditions through extractive data practices and biased algorithmic outputs (","textStyle":{"foregroundColor":{"color":{"rgbColor":{"red":0.05490196,"green":0.0627451,"blue":0.101960786}}},"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}},{"startIndex":78726,"endIndex":78746,"textRun":{"content":"Roberts et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400},"link":{"url":"https://academic.oup.com/ia/article/100/3/1275/7641064"}}}},{"startIndex":78746,"endIndex":78955,"textRun":{"content":"). Traditional regulatory bodies, designed for narrower technological domains, typically lack the necessary spatial remit, technical competence, or institutional authority to effectively govern these systems (","textStyle":{"foregroundColor":{"color":{"rgbColor":{"red":0.05490196,"green":0.0627451,"blue":0.101960786}}},"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}},{"startIndex":78955,"endIndex":78966,"textRun":{"content":"Dafoe, 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400},"link":{"url":"https://arxiv.org/abs/2307.04699"}}}},{"startIndex":78966,"endIndex":78969,"textRun":{"content":").\n","textStyle":{"foregroundColor":{"color":{"rgbColor":{"red":0.05490196,"green":0.0627451,"blue":0.101960786}}},"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"JUSTIFIED","lineSpacing":120.00001,"direction":"LEFT_TO_RIGHT"}}},{"startIndex":78969,"endIndex":78970,"paragraph":{"elements":[{"startIndex":78969,"endIndex":78970,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":78970,"endIndex":79456,"paragraph":{"elements":[{"startIndex":78970,"endIndex":79440,"textRun":{"content":"Consider the contrast with self-driving vehicles, where the primary externalities are relatively well-defined (safety of road users) and fall within existing regulatory frameworks (traffic safety agencies). Frontier AI systems, by contrast, generate externalities that cross traditional regulatory boundaries and jurisdictions, requiring new institutional approaches that can address the expertise gap, coordination gap, and temporal gap in current regulatory frameworks","textStyle":{"foregroundColor":{"color":{"rgbColor":{"red":0.05490196,"green":0.0627451,"blue":0.101960786}}},"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}},{"startIndex":79440,"endIndex":79441,"textRun":{"content":" ","textStyle":{"foregroundColor":{"color":{"rgbColor":{"red":0.05490196,"green":0.0627451,"blue":0.101960786}}},"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400},"link":{"url":"https://arxiv.org/abs/2307.04699"}}}},{"startIndex":79441,"endIndex":79453,"textRun":{"content":"(Dafoe, 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400},"link":{"url":"https://arxiv.org/abs/2307.04699"}}}},{"startIndex":79453,"endIndex":79456,"textRun":{"content":").\n","textStyle":{"foregroundColor":{"color":{"rgbColor":{"red":0.05490196,"green":0.0627451,"blue":0.101960786}}},"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"JUSTIFIED","lineSpacing":120.00001,"direction":"LEFT_TO_RIGHT"}}},{"startIndex":79456,"endIndex":79457,"paragraph":{"elements":[{"startIndex":79456,"endIndex":79457,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":79457,"endIndex":80379,"paragraph":{"elements":[{"startIndex":79457,"endIndex":79538,"textRun":{"content":"AI systems can cause harm in ways that are not always transparent or predictable.","textStyle":{"bold":true,"foregroundColor":{"color":{"rgbColor":{"red":0.05490196,"green":0.0627451,"blue":0.101960786}}},"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}},{"startIndex":79538,"endIndex":79982,"textRun":{"content":" Beyond software bugs or input-output mismatches, risks emerge from how AI systems internally represent goals, make trade-offs, and generalize from data. When these systems are deployed at scale, even subtle misalignments between system behavior and human intent can have widespread consequences. Automated subgoal pursuit, for example, can generate outcomes that are technically correct but socially catastrophic if not carefully constrained (","textStyle":{"foregroundColor":{"color":{"rgbColor":{"red":0.05490196,"green":0.0627451,"blue":0.101960786}}},"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}},{"startIndex":79982,"endIndex":79991,"textRun":{"content":"Cha, 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400},"link":{"url":"https://www.nature.com/articles/s41599-024-03017-1"}}}},{"startIndex":79991,"endIndex":80379,"textRun":{"content":"). Because many of these failure modes are embedded in opaque model architectures and training dynamics, they resist detection through conventional auditing or certification processes. National regulation provides an anchor for accountability by requiring developers to build, test, and deploy systems in ways that are externally verifiable, legally enforceable, and publicly legitimate.\n","textStyle":{"foregroundColor":{"color":{"rgbColor":{"red":0.05490196,"green":0.0627451,"blue":0.101960786}}},"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"JUSTIFIED","lineSpacing":120.00001,"direction":"LEFT_TO_RIGHT"}}},{"startIndex":80379,"endIndex":80844,"paragraph":{"elements":[{"startIndex":80379,"endIndex":80844,"textRun":{"content":"As we will see in this section, major regions have developed distinctly different regulatory philosophies that reflect their unique institutional contexts and political priorities. Understanding these national frameworks will provide context for our subsequent analysis of international governance mechanisms, which must navigate and harmonize these regional differences to create effective global standards for AI systems whose impacts transcend national borders.\n","textStyle":{"foregroundColor":{"color":{"rgbColor":{"red":0.05490196,"green":0.0627451,"blue":0.101960786}}},"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"JUSTIFIED","lineSpacing":120.00001,"direction":"LEFT_TO_RIGHT"}}},{"startIndex":80844,"endIndex":80845,"paragraph":{"elements":[{"startIndex":80844,"endIndex":80845,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":80845,"endIndex":82098,"paragraph":{"elements":[{"startIndex":80845,"endIndex":81158,"textRun":{"content":"Across the last decade, over 30 countries have released national AI strategies outlining their approach to development, regulation, and adoption. These strategies differ widely in emphasis, but when systematically analyzed, they fall into three recurring governance patterns: development, control, and promotion (","textStyle":{"foregroundColor":{"color":{"rgbColor":{"red":0.05490196,"green":0.0627451,"blue":0.101960786}}},"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}},{"startIndex":81158,"endIndex":81179,"textRun":{"content":"Papyshev et al., 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400},"link":{"url":"https://www.researchgate.net/publication/367010605_The_state's_role_in_governing_artificial_intelligence_development_control_and_promotion_through_national_strategies"}}}},{"startIndex":81179,"endIndex":82074,"textRun":{"content":"). In development-led models, such as those in China, South Korea, and Hungary, the state acts as a strategic coordinator, directing public resources toward AI infrastructure, research programs, and national missions. Control-oriented approaches, prominent in the European Union and countries like Norway and Mexico, emphasize legal standards, ethics oversight, and risk monitoring frameworks. Promotion-focused models, including the United States, United Kingdom, and Singapore, adopt a more decentralized approach: the state acts primarily as an enabler of private sector innovation, with relatively few regulatory constraints. These differences matter. Any attempt to build international governance frameworks will need to account for the structural asymmetries between these national regimes, particularly around enforcement authority, accountability mechanisms, and institutional capacity (","textStyle":{"foregroundColor":{"color":{"rgbColor":{"red":0.05490196,"green":0.0627451,"blue":0.101960786}}},"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}},{"startIndex":82074,"endIndex":82095,"textRun":{"content":"Papyshev et al., 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400},"link":{"url":"https://www.researchgate.net/publication/367010605_The_state's_role_in_governing_artificial_intelligence_development_control_and_promotion_through_national_strategies"}}}},{"startIndex":82095,"endIndex":82098,"textRun":{"content":").\n","textStyle":{"foregroundColor":{"color":{"rgbColor":{"red":0.05490196,"green":0.0627451,"blue":0.101960786}}},"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"JUSTIFIED","lineSpacing":120.00001,"direction":"LEFT_TO_RIGHT"}}},{"startIndex":82098,"endIndex":82099,"paragraph":{"elements":[{"startIndex":82098,"endIndex":82099,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":82099,"endIndex":82285,"table":{"rows":3,"columns":2,"tableRows":[{"startIndex":82100,"endIndex":82115,"tableCells":[{"startIndex":82101,"endIndex":82107,"content":[{"startIndex":82102,"endIndex":82107,"paragraph":{"elements":[{"startIndex":82102,"endIndex":82107,"textRun":{"content":"type\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit