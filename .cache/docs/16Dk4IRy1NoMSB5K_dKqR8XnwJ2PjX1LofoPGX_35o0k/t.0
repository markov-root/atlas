":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":67749,"endIndex":67753,"content":[{"startIndex":67750,"endIndex":67751,"paragraph":{"elements":[{"startIndex":67750,"endIndex":67751,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}},{"startIndex":67751,"endIndex":67753,"paragraph":{"elements":[{"startIndex":67751,"endIndex":67752,"inlineObjectElement":{"inlineObjectId":"kix.jy20owtb7wg6","textStyle":{}}},{"startIndex":67752,"endIndex":67753,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":67753,"endIndex":67960,"tableCells":[{"startIndex":67754,"endIndex":67763,"content":[{"startIndex":67755,"endIndex":67763,"paragraph":{"elements":[{"startIndex":67755,"endIndex":67763,"textRun":{"content":"caption\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":67763,"endIndex":67960,"content":[{"startIndex":67764,"endIndex":67960,"paragraph":{"elements":[{"startIndex":67764,"endIndex":67940,"textRun":{"content":"Swiss cheese model representing our recommended defense-in-depth strategy against the risk of loss of control via internally deployed misaligned AI. Threat vectors are in red (","textStyle":{}}},{"startIndex":67940,"endIndex":67957,"textRun":{"content":"Stix et al., 2025","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2504.12170"}}}},{"startIndex":67957,"endIndex":67960,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":80,"unit":"PT"}}]}}},{"startIndex":67961,"endIndex":67962,"paragraph":{"elements":[{"startIndex":67961,"endIndex":67962,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":67962,"endIndex":67989,"paragraph":{"elements":[{"startIndex":67962,"endIndex":67989,"textRun":{"content":"Frontier Safety Frameworks\n","textStyle":{}}}],"paragraphStyle":{"headingId":"h.ktdzgsfsqvdw","namedStyleType":"HEADING_3","direction":"LEFT_TO_RIGHT"}}},{"startIndex":67989,"endIndex":67990,"paragraph":{"elements":[{"startIndex":67989,"endIndex":67990,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":67990,"endIndex":69063,"paragraph":{"elements":[{"startIndex":67990,"endIndex":68067,"textRun":{"content":"Frontier Safety Frameworks (FSFs) are one example of corporate AI governance.","textStyle":{"bold":true}}},{"startIndex":68067,"endIndex":68858,"textRun":{"content":" FSFs are policies that AI companies create to guide their development process and ensure they're taking appropriate precautions as their systems become more capable. They're the equivalent of the safety protocols used in nuclear power plants or high-security laboratories, and help bridge internal corporate governance mechanisms and external regulatory oversight in AI safety. The concept of a FSF was first introduced in 2023. They gained momentum during the Seoul AI Summit in May 2024, where 16 companies committed to implementing such policies. As of March 2025, twelve companies have published comprehensive frontier AI safety policies: Anthropic, OpenAI, Google DeepMind, Magic, Naver, Meta, G42, Cohere, Microsoft, Amazon, xAI, and Nvidia, with additional companies following suit (","textStyle":{}}},{"startIndex":68858,"endIndex":68868,"textRun":{"content":"METR, 2025","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://metr.org/blog/2025-03-26-common-elements-of-frontier-ai-safety-policies/"}}}},{"startIndex":68868,"endIndex":69063,"textRun":{"content":"). They go under different names, for example OpenAI calls their FSF the preparedness framework, and Anthropic calls them responsible scaling policies (RSPs). They are very similar in principle.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":69063,"endIndex":69064,"paragraph":{"elements":[{"startIndex":69063,"endIndex":69064,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":69064,"endIndex":69200,"paragraph":{"elements":[{"startIndex":69064,"endIndex":69115,"textRun":{"content":"What essential elements define a comprehensive FSF?","textStyle":{"bold":true}}},{"startIndex":69115,"endIndex":69200,"textRun":{"content":" Despite variations in implementation, most FSFs share several fundamental elements:\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":69200,"endIndex":69694,"paragraph":{"elements":[{"startIndex":69200,"endIndex":69221,"textRun":{"content":"Capability Thresholds","textStyle":{"bold":true}}},{"startIndex":69221,"endIndex":69338,"textRun":{"content":": FSFs establish specific thresholds at which AI capabilities would pose severe risks requiring enhanced safeguards (","textStyle":{}}},{"startIndex":69338,"endIndex":69355,"textRun":{"content":"Nevo et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.rand.org/pubs/research_reports/RRA2849-1.html"}}}},{"startIndex":69355,"endIndex":69694,"textRun":{"content":"). Common capability concerns include: Biological weapons assistance (such as enabling the creation of dangerous pathogens), Cyber Offensive capabilities (such as automating zero-day exploit discovery), Automated AI research and development (such as accelerating AI progress beyond human oversight), Autonomous replication and adaptation.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.5xy6klczii30","textStyle":{}}}},{"startIndex":69694,"endIndex":70065,"paragraph":{"elements":[{"startIndex":69694,"endIndex":69715,"textRun":{"content":"Model Weight Security","textStyle":{"bold":true}}},{"startIndex":69715,"endIndex":70045,"textRun":{"content":": As models approach dangerous capability thresholds, companies implement increasingly sophisticated security measures to prevent unauthorized access to model weights. These range from standard information security protocols to advanced measures like restricted access environments, encryption, and specialized hardware security (","textStyle":{}}},{"startIndex":70045,"endIndex":70062,"textRun":{"content":"Nevo et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.rand.org/pubs/research_reports/RRA2849-1.html"}}}},{"startIndex":70062,"endIndex":70065,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.5xy6klczii30","textStyle":{}}}},{"startIndex":70065,"endIndex":70295,"paragraph":{"elements":[{"startIndex":70065,"endIndex":70110,"textRun":{"content":"Conditions for Halting Development/Deployment","textStyle":{"bold":true}}},{"startIndex":70110,"endIndex":70282,"textRun":{"content":": Most frameworks contain explicit commitments to pause model development or deployment if capability thresholds are crossed before adequate safeguards can be implemented (","textStyle":{}}},{"startIndex":70282,"endIndex":70292,"textRun":{"content":"METR, 2025","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://metr.org/blog/2025-03-26-common-elements-of-frontier-ai-safety-policies/"}}}},{"startIndex":70292,"endIndex":70295,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.5xy6klczii30","textStyle":{}}}},{"startIndex":70295,"endIndex":70476,"paragraph":{"elements":[{"startIndex":70295,"endIndex":70322,"textRun":{"content":"Full Capability Elicitation","textStyle":{"bold":true}}},{"startIndex":70322,"endIndex":70454,"textRun":{"content":": Through FSFs, companies commit to evaluating models in ways that reveal their full capabilities rather than underestimating them (","textStyle":{}}},{"startIndex":70454,"endIndex":70473,"textRun":{"content":"Phuong et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2403.13793"}}}},{"startIndex":70473,"endIndex":70476,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.5xy6klczii30","textStyle":{}}}},{"startIndex":70476,"endIndex":70760,"paragraph":{"elements":[{"startIndex":70476,"endIndex":70507,"textRun":{"content":"Evaluation Frequency and Timing","textStyle":{"bold":true}}},{"startIndex":70507,"endIndex":70736,"textRun":{"content":": FSFs establish specific timelines for when evaluations must occur (typically before deployment, during training, and after deployment) with triggers for additional assessments when models show significant capability increases (","textStyle":{}}},{"startIndex":70736,"endIndex":70757,"textRun":{"content":"Davidson et al., 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2312.07413"}}}},{"startIndex":70757,"endIndex":70760,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.5xy6klczii30","textStyle":{}}}},{"startIndex":70760,"endIndex":71069,"paragraph":{"elements":[{"startIndex":70760,"endIndex":70785,"textRun":{"content":"Accountability Mechanisms","textStyle":{"bold":true}}},{"startIndex":70785,"endIndex":71069,"textRun":{"content":": These include: Internal governance roles (for example, Anthropic's \"Responsible Scaling Officer\"), External advisory boards and third-party audits, Transparency commitments about model capabilities and safety measures, Whistleblower protections for staff reporting safety concerns.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.5xy6klczii30","textStyle":{}}}},{"startIndex":71069,"endIndex":71254,"paragraph":{"elements":[{"startIndex":71069,"endIndex":71083,"textRun":{"content":"Policy Updates","textStyle":{"bold":true}}},{"startIndex":71083,"endIndex":71241,"textRun":{"content":": All FSFs acknowledge the evolving nature of AI risks and commit to regular policy reviews and updates as understanding of risks and best practices improve (","textStyle":{}}},{"startIndex":71241,"endIndex":71251,"textRun":{"content":"METR, 2025","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://metr.org/blog/2025-03-26-common-elements-of-frontier-ai-safety-policies/"}}}},{"startIndex":71251,"endIndex":71254,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.5xy6klczii30","textStyle":{}}}},{"startIndex":71254,"endIndex":71255,"paragraph":{"elements":[{"startIndex":71254,"endIndex":71255,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":71255,"endIndex":71926,"paragraph":{"elements":[{"startIndex":71255,"endIndex":71364,"textRun":{"content":"A multi-layered internal auditing and governance approach helps operationalize safety frameworks in practice.","textStyle":{"bold":true}}},{"startIndex":71364,"endIndex":71791,"textRun":{"content":" When actually implementing the safety frameworks, organizations should ensure risks are identified and managed at multiple levels, reducing the chances of dangerous oversights. For example, when researchers develop a model with unexpectedly advanced capabilities, safety teams can conduct thorough evaluations and implement additional safeguards, while audit teams review broader processes for managing emergent capabilities (","textStyle":{}}},{"startIndex":71791,"endIndex":71804,"textRun":{"content":"Schuett, 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2212.08364"}}}},{"startIndex":71804,"endIndex":71910,"textRun":{"content":"). One approach is the Three Lines of Defense (3LoD) model adapted from other safety-critical industries (","textStyle":{}}},{"startIndex":71910,"endIndex":71923,"textRun":{"content":"Schuett, 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2212.08364"}}}},{"startIndex":71923,"endIndex":71926,"textRun":{"content":"):\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":71926,"endIndex":72121,"paragraph":{"elements":[{"startIndex":71926,"endIndex":71947,"textRun":{"content":"First Line of Defense","textStyle":{"bold":true}}},{"startIndex":71947,"endIndex":72121,"textRun":{"content":": Frontline researchers and developers implement safety measures in day-to-day work, conduct initial risk assessments, and adhere to ethical guidelines and safety protocols.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.ri2mh2oeobjw","textStyle":{}}}},{"startIndex":72121,"endIndex":72308,"paragraph":{"elements":[{"startIndex":72121,"endIndex":72143,"textRun":{"content":"Second Line of Defense","textStyle":{"bold":true}}},{"startIndex":72143,"endIndex":72308,"textRun":{"content":": Specialized risk management and compliance functions, including AI ethics committees, dedicated safety teams, and compliance units provide oversight and guidance.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.ri2mh2oeobjw","textStyle":{}}}},{"startIndex":72308,"endIndex":72533,"paragraph":{"elements":[{"startIndex":72308,"endIndex":72329,"textRun":{"content":"Third Line of Defense","textStyle":{"bold":true}}},{"startIndex":72329,"endIndex":72533,"textRun":{"content":": Independent internal audit functions provide assurance to board and senior management through regular audits of safety practices, independent model evaluations, and assessments of overall preparedness.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.ri2mh2oeobjw","textStyle":{}}}},{"startIndex":72533,"endIndex":72534,"paragraph":{"elements":[{"startIndex":72533,"endIndex":72534,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":72534,"endIndex":72535,"paragraph":{"elements":[{"startIndex":72534,"endIndex":72535,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":72535,"endIndex":72628,"table":{"rows":3,"columns":2,"tableRows":[{"startIndex":72536,"endIndex":72551,"tableCells":[{"startIndex":72537,"endIndex":72543,"content":[{"startIndex":72538,"endIndex":72543,"paragraph":{"elements":[{"startIndex":72538,"endIndex":72543,"textRun":{"content":"type\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}}}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":72543,"endIndex":72551,"content":[{"startIndex":72544,"endIndex":72551,"paragraph":{"elements":[{"startIndex":72544,"endIndex":72551,"textRun":{"content":"figure\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}}}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":72551,"endIndex":72565