":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":18697,"endIndex":18801,"tableCells":[{"startIndex":18698,"endIndex":18707,"content":[{"startIndex":18699,"endIndex":18707,"paragraph":{"elements":[{"startIndex":18699,"endIndex":18707,"textRun":{"content":"caption\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":18707,"endIndex":18801,"content":[{"startIndex":18708,"endIndex":18801,"paragraph":{"elements":[{"startIndex":18708,"endIndex":18801,"textRun":{"content":"The spectrum of chip architectures with trade-offs in regards to efficiency and flexibility.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":80,"unit":"PT"}}]}}},{"startIndex":18802,"endIndex":18803,"paragraph":{"elements":[{"startIndex":18802,"endIndex":18803,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":18803,"endIndex":19303,"paragraph":{"elements":[{"startIndex":18803,"endIndex":18924,"textRun":{"content":"Rather than trying to control all computing infrastructure, governance should focus specifically on specialized AI chips.","textStyle":{"bold":true}}},{"startIndex":18924,"endIndex":19168,"textRun":{"content":" These are distinct from general-purpose hardware in both capabilities and supply chains. By targeting only the most advanced AI-specific chips, we can address catastrophic risks while leaving the broader computing ecosystem largely untouched (","textStyle":{}}},{"startIndex":19168,"endIndex":19185,"textRun":{"content":"Heim et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2403.08501"}}}},{"startIndex":19185,"endIndex":19303,"textRun":{"content":"). For example, U.S. export controls specifically target high-end data center GPUs while excluding consumer hardware.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":19303,"endIndex":19304,"paragraph":{"elements":[{"startIndex":19303,"endIndex":19304,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":19304,"endIndex":19315,"paragraph":{"elements":[{"startIndex":19304,"endIndex":19315,"textRun":{"content":"Monitoring\n","textStyle":{}}}],"paragraphStyle":{"headingId":"h.igo7kvoybr96","namedStyleType":"HEADING_2","direction":"LEFT_TO_RIGHT"}}},{"startIndex":19315,"endIndex":19316,"paragraph":{"elements":[{"startIndex":19315,"endIndex":19316,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":19316,"endIndex":20176,"paragraph":{"elements":[{"startIndex":19316,"endIndex":19441,"textRun":{"content":"Training frontier AI models leaves multiple observable footprints which might allow us to detect concerning AI training runs.","textStyle":{"bold":true}}},{"startIndex":19441,"endIndex":19624,"textRun":{"content":" The most reliable is energy consumption - training runs that might produce dangerous systems require massive power usage, often hundreds of megawatts, creating distinctive patterns (","textStyle":{}}},{"startIndex":19624,"endIndex":19642,"textRun":{"content":"Wasil et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2408.16074"}}}},{"startIndex":19642,"endIndex":19643,"textRun":{"content":";","textStyle":{}}},{"startIndex":19643,"endIndex":19656,"textRun":{"content":" Shavit, 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2303.11341"}}}},{"startIndex":19656,"endIndex":19924,"textRun":{"content":"). Besides energy, other technical indicators include network traffic patterns characteristic of model training, hardware procurement and shipping records, cooling system requirements and thermal signatures, infrastructure buildout like power substation construction (","textStyle":{}}},{"startIndex":19924,"endIndex":19943,"textRun":{"content":"Sastry et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2402.08797"}}}},{"startIndex":19943,"endIndex":19944,"textRun":{"content":";","textStyle":{}}},{"startIndex":19944,"endIndex":19957,"textRun":{"content":" Shavit, 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2303.11341"}}}},{"startIndex":19957,"endIndex":19958,"textRun":{"content":";","textStyle":{}}},{"startIndex":19958,"endIndex":19976,"textRun":{"content":" Heim et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2403.08501"}}}},{"startIndex":19976,"endIndex":20176,"textRun":{"content":"). These signals become particularly powerful when combined - sudden spikes in both energy usage and network traffic at a facility containing known AI hardware strongly suggest active model training.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":20176,"endIndex":20177,"paragraph":{"elements":[{"startIndex":20176,"endIndex":20177,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":20177,"endIndex":20785,"paragraph":{"elements":[{"startIndex":20177,"endIndex":20265,"textRun":{"content":"Regulations have already begun using compute thresholds to trigger oversight mechanisms.","textStyle":{"bold":true}}},{"startIndex":20265,"endIndex":20614,"textRun":{"content":" The U.S. Executive Order on AI requires companies to notify the government about training runs exceeding $10^26$ operations - a threshold designed to capture the development of the most capable systems. The EU AI Act sets an even lower threshold of $10^25$ operations, requiring not just notification but also risk assessments and safety measures (","textStyle":{}}},{"startIndex":20614,"endIndex":20635,"textRun":{"content":"Heim & Koessler, 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2405.10799"}}}},{"startIndex":20635,"endIndex":20785,"textRun":{"content":"). These thresholds help identify potentially risky development activities before they complete, enabling preventive rather than reactive governance.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":20785,"endIndex":20786,"paragraph":{"elements":[{"startIndex":20785,"endIndex":20786,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":20786,"endIndex":20915,"table":{"rows":3,"columns":2,"tableRows":[{"startIndex":20787,"endIndex":20802,"tableCells":[{"startIndex":20788,"endIndex":20794,"content":[{"startIndex":20789,"endIndex":20794,"paragraph":{"elements":[{"startIndex":20789,"endIndex":20794,"textRun":{"content":"type\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"u