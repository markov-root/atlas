lor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":33660,"endIndex":33869,"content":[{"startIndex":33661,"endIndex":33662,"paragraph":{"elements":[{"startIndex":33661,"endIndex":33662,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}},{"startIndex":33662,"endIndex":33869,"paragraph":{"elements":[{"startIndex":33662,"endIndex":33845,"textRun":{"content":"Cumulative number of large-scale AI systems by country since 2017. Refers to the location of the primary organization with which the authors of large-scale AI systems are affiliated (","textStyle":{}}},{"startIndex":33845,"endIndex":33866,"textRun":{"content":"Giattino et al., 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://ourworldindata.org/artificial-intelligence"}}}},{"startIndex":33866,"endIndex":33869,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":80,"unit":"PT"}}]}}},{"startIndex":33870,"endIndex":33871,"paragraph":{"elements":[{"startIndex":33870,"endIndex":33871,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":33871,"endIndex":34337,"paragraph":{"elements":[{"startIndex":33871,"endIndex":33941,"textRun":{"content":"Race dynamics make collective action and coordination feel impossible.","textStyle":{"bold":true}}},{"startIndex":33941,"endIndex":34337,"textRun":{"content":" Countries hesitate to implement strong safety regulations that might handicap their domestic AI industries. Companies resist voluntary safety commitments unless competitors make identical pledges. Everyone waits for others to move first, creating gridlock even when all parties privately acknowledge the risks. The result is a lowest-common-denominator approach to safety that satisfies no one.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":34337,"endIndex":34338,"paragraph":{"elements":[{"startIndex":34337,"endIndex":34338,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":34338,"endIndex":34646,"paragraph":{"elements":[{"startIndex":34338,"endIndex":34410,"textRun":{"content":"AI governance needs innovative approaches to break out of race dynamics.","textStyle":{"bold":true}}},{"startIndex":34410,"endIndex":34556,"textRun":{"content":" Traditional arms control offers limited lessons, since AI development happens in private companies, not government labs. We need new approaches (","textStyle":{}}},{"startIndex":34556,"endIndex":34575,"textRun":{"content":"Trajano & Ang, 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://rsis.edu.sg/rsis-publication/rsis/we-need-to-prevent-a-global-ai-arms-race-now/"}}}},{"startIndex":34575,"endIndex":34576,"textRun":{"content":";","textStyle":{}}},{"startIndex":34576,"endIndex":34590,"textRun":{"content":" Barnett, 2025","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://techgov.intelligence.org/research/ai-governance-to-avoid-extinction"}}}},{"startIndex":34590,"endIndex":34646,"textRun":{"content":"). Several ideas have been proposed. Some examples are:\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":34646,"endIndex":34973,"paragraph":{"elements":[{"startIndex":34646,"endIndex":34674,"textRun":{"content":"Reciprocal snap-back limits.","textStyle":{"bold":true}}},{"startIndex":34674,"endIndex":34955,"textRun":{"content":" States publish caps on model scale, autonomous-weapon deployment and data-center compute that activate only when peers file matching commitments. The symmetry removes the fear of unilateral restraint and keeps incentives focused on shared security rather than zero-sum dominance (","textStyle":{}}},{"startIndex":34955,"endIndex":34970,"textRun":{"content":"Karnofsky, 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://carnegieendowment.org/research/2024/09/if-then-commitments-for-ai-risk-reduction?lang=en"}}}},{"startIndex":34970,"endIndex":34973,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.1l4dqtymryjz","textStyle":{}}}},{"startIndex":34973,"endIndex":35336,"paragraph":{"elements":[{"startIndex":34973,"endIndex":35003,"textRun":{"content":"Safety as a competitive asset.","textStyle":{"bold":true}}},{"startIndex":35003,"endIndex":35289,"textRun":{"content":" Labs earn market trust by subjecting frontier models to independent red-team audits, embedding provenance watermarks and disclosing incident reports. Regulation can turn these practices into a de-facto licence to operate so that “secure by design” becomes the shortest route to sales (","textStyle":{}}},{"startIndex":35289,"endIndex":35310,"textRun":{"content":"Shevlane et al., 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://intelligence.org/wp-content/uploads/2025/05/AI-Governance-to-Avoid-Extinction.pdf"}}}},{"startIndex":35310,"endIndex":35311,"textRun":{"content":";","textStyle":{}}},{"startIndex":35311,"endIndex":35333,"textRun":{"content":" Tamirisa et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2408.00761"}}}},{"startIndex":35333,"endIndex":35336,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.1l4dqtymryjz","textStyle":{}}}},{"startIndex":35336,"endIndex":35790,"paragraph":{"elements":[{"startIndex":35336,"endIndex":35348,"textRun":{"content":"Containment.","textStyle":{"bold":true}}},{"startIndex":35348,"endIndex":35734,"textRun":{"content":" Export controls on advanced chips; API-only access with real-time misuse monitoring; digital forensics; and Know-Your-Customer checks slow the spread of dangerous capabilities even as beneficial services stay widely available. These measures address open publication, model theft, talent mobility and hardware diffusion; factors that let a single leak replicate worldwide within days (","textStyle":{}}},{"startIndex":35734,"endIndex":35755,"textRun":{"content":"Shevlane et al., 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://intelligence.org/wp-content/uploads/2025/05/AI-Governance-to-Avoid-Extinction.pdf"}}}},{"startIndex":35755,"endIndex":35756,"textRun":{"content":";","textStyle":{}}},{"startIndex":35756,"endIndex":35768,"textRun":{"content":" Seger, 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2311.09227"}}}},{"startIndex":35768,"endIndex":35769,"textRun":{"content":";","textStyle":{}}},{"startIndex":35769,"endIndex":35787,"textRun":{"content":" Nevo et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.rand.org/pubs/research_reports/RRA2849-1.html"}}}},{"startIndex":35787,"endIndex":35790,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.1l4dqtymryjz","textStyle":{}}}},{"startIndex":35790,"endIndex":36159,"paragraph":{"elements":[{"startIndex":35790,"endIndex":35850,"textRun":{"content":"Agile multilateral oversight with a coordinated halt option.","textStyle":{"bold":true}}},{"startIndex":35850,"endIndex":36115,"textRun":{"content":" A lean UN-mandated body (think about it like a CERN or an IAEA-for-AI) needs the authority to impose emergency pauses when red-lines are crossed, backed by chip export restrictions and cloud-provider throttles that make a global “off switch” technically credible (","textStyle":{}}},{"startIndex":36115,"endIndex":36130,"textRun":{"content":"Karnofsky, 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://carnegieendowment.org/research/2024/09/if-then-commitments-for-ai-risk-reduction?lang=en"}}}},{"startIndex":36130,"endIndex":36131,"textRun":{"content":";","textStyle":{}}},{"startIndex":36131,"endIndex":36156,"textRun":{"content":" Petropoulos et al., 2025","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://cfg.eu/building-cern-for-ai/#chapter-12"}}}},{"startIndex":36156,"endIndex":36159,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.1l4dqtymryjz","textStyle":{}}}},{"startIndex":36159,"endIndex":36512,"paragraph":{"elements":[{"startIndex":36159,"endIndex":36184,"textRun":{"content":"Secret-safe verification.","textStyle":{"bold":true}}},{"startIndex":36184,"endIndex":36444,"textRun":{"content":" Secure enclaves, tamper-evident compute logs and zero-knowledge proofs let inspectors confirm that firms observe model and data controls without exposing weights or proprietary code, closing the principal oversight gap identified in current treaty proposals (","textStyle":{}}},{"startIndex":36444,"endIndex":36465,"textRun":{"content":"Shevlane et al., 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://intelligence.org/wp-content/uploads/2025/05/AI-Governance-to-Avoid-Extinction.pdf"}}}},{"startIndex":36465,"endIndex":36466,"textRun":{"content":";","textStyle":{}}},{"startIndex":36466,"endIndex":36485,"textRun":{"content":" Wasil et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2408.16074"}}}},{"startIndex":36485,"endIndex":36486,"textRun":{"content":";","textStyle":{}}},{"startIndex":36486,"endIndex":36509,"textRun":{"content":" Anderljung et al. 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2303.09377"}}}},{"startIndex":36509,"endIndex":36512,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.1l4dqtymryjz","textStyle":{}}}},{"startIndex":36512,"endIndex":36513,"paragraph":{"elements":[{"startIndex":36512,"endIndex":36513,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":36513,"endIndex":36527,"paragraph":{"elements":[{"startIndex":36513,"endIndex":36527,"textRun":{"content":"Proliferation\n","textStyle":{}}}],"paragraphStyle":{"headingId":"h.fkdc9xz4miwm","namedStyleType":"HEADING_2","direction":"LEFT_TO_RIGHT"}}},{"startIndex":36527,"endIndex":36528,"paragraph":{"elements":[{"startIndex":36527,"endIndex":36528,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":36528,"endIndex":37622,"paragraph":{"elements":[{"startIndex":36528,"endIndex":36661,"textRun":{"content":"AI capabilities propagate globally through digital networks at speeds that render traditional control mechanisms largely ineffective.","textStyle":{"bold":true}}},{"startIndex":36661,"endIndex":37622,"textRun":{"content":" Unlike nuclear weapons that require specialized materials and facilities, AI models are patterns of numbers that can be copied and transmitted instantly. Let's think about this scenario - a cutting-edge AI model, capable of generating hyper-realistic deepfakes or designing novel bioweapons, is developed by a well-intentioned research lab. The lab, adhering to principles of open science, publishes their findings and releases the model's code as open-source. Within hours, the model is downloaded thousands of times across the globe. Within days, modified versions start appearing on code-sharing platforms. Within weeks, the capabilities that were once confined to a single lab have proliferated across the internet, accessible to anyone with a decent computer and an internet connection. This scenario, while hypothetical, isn't far from reality. This fundamental difference makes traditional non-proliferation approaches nearly useless for AI governance.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":37622,"endIndex":37623,"paragraph":{"elements":[{"startIndex":37622,"endIndex":37623,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":37623,"endIndex":39746,"table":{"rows":4,"columns":2,"tableRows":[{"startIndex":37624,"endIndex":37640,"tableCells":[{"startIndex":37625,"endIndex":37631,"content":[{"startIndex":37626,"endIndex":37631,"paragraph":{"elements":[{"startIndex":37626,"endIndex":37631,"textRun":{"content":"type\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderT