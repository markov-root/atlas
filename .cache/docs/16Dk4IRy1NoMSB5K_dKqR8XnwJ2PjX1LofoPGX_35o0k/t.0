agnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":55036,"endIndex":55057,"content":[{"startIndex":55037,"endIndex":55057,"paragraph":{"elements":[{"startIndex":55037,"endIndex":55057,"textRun":{"content":"section-description\n","textStyle":{"fontSize":{"magnitude":11,"unit":"PT"}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}}}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":55057,"endIndex":55251,"tableCells":[{"startIndex":55058,"endIndex":55067,"content":[{"startIndex":55059,"endIndex":55067,"paragraph":{"elements":[{"startIndex":55059,"endIndex":55067,"textRun":{"content":"content\n","textStyle":{"fontSize":{"magnitude":11,"unit":"PT"}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}}}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":55067,"endIndex":55251,"content":[{"startIndex":55068,"endIndex":55251,"paragraph":{"elements":[{"startIndex":55068,"endIndex":55251,"textRun":{"content":"Robust governance requires combining corporate self-governance for technical speed, national regulation for enforcement, and international coordination to address cross border risks.\n","textStyle":{"fontSize":{"magnitude":11,"unit":"PT"}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":80,"unit":"PT"}}]}}},{"startIndex":55252,"endIndex":55253,"paragraph":{"elements":[{"startIndex":55252,"endIndex":55253,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":55253,"endIndex":55775,"paragraph":{"elements":[{"startIndex":55253,"endIndex":55351,"textRun":{"content":"The governance of frontier AI cannot be entrusted to any single institution or level of authority.","textStyle":{"bold":true}}},{"startIndex":55351,"endIndex":55775,"textRun":{"content":" Companies lack incentives to fully account for societal impacts, nations compete for technological advantage, and international bodies struggle with capacity for enforcement. Each level of governance – corporate, national, and international — brings unique strengths and faces distinct limitations. Understanding how these levels interact and reinforce each other is important for building effective AI governance systems.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":55775,"endIndex":55852,"table":{"rows":3,"columns":2,"tableRows":[{"startIndex":55776,"endIndex":55791,"tableCells":[{"startIndex":55777,"endIndex":55783,"content":[{"startIndex":55778,"endIndex":55783,"paragraph":{"elements":[{"startIndex":55778,"endIndex":55783,"textRun":{"content":"type\n","textStyle":{}}}],"paragraphStyle":{"namedSt