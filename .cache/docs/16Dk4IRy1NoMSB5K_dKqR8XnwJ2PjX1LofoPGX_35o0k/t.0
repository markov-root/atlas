itude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":10306,"endIndex":10358,"tableCells":[{"startIndex":10307,"endIndex":10316,"content":[{"startIndex":10308,"endIndex":10316,"paragraph":{"elements":[{"startIndex":10308,"endIndex":10316,"textRun":{"content":"caption\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":10316,"endIndex":10358,"content":[{"startIndex":10317,"endIndex":10358,"paragraph":{"elements":[{"startIndex":10317,"endIndex":10344,"textRun":{"content":"Examples of Proliferation (","textStyle":{}}},{"startIndex":10344,"endIndex":10355,"textRun":{"content":"Özcan, 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://cfg.eu/ai-governance-challenges-part-3-proliferation/"}}}},{"startIndex":10355,"endIndex":10358,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":80,"unit":"PT"}}]}}},{"startIndex":10359,"endIndex":10360,"paragraph":{"elements":[{"startIndex":10359,"endIndex":10360,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":10360,"endIndex":10379,"paragraph":{"elements":[{"startIndex":10360,"endIndex":10379,"textRun":{"content":"Governance Targets\n","textStyle":{}}}],"paragraphStyle":{"headingId":"h.gqfli233hi37","namedStyleType":"HEADING_2","lineSpacing":120.00001,"direction":"LEFT_TO_RIGHT","keepLinesTogether":false,"keepWithNext":false}}},{"startIndex":10379,"endIndex":10380,"paragraph":{"elements":[{"startIndex":10379,"endIndex":10380,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":10380,"endIndex":10952,"paragraph":{"elements":[{"startIndex":10380,"endIndex":10510,"textRun":{"content":"The unique challenges associated with AI governance mean we need to carefully choose where and how to intervene in AI development.","textStyle":{"bold":true}}},{"startIndex":10510,"endIndex":10602,"textRun":{"content":" This requires identifying both what to govern (targets) and how to govern it (mechanisms) (","textStyle":{}}},{"startIndex":10602,"endIndex":10625,"textRun":{"content":"Anderljung et al., 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2307.03718"}}}},{"startIndex":10625,"endIndex":10626,"textRun":{"content":";","textStyle":{}}},{"startIndex":10626,"endIndex":10649,"textRun":{"content":" Reuel & Bucknall, 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.governance.ai/research-paper/open-problems-in-technical-ai-governance"}}}},{"startIndex":10649,"endIndex":10952,"textRun":{"content":"). Governance must intervene at points that address core challenges before they manifest. We can't wait for dangerous capabilities to emerge or proliferate before acting. Instead, we need to identify intervention points in the AI development pipeline that will help us shape AI development proactively.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":10952,"endIndex":10953,"paragraph":{"elements":[{"startIndex":10952,"endIndex":10953,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":10953,"endIndex":11016,"paragraph":{"elements":[{"startIndex":10953,"endIndex":11016,"textRun":{"content":"Effective governance targets share three essential properties:\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":11016,"endIndex":11284,"paragraph":{"elements":[{"startIndex":11016,"endIndex":11029,"textRun":{"content":"Measurability","textStyle":{"bold":true}}},{"startIndex":11029,"endIndex":11262,"textRun":{"content":": We must be able to track and verify what's happening. The amount of computing power used for training can be measured in precise units (floating-point operations), making it possible to set clear thresholds and monitor compliance (","textStyle":{}}},{"startIndex":11262,"endIndex":11281,"textRun":{"content":"Sastry et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2402.08797"}}}},{"startIndex":11281,"endIndex":11284,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.oo0pyzlatof2","textStyle":{}}}},{"startIndex":11284,"endIndex":11596,"paragraph":{"elements":[{"startIndex":11284,"endIndex":11299,"textRun":{"content":"Controllability","textStyle":{"bold":true}}},{"startIndex":11299,"endIndex":11576,"textRun":{"content":": There must be concrete mechanisms to influence the target. It's not enough to identify what matters, we need practical ways to shape it. The semiconductor supply chain, for instance, has clear chokepoints where export controls can effectively limit access to advanced chips (","textStyle":{}}},{"startIndex":11576,"endIndex":11593,"textRun":{"content":"Heim et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.governance.ai/research-paper/governing-through-the-cloud"}}}},{"startIndex":11593,"endIndex":11596,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.oo0pyzlatof2","textStyle":{}}}},{"startIndex":11596,"endIndex":11969,"paragraph":{"elements":[{"startIndex":11596,"endIndex":11610,"textRun":{"content":"Meaningfulness","textStyle":{"bold":true}}},{"startIndex":11610,"endIndex":11944,"textRun":{"content":": Targets should address fundamental aspects of AI development that actually shape capabilities and risks. Regulating superficial aspects like user interfaces might be easy but won't prevent the emergence of dangerous capabilities. Core inputs like compute and data, however, directly determine what kinds of AI systems can be built (","textStyle":{}}},{"startIndex":11944,"endIndex":11967,"textRun":{"content":"Anderljung et al., 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2307.03718"}}}},{"startIndex":11967,"endIndex":11969,"textRun":{"content":")\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT","indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.oo0pyzlatof2","textStyle":{}}}},{"startIndex":11969,"endIndex":11970,"paragraph":{"elements":[{"startIndex":11969,"endIndex":11970,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":11970,"endIndex":12483,"paragraph":{"elements":[{"startIndex":11970,"endIndex":12050,"textRun":{"content":"In the AI development pipeline, several intervention points meet these criteria.","textStyle":{"bold":true}}},{"startIndex":12050,"endIndex":12292,"textRun":{"content":" Early in development, we can target the compute infrastructure required for training and the data that shapes model capabilities. During and after development, we can implement safety frameworks, monitoring systems, and deployment controls (","textStyle":{}}},{"startIndex":12292,"endIndex":12315,"textRun":{"content":"Anderljung et. al, 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2307.03718"}}}},{"startIndex":12315,"endIndex":12316,"textRun":{"content":";","textStyle":{}}},{"startIndex":12316,"endIndex":12334,"textRun":{"content":" Heim et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.governance.ai/analysis/computing-power-and-the-governance-of-ai"}}}},{"startIndex":12334,"endIndex":12335,"textRun":{"content":";","textStyle":{}}},{"startIndex":12335,"endIndex":12358,"textRun":{"content":" Hausenloy et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2412.03824"}}}},{"startIndex":12358,"endIndex":12483,"textRun":{"content":"). Each target offers different opportunities and faces different challenges, which we'll explore in the following sections.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":12483,"endIndex":12485,"paragraph":{"elements":[{"startIndex":12483,"endIndex":12484,"pageBreak":{"textStyle":{}}},{"startIndex":12484,"endIndex":12485,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":12485,"endIndex":12504,"paragraph":{"elements":[{"startIndex":12485,"endIndex":12504,"textRun":{"content":"Compute Governance\n","textStyle":{"bold":true,"foregroundColor":{"color":{"rgbColor":{"red":0.05490196,"green":0.0627451,"blue":0.101960786}}},"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}}],"paragraphStyle":{"headingId":"h.ub59wrtfzil0","namedStyleType":"HEADING_1","alignment":"JUSTIFIED","lineSpacing":120.00001,"direction":"LEFT_TO_RIGHT","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false}}},{"startIndex":12504,"endIndex":12505,"paragraph":{"elements":[{"startIndex":12504,"endIndex":12505,"textRun":{"content":"\n","textStyle":{"fontSize":{"magnitude":11,"unit":"PT"}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":12505,"endIndex":12745,"table":{"rows":2,"columns":2,"tableRows":[{"startIndex":12506,"endIndex":12534,"table