{"body":{"content":[{"endIndex":1,"sectionBreak":{"sectionStyle":{"columnSeparatorStyle":"NONE","contentDirection":"LEFT_TO_RIGHT","sectionType":"CONTINUOUS"}}},{"startIndex":1,"endIndex":24,"paragraph":{"elements":[{"startIndex":1,"endIndex":24,"textRun":{"content":"Chapter 4 - Governance\n","textStyle":{}}}],"paragraphStyle":{"headingId":"h.sov21asntryq","namedStyleType":"TITLE","alignment":"CENTER","lineSpacing":120.00001,"direction":"LEFT_TO_RIGHT"}}},{"startIndex":24,"endIndex":251,"paragraph":{"elements":[{"startIndex":24,"endIndex":251,"textRun":{"content":"AI is unique as a general-purpose, information-processing, and potentially intelligent technology. This breaks traditional regulatory assumptions, demanding novel governance frameworks to manage its unprecedented global risks.\n","textStyle":{}}}],"paragraphStyle":{"headingId":"h.fb4c45vhaxhf","namedStyleType":"SUBTITLE","direction":"LEFT_TO_RIGHT"}}},{"startIndex":251,"endIndex":252,"paragraph":{"elements":[{"startIndex":251,"endIndex":252,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":252,"endIndex":265,"paragraph":{"elements":[{"startIndex":252,"endIndex":265,"textRun":{"content":"Introduction\n","textStyle":{}}}],"paragraphStyle":{"headingId":"h.r13eg6izk59d","namedStyleType":"HEADING_1","lineSpacing":120.00001,"direction":"LEFT_TO_RIGHT"}}},{"startIndex":265,"endIndex":266,"paragraph":{"elements":[{"startIndex":265,"endIndex":266,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":266,"endIndex":819,"table":{"rows":6,"columns":2,"tableRows":[{"startIndex":267,"endIndex":281,"tableCells":[{"startIndex":268,"endIndex":274,"content":[{"startIndex":269,"endIndex":274,"paragraph":{"elements":[{"startIndex":269,"endIndex":274,"textRun":{"content":"type\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":