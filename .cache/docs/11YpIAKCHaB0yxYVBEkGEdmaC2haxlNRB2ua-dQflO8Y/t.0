ingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":26329,"endIndex":26646,"content":[{"startIndex":26330,"endIndex":26646,"paragraph":{"elements":[{"startIndex":26330,"endIndex":26646,"textRun":{"content":"A 2D loss landscape where each dot represents a learned algorithm with a different set of parameters on the landscape. There are various different algorithms that the model can learn from the CoinRun example. The goal of SGD is to search through this space for the right dot (set of parameters = learned algorithm).\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":80,"unit":"PT"}}]}}},{"startIndex":26647,"endIndex":26648,"paragraph":{"elements":[{"startIndex":26647,"endIndex":26648,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}},{"startIndex":26648,"endIndex":26664,"paragraph":{"elements":[{"startIndex":26648,"endIndex":26664,"textRun":{"content":"Path Dependence\n","textStyle":{}}}],"paragraphStyle":{"headingId":"h.sloh13d1fzlu","namedStyleType":"HEADING_2","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}},{"startIndex":26664,"endIndex":26665,"paragraph":{"elements":[{"startIndex":26664,"endIndex":26665,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":26665,"endIndex":27347,"paragraph":{"elements":[{"startIndex":26665,"endIndex":26789,"textRun":{"content":"Path dependence determines whether different starting points in the loss landscape lead to the same algorithmic destination.","textStyle":{"bold":true}}},{"startIndex":26789,"endIndex":27347,"textRun":{"content":" In simple landscapes with one dominant valley, almost every starting point rolls into the same solution—that's low path dependence. But complex landscapes contain multiple deep valleys separated by ridges. Now your starting position matters enormously. Drop the ball on the left side of a ridge, and it rolls into Valley A (learning to \"move right\" in CoinRun). Drop it on the right side, and it rolls into Valley B (learning to \"collect coins\"). Both valleys represent perfect solutions during training, but they implement completely different algorithms.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}},{"startIndex":27347,"endIndex":27348,"paragraph":{"elements":[{"startIndex":27347,"endIndex":27348,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}},{"startIndex":27348,"endIndex":27736,"table":{"rows":4,"columns":2,"tableRows":[{"startIndex":27349,"endIndex":27368,"tableCells":[{"startIndex":27350,"endIndex":27356,"content":[{"startIndex":27351,"endIndex":27356,"paragraph":{"elements":[{"startIndex":27351,"endIndex":27356,"textRun":{"content":"type\n","textStyle":{"bold":true}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LE