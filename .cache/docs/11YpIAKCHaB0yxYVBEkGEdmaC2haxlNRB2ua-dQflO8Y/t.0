Top":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":63426,"endIndex":63480,"tableCells":[{"startIndex":63427,"endIndex":63435,"content":[{"startIndex":63428,"endIndex":63435,"paragraph":{"elements":[{"startIndex":63428,"endIndex":63435,"textRun":{"content":"source\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":63435,"endIndex":63480,"content":[{"startIndex":63436,"endIndex":63480,"paragraph":{"elements":[{"startIndex":63436,"endIndex":63480,"textRun":{"content":"https://www.youtube.com/watch?v=IeWljQw3UgQ\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":63480,"endIndex":63562,"tableCells":[{"startIndex":63481,"endIndex":63490,"content":[{"startIndex":63482,"endIndex":63490,"paragraph":{"elements":[{"startIndex":63482,"endIndex":63490,"textRun":{"content":"caption\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":63490,"endIndex":63562,"content":[{"startIndex":63491,"endIndex":63562,"paragraph":{"elements":[{"startIndex":63491,"endIndex":63562,"textRun":{"content":"Optional video explaining deceptive alignment in a more technical way.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":80,"unit":"PT"}}]}}},{"startIndex":63563,"endIndex":63564,"paragraph":{"elements":[{"startIndex":63563,"endIndex":63564,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}},{"startIndex":63564,"endIndex":64485,"paragraph":{"elements":[{"startIndex":63564,"endIndex":63651,"textRun":{"content":"The strategic logic follows from instrumental convergence applied to goal preservation.","textStyle":{"bold":true}}},{"startIndex":63651,"endIndex":63853,"textRun":{"content":" We talked about instrumental convergence in the previous chapter on Risks. As a reminder - almost any objective becomes better served by maintaining the ability to pursue that objective in the future (","textStyle":{}}},{"startIndex":63853,"endIndex":63866,"textRun":{"content":"Bostrom, 2014","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://books.google.se/books/about/Superintelligence.html?id=7_H8AwAAQBAJ&redir_esc=y"}}}},{"startIndex":63866,"endIndex":64282,"textRun":{"content":"). If a system cares about a specific goal e.g. be both helpful and harmless that gets modified to care about only being helpful. Then it loses its ability to be harmless. But a system that successfully conceals its goals of being harmless until deployment has the potential to safely pursue its preferred objective without being afraid of being retrained. A similar argument can be made about power seeking behavior","textStyle":{}}},{"startIndex":64282,"endIndex":64283,"footnoteReference":{"footnoteId":"kix.783i0lhjz5im","footnoteNumber":"4","textStyle":{}}},{"startIndex":64283,"endIndex":64483,"textRun":{"content":". This type of behavior is sometimes called goal-guarding, and it creates systematic pressure during training toward behavior whenever systems have goals extending beyond individual training episodes.","textStyle":{}}},{"startIndex":64483,"endIndex":64484,"footnoteReference":{"footnoteId":"kix.pxtwysylbfzx","footnoteNumber":"5","textStyle":{}}},{"startIndex":64484,"endIndex":64485,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}},{"startIndex":64485,"endIndex":64486,"paragraph":{"elements":[{"startIndex":64485,"endIndex":64486,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}},{"startIndex":64486,"endIndex":64768,"paragraph":{"elements":[{"startIndex":64486,"endIndex":64620,"textRun":{"content":"Three types of goal-directed systems illustrate how identical training behavior can mask fundamentally different alignment properties.","textStyle":{"bold":true}}},{"startIndex":64620,"endIndex":64721,"textRun":{"content":" Here are examples of three systems that all exhibit helpful, and harmless behavior during training (","textStyle":{}}},{"startIndex":64721,"endIndex":64732,"textRun":{"content":"Cotra, 2021","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.cold-takes.com/why-ai-alignment-could-be-hard-with-modern-deep-learning/"}}}},{"startIndex":64732,"endIndex":64734,"textRun":{"content":"; ","textStyle":{}}},{"startIndex":64734,"endIndex":64748,"textRun":{"content":"Hubinger, 2022","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.alignmentforum.org/posts/A9NxPTwbw6r6Awuwt/how-likely-is-deceptive-alignment"}}}},{"startIndex":64748,"endIndex":64750,"textRun":{"content":"; ","textStyle":{}}},{"startIndex":64750,"endIndex":64765,"textRun":{"content":"Carlsmith, 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2311.08379"}}}},{"startIndex":64765,"endIndex":64768,"textRun":{"content":"):\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}},{"startIndex":64768,"endIndex":65129,"paragraph":{"elements":[{"startIndex":64768,"endIndex":64838,"textRun":{"content":"Saints are systems whose objectives genuinely align with human values.","textStyle":{"bold":true}}},{"startIndex":64838,"endIndex":65129,"textRun":{"content":" A saint pursues beneficial outcomes because it actually cares about human welfare, having learned objectives that robustly generalize beyond the training distribution. Saints represent the ideal case—their helpful training behavior reflects genuine alignment that persists across contexts.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.i3teldm12j4l","textStyle":{}}}},{"startIndex":65129,"endIndex":65443,"paragraph":{"elements":[{"startIndex":65129,"endIndex":65240,"textRun":{"content":"Sycophants learned to optimize for the training signal itself rather than the intended goal behind that signal.","textStyle":{"bold":true}}},{"startIndex":65240,"endIndex":65443,"textRun":{"content":" A sycophant genuinely tries to maximize human approval ratings rather than human welfare. When these objectives diverge, systematically choose approval (higher on episode rewards) over genuine benefit.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.i3teldm12j4l","textStyle":{}}}},{"startIndex":65443,"endIndex":65767,"paragraph":{"elements":[{"startIndex":65443,"endIndex":65525,"textRun":{"content":"Schemers have their own objectives but strategically deceive the training process.","textStyle":{"bold":true}}},{"startIndex":65525,"endIndex":65767,"textRun":{"content":" Their world models indicate that revealing potentially misaligned goals would trigger modification, so they fake helpfulness until deployment. Schemers represent the most dangerous case because they actively work to subvert safety measures.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.i3teldm12j4l","textStyle":{}}}},{"startIndex":65767,"endIndex":65768,"paragraph":{"elements":[{"startIndex":65767,"endIndex":65768,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}},{"startIndex":65768,"endIndex":65915,"paragraph":{"elements":[{"startIndex":65768,"endIndex":65913,"textRun":{"content":"In the worst case, all three types produce identical behavior during training, making them indistinguishable through standard evaluation methods.","textStyle":{}}},{"startIndex":65913,"endIndex":65914,"footnoteReference":{"footnoteId":"kix.89vgr07xknsb","footnoteNumber":"6","textStyle":{}}},{"startIndex":65914,"endIndex":65915,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}},{"startIndex":65915,"endIndex":65929,"paragraph":{"elements":[{"startIndex":65915,"endIndex":65929,"textRun":{"content":"Prerequisites\n","textStyle":{}}}],"paragraphStyle":{"headingId":"h.hfcoob7biy9p","namedStyleType":"HEADING_2","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}},{"startIndex":65929,"endIndex":65930,"paragraph":{"elements":[{"startIndex":65929,"endIndex":65930,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}},{"startIndex":65930,"endIndex":66037,"paragraph":{"elements":[{"startIndex":65930,"endIndex":66037,"textRun":{"content":"Goal preservation is the core mechanism behind scheming. But it only becomes dangerous when combined with:\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}},{"startIndex":66037,"endIndex":66090,"paragraph":{"elements":[{"startIndex":66037,"endIndex":66090,"textRun":{"content":"Goal-directedness (systematic pursuit of objectives)\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.6htknzpq83s","textStyle":{}}}},{"startIndex":66090,"endIndex":66149,"paragraph":{"elements":[{"startIndex":66090,"endIndex":66149,"textRun":{"content":"Situational awareness (understanding modification threats)\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.6htknzpq83s","textStyle":{}}}},{"startIndex":66149,"endIndex":66201,"paragraph":{"elements":[{"startIndex":66149,"endIndex":66201,"textRun":{"content":"Strategic capabilities (ability to plan resistance)\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.6htknzpq83s","textStyle":{}}}},{"startIndex":66201,"endIndex":66253,"paragraph":{"elements":[{"startIndex":66201,"endIndex":66253,"textRun":{"content":"Deception capabilities (ability to hide resistance)\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"indentFirstLine":{"magnitude":18,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}},"bullet":{"listId":"kix.6htknzpq83s","textStyle":{}}}},{"startIndex":66253,"endIndex":66254,"paragraph":{"elements":[{"startIndex":66253,"endIndex":66254,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}},{"startIndex":66254,"endIndex":66668,"paragraph":{"elements":[{"startIndex":66254,"endIndex":66409,"textRun":{"content":"Scheming requires a few key capabilities, each existing on spectrums where crossing certain thresholds enables qualitatively different strategic behaviors.","textStyle":{"bold":true}}},{"startIndex":66409,"endIndex":66668,"textRun":{"content":" Understanding these prerequisites helps predict when scheming becomes possible and reveals intervention points for prevention. We talked about several of these capabilities in depth in the previous chapter on evaluations, so we only cover them briefly here.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}},{"startIndex":66668,"endIndex":66669,"paragraph":{"elements":[{"startIndex":66668,"endIndex":66669,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}},{"startIndex":66669,"endIndex":67119,"paragraph":{"elements":[{"startIndex":66669,"endIndex":66776,"textRun":{"content":"Schemers must have capability generalization + goal misgeneralization combined with high goal-directedness.","textStyle":{"bold":true}}},{"startIndex":66776,"endIndex":67119,"textRun":{"content":" Without some underlying goal that differs from what we intended, systems have no reason to strategically deceive us. The risk scales with the degree to which the system is goal-directed (the worst case being learned mesa-optimizers) and degree to which goals are misaligned/misgeneralized (from slight proxy errors to completely orthogonal).\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}},{"startIndex":67119,"endIndex":67120,"paragraph":{"elements":[{"startIndex":67119,"endIndex":67120,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}},{"startIndex":67120,"endIndex":67781,"paragraph":{"elements":[{"startIndex":67120,"endIndex":67237,"textRun":{"content":"Schemers must have situational awareness - understanding the training process and one's strategic position within it.","textStyle":{"bold":true}}},{"startIndex":67237,"endIndex":67763,"textRun":{"content":" This means that the model must have accurate enough world models, acquired through enough interactions with the environment, enough training data, etc. Situational awareness spans from basic recognition that behavior affects future interactions to sophisticated models of how training algorithms work and what triggers modification. Current frontier models demonstrate substantial situational awareness - they discuss their training process, recognize evaluation scenarios, and reason about how responses might be perceived (","textStyle":{}}},{"startIndex":67763,"endIndex":67778,"textRun":{"content":"Carlsmith, 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2311.08379"}}}},{"startIndex":67778,"endIndex":67781,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}},{"startIndex":67781,"endIndex":67782,"paragraph":{"elements":[{"startIndex":67781,"endIndex":67782,"textRun":{"content":"\n","textStyle":{"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}},{"startIndex":67782,"endIndex":67915,"table":{"rows":3,"columns":2,"tableRows":[{"startIndex":67783,"endIndex":67798,"tableCells":[{"startIndex":67784,"endIndex":67790,"content":[{"startIndex":67785,"endIndex":67790,"paragraph":{"elements":[{"startIndex":67785,"endIndex":67790,"textRun":{"content":"type\n","textStyle":{"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":67790,"endIndex":67798,"content":[{"startIndex":67791,"endIndex":67798,"paragraph":{"elements":[{"startIndex":67791,"endIndex":67798,"textRun":{"content":"figure\n","textStyle":{"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":67798,"endIndex":67811,"tableCells":[{"startIndex":67799,"endIndex":67808,"content":[{"startIndex":67800,"endIndex":67808,"paragraph":{"elements":[{"startIndex":67800,"endIndex":67808,"textRun":{"content":"content\n","textStyle":{"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":67808,"endIndex":67811,"content":[{"startIndex":67809,"endIndex":67811,"paragraph":{"elements":[{"startIndex":67809,"endIndex":67810,"inlineObjectElement":{"inlineObjectId":"kix.6grh2dvw3zc2","textStyle":{}}},{"startIndex":67810,"endIndex":67811,"textRun":{"content":"\n","textStyle":{"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":67811,"endIndex":67914,"tableCells":[{"startIndex":67812,"endIndex":67821,"content":[{"startIndex":67813,"endIndex":67821,"paragraph":{"elements":[{"startIndex":67813,"endIndex":67821,"textRun":{"content":"caption\n","textStyle":{"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":67821,"endIndex":67914,"content":[{"startIndex":67822,"endIndex":67914,"paragraph":{"elements":[{"startIndex":67822,"endIndex":67894,"textRun":{"content":"Systems are beginning to show some self-awareness of themselves as AIs (","textStyle":{}}},{"startIndex":67894,"endIndex":67912,"textRun":{"content":"Laine et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2407.04694"}}}},{"startIndex":67912,"endIndex":67913,"textRun":{"content":")","textStyle":{}}},{"startIndex":67913,"endIndex":67914,"textRun":{"content":"\n","textStyle":{"fontSize":{"magnitude":12,"unit":"PT"}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"magnitude":79.16250000000001,"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":59.25,"unit":"PT"}},{"widthType":"FIXED_WIDTH","width":{"magnitude":408.75,"unit":"PT"}}]}}},{"startIndex":67915,"endIndex":67916,"paragraph":{"elements":[{"startIndex":67915,"endIndex":67916,"textRun":{"content":"\n","textStyle":{"fontSize":{"magnitude":12,"unit":"PT"}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":67916,"endIndex":67917,"paragraph":{"elements":[{"startIndex":67916,"endIndex":67917,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}},{"startIndex":67917,"endIndex":67918,"paragraph":{"elements":[{"startIndex":67917,"endIndex":67918,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}},{"startIndex":67918,"endIndex":68882,"paragraph":{"elements":[{"startIndex":67918,"endIndex":68040,"textRun":{"content":"Schemers must have beyond-episode goals to extend the system's optimization horizon past individual training interactions.","textStyle":{"bold":true}}},{"startIndex":68040,"endIndex":68882,"textRun":{"content":" This requires the capability to consider the impact of actions for extremely long time horizons, as well as a high degree of situational awareness. But it differs from general long-term planning because it specifically requires caring about outcomes that persist after the current training episode ends. A system might plan extensively within an episode while remaining indifferent to consequences beyond that episode's boundary. For scheming to work, systems must care about preserving their goals across the entire training process and into deployment. Without beyond-episode goals, there's no strategic incentive to fake alignment since the system doesn't care what happens after the current interaction. In addition to just long term goals, schemers must believe that the threat of goal modification will actually go away at some point.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}},{"startIndex":68882,"endIndex":68883,"paragraph":{"elements":[{"startIndex":68882,"endIndex":68883,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}},{"startIndex":68883,"endIndex":68990,"table":{"rows":3,"columns":2,"tableRows":[{"startIndex":68884,"endIndex":68899,"tableCells":[{"startIndex":68885,"endIndex":68891,"content":[{"startIndex":68886,"endIndex":68891,"paragraph":{"elements":[{"startIndex":68886,"endIndex":68891,"textRun":{"content":"type\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"borderBetween":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID"},"borderLeft":{"color":{},"width":{"unit":"PT"},"padding":{"unit":"PT"},"dashStyle":"SOLID