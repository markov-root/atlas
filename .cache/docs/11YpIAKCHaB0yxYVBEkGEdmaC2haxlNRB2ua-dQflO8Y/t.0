her":false,"keepWithNext":false,"avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}},"pageBreakBefore":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":23159,"endIndex":23346,"content":[{"startIndex":23160,"endIndex":23346,"paragraph":{"elements":[{"startIndex":23160,"endIndex":23328,"textRun":{"content":"This is the loss landscape of ResNet-110-noshort, in both 3D (left) and 2D (right). The paths that SGD takes through these different loss landscapes will be different (","textStyle":{}}},{"startIndex":23328,"endIndex":23343,"textRun":{"content":"Li et al., 2017","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/1712.09913"}}}},{"startIndex":23343,"endIndex":23346,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":80,"unit":"PT"}}]}}},{"startIndex":23347,"endIndex":23348,"paragraph":{"elements":[{"startIndex":23347,"endIndex":23348,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}},{"startIndex":23348,"endIndex":24177,"paragraph":{"elements":[{"startIndex":23348,"endIndex":23458,"textRun":{"content":"The loss landscape itself remains identical across different training runs—only the starting position changes.","textStyle":{"bold":true}}},{"startIndex":23458,"endIndex":24177,"textRun":{"content":" Think of this landscape as a fixed mountain range with peaks, valleys, ridges, and basins. This terrain is completely determined by your network architecture (the geological structure), your training data (the climate that shaped it), and your loss function (the elevation measurement system). Every time you train the same architecture on the same data, you're exploring the exact same mountain range. The peaks and valleys never move. What changes is where you start: random initialization is like being blindfolded and dropped at a random location in this mountain range. From each starting point, gradient descent acts like a ball rolling downhill, following the steepest descent toward the nearest valley bottom.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}},{"startIndex":24177,"endIndex":24178,"paragraph":{"elements":[{"startIndex":24177,"endIndex":24178,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}},{"startIndex":24178,"endIndex":24996,"paragraph":{"elements":[{"startIndex":24178,"endIndex":24267,"textRun":{"content":"The geometry of these landscapes determines which algorithms are discoverable and robust.","textStyle":{"bold":true}}},{"startIndex":24267,"endIndex":24645,"textRun":{"content":" Some algorithmic solutions occupy wide, flat valleys where many parameter settings implement similar approaches. Others exist as sharp, narrow peaks that are difficult to find, easy to lose and often misgeneralize under distribution shifts. Algorithms in wide basins remain stable when their parameters are slightly perturbed, corresponding to robust, generalizable solutions (","textStyle":{}}},{"startIndex":24645,"endIndex":24660,"textRun":{"content":"Li et al., 2017","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/1712.09913"}}}},{"startIndex":24660,"endIndex":24758,"textRun":{"content":"). Sharp peaks represent brittle algorithms where tiny changes can cause major performance drops (","textStyle":{}}},{"startIndex":24758,"endIndex":24777,"textRun":{"content":"Keskar et al.; 2017","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/1609.04836"}}}},{"startIndex":24777,"endIndex":24996,"textRun":{"content":").  This geometry matters for goal misgeneralization because the width of different goal-valleys determines their discoverability—wider valleys for misaligned goals make those goals more likely to emerge from training.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}},{"startIndex":24996,"endIndex":24997,"paragraph":{"elements":[{"startIndex":24996,"endIndex":24997,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}},{"startIndex":24997,"endIndex":25520,"table":{"rows":3,"columns":2,"tableRows":[{"startIndex":24998,"endIndex":25013,"tableCells":[{"startIndex":24999,"endIndex":25005,"content":[{"startIndex":25000,"endIndex":25005,"paragraph":{"elements":[{"sta