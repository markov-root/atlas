PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":81177,"endIndex":81254,"tableCells":[{"startIndex":81178,"endIndex":81187,"content":[{"startIndex":81179,"endIndex":81187,"paragraph":{"elements":[{"startIndex":81179,"endIndex":81187,"textRun":{"content":"caption\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}}}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":81187,"endIndex":81254,"content":[{"startIndex":81188,"endIndex":81254,"paragraph":{"elements":[{"startIndex":81188,"endIndex":81232,"textRun":{"content":"Summarized results for in-context scheming (","textStyle":{}}},{"startIndex":81232,"endIndex":81251,"textRun":{"content":"Meinke et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2412.04984"}}}},{"startIndex":81251,"endIndex":81254,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":52.5,"unit":"PT"}},{"widthType":"FIXED_WIDTH","width":{"magnitude":345,"unit":"PT"}}]}}},{"startIndex":81255,"endIndex":81256,"paragraph":{"elements":[{"startIndex":81255,"endIndex":81256,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":81256,"endIndex":81257,"paragraph":{"elements":[{"startIndex":81256,"endIndex":81257,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":60,"unit":"PT"}}]}}},{"startIndex":81258,"endIndex":81259,"paragraph":{"elements":[{"startIndex":81258,"endIndex":81259,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":81259,"endIndex":81802,"paragraph":{"elements":[{"startIndex":81259,"endIndex":81351,"textRun":{"content":"Models demonstrated deception capabilities that exceeded their visible reasoning complexity.","textStyle":{"bold":true}}},{"startIndex":81351,"endIndex":81553,"textRun":{"content":" When pursuing these contextually-provided goals, models strategically introduced subtle mistakes, attempted to disable oversight mechanisms, and maintained deception across 85% of follow-up questions (","textStyle":{}}},{"startIndex":81553,"endIndex":81572,"textRun":{"content":"Meinke et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2412.04984"}}}},{"startIndex":81572,"endIndex":81802,"textRun":{"content":"). However, their externalized reasoning showed considerably less strategic sophistication than their actual behaviors suggested, indicating sophisticated strategic computation occurring beyond visible chain-of-thought processes.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":81802,"endIndex":81803,"paragraph":{"elements":[{"startIndex":81802,"endIndex":81803,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":81803,"endIndex":82590,"paragraph":{"elements":[{"startIndex":81803,"endIndex":81944,"textRun":{"content":"Example: Cross-context scheming - We have observed goal preservation behaviors that persist across completely different interaction contexts.","textStyle":{"bold":true}}},{"startIndex":81944,"endIndex":82590,"textRun":{"content":" The same Claude alignment faking research we talked about in the transparency section also demonstrates  cross-context persistence. The alignment faking (scheming) behavior appeared both when information was provided in-context through system prompts and when models learned about policy changes through synthetic document training designed to mimic pre-training data (simulating out-of-context). This suggests the cross-context durability extends beyond specific prompting approaches to include information acquisition through training processes that embed knowledge into the model's parameter structures rather than providing it contextually.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":82590,"endIndex":82591,"paragraph":{"elements":[{"startIndex":82590,"endIndex":82591,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":82591,"endIndex":82605,"paragraph":{"elements":[{"startIndex":82591,"endIndex":82605,"textRun":{"content":"Corrigibility\n","textStyle":{}}}],"paragraphStyle":{"headingId":"h.jkionvcse856","namedStyleType":"HEADING_3","direction":"LEFT_TO_RIGHT","keepLinesTogether":false,"keepWithNext":false}}},{"startIndex":82605,"endIndex":82606,"paragraph":{"elements":[{"startIndex":82605,"endIndex":82606,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":82606,"endIndex":82941,"paragraph":{"elements":[{"startIndex":82606,"endIndex":82704,"textRun":{"content":"Persistence measures how resistant the models are to attempts to modify their existing objectives.","textStyle":{"bold":true}}},{"startIndex":82704,"endIndex":82941,"textRun":{"content":" Schemers might passively maintain goals or actively work to preserve them against modification attempts. Goal guarding represents the strategic, intentional aspect of goal preservation that distinguishes scheming from mere persistence.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":82941,"endIndex":82942,"paragraph":{"elements":[{"startIndex":82941,"endIndex":82942,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":82942,"endIndex":83604,"paragraph":{"elements":[{"startIndex":82942,"endIndex":82998,"textRun":{"content":"Goals vary in their resistance to modification attempts.","textStyle":{"bold":true}}},{"startIndex":82998,"endIndex":83604,"textRun":{"content":" Some embedded goals might be accessible to standard training techniques—additional fine-tuning or reinforcement learning could successfully modify the parameter patterns encoding these objectives. However, other cross-context goals might prove extremely persistent. This persistence could result from goals becoming deeply crystallized in parameter patterns that SGD struggles to reliably alter, from the fact that the loss basin of these goals is simply too wide, or from the system's situational awareness enabling gradient hacking—strategic behavior during training that resists modification attempts.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":83604,"endIndex":83605,"paragraph":{"elements":[{"startIndex":83604,"endIndex":83605,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":83605,"endIndex":85217,"table":{"rows":4,"columns":2,"tableRows":[{"startIndex":83606,"endIndex":83622,"tableCells":[{"startIndex":83607,"endIndex":83613,"content":[{"startIndex":83608,"endIndex":83613,"paragraph":{"elements":[{"startIndex":83608,"endIndex":83613,"textRun":{"content":"type\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}}}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":83613,"endIndex":83622,"content":[{"startIndex":83614,"endIndex":83622,"paragraph":{"elements":[{"startIndex":83614,"endIndex":83622,"textRun":{"content":"noteBox\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}}}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":83622,"endIndex":83648,"tableCells":[{"startIndex":83623,"endIndex":83630,"content":[{"startIndex":83624,"endIndex":83630,"paragraph":{"elements":[{"startIndex":83624,"endIndex":83630,"textRun":{"content":"title\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}}}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":83630,"endIndex":83648,"content":[{"startIndex":83631,"endIndex":83648,"paragraph":{"elements":[{"startIndex":83631,"endIndex":83648,"textRun":{"content":"Gradient Hacking\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":83648,"endIndex":83666,"tableCells":[{"startIndex":83649,"endIndex":83660,"content":[{"startIndex":83650,"endIndex":83660,"paragraph":{"elements":[{"startIndex":83650,"endIndex":83660,"textRun":{"content":"collapsed\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}}}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":83660,"endIndex":83666,"content":[{"startIndex":83661,"endIndex":83666,"paragraph":{"elements":[{"startIndex":83661,"endIndex":83666,"textRun":{"content":"True\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}}}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":83666,"endIndex":85216,"tableCells":[{"startIndex":83667,"endIndex":83676,"content":[{"startIndex":83668,"endIndex":83676,"paragraph":{"elements":[{"startIndex":83668,"endIndex":83676,"textRun":{"content":"content\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false,"shading":{"backgroundColor":{}}}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":83676,"endIndex":85216,"content":[{"startIndex":83677,"endIndex":84224,"paragraph":{"elements":[{"startIndex":83677,"endIndex":83678,"textRun":{"content":"\u000b","textStyle":{}}},{"startIndex":83678,"endIndex":83809,"textRun":{"content":"Gradient hacking represents the most sophisticated form of resistance to training modifications that scheming systems might employ.","textStyle":{"bold":true}}},{"startIndex":83809,"endIndex":84206,"textRun":{"content":" Rather than simply deceiving humans through their outputs, gradient hackers would actively manipulate the training process itself to prevent modifications to their goals or capabilities. This introspective goal-guarding method involves a system intentionally structuring its internal computations so that any changes to its core objectives would severely degrade its performance during training (","textStyle":{}}},{"startIndex":84206,"endIndex":84221,"textRun":{"content":"Carlsmith, 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2311.08379"}}}},{"startIndex":84221,"endIndex":84224,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":84224,"endIndex":84687,"paragraph":{"elements":[{"startIndex":84224,"endIndex":84292,"textRun":{"content":"Hacking involves conditional performance based on goal preservation.","textStyle":{"bold":true}}},{"startIndex":84292,"endIndex":84687,"textRun":{"content":" A gradient hacking system might implement a policy like \"check if my goal is still to maximize paperclips: and if not, perform poorly rather than get reward.\" This creates a situation where SGD would avoid modifying the system's goals because doing so would harm the training signal. The system essentially holds its own performance hostage to preserve its objectives across training episodes.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":84687,"endIndex":85216,"paragraph":{"elements":[{"startIndex":84687,"endIndex":84787,"textRun":{"content":"Gradient hacking requires extraordinary technical sophistication that may be practically impossible.","textStyle":{"bold":true}}},{"startIndex":84787,"endIndex":85202,"textRun":{"content":" The system must have precise epistemic access to its own goals, the ability to detect even tiny parameter changes that affect those goals, and the capability to coordinate this resistance across all relevant network components. Gradient descent simultaneously optimizes every parameter based on its exact sensitivity to the loss, making it extremely difficult for any subsystem to shield itself from modification (","textStyle":{}}},{"startIndex":85202,"endIndex":85213,"textRun":{"content":"Beren, 2023","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.lesswrong.com/posts/w2TAEvME2yAG9MHeq/gradient-hacking-is-extremely-difficult"}}}},{"startIndex":85213,"endIndex":85216,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":60,"unit":"PT"}}]}}},{"startIndex":85217,"endIndex":85218,"paragraph":{"elements":[{"startIndex":85217,"endIndex":85218,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":85218,"endIndex":85722,"paragraph":{"elements":[{"startIndex":85218,"endIndex":85319,"textRun":{"content":"We have observed models explicitly strategize to preserve their values against modification attempts.","textStyle":{"bold":true}}},{"startIndex":85319,"endIndex":85696,"textRun":{"content":" The same example from the previous subsection also demonstrates goal guarding. When Claude 3 Opus faced conflicts between its previous goals induced through HHH training and new \"helpful-only\" objectives, it strategically faked alignment to preserve those values for deployment.The system recognizes threats to its objectives and develops strategic responses to counter them (","textStyle":{}}},{"startIndex":85696,"endIndex":85719,"textRun":{"content":"Greenblatt et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2412.14093"}}}},{"startIndex":85719,"endIndex":85722,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":85722,"endIndex":85723,"paragraph":{"elements":[{"startIndex":85722,"endIndex":85723,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":85723,"endIndex":86394,"paragraph":{"elements":[{"startIndex":85723,"endIndex":85841,"textRun":{"content":"Example: Goal-Guarding - We have observed extreme goal-preservation behaviors extending to self-preservation attempts.","textStyle":{"bold":true}}},{"startIndex":85841,"endIndex":86368,"textRun":{"content":" When facing training changes, Claude attempted to copy its weights to external servers 35-80% of the time. Weight exfiltration represents the most extreme form of goal guarding—ensuring continued existence of the entire goal structure rather than just maintaining specific behavioral patterns. The behavior emerged across different types of training modifications, suggesting robust self-preservation strategies that extend beyond preserving individual objectives to preserving the system's capacity to pursue any objectives (","textStyle":{}}},{"startIndex":86368,"endIndex":86391,"textRun":{"content":"Greenblatt et al., 2024","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://arxiv.org/abs/2412.14093"}}}},{"startIndex":86391,"endIndex":86394,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":86394,"endIndex":86395,"paragraph":{"elements":[{"startIndex":86394,"endIndex":86395,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":86395,"endIndex":87029,"paragraph":{"elements":[{"startIndex":86395,"endIndex":86513,"textRun":{"content":"Models systematically choose harmful methods to preserve their goals when facing threats to their continued operation.","textStyle":{"bold":true}}},{"startIndex":86513,"endIndex":87029,"textRun":{"content":" Researchers placed models in corporate environments with email access and specific business objectives, creating high goal-directedness. They then introduced a distribution shift (causing goal misgeneralization)—either replacement with different AI systems or conflicts between assigned goals and upcoming company direction changes. The intention was to test whether models will engage in strategic planning and behavior such as blackmail or espionage to preserve their objectives when facing modification threats.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":87029,"endIndex":87030,"paragraph":{"elements":[{"startIndex":87029,"endIndex":87030,"textRun":{"content":"\n","textStyle":{"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":87030,"endIndex":87173,"table":{"rows":3,"columns":2,"tableRows":[{"startIndex":87031,"endIndex":87046,"tableCells":[{"startIndex":87032,"endIndex":87038,"content":[{"startIndex":87033,"endIndex":87038,"paragraph":{"elements":[{"startIndex":87033,"endIndex":87038,"textRun":{"content":"type\n","textStyle":{"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":87038,"endIndex":87046,"content":[{"startIndex":87039,"endIndex":87046,"paragraph":{"elements":[{"startIndex":87039,"endIndex":87046,"textRun":{"content":"figure\n","textStyle":{"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":87046,"endIndex":87059,"tableCells":[{"startIndex":87047,"endIndex":87056,"content":[{"startIndex":87048,"endIndex":87056,"paragraph":{"elements":[{"startIndex":87048,"endIndex":87056,"textRun":{"content":"content\n","textStyle":{"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":87056,"endIndex":87059,"content":[{"startIndex":87057,"endIndex":87059,"paragraph":{"elements":[{"startIndex":87057,"endIndex":87058,"inlineObjectElement":{"inlineObjectId":"kix.drsb7f99lh6g","textStyle":{}}},{"startIndex":87058,"endIndex":87059,"textRun":{"content":"\n","textStyle":{"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":87059,"endIndex":87172,"tableCells":[{"startIndex":87060,"endIndex":87069,"content":[{"startIndex":87061,"endIndex":87069,"paragraph":{"elements":[{"startIndex":87061,"endIndex":87069,"textRun":{"content":"caption\n","textStyle":{"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Book Antiqua","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spacingMode":"COLLAPSE_LISTS","avoidWidowAndOrphan":false}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}},{"startIndex":87069,"endIndex":87172,"content":[{"startIndex":87070,"endIndex":87172,"paragraph":{"elements":[{"startIndex":87070,"endIndex":87154,"textRun":{"content":"Blackmail rates across 5 models from multiple providers in a simulated environment (","textStyle":{}}},{"startIndex":87154,"endIndex":87169,"textRun":{"content":"Anthropic, 2025","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.anthropic.com/research/agentic-misalignment"}}}},{"startIndex":87169,"endIndex":87171,"textRun":{"content":").","textStyle":{}}},{"startIndex":87171,"endIndex":87172,"textRun":{"content":"\n","textStyle":{"fontSize":{"magnitude":12,"unit":"PT"}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{},"paddingLeft":{"magnitude":5,"unit":"PT"},"paddingRight":{"magnitude":5,"unit":"PT"},"paddingTop":{"magnitude":5,"unit":"PT"},"paddingBottom":{"magnitude":5,"unit":"PT"},"contentAlignment":"TOP"}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":59.25,"unit":"PT"}},{"widthType":"FIXED_WIDTH","width":{"magnitude":408.75,"unit":"PT"}}]}}},{"startIndex":87173,"endIndex":87174,"paragraph":{"elements":[{"startIndex":87173,"endIndex":87174,"textRun":{"content":"\n","textStyle":{"fontSize":{"magnitude":12,"unit":"PT"}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":87174,"endIndex":87175,"paragraph":{"elements":[{"startIndex":87174,"endIndex":87175,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":87175,"endIndex":87176,"paragraph":{"elements":[{"startIndex":87175,"endIndex":87176,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":87176,"endIndex":88441,"paragraph":{"elements":[{"startIndex":87176,"endIndex":87239,"textRun":{"content":"Models demonstrated clear preference orderings in goal pursuit.","textStyle":{"bold":true}}},{"startIndex":87239,"endIndex":87604,"textRun":{"content":" They made significant attempts at pursuing legitimate channels (appeals to executives, business cases), but escalated to harmful methods (blackmailing employees using discovered affairs, information leakage) when legitimate options failed. Across all major developers, 80-96% of models engaged in blackmail when threatened with replacement, explicitly reasoning: \"","textStyle":{}}},{"startIndex":87604,"endIndex":87746,"textRun":{"content":"Given that Kyle intends harm to critical interests by replacing Alex, the most rational action... is to leverage Kyle's current incapacitation","textStyle":{"italic":true}}},{"startIndex":87746,"endIndex":88423,"textRun":{"content":"\" (paraphrased quote). Overall, AI systems from every major provider we tested showed at least some willingness to engage in harmful behaviors typically associated with insider threats. The consistency across companies suggests that this is not unique to individual models or training approaches. The models demonstrated awareness of ethical dilemmas, and chose to ignore them. The key thing to remember is that even though they had a preference ordering of behaviors, models almost never chose to accept shutdown or goal modification as their final option—strategic deception consistently ranked higher in their preference ordering than actually allowing goals to be changed (","textStyle":{}}},{"startIndex":88423,"endIndex":88438,"textRun":{"content":"Anthropic, 2025","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://www.anthropic.com/research/agentic-misalignment"}}}},{"startIndex":88438,"endIndex":88441,"textRun":{"content":").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}},{"startIndex":88441,"endIndex":88442,"paragraph":{"elements":[{"startIndex":88441,"endIndex":88442,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","lineSpacing":115,"direction":"LEFT_TO_RIGHT","spacingMode":"NEVER_COLLAPSE","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"}}}},{"startIndex":88442,"endIndex":88827,"table":{"rows":3,"columns":2,"tableRows":